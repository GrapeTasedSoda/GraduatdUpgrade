# MAC16 三 PVT corner SPEF 提取脚本 - Fusion Compiler V-2023.12
# 在已保存的 P&R 设计上建立 3 个 corner(TYP/SS-RCworst/FF-RCbest),
# 各自绑定 TLU+ 与工艺库, 提取寄生并写出 3 个 SPEF。
# 运行: cd script && fc_shell -64 -batch -f fc_3corner_spef.tcl
set PROJ_ROOT [file normalize [file dirname [info script]]/..]
/home/user/MAC16_work
set PDK_ROOT  "$PROJ_ROOT/lib/PDK/Common/ics55_LLSC_H9CR_0917"
/home/user/MAC16_work/lib/PDK/Common/ics55_LLSC_H9CR_0917
set OUTDIR    "$PROJ_ROOT/out/apr"
/home/user/MAC16_work/out/apr
set NDM_LIB   "$OUTDIR/ndm/mac16_ndm"
/home/user/MAC16_work/out/apr/ndm/mac16_ndm
# 3 个 corner 的 TLU+ (由 PDK RCE ETF 转 ITF 后用 grdgenxo 生成)
set TLU_TYP "$OUTDIR/tech/ics55_typ.tlup"
/home/user/MAC16_work/out/apr/tech/ics55_typ.tlup
set TLU_RCW "$OUTDIR/tech/ics55_rcworst.tlup"
/home/user/MAC16_work/out/apr/tech/ics55_rcworst.tlup
set TLU_RCB "$OUTDIR/tech/ics55_rcbest.tlup"
/home/user/MAC16_work/out/apr/tech/ics55_rcbest.tlup
# 3 个 corner 的时序库
set LIB_TYP "$PDK_ROOT/liberty/db/ics55_LLSC_H9CR_typ_tt_1p2_25_nldm.db"
/home/user/MAC16_work/lib/PDK/Common/ics55_LLSC_H9CR_0917/liberty/db/ics55_LLSC_H9CR_typ_tt_1p2_25_nldm.db
set LIB_RCW "$PDK_ROOT/liberty/db/ics55_LLSC_H9CR_ss_rcworst_1p08_125_nldm.db"
/home/user/MAC16_work/lib/PDK/Common/ics55_LLSC_H9CR_0917/liberty/db/ics55_LLSC_H9CR_ss_rcworst_1p08_125_nldm.db
set LIB_RCB "$PDK_ROOT/liberty/db/ics55_LLSC_H9CR_ff_rcbest_1p32_m40_nldm.db"
/home/user/MAC16_work/lib/PDK/Common/ics55_LLSC_H9CR_0917/liberty/db/ics55_LLSC_H9CR_ff_rcbest_1p32_m40_nldm.db
set_app_var link_library [list $LIB_TYP $LIB_RCW $LIB_RCB]
/home/user/MAC16_work/lib/PDK/Common/ics55_LLSC_H9CR_0917/liberty/db/ics55_LLSC_H9CR_typ_tt_1p2_25_nldm.db /home/user/MAC16_work/lib/PDK/Common/ics55_LLSC_H9CR_0917/liberty/db/ics55_LLSC_H9CR_ss_rcworst_1p08_125_nldm.db /home/user/MAC16_work/lib/PDK/Common/ics55_LLSC_H9CR_0917/liberty/db/ics55_LLSC_H9CR_ff_rcbest_1p32_m40_nldm.db
open_lib $NDM_LIB
Information: Loading library file '/home/user/MAC16_work/out/apr/ndm/mac16_ndm' (FILE-007)
Information: Loading library file '/home/user/MAC16_work/script/CLIBs/ics55_LLSC_H9CR.ndm' (FILE-007)
Information: Loading library file '/home/user/MAC16_work/script/CLIBs/ics55_LLSC_H9CR_physical_only.ndm' (FILE-007)
Information: Auto created reference libraries are up-to-date, no need to rebuild. (LIB-084)
{mac16_ndm}
open_block mac16.design
Information: User units loaded from library 'ics55_LLSC_H9CR_typ_tt_1p2_25' (LNK-040)
Opening block 'mac16_ndm:mac16.design' in edit mode
{mac16_ndm:mac16.design}
# 幂等: 清掉已有同名 corner / scenario
set existing [get_corners {typ_tt_1p2_25 ss_rcworst_1p08_125 ff_rcbest_1p32_m40}]
Using libraries: mac16_ndm ics55_LLSC_H9CR_typ_tt_1p2_25 ics55_LLSC_H9CR_physical_only
Visiting block mac16_ndm:mac16.design
Design 'mac16' was successfully linked.
{typ_tt_1p2_25 ss_rcworst_1p08_125 ff_rcbest_1p32_m40}
if {[sizeof_collection $existing] > 0} { remove_corners $existing }
3
set exsc [get_scenarios {scen_typ scen_rcw scen_rcb}]
Warning: No scenario objects matched 'scen_typ' (SEL-004)
Warning: No scenario objects matched 'scen_rcw' (SEL-004)
Warning: No scenario objects matched 'scen_rcb' (SEL-004)
if {[sizeof_collection $exsc] > 0} { remove_scenarios $exsc }
# corner 1: TYP 1.2V 25C (参考)
create_corner typ_tt_1p2_25
1
set_operating_conditions -library ics55_LLSC_H9CR_typ_tt_1p2_25 ETSCA_N55_H9BR_tt_mos_TYP_1.2_25
1
read_parasitic_tech -tlup $TLU_TYP
NEX(WARNING): parasitic_tech file: /home/user/MAC16_work/out/apr/tech/ics55_typ.tlup already read in, mandatory 1-to-1 map between tluplus file and paraTech
1
set_parasitic_parameters -early_spec ics55_typ.tlup -early_temperature 25 \
                         -late_spec ics55_typ.tlup -late_temperature 25
1
# corner 2: SS 1.08V 125C / RCworst (setup 最差)
create_corner ss_rcworst_1p08_125
1
set_operating_conditions -library ics55_LLSC_H9CR_ss_rcworst_1p08_125 ETSCA_N55_H9BR_ss_mos_RCworst_1.08_125
1
read_parasitic_tech -tlup $TLU_RCW
NEX(WARNING): parasitic_tech file: /home/user/MAC16_work/out/apr/tech/ics55_rcworst.tlup already read in, mandatory 1-to-1 map between tluplus file and paraTech
1
set_parasitic_parameters -early_spec ics55_rcworst.tlup -early_temperature 125 \
                         -late_spec ics55_rcworst.tlup -late_temperature 125
1
# corner 3: FF 1.32V -40C / RCbest (hold 最差)
create_corner ff_rcbest_1p32_m40
1
set_operating_conditions -library ics55_LLSC_H9CR_ff_rcbest_1p32_m40 ETSCA_N55_H9BR_ff_mos_RCbest_1.32_-40
1
read_parasitic_tech -tlup $TLU_RCB
NEX(WARNING): parasitic_tech file: /home/user/MAC16_work/out/apr/tech/ics55_rcbest.tlup already read in, mandatory 1-to-1 map between tluplus file and paraTech
1
set_parasitic_parameters -early_spec ics55_rcbest.tlup -early_temperature -40 \
                         -late_spec ics55_rcbest.tlup -late_temperature -40
1
# scenario: 每个 corner 一个, 激活 setup/hold 分析
create_scenario -mode default -corner typ_tt_1p2_25 -name scen_typ
Created scenario scen_typ for mode default and corner typ_tt_1p2_25
All analysis types are activated.
{scen_typ}
create_scenario -mode default -corner ss_rcworst_1p08_125 -name scen_rcw
Created scenario scen_rcw for mode default and corner ss_rcworst_1p08_125
All analysis types are activated.
{scen_rcw}
create_scenario -mode default -corner ff_rcbest_1p32_m40 -name scen_rcb
Created scenario scen_rcb for mode default and corner ff_rcbest_1p32_m40
All analysis types are activated.
{scen_rcb}
set_scenario_status {scen_typ scen_rcw scen_rcb} -active true -setup true -hold true
Scenario scen_typ (mode default corner typ_tt_1p2_25) is active for setup/hold/leakage_power/dynamic_power/max_transition/max_capacitance/min_capacitance analysis.
Scenario scen_rcw (mode default corner ss_rcworst_1p08_125) is active for setup/hold/leakage_power/dynamic_power/max_transition/max_capacitance/min_capacitance analysis.
Scenario scen_rcb (mode default corner ff_rcbest_1p32_m40) is active for setup/hold/leakage_power/dynamic_power/max_transition/max_capacitance/min_capacitance analysis.
1
# 提取并写出所有 corner 的 SPEF
update_timing -full
