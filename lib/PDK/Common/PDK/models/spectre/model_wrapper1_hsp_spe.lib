section mos_total

parameters sigma_mis_a = 0          
parameters sigma_mis_b = 0          
parameters sigma_mis_c = 0          
parameters sigma_mis_d = 0          
parameters sigma_mis_e = 0          
parameters sigma_mis_f = 0          
parameters sigma_mis_g = 0          
parameters sigma_mis_h = 0          
statistics {
    mismatch {
        vary sigma_mis_a dist = gauss std = 1/1
        vary sigma_mis_b dist = gauss std = 1/1
        vary sigma_mis_c dist = gauss std = 1/1
        vary sigma_mis_d dist = gauss std = 1/1
        vary sigma_mis_e dist = gauss std = 1/1
        vary sigma_mis_f dist = gauss std = 1/1
        vary sigma_mis_g dist = gauss std = 1/1
        vary sigma_mis_h dist = gauss std = 1/1
    }
}
subckt nm1p2_svt_lp (d g s b )
parameters
+w        = 1e-6          
+l        = 1e-6          
+sa       = 0             
+sb       = 0             
+sd       = 0             
+as       = 0             
+ad       = 0             
+ps       = 0             
+pd       = 0             
+nrd      = 0             
+nrs      = 0             
+sca      = 0             
+scb      = 0             
+scc      = 0             
+nf       = 1             
+mr       = 1             
+mismod   = 1             
+prelayout = 0            

parameters geo_fac  = 1/sqrt(wef*lef*mr)
+lef      = l*0.9-2e-009-5*(-2.436e-008)
+wef      = (w*0.9+1.5e-008-0*2*(1e-008))/nf
+atoxe_nm1p2_svt_lp = 2.0e-19 avth0_nm1p2_svt_lp = 5e-9 avoff_nm1p2_svt_lp = 2.5e-9
+au0_nm1p2_svt_lp = 1.0e-12 aeta0_nm1p2_svt_lp = 1.0e-8
+dtoxe_nm1p2_svt_lp_mis = 0+atoxe_nm1p2_svt_lp*geo_fac*sigma_mis_a*mismod
+dvth0_nm1p2_svt_lp_mis = 0+avth0_nm1p2_svt_lp*geo_fac*sigma_mis_b*mismod
+du0_nm1p2_svt_lp_mis = 0+au0_nm1p2_svt_lp*geo_fac*sigma_mis_c*mismod
+dvoff_nm1p2_svt_lp_mis = 0+avoff_nm1p2_svt_lp*geo_fac*sigma_mis_d*mismod
+deta0_nm1p2_svt_lp_mis = 0+aeta0_nm1p2_svt_lp*geo_fac*sigma_mis_e*mismod
+dtoxe_nm1p2_svt_lp_mismatch = 0+dtoxe_nm1p2_svt_lp_mis
+dvth0_nm1p2_svt_lp_mismatch = 0+dvth0_nm1p2_svt_lp_mis
+du0_nm1p2_svt_lp_mismatch = 0+du0_nm1p2_svt_lp_mis
+dvoff_nm1p2_svt_lp_mismatch = 0+dvoff_nm1p2_svt_lp_mis
+deta0_nm1p2_svt_lp_mismatch = 0+deta0_nm1p2_svt_lp_mis
m1 d g s b nm1p2_svt_lp w = w l = l sa = sa sb = sb sd = sd as = as ad = ad ps = ps pd = pd nrd = nrd nrs = nrs sca = sca scb = scb scc = scc nf = nf m = mr 
include "./mos/nsvt_spe.mdl"
ends nm1p2_svt_lp

