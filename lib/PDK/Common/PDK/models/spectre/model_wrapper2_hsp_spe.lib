section var_mc

// *mos varactor
parameters sigma_mis_var = 0        
parameters sigma_mc_var = 0         
parameters aa       = sigma_mc_var  
parameters ac0_var1p2_npd_nw_lp = 1.18e-14*1.2
parameters bc0_var1p2_npd_nw_lp = 49e-10*1.2
parameters cc0_var1p2_npd_nw_lp = 0*1.2
statistics {
    mismatch {
        vary sigma_mis_var dist = gauss std = 1/1
    }
    process {
        vary sigma_mc_var dist = gauss std = 1/3
    }
}

parameters ac0_var3p3_npd_nw_lp = 0.315e-14*1.2
parameters bc0_var3p3_npd_nw_lp = 2.256e-8*1.2
parameters cc0_var3p3_npd_nw_lp = 0*1.2

parameters dcgg_var1p2_npd_nw_lp = 0.03*aa
parameters dtox_var1p2_npd_nw_lp = -4.8e-11*aa
parameters dcgg_var3p3_npd_nw_lp = 0.03*aa
include "./var/varactor_spe.ckt"

endsection var_mc


