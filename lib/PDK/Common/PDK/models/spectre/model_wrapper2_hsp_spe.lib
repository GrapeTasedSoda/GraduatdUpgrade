// * mom corner model *
// ********************
section mom_tt

parameters sigma_mis_mom = 0        
parameters dmom_mnx = 0             
statistics {
    mismatch {
        vary sigma_mis_mom dist = gauss std = 1/1
    }
}
include "./mom/mom_spe.ckt"

endsection mom_tt


section mom_ff

parameters sigma_mis_mom = 0        
parameters dmom_mnx = -0.1          
statistics {
    mismatch {
        vary sigma_mis_mom dist = gauss std = 1/1
    }
}
include "./mom/mom_spe.ckt"

endsection mom_ff


section mom_ss

parameters sigma_mis_mom = 0        
parameters dmom_mnx = 0.1           
statistics {
    mismatch {
        vary sigma_mis_mom dist = gauss std = 1/1
    }
}
include "./mom/mom_spe.ckt"

endsection mom_ss


section mom_mc

parameters sigma_mom = 0            
parameters sigma_mis_mom = 0        
parameters dmom_mnx = -0.1*sigma_mom
statistics {
    mismatch {
        vary sigma_mis_mom dist = gauss std = 1/1
    }
    process {
        vary sigma_mom dist = gauss std = 1/3
    }
}
include "./mom/mom_spe.ckt"

endsection mom_mc




