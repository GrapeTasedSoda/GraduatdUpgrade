simulator lang = spectre

library model_wrapper2_hsp
// * three corners are supported: tt_passive, ff_passive, ss_passive.
// * this file should be used with the model parameter files 'pnp12_lp.mdl', 'npn12_lp.mdl', 'pnp33_lp.mdl', 'npn33_lp.mdl'.
// * 'dio_core.mdl', 'dio_io33.mdl', 'dio_well.mdl'.
// * 'resistor.ckt', 'varactor.ckt', 'mom.ckt'. 


// **********************
// * bjt corner model
// **********************
section bjt_core12_tt

parameters sigma_mis_bjt12_a = 0    
parameters sigma_mis_bjt12_b = 0    
parameters dbf_vpnp1p2_10x_lp = 0    dis_vpnp1p2_10x_lp = 0    dnf_vpnp1p2_10x_lp = 0   
parameters dbf_vpnp1p2_5x_lp = 0     dis_vpnp1p2_5x_lp = 0     dnf_vpnp1p2_5x_lp = 0    
parameters dbf_vpnp1p2_2x_lp = 0     dis_vpnp1p2_2x_lp = 0     dnf_vpnp1p2_2x_lp = 0    
parameters dcje_vpnp1p2_10x_lp = 0  
parameters dcje_vpnp1p2_5x_lp = 0   
parameters dcje_vpnp1p2_2x_lp = 0   
parameters dcjc_vpnp1p2_10x_lp = 0  
parameters dcjc_vpnp1p2_5x_lp = 0   
parameters dcjc_vpnp1p2_2x_lp = 0   
parameters dbf_vnpn1p2_10x_lp = 0    dis_vnpn1p2_10x_lp = 0    dnf_vnpn1p2_10x_lp = 0   
parameters dbf_vnpn1p2_5x_lp = 0     dis_vnpn1p2_5x_lp = 0     dnf_vnpn1p2_5x_lp = 0    
parameters dbf_vnpn1p2_2x_lp = 0     dis_vnpn1p2_2x_lp = 0     dnf_vnpn1p2_2x_lp = 0    
parameters dcje_vnpn1p2_10x_lp = 0  
parameters dcje_vnpn1p2_5x_lp = 0   
parameters dcje_vnpn1p2_2x_lp = 0   
parameters dcjc_vnpn1p2_10x_lp = 0  
parameters dcjc_vnpn1p2_5x_lp = 0   
parameters dcjc_vnpn1p2_2x_lp = 0   
statistics {
    mismatch {
        vary sigma_mis_bjt12_a dist = gauss std = 1/1
        vary sigma_mis_bjt12_b dist = gauss std = 1/1
    }
}
include "./bjt/pnp12_lp_spe.mdl"
include "./bjt/npn12_lp_spe.mdl"

endsection bjt_core12_tt


