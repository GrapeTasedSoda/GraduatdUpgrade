// ***********************************************************************************
// *                              3.3v io nmos model                               *
// ***********************************************************************************
model nm3p3_lp bsim4 
+type     = n              lmin     = 3.42e-007      lmax     = 0.0001        
+wmin     = 1.89e-007      wmax     = 0.0001         version  = 4.5           
+binunit  = 2              paramchk = 1              mobmod   = 0             
+capmod   = 2              igcmod   = 0              igbmod   = 0             
