}


parameters u0_q     = evalbin(u0_c(xbin+1,ybin+1), u0_c(xbin+1,ybin), u0_c(xbin,ybin), u0_c(xbin,ybin+1))


real ags_w0p12(real y) {
	return selectp7(y,ags_w0p12_1,ags_w0p12_2,ags_w0p12_3,ags_w0p12_4,ags_w0p12_5,ags_w0p12_6,ags_w0p12_7);
