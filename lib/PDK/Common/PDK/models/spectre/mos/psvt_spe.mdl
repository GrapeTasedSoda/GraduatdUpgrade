}


real vsat_c(real x, real y) {
	return selectp6(x, vsat_w0p12(y), vsat_w0p15(y), vsat_w0p3(y), vsat_w0p5(y), vsat_w1(y), vsat_w10(y));
}


parameters vsat_qq  = evalbin(vsat_c(xbin+1,ybin+1), vsat_c(xbin+1,ybin), vsat_c(xbin,ybin), vsat_c(xbin,ybin+1))


parameters du0a     = 0.001         


parameters du0b     = 1.2           


parameters du0c     = -0.4          


parameters du0d     = -0.05         


parameters du0e     = 0.5           


parameters du0      = du0a/cosh((du0b)*(w/nf*1e6+du0c))*(1+du0d/pwr(l*1e6,du0e))



// ***********************************************************************************
// *                              1.2v core svt pmos model                               *
// ***********************************************************************************
model pm1p2_svt_lp bsim4 
+type     = p              version  = 4.5           
+binunit  = 2.0            paramchk = 1.0           
+mobmod   = 0              capmod   = 2.0           
+rdsmod   = 0              igcmod   = 2.0           
+igbmod   = 1.0            rbodymod = 0             
+trnqsmod = 0              acnqsmod = 0             
+diomod   = 2.0            tempmod  = 0             
+permod   = 1.0            geomod   = 0             
+rgeomod  = 1.0            rgatemod = 0             
+wpemod   = 1.0            fnoimod  = 1.0           
+tnoimod  = 0              xpart    = 1.0           
+epsrox   = 3.9            toxe     = 2.66e-009+dtoxe_pm1p2_svt_lp + dtoxe_pm1p2_svt_lp_mis
+dtox     = 4.2e-10        toxref   = 2.66e-9       
+xj       = 1.45e-7        ndep     = 7.5e17        
+ngate    = 1.8e20         nsd      = 1.0e20        
+rsh      = 12.15          wint     = -3.0e-8       
+wl       = 0              wln      = 1.0           
+ww       = 1.8e-15        wwn      = 1.0           
+wwl      = 0              lint     = -2.01e-8      
+ll       = 0              lln      = 1.0           
+lw       = 0              lwn      = 1.0           
+lwl      = 3.0e-23        llc      = 0             
+lwc      = 0              lwlc     = 0             
+wlc      = 0              wwc      = 0             
+wwlc     = 0              dwg      = 0             
+dwb      = 0              xl       = -2e-009+dxl_pm1p2_svt_lp
+xw       = 8e-009+dxw_pm1p2_svt_lp dlc      = 1.12e-8       
+dwc      = -1.2e-8        lmin     = 5.4e-8        
+lmax     = 1.0e-4         wmin     = 1.08e-7       
+wmax     = 1.0e-4         dlcig    = 1.0e-9        
+vth0     = (-0.328)+dvth0_pm1p2_svt_lp + dvth0_pm1p2_svt_lp_mis + vth0_q lvth0    = 1.6e-8+dlvth0_pm1p2_svt_lp
+wvth0    = 5.9e-9+dwvth0_pm1p2_svt_lp pvth0    = (1.0e-16)+dpvth0_pm1p2_svt_lp
+phin     = 0.12           k1       = 0.285         
+k2       = -0.006         lk2      = -5.0e-9       
+wk2      = -2.0e-9        pk2      = -2.5e-16      
+k3       = -9.0           k3b      = 3.2           
+w0       = 2.5e-6         lpe0     = 1.2e-7        
+lpeb     = 1.0e-10        vbm      = -3.0          
+dvtp0    = 5.4e-7         dvtp1    = 0.7           
+dvt0     = -0.57          dvt1     = 0.14          
+dvt2     = 0              dvt0w    = 2.5           
+dvt1w    = 5300000.0      dvt2w    = 0             
+u0       = 0.0086+du0_pm1p2_svt_lp+du0_pm1p2_svt_lp_mis + du0 + u0_q lu0      = (-2.41e-10)+dlu0_pm1p2_svt_lp
+wu0      = 6.0e-11+dwu0_pm1p2_svt_lp pu0      = (-8.6e-18)+dpu0_pm1p2_svt_lp
+ua       = 2.0e-11        lua      = -1.1e-16      
+pua      = -8.0e-25       ub       = 1.2189e-18    
+lub      = 1.5e-26        wub      = 1.0e-27       
+pub      = 4.0e-33        uc       = -2.0e-11      
+luc      = 2.0e-18        wuc      = 1.0e-17       
+puc      = -1.0e-24       ud       = 0             
+eu       = 1.67           vsat     = 95000.0 + vsat_qq + dvsat_pm1p2_svt_lp_mis
+lvsat    = (-0.004)+dlvsat_pm1p2_svt_lp pvsat    = (-1.8e-11)+dpvsat_pm1p2_svt_lp
+a0       = 2.9            la0      = -5.9344e-7    
+pa0      = -3.0e-14       ags      = 0.7 + ags_qq + +dags_pm1p2_svt_lp
+lags     = 2.0e-7         wags     = 2.0e-8 + dwags_pm1p2_svt_lp
+b0       = 1.0e-8         b1       = 0             
+keta     = 0.02           lketa    = -5.0e-9       
+wketa    = -2.0e-9        pketa    = 7.0e-16       
+a1       = 0              a2       = 1.0           
+voff     = (-0.0585)+dvoff_pm1p2_svt_lp + dvoff_pm1p2_svt_lp_mis lvoff    = 1.0e-11       
+pvoff    = 2.5e-16        voffl    = -2.0e-10      
