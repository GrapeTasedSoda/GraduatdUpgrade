real ags_c(real x, real y) {
	return selectp6(x, ags_w0p12(y), ags_w0p15(y), ags_w0p3(y), ags_w0p5(y), ags_w1(y), ags_w10(y));
}


parameters ags_qq   = evalbin(ags_c(xbin+1,ybin+1), ags_c(xbin+1,ybin), ags_c(xbin,ybin), ags_c(xbin,ybin+1))


real vsat_w0p12(real y) {
	return selectp7(y,vsat_w0p12_1,vsat_w0p12_2,vsat_w0p12_3,vsat_w0p12_4,vsat_w0p12_5,vsat_w0p12_6,vsat_w0p12_7);
