real evalbin(real p1, real p2, real p3, real p4) {
	return (p1/lbin/dbin-p2/lbin/ubin+p3/rbin/ubin-p4/rbin/dbin + ((p2-p1)/lbin+(p4-p3)/rbin)/lum + ((p4-p1)/dbin+(p2-p3)/ubin)/wum + (p1-p2+p3-p4)/lum/wum)/(1/lbin-1/rbin)/(1/dbin-1/ubin);
}


real select6(real v, real v1, real v2, real v3, real v4, real v5, real v6) {
	return v<v1?1 : v<v2?1 : v<v3?2 : v<v4?3 : v<v5?4 : v<v6?5 : 5;
}


real select7(real v, real v1, real v2, real v3, real v4, real v5, real v6, real v7) {
	return v<v1?1 : v<v2?1 : v<v3?2 : v<v4?3 : v<v5?4 : v<v6?5 : v<v7?6 : 6;
}


real selectp6(real p, real p1, real p2, real p3, real p4, real p5, real p6) {
	return p==1?p1 : p==2?p2 : p==3?p3 : p==4?p4 : p==5?p5 : p==6?p6 : 1e4;
}


real selectp7(real p, real p1, real p2, real p3, real p4, real p5, real p6, real p7) {
	return p==1?p1 : p==2?p2 : p==3?p3 : p==4?p4 : p==5?p5 : p==6?p6 : p==7?p7 : 1e4;
}


parameters xbin     = select6(wum,0.12,0.15,0.3,0.5,1,10)


parameters lbin     = selectp6(xbin,0.12,0.15,0.3,0.5,1,10)


parameters rbin     = selectp6(xbin+1,0.12,0.15,0.3,0.5,1,10)


parameters ybin     = select7(lum,0.06,0.08,0.2,0.5,0.7,1,10)


parameters dbin     = selectp7(ybin,0.06,0.08,0.2,0.5,0.7,1,10)


parameters ubin     = selectp7(ybin+1,0.06,0.08,0.2,0.5,0.7,1,10)


real vth0_w0p12(real y) {
	return selectp7(y,vth0_w0p12_1,vth0_w0p12_2,vth0_w0p12_3,vth0_w0p12_4,vth0_w0p12_5,vth0_w0p12_6,vth0_w0p12_7);
}


