}


real vth0_c(real x, real y) {
	return selectp6(x, vth0_w0p12(y), vth0_w0p15(y), vth0_w0p3(y), vth0_w0p5(y), vth0_w1(y), vth0_w10(y));
}


parameters vth0_q   = evalbin(vth0_c(xbin+1,ybin+1), vth0_c(xbin+1,ybin), vth0_c(xbin,ybin), vth0_c(xbin,ybin+1))


