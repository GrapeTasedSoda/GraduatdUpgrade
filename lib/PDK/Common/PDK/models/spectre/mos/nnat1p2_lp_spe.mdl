real evalbin(real p1, real p2, real p3, real p4) {
	return (p1/lbin/dbin-p2/lbin/ubin+p3/rbin/ubin-p4/rbin/dbin + ((p2-p1)/lbin+(p4-p3)/rbin)/lum + ((p4-p1)/dbin+(p2-p3)/ubin)/wum + (p1-p2+p3-p4)/lum/wum)/(1/lbin-1/rbin)/(1/dbin-1/ubin);
}

real select3(real v, real v1, real v2, real v3) {
	return v<v1?1 : v<v2?1 : v<v3?2 : 2;
}

real select5(real v, real v1, real v2, real v3, real v4, real v5) {
	return v<v1?1 : v<v2?1 : v<v3?2 : v<v4?3 : v<v5?4 : 4;
}

real selectp3(real p, real p1, real p2, real p3) {
	return p==1?p1 : p==2?p2 : p==3?p3 : 1e4;
}

real selectp5(real p, real p1, real p2, real p3, real p4, real p5) {
	return p==1?p1 : p==2?p2 : p==3?p3 : p==4?p4 : p==5?p5 : 1e4;
}


parameters xbin     = select3(wum,0.5,1,10)

parameters lbin     = selectp3(xbin,0.5,1,10)

parameters rbin     = selectp3(xbin+1,0.5,1,10)

parameters ybin     = select5(lum,0.2,0.5,0.7,1,10)

parameters dbin     = selectp5(ybin,0.2,0.5,0.7,1,10)

parameters ubin     = selectp5(ybin+1,0.2,0.5,0.7,1,10)



real vth0_w0p5(real y) {
	return selectp5(y,vth0_w0p5_1,vth0_w0p5_2,vth0_w0p5_3,vth0_w0p5_4,vth0_w0p5_5);
}

real vth0_w1(real y) {
	return selectp5(y,vth0_w1_1,vth0_w1_2,vth0_w1_3,vth0_w1_4,vth0_w1_5);
}

real vth0_w10(real y) {
	return selectp5(y,vth0_w10_1,vth0_w10_2,vth0_w10_3,vth0_w10_4,vth0_w10_5);
}

real vth0_c(real x, real y) {
	return selectp3(x, vth0_w0p5(y), vth0_w1(y), vth0_w10(y));
}

parameters vth0_q   = evalbin(vth0_c(xbin+1,ybin+1), vth0_c(xbin+1,ybin), vth0_c(xbin,ybin), vth0_c(xbin,ybin+1))


real u0_w0p5(real y) {
