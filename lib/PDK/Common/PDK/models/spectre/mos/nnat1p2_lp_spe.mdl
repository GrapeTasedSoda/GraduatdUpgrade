}

real u0_c(real x, real y) {
	return selectp3(x,  u0_w0p5(y),  u0_w1(y), u0_w10(y));
}

parameters u0_q     = evalbin(u0_c(xbin+1,ybin+1), u0_c(xbin+1,ybin), u0_c(xbin,ybin), u0_c(xbin,ybin+1))


