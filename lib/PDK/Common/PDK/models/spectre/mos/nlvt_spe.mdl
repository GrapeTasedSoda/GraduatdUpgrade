real select6(real v, real v1, real v2, real v3, real v4, real v5, real v6) {
	return v<v1?1 : v<v2?1 : v<v3?2 : v<v4?3 : v<v5?4 : v<v6?5 : 5;
}


real select7(real v, real v1, real v2, real v3, real v4, real v5, real v6, real v7) {
	return v<v1?1 : v<v2?1 : v<v3?2 : v<v4?3 : v<v5?4 : v<v6?5 : v<v7?6 : 6;
}


real selectp6(real p, real p1, real p2, real p3, real p4, real p5, real p6) {
	return p==1?p1 : p==2?p2 : p==3?p3 : p==4?p4 : p==5?p5 : p==6?p6 : 1e4;
}


real selectp7(real p, real p1, real p2, real p3, real p4, real p5, real p6, real p7) {
	return p==1?p1 : p==2?p2 : p==3?p3 : p==4?p4 : p==5?p5 : p==6?p6 : p==7?p7 : 1e4;
}


real evalbin_core(real p1, real p2, real p3, real p4) {
	return (p1/lbin_core/dbin_core-p2/lbin_core/ubin_core+p3/rbin_core/ubin_core-p4/rbin_core/dbin_core + ((p2-p1)/lbin_core+(p4-p3)/rbin_core)/(l*1e6) + ((p4-p1)/dbin_core+(p2-p3)/ubin_core)/(w*1e6) + (p1-p2+p3-p4)/(l*1e6)/(w*1e6))/(1/lbin_core-1/rbin_core)/(1/dbin_core-1/ubin_core);
}


