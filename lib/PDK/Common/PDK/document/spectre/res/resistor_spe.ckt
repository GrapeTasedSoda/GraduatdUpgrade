+weff     = w*ra*scale_r-2*dw
+leff     = l*ra*scale_r-2*dl
+rvc0     = 8e-14          rvc1     = 1.743e-8       rvc2     = 1e-18         
+tcoef    = 1.0+(temp-25.0)*(rtc1+rtc2*(temp-25.0))
+r0       = rsh*leff/weff/mr rvc      = max(0,((rvc0 + rvc1 * weff + rvc2 * l/w)/leff/leff))
+cox      = 1.18e-4+dcox_re_ppo_sab_3t capsw    = (7.708e-11+dcapsw_re_ppo_sab_3t)*flag_cc

//*****noise parameters*******
+raf = 2 rkf = 1.7E-22 ref = 1 rweexp = 1.01 rleexp = 0.96
+rgeo_noi = pow(rweff, rweexp) * pow(rleff, rleexp)

c1 n2 sub capacitor c = (cox*weff*leff/2+capsw*weff+capsw*leff)*mr 
r1 n2 n1 resistor r = r0*tcoef*(0.5+1/(2+rvc*v(n2,n1)*v(n2,n1))) 
c2 n1 sub capacitor c = (cox*weff*leff/2+capsw*weff+capsw*leff)*mr 
ends re_ppo_sab_3t



// *****************************************  
// *          metal 1 resistance           *  
// *****************************************
subckt re_m1_2t (n2 n1 )
parameters
+l        = lr            
+w        = wr            
+mr       = 1             

parameters rsh      = 0.1122+drsh_re_m1_2t
+rtc1     = 0.003242       rtc2     = 6.79e-6       
+dw       = 0.012485e-6+ddw_re_m1_2t
+dl       = 0              scale_r  = 0.9           
+weff     = w*scale_r-2*dw
+leff     = l*scale_r-2*dl
+rvc0     = 1.08524e-09    rvc1     = 3.30805e-10    rvc2     = 1.48241e-12   
+tcoef    = 1.0+(temp-25.0)*(rtc1+rtc2*(temp-25.0))
+r0       = rsh*leff/weff/mr rvc      = max(0,((rvc0 + rvc1 * weff + rvc2 * l/w)/leff/leff))

   
r1 n2 n1 resistor r = r0*tcoef*(1.5-1/(2+rvc*v(n2,n1)*v(n2,n1))) 
ends re_m1_2t


// *****************************************  
// *          metal 1 resistance(three terminal)           *  
// *****************************************
subckt re_m1_3t (n2 n1 sub )
parameters
+l        = lr            
+w        = wr            
+mr       = 1             
+flag_cc  = 1             

parameters rsh      = 0.1122+drsh_re_m1_2t
+rtc1     = 0.003242       rtc2     = 6.79e-6       
+dw       = 0.012485e-6+ddw_re_m1_2t
+dl       = 0              scale_r  = 0.9           
+weff     = w*scale_r-2*dw
+leff     = l*scale_r-2*dl
+rvc0     = 1.08524e-09    rvc1     = 3.30805e-10    rvc2     = 1.48241e-12   
+tcoef    = 1.0+(temp-25.0)*(rtc1+rtc2*(temp-25.0))
+r0       = rsh*leff/weff/mr rvc      = max(0,((rvc0 + rvc1 * weff + rvc2 * l/w)/leff/leff))
+cox      = 5.713e-05+dcox_re_m1_2t capsw    = (9.441e-11+dcapsw_re_m1_2t)*flag_cc

c1 n2 sub capacitor c = (cox*weff*l*0.9/2+capsw*weff+capsw*l*0.9)*mr 
r1 n2 n1 resistor r = r0*tcoef*(1.5-1/(2+rvc*v(n2,n1)*v(n2,n1))) 
c2 n1 sub capacitor c = (cox*weff*l*0.9/2+capsw*weff+capsw*l*0.9)*mr 
ends re_m1_3t


