simulator lang = spectre

// *
// *  release version    : 1.2
// *
// *  release date       : 03/15/2025
// *
// *  simulation tool    : synopsys hspice version n-2017.12-sp2
// *
// * 
// *   resistor         : 
// *        *---------------------------------------------------------------------------------*  
// *        |=================================================================================|  
// *        | silicide n+ diffusion                                           |     re_ndif_2t     | 
// *        |---------------------------------------------------------------------------------| 
// *        | silicide n+ diffusion (three terminal)                               |    re_ndif_3t    | 
// *        |---------------------------------------------------------------------------------|  
// *        | silicide p+ diffusion                                           |     re_pdif_2t     | 
// *        |---------------------------------------------------------------------------------| 
// *        | silicide p+ diffusion (three terminal)                               |   re_pdif_3t   | 
// *        |---------------------------------------------------------------------------------| 
// *        | silicide n+ poly                                                |     re_npo_2t      | 
// *        |---------------------------------------------------------------------------------| 
// *        | silicide n+ poly (three terminal)                               |    re_npo_3t    | 
// *        |---------------------------------------------------------------------------------| 
// *        | silicide p+ poly                                                |     re_ppo_2t      | 
// *        |---------------------------------------------------------------------------------| 
// *        | silicide p+ poly (three terminal)                               |    re_npo_3t    | 
// *        |---------------------------------------------------------------------------------| 
// *        | nwell under sti                                                 |    re_nwsti_2t     | 
// *        |---------------------------------------------------------------------------------| 
// *        | nwell under sti  (three terminal)                        |    re_nwsti_3t     | 
// *        |---------------------------------------------------------------------------------| 
// *        | nwell under aa                                                  |    re_nwaa_2t      |      
// *        |---------------------------------------------------------------------------------| 
// *        | nwell under aa  (three terminal)                        |    re_nwaa_3t      |      
// *        |---------------------------------------------------------------------------------|
// *        | non-silicide n+ diffusion                                       |    re_ndif_sab_2t   | 
// *        |---------------------------------------------------------------------------------|
// *        | non-silicide n+ diffusion (three terminal)              |    re_ndif_sab_3t   | 
// *        |---------------------------------------------------------------------------------| 
// *        | non-silicide p+ diffusion                                       |    re_pdif_sab_2t   | 
// *        |---------------------------------------------------------------------------------|  
// *        | non-silicide p+ diffusion (three terminal)              |    re_pdif_sab_3t   | 
// *        |---------------------------------------------------------------------------------| 
// *        | non-silicide n+ poly                                            |    re_npo_sab_2t    | 
// *        |---------------------------------------------------------------------------------| 
// *        | non-silicide n+ poly (three terminal)                           |   re_npo_sab_3t  | 
// *        |---------------------------------------------------------------------------------| 
// *        | non-silicide p+ poly                                            |    re_ppo_sab_2t    | 
// *        |---------------------------------------------------------------------------------|
// *        | non-silicide p+ poly (three terminal)                           |   re_ppo_sab_3t  | 
// *        |---------------------------------------------------------------------------------|  
// *        |          metal 1                                                |      re_m1_2t      | 
// *        |---------------------------------------------------------------------------------| 
// *        |          metal 1 (three terminal)                       |      re_m1_3t      | 
// *        |---------------------------------------------------------------------------------|  
// *        |          metal 2                                                |      re_m2_2t      |
// *        |---------------------------------------------------------------------------------|
// *        |          metal 2 (three terminal)                        |      re_m2_3t      |
// *        |---------------------------------------------------------------------------------|  
// *        |          metal 3                                                |      re_m3_2t      | 
// *        |---------------------------------------------------------------------------------| 
// *        |          metal 3 (three terminal)                       |     re_m3_3t     | 
// *        |---------------------------------------------------------------------------------|  
// *        |          metal 4                                                |      re_m4_2t      | 
// *        |---------------------------------------------------------------------------------| 
// *        |          metal 4 (three terminal)                        |      re_m4_3t      | 
// *        |---------------------------------------------------------------------------------|  
// *        |          metal 5                                                |      re_m5_2t      | 
// *        |---------------------------------------------------------------------------------|  
// *        |          metal 5 (three terminal)                        |      re_m5_3t      | 
// *        |---------------------------------------------------------------------------------|
// *        |          metal 6                                                |     re_m6_2t      | 
// *        |---------------------------------------------------------------------------------|  
// *        |          metal 6  (three terminal)                      |     re_m6_3t      | 
// *        |---------------------------------------------------------------------------------| 
// *        |          metal 7                                                |      re_m7_2t     |
// *        |---------------------------------------------------------------------------------|  
// *        |          metal 7  (three terminal)                       |      re_m7_3t      |
// *        |---------------------------------------------------------------------------------|
// *        |          metal 8                                                |      re_m8_2t      |
// *        |---------------------------------------------------------------------------------|  
// *        |          metal 6  (three terminal)                       |      re_m8_3t      |
// *        |---------------------------------------------------------------------------------|
// *        | top metal1 for wmin=0.4um(standard option)                      |     re_tm2_2t     | 
// *        |---------------------------------------------------------------------------------|  
// *        | top metal2 for wmin=0.4um(standard option)                      |     re_tm2_3t     | 
// *        |---------------------------------------------------------------------------------|
// *        | alpa (thickness=1.45um,standard option)                               |    re_alpa_2t      | 
// *        |---------------------------------------------------------------------------------|
// *        | alpa (thickness=1.45um,standard option) (three terminal)       |    re_alpa_3t      | 
// *        |---------------------------------------------------------------------------------|
// *        | non-silicide hr poly resistance                                 |   re_hrpo_2t       |
// *        |---------------------------------------------------------------------------------|
// *        | non-silicide hr poly resistance (three terminal)                |   re_hrpo_3t    |  
// *        *---------------------------------------------------------------------------------*  
// *
// *   the valid temperature range is from -40c to 125c
// *
// ************************************************************************************  
// *        silicide n+ diffusion resistor subcircuit netlist                         *  
// ************************************************************************************ 
subckt re_ndif_2t (n2 n1 )
parameters
+l        = lr            
+w        = wr            
+mr       = 1             

parameters rsh      = 1.15e+01+drsh_re_ndif_2t rtc1     = 2.08e-03       rtc2     = 1.77e-06      
+dw       = -1.31e-08+ddw_re_ndif_2t dl       = -2e-7          ra       = 0.981          scale_r  = 0.9           
+weff     = w*ra*scale_r-2*dw leff     = l*ra*scale_r-2*dl
+tcoef    = 1.0+(temp-25.0)*(rtc1+rtc2*(temp-25.0))
+rvc0     = 1e-12          rvc1     = 3.00e-11       rvc2     = 1.99e-14      
+r0       = rsh*leff/weff/mr rvc      = max(0,((rvc0 + rvc1 * weff + rvc2 * l/w)/leff/leff))

r1 n2 n1 resistor r = r0*tcoef*(1.5-1/(2+rvc*v(n2,n1)*v(n2,n1))) 

ends re_ndif_2t


// ************************************************************************************  
// *        silicide n+ diffusion resistor subcircuit netlist (three terminal)                         *  
// ************************************************************************************ 
subckt re_ndif_3t (n2 n1 sub )
parameters
+l        = lr            
+w        = wr            
+mr       = 1             

parameters rsh      = 1.15e+01+drsh_re_ndif_2t rtc1     = 2.08e-03       rtc2     = 1.77e-06      
+dw       = -1.31e-08+ddw_re_ndif_2t dl       = -2e-7          ra       = 0.981          scale_r  = 0.9           
+weff     = w*ra*scale_r-2*dw leff     = l*ra*scale_r-2*dl
+tcoef    = 1.0+(temp-25.0)*(rtc1+rtc2*(temp-25.0))
+rvc0     = 1e-12          rvc1     = 3.00e-11       rvc2     = 1.99e-14      
+r0       = rsh*leff/weff/mr rvc      = max(0,((rvc0 + rvc1 * weff + rvc2 * l/w)/leff/leff))

d1 sub n2 dio_1p2_np_pw_lp area = (w-(2/0.9)*dw)*l/5*mr pj = ((w-(2/0.9)*dw)+2*l/5)*mr 
r1 n2 na resistor r = r0/4*tcoef*(1.5-1/(2+rvc*v(n2,n1)*v(n2,n1))) 
d2 sub na dio_1p2_np_pw_lp area = (w-(2/0.9)*dw)*l/5*mr pj = 2*l/5*mr 
r2 na nb resistor r = r0/4*tcoef*(1.5-1/(2+rvc*v(n2,n1)*v(n2,n1))) 
d3 sub nb dio_1p2_np_pw_lp area = (w-(2/0.9)*dw)*l/5*mr pj = 2*l/5*mr 
r3 nb nc resistor r = r0/4*tcoef*(1.5-1/(2+rvc*v(n2,n1)*v(n2,n1))) 
d4 sub nc dio_1p2_np_pw_lp area = (w-(2/0.9)*dw)*l/5*mr pj = 2*l/5*mr 
r4 nc n1 resistor r = r0/4*tcoef*(1.5-1/(2+rvc*v(n2,n1)*v(n2,n1))) 
d5 sub n1 dio_1p2_np_pw_lp area = (w-(2/0.9)*dw)*l/5*mr pj = ((w-(2/0.9)*dw)+2*l/5)*mr 
ends re_ndif_3t


// ************************************************************************************  
// *        silicide p+ diffusion resistor subcircuit netlist                         *  
// ************************************************************************************ 
subckt re_pdif_2t (n2 n1 )
parameters
+l        = lr            
+w        = wr            
+mr       = 1             

parameters rsh      = 10.22+drsh_re_pdif_2t
+rtc1     = 0.002543       rtc2     = -9.401e-7     
+dw       = -0.016e-6+ddw_re_pdif_2t
+dl       = -6.06e-8       scale_r  = 0.9           
+weff     = w*scale_r-2*dw
+leff     = l*scale_r-2*dl
+tcoef    = 1.0+(temp-25.0)*(rtc1+rtc2*(temp-25.0))
+rvc0     = 0.999e-12      rvc1     = 5.261e-12      rvc2     = 0.0382e-12    
+r0       = rsh*leff/weff/mr rvc      = max(0,((rvc0 + rvc1 * weff + rvc2 * l/w)/leff/leff))

r1 n2 n1 resistor r = r0*tcoef*(1.5-1/(2+rvc*v(n2,n1)*v(n2,n1))) 

ends re_pdif_2t


// ************************************************************************************  
// *        silicide p+ diffusion resistor subcircuit netlist (three terminal)                           *  
// ************************************************************************************ 
subckt re_pdif_3t (n2 n1 sub )
parameters
+l        = lr            
+w        = wr            
+mr       = 1             

parameters rsh      = 10.22+drsh_re_pdif_2t
+rtc1     = 0.002543       rtc2     = -9.401e-7     
+dw       = -0.016e-6+ddw_re_pdif_2t
+dl       = -6.06e-8       scale_r  = 0.9           
+weff     = w*scale_r-2*dw
+leff     = l*scale_r-2*dl
+tcoef    = 1.0+(temp-25.0)*(rtc1+rtc2*(temp-25.0))
+rvc0     = 0.999e-12      rvc1     = 5.261e-12      rvc2     = 0.0382e-12    
+r0       = rsh*leff/weff/mr rvc      = max(0,((rvc0 + rvc1 * weff + rvc2 * l/w)/leff/leff))

d1 n2 sub dio_1p2_pp_nw_lp area = (w-(2/0.9)*dw)*l/5*mr pj = ((w-(2/0.9)*dw)+2*l/5)*mr 
r1 n2 na resistor r = r0/4*tcoef*(1.5-1/(2+rvc*v(n2,n1)*v(n2,n1))) 
d2 na sub dio_1p2_pp_nw_lp area = (w-(2/0.9)*dw)*l/5*mr pj = 2*l/5*mr 
r2 na nb resistor r = r0/4*tcoef*(1.5-1/(2+rvc*v(n2,n1)*v(n2,n1))) 
d3 nb sub dio_1p2_pp_nw_lp area = (w-(2/0.9)*dw)*l/5*mr pj = 2*l/5*mr 
r3 nb nc resistor r = r0/4*tcoef*(1.5-1/(2+rvc*v(n2,n1)*v(n2,n1))) 
d4 nc sub dio_1p2_pp_nw_lp area = (w-(2/0.9)*dw)*l/5*mr pj = 2*l/5*mr 
r4 nc n1 resistor r = r0/4*tcoef*(1.5-1/(2+rvc*v(n2,n1)*v(n2,n1))) 
d5 n1 sub dio_1p2_pp_nw_lp area = (w-(2/0.9)*dw)*l/5*mr pj = ((w-(2/0.9)*dw)+2*l/5)*mr 
ends re_pdif_3t


// ************************************************************************************  
// *          silicide n+ poly resistor subcircuit netlist                            *  
// ************************************************************************************ 
subckt re_npo_2t (n2 n1 )
parameters
+l        = lr            
+w        = wr            
+mr       = 1             

parameters rsh      = 1.11e+01+drsh_re_npo_2t rtc1     = 2.19e-03       rtc2     = -1.29e-07     
+dw       = -9.88e-09+ddw_re_npo_2t dl       = 0              scale_r  = 0.9           
+weff     = w*scale_r-2*dw leff     = l*scale_r-2*dl
+tcoef    = 1.0+(temp-25.0)*(rtc1+rtc2*(temp-25.0))
+rvc0     = 1e-12          rvc1     = 0.000002e-6    rvc2     = 0.23e-12      
+r0       = rsh*leff/weff/mr rvc      = max(0,((rvc0 + rvc1 * weff + rvc2 * l/w)/leff/leff))


r1 n2 n1 resistor r = r0*tcoef*(1.5-1/(2+rvc*v(n2,n1)*v(n2,n1))) 
ends re_npo_2t


// ************************************************************************************  
// *          silicide n+ poly resistor subcircuit netlist (three terminal)           *  
// ************************************************************************************ 
subckt re_npo_3t (n2 n1 sub )
parameters
+l        = lr            
+w        = wr            
+mr       = 1             
+flag_cc  = 1             

parameters rsh      = 1.11e+01+drsh_re_npo_2t rtc1     = 2.19e-03       rtc2     = -1.29e-07     
+dw       = -9.88e-09+ddw_re_npo_2t dl       = 0              scale_r  = 0.9           
+weff     = w*scale_r-2*dw leff     = l*scale_r-2*dl
+tcoef    = 1.0+(temp-25.0)*(rtc1+rtc2*(temp-25.0))
+rvc0     = 1e-12          rvc1     = 0.000002e-6    rvc2     = 0.23e-12      
+r0       = rsh*leff/weff/mr rvc      = max(0,((rvc0 + rvc1 * weff + rvc2 * l/w)/leff/leff))
+cox      = 1.18e-4+dcox_re_npo_3t capsw    = (7.708e-11+dcapsw_re_npo_3t)*flag_cc

c1 n2 sub capacitor c = (cox*weff*l*0.9/2+capsw*weff+capsw*l*0.9)*mr 
r1 n2 n1 resistor r = r0*tcoef*(1.5-1/(2+rvc*v(n2,n1)*v(n2,n1))) 
c2 n1 sub capacitor c = (cox*weff*l*0.9/2+capsw*weff+capsw*l*0.9)*mr 
ends re_npo_3t


// ************************************************************************************  
// *          silicide p+ poly resistor subcircuit netlist                            *  
// ************************************************************************************ 
subckt re_ppo_2t (n2 n1 )
parameters
+l        = lr            
+w        = wr            
+mr       = 1             

parameters rsh      = 10.252+drsh_re_ppo_2t
+rtc1     = 0.002496       rtc2     = -1.366e-6     
+dw       = -0.0066e-6+ddw_re_ppo_2t
+dl       = 0              scale_r  = 0.9            rvc0     = 0.99997e-12   
+rvc1     = 4.281e-11      rvc2     = 0.3051e-12    
+weff     = w*scale_r-2*dw leff     = l*scale_r-2*dl
+tcoef    = 1.0+(temp-25.0)*(rtc1+rtc2*(temp-25.0))
+r0       = rsh*leff/weff/mr rvc      = max(0,((rvc0 + rvc1 * weff + rvc2 * l/w)/leff/leff))

r1 n2 n1 resistor r = r0*tcoef*(1.5-1/(2+rvc*v(n2,n1)*v(n2,n1))) 
ends re_ppo_2t

// ************************************************************************************  
// *          silicide p+ poly resistor subcircuit netlist (three terminal)           *  
// ************************************************************************************ 
subckt re_ppo_3t (n2 n1 sub )
parameters
+l        = lr            
+w        = wr            
+mr       = 1             
+flag_cc  = 1             

parameters rsh      = 10.252+drsh_re_ppo_2t
+rtc1     = 0.002496       rtc2     = -1.366e-6     
+dw       = -0.0066e-6+ddw_re_ppo_2t
+dl       = 0              scale_r  = 0.9            rvc0     = 0.99997e-12   
+rvc1     = 4.281e-11      rvc2     = 0.3051e-12    
+weff     = w*scale_r-2*dw leff     = l*scale_r-2*dl
+tcoef    = 1.0+(temp-25.0)*(rtc1+rtc2*(temp-25.0))
+r0       = rsh*leff/weff/mr rvc      = max(0,((rvc0 + rvc1 * weff + rvc2 * l/w)/leff/leff))
+cox      = 1.18e-4+dcox_re_ppo_3t capsw    = (7.708e-11+dcapsw_re_ppo_3t)*flag_cc

c1 n2 sub capacitor c = (cox*weff*l*0.9/2+capsw*weff+capsw*l*0.9)*mr 
r1 n2 n1 resistor r = r0*tcoef*(1.5-1/(2+rvc*v(n2,n1)*v(n2,n1))) 
c2 n1 sub capacitor c = (cox*weff*l/2+capsw*weff+capsw*l)*mr 
ends re_ppo_3t


// ************************************************************************************  
// *          non-silicide hr poly resistor subcircuit netlist                        *  
// ************************************************************************************ 
subckt re_hrpo_2t (n2 n1 )
parameters
+l        = lr            
+w        = wr            
+mr       = 1             
+resmis_mod = 1           

// *****mismatch parameters*****
parameters rshmis   = arsh*geo_fac*sigma_mis_r*resmis_mod
+geo_fac  = 1/sqrt(weff*leff*mr)
+arsh     = 8.15e-9       
  
+rsh      = (9.6213e+02+drsh_re_hrpo_2t)*(1+rshmis) rtc1     = -4.315e-04     rtc2     = 5.56e-07      
+dw       = 2.586e-08+ddw_re_hrpo_2t dl       = 8.865e-08      scale_r  = 0.9           
+rvc0     = 8e-14          rvc1     = 2.74e-9        rvc2     = 4.95e-14      
+weff     = w*scale_r-2*dw leff     = l*scale_r-2*dl
+tcoef    = 1.0+(temp-25.0)*(rtc1+rtc2*(temp-25.0))
+r0       = rsh*leff/weff/mr rvc      = max(0,((rvc0 + rvc1 * weff + rvc2 * l/w)/leff/leff))

r1 n2 n1 resistor r = r0*tcoef*(0.5+1/(2+rvc*v(n2,n1)*v(n2,n1))) 
ends re_hrpo_2t

 
// ************************************************************************************  
// *        non-silicide hr poly resistor subcircuit netlist(three terminal)          *  
// ************************************************************************************ 
subckt re_hrpo_3t (n2 n1 sub )
parameters
+l        = lr            
+w        = wr            
+mr       = 1             
+resmis_mod = 1           
+flag_cc  = 1             

// *****mismatch parameters*****
parameters rshmis   = arsh*geo_fac*sigma_mis_r*resmis_mod
+geo_fac  = 1/sqrt(weff*leff*mr)

+arsh     = 8.15e-9       
  
+rsh      = (9.6213e+02+drsh_re_hrpo_2t)*(1+rshmis) rtc1     = -4.315e-04     rtc2     = 5.56e-07      
+dw       = 2.586e-08+ddw_re_hrpo_2t dl       = 8.865e-08      scale_r  = 0.9           
+rvc0     = 8e-14          rvc1     = 2.74e-9        rvc2     = 4.95e-14      
+weff     = w*scale_r-2*dw leff     = l*scale_r-2*dl
+tcoef    = 1.0+(temp-25.0)*(rtc1+rtc2*(temp-25.0))
+r0       = rsh*leff/weff/mr rvc      = max(0,((rvc0 + rvc1 * weff + rvc2 * l/w)/leff/leff))

+cox      = 1.18e-4+dcox_re_hrpo_3t capsw    = (7.708e-11+dcapsw_re_hrpo_3t)*flag_cc

c1 n2 sub capacitor c = (cox*weff*l*0.9/2+capsw*weff+capsw*l*0.9)*mr 
r1 n2 n1 resistor r = r0*tcoef*(0.5+1/(2+rvc*v(n2,n1)*v(n2,n1))) 
c2 n1 sub capacitor c = (cox*weff*l/2+capsw*weff+capsw*l)*mr 
ends re_hrpo_3t


// ************************************************************************************  
// *          nwell resistor under sti subcircuit netlist                             *  
// ************************************************************************************ 
subckt re_nwsti_2t (n2 n1 )
parameters
+l        = lr            
+w        = wr            
+mr       = 1             
+resmis_mod = 1           

// *****mismatch parameters*****
parameters rshmis   = arsh*geo_fac*sigma_mis_r*resmis_mod
+geo_fac  = 1/sqrt(weff*leff*mr)
+arsh     = 1.31e-6       

+rsh      = 550+drsh_re_nwsti_2t+rshmis
+rtc1     = 6.896e-4       rtc2     = 1.744e-5      
+dw       = 8.2e-8+ddw_re_nwsti_2t
+dl       = -5.5e-7        scale_r  = 0.9            ra       = 1.0078        
+rvc0     = 1.2e-13        rvc1     = 5e-9           rvc2     = 1e-15         
+weff     = w*ra*scale_r-2*dw leff     = l*ra*scale_r-2*dl
+tcoef    = 1.0+(temp-25.0)*(rtc1+rtc2*(temp-25.0))
+r0       = rsh*leff/weff/mr rvc      = max(0,((rvc0 + rvc1 * weff +rvc2 * l/w)/leff/leff))
//  *************************************
r1 n2 n1 resistor r = rsh*leff/weff*tcoef*(2 - 1/(1+ rvc*v(n2,n1)*v(n2,n1))) 
ends re_nwsti_2t


// ************************************************************************************  
// *          nwell resistor under sti subcircuit netlist  (three terminal)                              *  
// ************************************************************************************ 
subckt re_nwsti_3t (n2 n1 sub )
parameters
+l        = lr            
+w        = wr            
+mr       = 1             
+resmis_mod = 1           

// *****mismatch parameters*****
parameters rshmis   = arsh*geo_fac*sigma_mis_r*resmis_mod
+geo_fac  = 1/sqrt(weff*leff*mr)
+arsh     = 1.31e-6       

+rsh      = 550+drsh_re_nwsti_2t+rshmis
+rtc1     = 6.896e-4       rtc2     = 1.744e-5      
+dw       = 8.2e-8+ddw_re_nwsti_2t
+dl       = -5.5e-7        scale_r  = 0.9            ra       = 1.0078        
+rvc0     = 1.2e-13        rvc1     = 5e-9           rvc2     = 1e-15         
+weff     = w*ra*scale_r-2*dw leff     = l*ra*scale_r-2*dl
+tcoef    = 1.0+(temp-25.0)*(rtc1+rtc2*(temp-25.0))
+r0       = rsh*leff/weff/mr rvc      = max(0,((rvc0 + rvc1 * weff +rvc2 * l/w)/leff/leff))
//  *************************************
d1 sub n2 dio_1p2_nw_psub_lp area = (w-(2/0.9)*dw)*l/5*mr pj = ((w-(2/0.9)*dw)+2*l/5)*mr 
r1 n2 na resistor r = rsh*leff/4/weff*tcoef*(2 - 1/(1+ rvc*v(n2,n1)*v(n2,n1))) 
d2 sub na dio_1p2_nw_psub_lp area = (w-(2/0.9)*dw)*l/5*mr pj = 2*l/5*mr 
r2 na nb resistor r = rsh*leff/4/weff*tcoef*(2 - 1/(1+ rvc*v(n2,n1)*v(n2,n1))) 
d3 sub nb dio_1p2_nw_psub_lp area = (w-(2/0.9)*dw)*l/5*mr pj = 2*l/5*mr 
r3 nb nc resistor r = rsh*leff/4/weff*tcoef*(2 - 1/(1+ rvc*v(n2,n1)*v(n2,n1))) 
d4 sub nc dio_1p2_nw_psub_lp area = (w-(2/0.9)*dw)*l/5*mr pj = 2*l/5*mr 
r4 nc n1 resistor r = rsh*leff/4/weff*tcoef*(2 - 1/(1+ rvc*v(n2,n1)*v(n2,n1))) 
d5 sub n1 dio_1p2_nw_psub_lp area = (w-(2/0.9)*dw)*l/5*mr pj = ((w-(2/0.9)*dw)+2*l/5)*mr 
ends re_nwsti_3t


// ************************************************************************************  
// *           nwell resistor under aa subcircuit netlist                             *  
// ************************************************************************************ 
subckt re_nwaa_2t (n2 n1 )
parameters
+l        = lr            
+w        = wr            
+mr       = 1             
+resmis_mod = 1           

// *****mismatch parameters*****
parameters rshmis   = arsh*geo_fac*sigma_mis_r*resmis_mod
+geo_fac  = 1/sqrt(weff*leff*mr)
+arsh     = 6.79e-7       
+rsh      = 3.63e+02+drsh_re_nwaa_2t+rshmis rtc1     = 1.112e-3       rtc2     = 1.766e-5      
+dw       = 6e-08+ddw_re_nwaa_2t dl       = -3e-07         ra       = 0.827          scale_r  = 0.9           

+rvc0     = 1.0e-13        rvc1     = 4e-8           rvc2     = 1.6e-16       
+weff     = w*ra*scale_r-2*dw leff     = l*ra*scale_r-2*dl 

+tcoef    = 1.0+(temp-25.0)*(rtc1+rtc2*(temp-25.0))
+r0       = rsh*leff/weff/mr rvc      = max(0,((rvc0 + rvc1 * weff +rvc2 * l/w)/leff/leff))
//  *************************************
r1 n2 n1 resistor r = r0*tcoef*min(max(2 - 1/(1+ rvc*v(n2,n1)*v(n2,n1)), 0.85), 1.15) 

ends re_nwaa_2t


// ************************************************************************************  
// *           nwell resistor under aa subcircuit netlist(three terminal)                              *  
// ************************************************************************************ 
subckt re_nwaa_3t (n2 n1 sub )
parameters
+l        = lr            
+w        = wr            
+mr       = 1             
+resmis_mod = 1           

// *****mismatch parameters*****
parameters rshmis   = arsh*geo_fac*sigma_mis_r*resmis_mod
+geo_fac  = 1/sqrt(weff*leff*mr)
+arsh     = 6.79e-7       
+rsh      = 3.63e+02+drsh_re_nwaa_2t+rshmis rtc1     = 1.112e-3       rtc2     = 1.766e-5      
+dw       = 6e-08+ddw_re_nwaa_2t dl       = -3e-07         ra       = 0.827          scale_r  = 0.9           

+rvc0     = 1.0e-13        rvc1     = 4e-8           rvc2     = 1.6e-16       
+weff     = w*ra*scale_r-2*dw leff     = l*ra*scale_r-2*dl 

+tcoef    = 1.0+(temp-25.0)*(rtc1+rtc2*(temp-25.0))
+r0       = rsh*leff/weff/mr rvc      = max(0,((rvc0 + rvc1 * weff +rvc2 * l/w)/leff/leff))
//  *************************************

d1 sub n2 dio_1p2_nw_psub_lp area = (w-(2/0.9)*dw)*l/5*mr pj = ((w-(2/0.9)*dw)+2*l/5)*mr 
r1 n2 na resistor r = r0/4*tcoef*min(max(2 - 1/(1+ rvc*v(n2,n1)*v(n2,n1)), 0.85), 1.15) 
d2 sub na dio_1p2_nw_psub_lp area = (w-(2/0.9)*dw)*l/5*mr pj = 2*l/5*mr 
r2 na nb resistor r = r0/4*tcoef*min(max(2 - 1/(1+ rvc*v(n2,n1)*v(n2,n1)), 0.85), 1.15) 
d3 sub nb dio_1p2_nw_psub_lp area = (w-(2/0.9)*dw)*l/5*mr pj = 2*l/5*mr 
r3 nb nc resistor r = r0/4*tcoef*min(max(2 - 1/(1+ rvc*v(n2,n1)*v(n2,n1)), 0.85), 1.15) 
d4 sub nc dio_1p2_nw_psub_lp area = (w-(2/0.9)*dw)*l/5*mr pj = 2*l/5*mr 
r4 nc n1 resistor r = r0/4*tcoef*min(max(2 - 1/(1+ rvc*v(n2,n1)*v(n2,n1)), 0.85), 1.15) 
d5 sub n1 dio_1p2_nw_psub_lp area = (w-(2/0.9)*dw)*l/5*mr pj = ((w-(2/0.9)*dw)+2*l/5)*mr 
ends re_nwaa_3t


// ************************************************************************************  
// *      non-silicide n+ diffusion resistor subcircuit netlist                       *  
// ************************************************************************************ 
subckt re_ndif_sab_2t (n2 n1 )
parameters
+l        = lr            
+w        = wr            
+mr       = 1             
+resmis_mod = 1           

// *****mismatch parameters*****
parameters rshmis   = arsh*geo_fac*sigma_mis_r*resmis_mod
+geo_fac  = 1/sqrt(weff*leff*mr)
+arsh     = 6.62e-8       
 
+rsh      = 1.18e+02+drsh_re_ndif_sab_2t+rshmis rtc1     = 1.27e-03       rtc2     = 2.023e-05     
   
+dw       = 2.36e-09+ddw_re_ndif_sab_2t dl       = -1.89e-09      ra       = 0.254          scale_r  = 0.9           
+weff     = w*ra*scale_r-2*dw leff     = l*ra*scale_r-2*dl
+rvc0     = 5e-15          rvc1     = 2e-9           rvc2     = 1e-16         
+tcoef    = 1.0+(temp-25.0)*(rtc1+rtc2*(temp-25.0))
+r0       = rsh*(leff + (-5e-28)/l/l/l)/weff/mr rvc      = max(0,((rvc0 + rvc1 * weff + rvc2 * l/w)/leff/leff))

// ************************************* 
r1 n2 n1 resistor r = r0*tcoef*(2-1/(1+rvc*v(n2,n1)*v(n2,n1))) 
ends re_ndif_sab_2t


// ************************************************************************************  
// *      non-silicide n+ diffusion resistor subcircuit netlist  (three terminal)                       *  
// ************************************************************************************ 
subckt re_ndif_sab_3t (n2 n1 sub )
parameters
+l        = lr            
+w        = wr            
+mr       = 1             
+resmis_mod = 1           

// *****mismatch parameters*****
parameters rshmis   = arsh*geo_fac*sigma_mis_r*resmis_mod
+geo_fac  = 1/sqrt(weff*leff*mr)
+arsh     = 6.62e-8       
 
+rsh      = 1.18e+02+drsh_re_ndif_sab_2t+rshmis rtc1     = 1.27e-03       rtc2     = 2.023e-05     
   
+dw       = 2.36e-09+ddw_re_ndif_sab_2t dl       = -1.89e-09      ra       = 0.254          scale_r  = 0.9           
+weff     = w*ra*scale_r-2*dw leff     = l*ra*scale_r-2*dl
+rvc0     = 5e-15          rvc1     = 2e-9           rvc2     = 1e-16         

+tcoef    = 1.0+(temp-25.0)*(rtc1+rtc2*(temp-25.0))
+r0       = rsh*(leff + (-5e-28)/l/l/l)/weff/mr rvc      = max(0,((rvc0 + rvc1 * weff + rvc2 * l/w)/leff/leff))

// *************************************
d1 sub n2 dio_1p2_np_pw_lp area = (w-(2/0.9)*dw)*(l-(2/0.9)*dl)/5*mr pj = ((w-(2/0.9)*dw)+2*(l-(2/0.9)*dl)/5)*mr 
r1 n2 nb resistor r = r0/4*tcoef*(2-1/(1+rvc*v(n2,n1)*v(n2,n1))) 
d2 sub nb dio_1p2_np_pw_lp area = (w-(2/0.9)*dw)*(l-(2/0.9)*dl)/5*mr pj = 2*(l-(2/0.9)*dl)/5*mr 
r2 nb nc resistor r = r0/4*tcoef*(2-1/(1+rvc*v(n2,n1)*v(n2,n1))) 
d3 sub nc dio_1p2_np_pw_lp area = (w-(2/0.9)*dw)*(l-(2/0.9)*dl)/5*mr pj = 2*(l-(2/0.9)*dl)/5*mr 
r3 nc nd resistor r = r0/4*tcoef*(2-1/(1+rvc*v(n2,n1)*v(n2,n1))) 
d4 sub nd dio_1p2_np_pw_lp area = (w-(2/0.9)*dw)*(l-(2/0.9)*dl)/5*mr pj = 2*(l-(2/0.9)*dl)/5*mr 
r4 nd n1 resistor r = r0/4*tcoef*(2-1/(1+rvc*v(n2,n1)*v(n2,n1))) 
d5 sub n1 dio_1p2_np_pw_lp area = (w-(2/0.9)*dw)*(l-(2/0.9)*dl)/5*mr pj = ((w-(2/0.9)*dw)+2*(l-(2/0.9)*dl)/5)*mr 
ends re_ndif_sab_3t


// ************************************************************************************  
// *      non-silicide p+ diffusion resistor subcircuit netlist                       *  
// ************************************************************************************ 
subckt re_pdif_sab_2t (n2 n1 )
parameters
+l        = lr            
+w        = wr            
+mr       = 1             
+resmis_mod = 1           

// *****mismatch parameters*****
parameters rshmis   = arsh*geo_fac*sigma_mis_r*resmis_mod
+geo_fac  = 1/sqrt(weff*leff*mr)
+arsh     = 1.56e-6       

+rsh      = 249.1+drsh_re_pdif_sab_2t+rshmis
+rtc1     = 0.001368       rtc2     = 7.485e-6      
+dw       = -1.24e-9+ddw_re_pdif_sab_2t
+dl       = -4.81e-8       ra       = 0.847          scale_r  = 0.9           
+rvc0     = 1.2e-14        rvc1     = 2e-8           rvc2     = 2e-15         
 
+weff     = w*ra*scale_r-2*dw leff     = l*ra*scale_r-2*dl
+tcoef    = 1.0+(temp-25.0)*(rtc1+rtc2*(temp-25.0))
+r0       = rsh*leff/weff/mr rvc      = max(0,((rvc0 + rvc1 * weff + rvc2 * l/w)/leff/leff))

// *************************************
r1 n2 n1 resistor r = r0*tcoef*(2-1/(1+rvc*v(n2,n1)*v(n2,n1))) 
ends re_pdif_sab_2t


