// ************************************************************************************  
// *        non-silicide n+ poly resistor subcircuit netlist                          *  
// ************************************************************************************ 
subckt re_npo_sab_2t (n2 n1 )
parameters
+l        = lr            
+w        = wr            
+mr       = 1             
+resmis_mod = 1           

// *****mismatch parameters*****
parameters rshmis   = arsh*geo_fac*sigma_mis_r*resmis_mod
+geo_fac  = 1/sqrt(weff*leff*mr)
+arsh     = 4.8e-6        

+rsh      = 2.69e+02+drsh_re_npo_sab_2t+rshmis rtc1     = -2.57e-04      rtc2     = 6.16e-06      
+dw       = 2e-08+ddw_re_npo_sab_2t dl       = -7.65e-09      ra       = 0.771          scale_r  = 0.9           
+rvc0     = 2e-13          rvc1     = 8e-9           rvc2     = 1e-16         
+weff     = w*ra*scale_r-2*dw leff     = l*ra*scale_r-2*dl
+tcoef    = 1.0+(temp-25.0)*(rtc1+rtc2*(temp-25.0))
+r0       = rsh*leff/weff/mr rvc      = max(0,((rvc0 + rvc1 * weff + rvc2 * l/w)/leff/leff))
// *************************************

r1 n2 n1 resistor r = r0*tcoef*(0.5+1/(2+rvc*v(n2,n1)*v(n2,n1))) 
ends re_npo_sab_2t


// ************************************************************************************  
// *        non-silicide n+ poly resistor subcircuit netlist (three terminal)         *  
// ************************************************************************************ 
subckt re_npo_sab_3t (n2 n1 sub )
parameters
+l        = lr            
+w        = wr            
+mr       = 1             
+resmis_mod = 1           
+flag_cc  = 1             

// *****mismatch parameters*****
parameters rshmis   = arsh*geo_fac*sigma_mis_r*resmis_mod
+geo_fac  = 1/sqrt(weff*leff*mr)
+arsh     = 4.8e-6        

+rsh      = 2.69e+02+drsh_re_npo_sab_2t+rshmis rtc1     = -2.57e-04      rtc2     = 6.16e-06      
+dw       = 2e-08+ddw_re_npo_sab_2t dl       = -7.65e-09      ra       = 0.771          scale_r  = 0.9           
+rvc0     = 2e-13          rvc1     = 8e-9           rvc2     = 1e-16         
+weff     = w*ra*scale_r-2*dw leff     = l*ra*scale_r-2*dl
+tcoef    = 1.0+(temp-25.0)*(rtc1+rtc2*(temp-25.0))
+r0       = rsh*leff/weff/mr rvc      = max(0,((rvc0 + rvc1 * weff + rvc2 * l/w)/leff/leff))

+cox      = 1.18e-4+dcox_re_npo_sab_3t capsw    = (7.708e-11+dcapsw_re_npo_sab_3t)*flag_cc

// *************************************

c1 n2 sub capacitor c = (cox*weff*leff/2+capsw*weff+capsw*leff)*mr 
r1 n2 n1 resistor r = r0*tcoef*(0.5+1/(2+rvc*v(n2,n1)*v(n2,n1))) 
c2 n1 sub capacitor c = (cox*weff*leff/2+capsw*weff+capsw*leff)*mr 
ends re_npo_sab_3t


// ************************************************************************************  
// *        non-silicide p+ poly resistor subcircuit netlist                          *  
// ************************************************************************************ 
subckt re_ppo_sab_2t (n2 n1 )
parameters
+l        = lr            
+w        = wr            
+mr       = 1             
+resmis_mod = 1           

// *****mismatch parameters*****
parameters rshmis   = arsh*geo_fac*sigma_mis_r*resmis_mod
+geo_fac  = 1/sqrt(weff*leff*mr)
+arsh     = 4.2e-6        
+rsh      = 725.7+drsh_re_ppo_sab_2t+rshmis
+rtc1     = -3.6e-4        rtc2     = 3.9e-6        
+dw       = 1.51e-8+ddw_re_ppo_sab_2t
+dl       = -1.83e-8       ra       = 0.779          scale_r  = 0.9           
+weff     = w*ra*scale_r-2*dw
+leff     = l*ra*scale_r-2*dl
+rvc0     = 8e-14          rvc1     = 1.743e-8       rvc2     = 1e-18         
+tcoef    = 1.0+(temp-25.0)*(rtc1+rtc2*(temp-25.0))
+r0       = rsh*leff/weff/mr rvc      = max(0,((rvc0 + rvc1 * weff + rvc2 * l/w)/leff/leff))

//*****noise parameters*******
+raf = 2 rkf = 1.7E-22 ref = 1 rweexp = 1.01 rleexp = 0.96
+rgeo_noi = pow(rweff, rweexp) * pow(rleff, rleexp)

r1 n2 n1 resistor r = r0*tcoef*(0.5+1/(2+rvc*v(n2,n1)*v(n2,n1))) 
ends re_ppo_sab_2t


