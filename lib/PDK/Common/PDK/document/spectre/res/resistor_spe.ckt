// *****************************************  

// ****************************************************************** 
// *                 top metal for wmin=0.4um(standard option)     *  
// ******************************************************************
subckt re_tm2_2t (n2 n1 )
parameters
+l        = lr            
+w        = wr            
+mr       = 1             

parameters rsh      = 2.39e-02+drsh_re_tm2_2t rtc1     = 3.635e-03      rtc2     = -3.27e-07     
+dw       = -2.21e-09+ddw_re_tm2_2t scale_r  = 0.9           
// *+vc1      = 0                        vc2  = 7.98e-03
+jc1a     = 0              jc1b     = 0             
+jc2a     = 6.83e-05       jc2b     = 2.25e-10      
+rvc1     = jc1a+jc1b/(l*0.9) rvc2     = (jc2a+jc2b/(l*0.9))/(l*0.9)
+weff     = w*0.9-2*dw    
+tcoef    = 1.0+(temp-25.0)*(rtc1+rtc2*(temp-25.0))
    
r1 n2 n1 resistor r = rsh/mr*l*0.9/weff*tcoef*min(1.0+rvc1*abs(v(n2,n1))+rvc2*v(n2,n1)*v(n2,n1), 1.1) 

ends re_tm2_2t


