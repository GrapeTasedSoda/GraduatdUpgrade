****************************
* mos varactor corner model
****************************
.lib var_tt
.param
*mos varactor
+sigma_mis_var    = agauss(0,1,1)
+ac0_var1p2_npd_nw_lp = '1.18e-14*1.2'   
+bc0_var1p2_npd_nw_lp = '49e-10*1.2'    
+cc0_var1p2_npd_nw_lp = '0*1.2'

+ac0_var3p3_npd_nw_lp = '0.315e-14*1.2'  
+bc0_var3p3_npd_nw_lp = '2.256e-8*1.2'  
+cc0_var3p3_npd_nw_lp = '0*1.15'

+dcgg_var1p2_npd_nw_lp         = 0               dtox_var1p2_npd_nw_lp         = 0       
+dcgg_var3p3_npd_nw_lp         = 0
.inc './var/varactor.ckt'
.endl var_tt


.lib var_ff
.param
*mos varactor
+sigma_mis_var    = agauss(0,1,1)
+ac0_var1p2_npd_nw_lp = '1.18e-14*1.2'
+bc0_var1p2_npd_nw_lp = '49e-10*1.2'
+cc0_var1p2_npd_nw_lp = '0*1.2'

+ac0_var3p3_npd_nw_lp = '0.315e-14*1.2'
+bc0_var3p3_npd_nw_lp = '2.256e-8*1.2'
+cc0_var3p3_npd_nw_lp = '0*1.2'

+dcgg_var1p2_npd_nw_lp         = 0.03              dtox_var1p2_npd_nw_lp         = -4.8e-11
+dcgg_var3p3_npd_nw_lp         = 0.03
.inc './var/varactor.ckt'
.endl  var_ff  


.lib var_ss
.param
*mos varactor
+sigma_mis_var    = agauss(0,1,1)
+ac0_var1p2_npd_nw_lp = '1.18e-14*1.2'
+bc0_var1p2_npd_nw_lp = '49e-10*1.2'
+cc0_var1p2_npd_nw_lp = '0*1.2'

+ac0_var3p3_npd_nw_lp = '0.315e-14*1.2'
+bc0_var3p3_npd_nw_lp = '2.256e-8*1.2'
+cc0_var3p3_npd_nw_lp = '0*1.2'

+dcgg_var1p2_npd_nw_lp         = -0.03              dtox_var1p2_npd_nw_lp         = 4.8e-11
+dcgg_var3p3_npd_nw_lp         = -0.03   
.inc './var/varactor.ckt'
.endl  var_ss

.lib var_mc
.param
*mos varactor
+sigma_mis_var    = agauss(0,1,1)
+sigma_mc_var     = agauss(0,1,3)
+aa = sigma_mc_var 
+ac0_var1p2_npd_nw_lp = '1.18e-14*1.2'
+bc0_var1p2_npd_nw_lp = '49e-10*1.2'
+cc0_var1p2_npd_nw_lp = '0*1.2'

+ac0_var3p3_npd_nw_lp = '0.315e-14*1.2'
+bc0_var3p3_npd_nw_lp = '2.256e-8*1.2'
+cc0_var3p3_npd_nw_lp = '0*1.2'

+dcgg_var1p2_npd_nw_lp         = '0.03*aa'              dtox_var1p2_npd_nw_lp         = '-4.8e-11*aa'
+dcgg_var3p3_npd_nw_lp         = '0.03*aa'
.inc './var/varactor.ckt'
.endl var_mc

********************
* mom corner model *
********************
.lib mom_tt
.param
+sigma_mis_mom    = agauss(0,1,1)
+dmom_mnx         = 0
.inc './mom/mom.ckt'
.endl mom_tt

.lib mom_ff
.param
+sigma_mis_mom    = agauss(0,1,1)
+dmom_mnx         = -0.1
.inc './mom/mom.ckt'
.endl mom_ff

.lib mom_ss
.param
+sigma_mis_mom    = agauss(0,1,1)
+dmom_mnx         = 0.1
.inc './mom/mom.ckt'
.endl mom_ss

.lib mom_mc
.param
+sigma_mom        = agauss(0,1,3)
+sigma_mis_mom    = agauss(0,1,1)
+dmom_mnx         = '-0.1*sigma_mom'
.inc './mom/mom.ckt' 
.endl mom_mc


