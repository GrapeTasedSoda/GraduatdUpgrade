*********************************
* res monte carlo model
*********************************
.LIB res_mc
.PARAM
+rnd0    = agauss(0,1,3)  
+rnd1    = agauss(0,1,3)  
+rnd2    = agauss(0,1,3)  
+p0      = 1.0            
+p1      = 1.0            
+p2      = 1.0            
+par0    = 'rnd0*p0'      
+par1    = 'rnd1*p1'      
+par2    = 'rnd2*p2'      
.PARAM
+sigma_mis_r= agauss(0,1,1)
+drsh_re_ndif_2t= '0+(3.7298)*par0+(0.042375)*par1+(4.3128e-08)*par2'
