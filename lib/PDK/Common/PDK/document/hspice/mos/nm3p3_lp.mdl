.param evalbin(p1,p2,p3,p4) = '(p1/lbin/dbin-p2/lbin/ubin+p3/rbin/ubin-p4/rbin/dbin + ((p2-p1)/lbin+(p4-p3)/rbin)/lum + ((p4-p1)/dbin+(p2-p3)/ubin)/wum + (p1-p2+p3-p4)/lum/wum)/(1/lbin-1/rbin)/(1/dbin-1/ubin)'
.param select6(v,v1,v2,v3,v4,v5,v6) = 'v<v1?1 : v<v2?1 : v<v3?2 : v<v4?3 : v<v5?4 : v<v6?5 : 5'
.param select7(v,v1,v2,v3,v4,v5,v6,v7) = 'v<v1?1 : v<v2?1 : v<v3?2 : v<v4?3 : v<v5?4 : v<v6?5 : v<v7?6 : 6'
.param selectp6(p,p1,p2,p3,p4,p5,p6) = 'p==1?p1 : p==2?p2 : p==3?p3 : p==4?p4 : p==5?p5 : p==6?p6 : 1e4'
.param selectp7(p,p1,p2,p3,p4,p5,p6,p7) = 'p==1?p1 : p==2?p2 : p==3?p3 : p==4?p4 : p==5?p5 : p==6?p6 : p==7?p7 : 1e4'

.param xbin = select6(wum,0.21,0.25,0.3,0.5,1,10)  *W 123456
.param lbin = selectp6(xbin,0.21,0.25,0.3,0.5,1,10) *W 123456
.param rbin = selectp6(xbin+1,0.21,0.25,0.3,0.5,1,10) *W 123456
.param ybin = select7(lum,0.38,0.4,0.5,1,2,5,10) *l 1234567
.param dbin = selectp7(ybin,0.38,0.4,0.5,1,2,5,10) *l 1234567
.param ubin = selectp7(ybin+1,0.38,0.4,0.5,1,2,5,10) *l 1234567

.param vth0_w0p21(y) = 'selectp7(y,vth0_w0p21_1,vth0_w0p21_2,vth0_w0p21_3,vth0_w0p21_4,vth0_w0p21_5,vth0_w0p21_6,vth0_w0p21_7)' *w-0.12 l-1234567
.param vth0_w0p25(y) = 'selectp7(y,vth0_w0p25_1,vth0_w0p25_2,vth0_w0p25_3,vth0_w0p25_4,vth0_w0p25_5,vth0_w0p25_6,vth0_w0p25_7)' *w-0.15 l-1234567
.param vth0_w0p3(y) = 'selectp7(y,vth0_w0p3_1,vth0_w0p3_2,vth0_w0p3_3,vth0_w0p3_4,vth0_w0p3_5,vth0_w0p3_6,vth0_w0p3_7)'
.param vth0_w0p5(y) = 'selectp7(y,vth0_w0p5_1,vth0_w0p5_2,vth0_w0p5_3,vth0_w0p5_4,vth0_w0p5_5,vth0_w0p5_6,vth0_w0p5_7)'
.param vth0_w1(y) = 'selectp7(y,vth0_w1_1,vth0_w1_2,vth0_w1_3,vth0_w1_4,vth0_w1_5,vth0_w1_6,vth0_w1_7)'
.param vth0_w10(y) = 'selectp7(y,vth0_w10_1,vth0_w10_2,vth0_w10_3,vth0_w10_4,vth0_w10_5,vth0_w10_6,vth0_w10_7)'
.param vth0_c(x,y) = 'selectp6(x, vth0_w0p21(y), vth0_w0p25(y), vth0_w0p3(y), vth0_w0p5(y), vth0_w1(y), vth0_w10(y))'  
.param vth0_q = 'evalbin(vth0_c(xbin+1,ybin+1), vth0_c(xbin+1,ybin), vth0_c(xbin,ybin), vth0_c(xbin,ybin+1))' *this parameter should be give to vth0

.param u0_w0p21(y) = 'selectp7(y,u0_w0p21_1,u0_w0p21_2,u0_w0p21_3,u0_w0p21_4,u0_w0p21_5,u0_w0p21_6,u0_w0p21_7)'
.param u0_w0p25(y) = 'selectp7(y,u0_w0p25_1,u0_w0p25_2,u0_w0p25_3,u0_w0p25_4,u0_w0p25_5,u0_w0p25_6,u0_w0p25_7)'
.param u0_w0p3(y) = 'selectp7(y,u0_w0p3_1,u0_w0p3_2,u0_w0p3_3,u0_w0p3_4,u0_w0p3_5,u0_w0p3_6,u0_w0p3_7)'
.param u0_w0p5(y) = 'selectp7(y,u0_w0p5_1,u0_w0p5_2,u0_w0p5_3,u0_w0p5_4,u0_w0p5_5,u0_w0p5_6,u0_w0p5_7)'
.param u0_w1(y) = 'selectp7(y,u0_w1_1,u0_w1_2,u0_w1_3,u0_w1_4,u0_w1_5,u0_w1_6,u0_w1_7)'
.param u0_w10(y) = 'selectp7(y,u0_w10_1,u0_w10_2,u0_w10_3,u0_w10_4,u0_w10_5,u0_w10_6,u0_w10_7)'
.param u0_c(x,y) = 'selectp6(x, u0_w0p21(y), u0_w0p25(y), u0_w0p3(y), u0_w0p5(y), u0_w1(y), u0_w10(y))'
.param u0_q = 'evalbin(u0_c(xbin+1,ybin+1), u0_c(xbin+1,ybin), u0_c(xbin,ybin), u0_c(xbin,ybin+1))'

.param dsub_w0p21(y) = 'selectp7(y,dsub_w0p21_1,dsub_w0p21_2,dsub_w0p21_3,dsub_w0p21_4,dsub_w0p21_5,dsub_w0p21_6,dsub_w0p21_7)'
.param dsub_w0p25(y) = 'selectp7(y,dsub_w0p25_1,dsub_w0p25_2,dsub_w0p25_3,dsub_w0p25_4,dsub_w0p25_5,dsub_w0p25_6,dsub_w0p25_7)'
.param dsub_w0p3(y) = 'selectp7(y,dsub_w0p3_1,dsub_w0p3_2,dsub_w0p3_3,dsub_w0p3_4,dsub_w0p3_5,dsub_w0p3_6,dsub_w0p3_7)'
.param dsub_w0p5(y) = 'selectp7(y,dsub_w0p5_1,dsub_w0p5_2,dsub_w0p5_3,dsub_w0p5_4,dsub_w0p5_5,dsub_w0p5_6,dsub_w0p5_7)'
.param dsub_w1(y) = 'selectp7(y,dsub_w1_1,dsub_w1_2,dsub_w1_3,dsub_w1_4,dsub_w1_5,dsub_w1_6,dsub_w1_7)'
.param dsub_w10(y) = 'selectp7(y,dsub_w10_1,dsub_w10_2,dsub_w10_3,dsub_w10_4,dsub_w10_5,dsub_w10_6,dsub_w10_7)'
.param dsub_c(x,y) = 'selectp6(x, dsub_w0p21(y), dsub_w0p25(y), dsub_w0p3(y), dsub_w0p5(y), dsub_w1(y), dsub_w10(y))'
.param dsub_qq = 'evalbin(dsub_c(xbin+1,ybin+1), dsub_c(xbin+1,ybin), dsub_c(xbin,ybin), dsub_c(xbin,ybin+1))'

.param ags_w0p21(y) = 'selectp7(y,ags_w0p21_1,ags_w0p21_2,ags_w0p21_3,ags_w0p21_4,ags_w0p21_5,ags_w0p21_6,ags_w0p21_7)'
.param ags_w0p25(y) = 'selectp7(y,ags_w0p25_1,ags_w0p25_2,ags_w0p25_3,ags_w0p25_4,ags_w0p25_5,ags_w0p25_6,ags_w0p25_7)'
.param ags_w0p3(y) = 'selectp7(y,ags_w0p3_1,ags_w0p3_2,ags_w0p3_3,ags_w0p3_4,ags_w0p3_5,ags_w0p3_6,ags_w0p3_7)'
.param ags_w0p5(y) = 'selectp7(y,ags_w0p5_1,ags_w0p5_2,ags_w0p5_3,ags_w0p5_4,ags_w0p5_5,ags_w0p5_6,ags_w0p5_7)'
.param ags_w1(y) = 'selectp7(y,ags_w1_1,ags_w1_2,ags_w1_3,ags_w1_4,ags_w1_5,ags_w1_6,ags_w1_7)'
.param ags_w10(y) = 'selectp7(y,ags_w10_1,ags_w10_2,ags_w10_3,ags_w10_4,ags_w10_5,ags_w10_6,ags_w10_7)'
.param ags_c(x,y) = 'selectp6(x, ags_w0p21(y), ags_w0p25(y), ags_w0p3(y), ags_w0p5(y), ags_w1(y), ags_w10(y))'
.param ags_qq = 'evalbin(ags_c(xbin+1,ybin+1), ags_c(xbin+1,ybin), ags_c(xbin,ybin), ags_c(xbin,ybin+1))'

.param vsat_w0p21(y) = 'selectp7(y,vsat_w0p21_1,vsat_w0p21_2,vsat_w0p21_3,vsat_w0p21_4,vsat_w0p21_5,vsat_w0p21_6,vsat_w0p21_7)'
.param vsat_w0p25(y) = 'selectp7(y,vsat_w0p25_1,vsat_w0p25_2,vsat_w0p25_3,vsat_w0p25_4,vsat_w0p25_5,vsat_w0p25_6,vsat_w0p25_7)'
.param vsat_w0p3(y) = 'selectp7(y,vsat_w0p3_1,vsat_w0p3_2,vsat_w0p3_3,vsat_w0p3_4,vsat_w0p3_5,vsat_w0p3_6,vsat_w0p3_7)'
