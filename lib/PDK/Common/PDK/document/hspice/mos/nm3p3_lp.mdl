.param vsat_w10(y) = 'selectp7(y,vsat_w10_1,vsat_w10_2,vsat_w10_3,vsat_w10_4,vsat_w10_5,vsat_w10_6,vsat_w10_7)'
.param vsat_c(x,y) = 'selectp6(x, vsat_w0p21(y), vsat_w0p25(y), vsat_w0p3(y), vsat_w0p5(y), vsat_w1(y), vsat_w10(y))'
.param vsat_qq = 'evalbin(vsat_c(xbin+1,ybin+1), vsat_c(xbin+1,ybin), vsat_c(xbin,ybin), vsat_c(xbin,ybin+1))'


***********************************************************************************
*                              3.3v io nmos model                               *
***********************************************************************************
.model  nm3p3_lp  nmos  level = 54
**************************************************************
*               MODEL FLAG PARAMETERS
**************************************************************
+lmin    = 3.42e-007       lmax    = 0.0001          wmin    = 1.89e-007       wmax    = 0.0001
+version = 4.5             binunit = 2               paramchk= 1               mobmod  = 0
+capmod  = 2               igcmod  = 0               igbmod  = 0               geomod  = 0
+diomod  = 2               rdsmod  = 0               rbodymod= 0               rgeomod = 1
+rgatemod= 0               permod  = 1               acnqsmod= 0               trnqsmod= 0
+tempmod = 0               wpemod  = 1
**************************************************************
*               GENERAL MODEL PARAMETERS
**************************************************************
+tnom    = 25              toxe    = '6.44e-009 + dtoxe_nm3p3_lp_mis'      dtox = '(-3.5E-10) + ddtox_nm3p3_lp'        epsrox  = 3.9
