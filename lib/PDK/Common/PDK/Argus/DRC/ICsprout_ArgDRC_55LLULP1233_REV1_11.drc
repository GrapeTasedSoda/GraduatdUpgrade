trs::setlayer check_window = geom_with_width ( geom_and (  err1_TMP1 check_region ) >= 50  ) 
trs::outputlayer check_density ( check_pattern check_window "\[!!AREA(check_window)*AREA(check_pattern)/AREA(check_window)\]" > 0.8  by_window 100  delta 50  boundary_backup inside_of_layer DRC:1 in_polygon output_log "${metal_layer}_D_1_max.log" result_db \
"${metal_layer}_D_1_max.rdb" ) 

}
} else {
 
trs::setlayer check_region_1 = ~geom_inside (  geom_not (  geom_not (  geom_not (  geom_not (  DRC:1 FUTR ) GRID ) SRINGBLK ) INDALL ) NODRC ) 
trs::setlayer check_region = geom_with_width ( check_region_1 >= 50  ) 
trs::setlayer check_pattern = geom_and (  "${metal_layer}ALLi" check_region ) 
trs::setlayer err1_TMP1 = check_density ( check_pattern check_region "\[!!AREA(check_region)*AREA(check_pattern)/AREA(check_region)\]" > 0.8  by_window 100  delta 50  boundary_backup inside_of_layer DRC:1 in_polygon ) 

trs::setlayer check_window = geom_with_width ( geom_and (  err1_TMP1 check_region ) >= 50  ) 
trs::outputlayer check_density ( check_pattern check_window "\[!!AREA(check_window)*AREA(check_pattern)/AREA(check_window)\]" > 0.8  by_window 100  delta 50  boundary_backup inside_of_layer DRC:1 in_polygon output_log "${metal_layer}_D_1_max.log" result_db \
"${metal_layer}_D_1_max.rdb" ) 

}
}

trs::rule ${metal_layer}_D_2 {
trs::rule_comment Average density for Mn inside the dummy block area size 2.5um in 100umX100um window with step size 50um
trs::rule_comment when the dummy block area >= 100umX100um. INDALL/FUTR/GRID/SRINGBLK covered areas are excluded from this rule checking
trs::rule_comment Device sensitive areas can be waived. >= 10%
  trs::setlayer X = check_density ( "${metal_layer}ALLi" < 0.1  by_window 100  delta 50  boundary_backup output_log "density_report_${metal_layer}_D_2.log" ) 
  trs::setlayer Y = geom_not (  geom_or (  geom_size ( "${metal_layer}DUMB" by 2.5  ) SRBLK ) geom_or (  INDALL FUTR GRID SRINGBLK ) ) 
  trs::setlayer Z = geom_size ( Y by 12.5  in_out ) 
  trs::outputlayer ~geom_inside (  geom_and (  X Z ) NODRC ) 
}

trs::rule ${metal_layer}_D_3 {
trs::rule_comment The difference between Mn density in 100umX100um with step size 200um and those of the adjacent checking windows (including dummy)
trs::rule_comment INDALL/GRID/FUTR/SRINGBLK covered areas are excluded for this rule checking <= 20%
  trs::setlayer X = check_density ( "${metal_layer}ALLi" >= 0  by_window 200  check_gradient > 0.20  absolute_value boundary_backup inside_of_layer density_checkarea output_log "density_report_${metal_layer}_D_3.log" ) 
  trs::outputlayer ~geom_inside (  geom_not (  geom_not (  geom_not (  geom_not (  X FUTR ) GRID ) SRINGBLK ) INDALL ) NODRC ) 
}

trs::pvrs_block  {
#ENDIF 
}

trs::rule ${metal_layer}_R_1 {
trs::rule_comment Mn line end must be rectangular.
  trs::setlayer A = width (  "${metal_layer}" < 0.01  adjacent == 45  region ) 
  trs::setlayer B = space (  "${metal_layer}" < 0.01  adjacent == 45  region ) 
  trs::setlayer C = width (  "${metal_layer}" < 0.01  adjacent == 135  region ) 
  trs::setlayer D = space (  "${metal_layer}" < 0.01  adjacent == 135  region ) 
  trs::outputlayer ~geom_inside (  A NODRC ) 
  trs::outputlayer ~geom_inside (  B NODRC ) 
  trs::outputlayer ~geom_inside (  C NODRC ) 
  trs::outputlayer ~geom_inside (  D NODRC ) 
}

  }
}


#***********************************************
# Vn: Via n (n=1, 2,3,4,5,6,7) design rules
#***********************************************


set via_list { V1 V2 V3 V4 V5 V6 V7 }
foreach via_layer $via_list {
  set tmp CHECK_$via_layer
  set tmp_v [set $tmp]

  if { $tmp_v == 1 } {
    group_rule "G${via_layer}" "${via_layer}_?" 
  set number [string index $via_layer 1]
  set bottom_metal M$number
  set up_metal M[expr $number +1]
#  set wide_metal

trs::rule ${via_layer}_W_1 {
trs::rule_comment Fixed $via_layer size (square shape) is 0.09,exclude GRING OR SRINGBLK area
  trs::outputlayer ~geom_inside (  ~geom_rectangle ( $via_layer == 0.09  by == 0.09  ) geom_or (  GRID SRINGBLK NODRC ) ) 
}

trs::rule ${via_layer}_W_2 {
trs::rule_comment Fixed $via_layer width(datatype 13) is 0.09,exclude EFUSEALL OR SRAMALL OR FUSEALL area
  trs::outputlayer geom_inside (  geom_with_width ( "${via_layer}bar" < 0.09  ) geom_or (  SRAMALL EFUSEALL FUSEALL ) ) 
  trs::outputlayer geom_inside (  geom_with_width ( "${via_layer}bar" > 0.09  ) geom_or (  SRAMALL EFUSEALL FUSEALL ) ) 
}

trs::rule ${via_layer}_S_1 {
trs::rule_comment Space between two $via_layer is 0.11
  trs::outputlayer ~geom_inside (  space (  $via_layer < 0.11  adjacent < 90  point_touch region ) NODRC ) 
}

trs::rule ${via_layer}_S_2 {
trs::rule_comment Space between ${via_layer}s between VIA and 3-neighboring  VIAs whose space is < 0.14um.  >= 0.13.
  trs::setlayer X = geom_size ( $via_layer by 0.07  out_in ) 
  trs::setlayer Y = geom_size ( X by 0.340  in_out ) 
  trs::setlayer Z = geom_inside (  $via_layer Y ) 
  trs::outputlayer ~geom_inside (  space (  Z < 0.13  adjacent < 90  point_touch region ) NODRC ) 
}

trs::rule ${via_layer}_S_3 {
trs::rule_comment Minimum Space between two neighbor ${via_layer}s (different net and run length>0) >= 0.13um.
  trs::outputlayer ~geom_inside (  space (  $via_layer < 0.13  opposite adjacent < 90  region diff_net ) NODRC ) 
}

trs::rule ${via_layer}_EN_2a_2b_2c {
trs::rule_comment Vn must be fully enclosed by Mn >= 0
trs::rule_comment Min $bottom_metal enclosure of $via_layer for two opposite sides >=0.04
trs::rule_comment Vn must be fully enclosed by Mn/Mn+1 all sides >=0.03
 trs::setlayer X = enc_rect ( $via_layer $bottom_metal adjacent < 90  outside_also correct 0  0.04  opposite 0  0.04  opposite correct 0.03  0.03  0.03  0.03  opposite ) 
  trs::outputlayer ~geom_inside (  X NODRC ) 
  trs::outputlayer ~geom_inside (  geom_not (  $via_layer $bottom_metal ) NODRC ) 
}

trs::pvrs_block  {
#IFDEF OPEN_RECOMMENDED_ON YES 
}
trs::rule ${via_layer}_2a_R_2b_R {
trs::rule_comment Vn must be fully enclosed by Mn >= 0.04
trs::rule_comment Min $bottom_metal enclosure of $via_layer for two opposite sides >=0.07
trs::rule_comment Vn must be fully enclosed by Mn all sides >=0.03
 trs::setlayer X = enc_rect ( $via_layer $bottom_metal adjacent < 90  outside_also correct 0.04  0.07  opposite 0.04  0.07  opposite ) 
 trs::outputlayer ~geom_inside (  X NODRC ) 
 trs::outputlayer ~geom_inside (  geom_not (  $via_layer $bottom_metal ) NODRC ) 
}
trs::pvrs_block  {
#ENDIF 
}

trs::rule ${via_layer}_EN_5a_5b {
trs::rule_comment Vn must be fully enclosed by Mn+1
trs::rule_comment Min $up_metal enclsoure of $via_layer is 0.005
trs::rule_comment Min $up_metal enclosure of $via_layer is 0.02 when $up_metal enclosure on one or both perpendicular directions<0.02um
trs::setlayer X = enc_rect ( $via_layer $up_metal adjacent < 90  outside_also correct 0.005  opposite 0.02  opposite 0.005  opposite 0.02  opposite ) 
  trs::outputlayer ~geom_inside (  extension (  X $up_metal < 0.005  adjacent < 90  point_touch region overlapped outside_also ) NODRC ) 
  trs::setlayer Y = extension (  "\[X\]" $up_metal < 0.02  opposite ) 
  trs::outputlayer ~geom_inside (  width (  Y < 0.01  adjacent == 90  intersecting_only region ) NODRC ) 
  trs::outputlayer ~geom_inside (  geom_not (  $via_layer $up_metal ) NODRC ) 

  }


trs::pvrs_block  {
#IFDEF OPEN_RECOMMENDED_ON YES 
}
trs::rule ${via_layer}_R_1_R {
trs::rule_comment There should be at least two ${via_layer}s in the $bottom_metal and $up_metal intersection area when either or both $bottom_metal and $up_metal with width >= 0.5um
trs::rule_comment There should be at least two ${via_layer}s in the $bottom_metal and $up_metal intersection area when either or both $bottom_metal and $up_metal 
trs::rule_comment connected with metal line of width>=0.5um and space between $via_layer and wider metal edge <0.5um
trs::rule_comment NOTICE: It is a recommended rule.

  trs::setlayer X = geom_size ( geom_with_width ( $bottom_metal >= 0.5  ) by 0.499  inside_of_layer     $bottom_metal delta 0.01  ) 
  trs::setlayer S$via_layer = geom_interact (  $via_layer "S${via_layer}_metal" ) 
  trs::outputlayer ~geom_inside (  geom_enclose (  "S${via_layer}_metal" geom_not (  geom_not (  geom_interact (  S$via_layer X ) LOGO ) GRID ) ) NODRC ) 
  trs::setlayer Y = geom_size ( geom_with_width ( $up_metal >= 0.5  ) by 0.499  inside_of_layer     $up_metal delta 0.01  ) 
  trs::outputlayer ~geom_inside (  geom_enclose (  "S${via_layer}_metal" geom_not (  geom_not (  geom_interact (  S$via_layer Y ) LOGO ) GRID ) ) NODRC ) 
}
trs::pvrs_block  {
#ENDIF 
}

trs::rule ${via_layer}_R_2a_2b {
trs::rule_comment There should be at least two Vns at the intersection of Mn and Mn+1 when either Mn or Mn+1 width >= 0.3um
trs::rule_comment There should be at least 4 Vns at the intersection of Mn and Mn+1, if either Mn or Mn+1 is connected to a metal line with width d>=0.7um and space c<0.2um (space between Vns at the intersection and the wide metal)
  trs::setlayer X = geom_size ( geom_with_width ( geom_and (  $bottom_metal $up_metal ) >= 0.3  ) by 0.199  inside_of_layer   geom_and (  $bottom_metal $up_metal ) delta 0.01  ) 
  trs::setlayer "S${via_layer}" = geom_interact (  $via_layer "S${via_layer}_metal" ) 
  trs::outputlayer ~geom_inside (  geom_enclose (  "S${via_layer}_metal" geom_not (  geom_not (  geom_interact (  S$via_layer X ) LOGO ) GRID ) ) NODRC ) 

  trs::setlayer X1 = geom_size ( geom_with_width ( geom_and (  $bottom_metal $up_metal ) >= 0.7  ) by 0.199  inside_of_layer   geom_and (  $bottom_metal $up_metal ) delta 0.01  ) 
  trs::setlayer U4$via_layer = geom_interact (  $via_layer "U4${via_layer}_metal" ) 
  trs::outputlayer ~geom_inside (  geom_enclose (  "U4${via_layer}_metal" geom_not (  geom_not (  geom_interact (  "U4${via_layer}" X1 ) LOGO ) GRID ) ) NODRC ) 
}

trs::rule ${via_layer}_R_5 {
trs::rule_comment 45-dgree rotated via is not allowed
trs::outputlayer edge_angle (  $via_layer == 45  ) 
}

}

}


trs::setlayer TMP = geom_and (  AA PO ) 
#------------------------for via stack------------------------
for {set j 1} { $j < [expr $total_metal - $top_metal ] } {incr j} {
  trs::setlayer "V${j}N_M" = geom_interact (  "V${j}N" "st_${j}" ) 
  trs::setlayer "st_${j}" = geom_enclose (  geom_and (  "M${j}" "M[expr $j+1]" ) "V${j}" == 1  ) 
  trs::setlayer "V${j}N" = geom_and (  "V${j}" geom_rectangle ( "V${j}" == 0.09  by == 0.09  ) ) 
  trs::setlayer "RV${j}" = geom_and (  "V${j}" geom_rectangle ( "V${j}" ratio != 1  ) ) 
#--------------------------------------------------------------------------
trs::rule V${j}_R_3 {
trs::rule_comment Single Vn is not allowed in "H-shape" Mn+1 when:
trs::rule_comment 1) The Mn+1 has "H-shape" metal interact with two metal holes: both two metal holes' length (L2) <= 5um and area <= 5um2.
trs::rule_comment 2) The Vn overlaps on the center metal bar of this "H-shape" Mn+1
trs::rule_comment 3) The center metal bar has the length (L) <= 1um and the width <= 3um
  via_in_H_bar V${j}N M[expr $j +1] 5 5 1 3
  trs::outputlayer ~geom_inside (  geom_interact (  Z "V${j}N" == 1  ) NODRC ) 
}
if { [expr $total_metal - $top_metal -1 -$j -4] >= 0} {

trs::pvrs_block  {
#IFDEF OPEN_RECOMMENDED_ON YES 
}
trs::rule V${j}_R_4_R {
trs::rule_comment Single vias stacked by more than 4 layers are not allowed. <=4
  trs::setlayer X = geom_interact (  "V${j}N_M" geom_interact (  "V[expr $j +1]N_M" geom_interact (  "V[expr $j +2]N_M" geom_interact (  "V[expr $j +3]N_M" "V[expr $j +4]N_M" ) ) ) ) 
  trs::outputlayer ~geom_inside (  X NODRC ) 
}
trs::pvrs_block  {
#ENDIF 
}
}

#----stack end-----
}

#=======================
#  T4V1 - Top Via 1a DRC
#=======================


if { [set CHECK_T4V1] == 1 } {
  set bottom_metal_list { M8 M7 M6 M5 M4 M3 }
  foreach bottom_metal $bottom_metal_list {
    set tmp CHECK_$bottom_metal
    set tem_v [set $tmp]
    if { $tem_v == 1 } break
  }
  
group_rule GT4V1 T4V1_? 

trs::rule T4V1_W_1 {
trs::rule_comment Fixed T4V1 size (square shape),exclude GRDID and SRINGBLK region = 0.36
  trs::outputlayer ~geom_inside (  geom_not (  ~geom_rectangle ( geom_not (  T4V1 GT4V1 ) == 0.36  by == 0.36  ) GRID ) geom_or (  SRINGBLK NODRC ) ) 
  trs::outputlayer ~geom_inside (  ~geom_rectangle ( geom_rectangle ( geom_and (  T4V1 GRID ) ) == 0.36  by == 0.36  ) geom_or (  SRINGBLK NODRC ) ) 
}

trs::rule T4V1_W_2 {
trs::rule_comment Fixed T4V1bar width  = 0.36
 trs::outputlayer geom_with_width ( T4V1bar < 0.36  ) 
 trs::outputlayer geom_with_width ( T4V1bar > 0.36  ) 
}

trs::rule T4V1_S_1 {
trs::rule_comment Min Space between two T4V1s >= 0.34
  trs::outputlayer ~geom_inside (  space (  T4V1 < 0.34  adjacent < 90  point_touch region ) NODRC ) 
}

trs::rule T4V1_S_2 {
trs::rule_comment Min Space between T4V1s within array greater or equal to 3x3 (Two via regions whose space is <= 0.56um are considered to be in the same array) >= 0.5

  trs::setlayer X = geom_size ( T4V1 by 0.28  out_in ) 
  trs::setlayer Y = geom_size ( X by 0.855  in_out ) 
  trs::setlayer Z = geom_inside (  T4V1 Y ) 
  trs::outputlayer ~geom_inside (  space (  Z < 0.5  adjacent < 90  point_touch region ) NODRC ) 
}

trs::rule T4V1_EN_2_EN_3 {
trs::rule_comment Min $bottom_metal fully enclosure of T4V1 ($bottom_metal is Metal layer directly underneath T4V1) >= 0.01
trs::rule_comment Min $bottom_metal enclosure of T4V1, when $bottom_metal enclosure on one or both perpendicular directions< 0.05um ($bottom_metal is Metal layer directly underneath T4V1) >= 0.05 
trs::setlayer X = enc_rect ( T4V1 $bottom_metal adjacent < 90  outside_also correct 0.01  opposite 0.05  opposite 0.01  opposite 0.05  opposite ) 
  trs::outputlayer ~geom_inside (  extension (  X $bottom_metal < 0.01  adjacent < 90  point_touch region overlapped outside_also ) NODRC ) 
  trs::setlayer Y = extension (  "\[X\]" $bottom_metal < 0.05  opposite ) 
  trs::outputlayer ~geom_inside (  width (  Y < 0.01  adjacent == 90  region intersecting_only ) NODRC ) 
  trs::outputlayer ~geom_inside (  geom_not (  T4V1 $bottom_metal ) NODRC ) 
}
trs::rule T4V1_EN_5_EN_6 {
trs::rule_comment T4V1 must be fully covered by T4M1.
trs::rule_comment Min T4M1 fully enclosure of T4V1  >= 0.02
  trs::outputlayer ~geom_inside (  extension (  T4V1 T4M1 < 0.02  adjacent < 90  point_touch region outside_also ) NODRC ) 
}

trs::pvrs_block  {
#IFDEF OPEN_RECOMMENDED_ON YES 
}
trs::rule T4V1_R_1_R {
trs::rule_comment There should be at least two square T4V1s at the intersection of Mn and T4M1 when either Mn or T4M1 width,exclude GRBLK and SRINGBLK region >= 0.5um
trs::setlayer T4V1_SQ = geom_rectangle ( T4V1 ratio == 1  ) 
trs::setlayer X1_Mn = geom_enclose (  $bottom_metal geom_with_width ( $bottom_metal >= 0.5  ) ) 
trs::setlayer X1_T4M1 = geom_enclose (  T4M1 geom_with_width ( T4M1 >= 0.5  ) ) 
trs::setlayer T4M1Mn = geom_and (  $bottom_metal T4M1 ) 
trs::setlayer X1 = geom_or (  X1_Mn X1_T4M1 ) 
trs::outputlayer ~geom_inside (  geom_interact (  geom_interact (  T4M1Mn T4V1_SQ == 1  ) X1 ) geom_or (  SRINGBLK NODRC GRBLK ) ) 
}
trs::pvrs_block  {
#ENDIF 
}
trs::rule T4V1_R_3 {
trs::rule_comment 45-dgree T4V1 is not allowed
trs::outputlayer edge_angle (  T4V1 == 45  ) 
}

trs::pvrs_block  {
#IFDEF OPEN_RECOMMENDED_ON YES 
}
trs::rule T4V1_R_4_R {
trs::rule_comment Recommended us redundant T4V1s as possible, DRC can help to flag single T4V1
trs::outputlayer geom_interact (  geom_and (  $bottom_metal T4M1 ) T4V1 == 1  ) 
}

trs::pvrs_block  {
#ENDIF 
}


#=========================
#  T4M1 - Top Metal 1a DRC
#=========================

group_rule GT4M1 T4M1_? 

trs::rule T4M1_W_1 {
trs::rule_comment T4M1 width >= 0.40um
trs::rule_comment T4M1 width <= 20um
trs::rule_comment DRC doesn't check DEUPAD and INDALL region
  trs::outputlayer ~geom_inside (  width (  T4M1 < 0.40  adjacent < 90  point_touch region ) geom_or (  INDALL DEUPAD NODRC ) ) 
  trs::outputlayer ~geom_inside (  geom_with_width ( T4M1 > 20  ) geom_or (  INDALL DEUPAD NODRC ) ) 
}

trs::rule T4M1_S_1 {
trs::rule_comment Min Space between two T4M1s is 0.40um,DRC waive check 89 to 90 degree spaces in the INDALL region.
  trs::outputlayer ~geom_inside (  geom_not (  space (  T4M1 < 0.40  adjacent < 90  point_touch region ) INDALL ) NODRC ) 
  trs::outputlayer ~geom_inside (  geom_and (  space (  T4M1 < 0.40  adjacent < 89  point_touch region ) INDALL ) NODRC ) 
}

trs::rule T4M1_S_2 {
trs::rule_comment Min Space between two T4M1s when one or both T4M1 width or length >=2um, and the run length of two T4M1s is >= 2um. >= 0.5um 
  Mn_2b T4M1ALL 2 2 0.5
}

trs::rule T4M1_A_1 {
trs::rule_comment T4M1 area >= 0.40
  trs::outputlayer ~geom_inside (  geom_area  ( T4M1 < 0.40  ) NODRC ) 
}

trs::rule T4M1_A_2 {
trs::rule_comment Min Enclosed area by T4M1 is 0.6
  trs::setlayer X = geom_not (  geom_holes ( T4M1 inner_most ) T4M1 ) 
  trs::outputlayer ~geom_inside (  geom_area  ( X < 0.6  ) NODRC ) 
}

trs::pvrs_block  {
#IFDEF Density_rules YES 
}
trs::rule T4M1_D_1_min {
trs::rule_comment T4M1 density (including dummy) in 100umX100um window with step size 100um >= 20%  
trs::rule_comment INDALL/FUTR/GRID/SRINGBLK covered areas are excluded for this rule checking. 
trs::rule_comment (Top metal bond pad areas and DEUPAD regions can be waived.)
  trs::setlayer X1 = geom_not (  T4M1ALLi DEUPAD ) 
  trs::setlayer X = check_density ( X1 < 0.20  by_window 100  delta 50  boundary_backup inside_of_layer density_checkarea output_log density_report_T4M1__D_1_min.log ) 
  trs::setlayer Y = geom_or (  FUTR GRID SRINGBLK PA INDALL ) 
  trs::outputlayer ~geom_inside (  geom_not (  X Y ) NODRC ) 
}


trs::rule T4M1_D_1_max {
trs::rule_comment T4M1 density (including dummy) in 100umX100um window with step size 100um <= 85%. 
trs::rule_comment INDALL/FUTR/GRID/SRINGBLK covered areas are excluded for this rule checking. 
trs::rule_comment (Top metal bond pad areas can be waived.)
  trs::setlayer X1 = geom_not (  T4M1ALLi DEUPAD ) 
  trs::setlayer X = check_density ( X1 > 0.85  by_window 100  delta 50  boundary_backup inside_of_layer density_checkarea output_log density_report_T4M1_D_1_max.log ) 
  trs::setlayer Y = geom_or (  FUTR GRID SRINGBLK PA INDALL ) 
  trs::outputlayer ~geom_inside (  geom_not (  X Y ) NODRC ) 
}

trs::rule T4M1_D_2 {
trs::rule_comment T4M1 density inside (T4M1dumb sizing up 2.5um) in 100umX100um window with step size 100um >= 10%  
  trs::setlayer CHECK_AREA = geom_size ( T4M1DUMB by 2.5  ) 
  trs::setlayer X1 = geom_not (  T4M1ALLi DEUPAD ) 
  trs::setlayer X = check_density ( X1 < 0.10  by_window 100  delta 50  boundary_backup inside_of_layer CHECK_AREA output_log density_report_T4M1_D_2.log ) 
  trs::setlayer Y = geom_or (  FUTR GRID SRINGBLK PA INDALL ) 
  trs::outputlayer ~geom_inside (  geom_not (  X Y ) NODRC ) 
}


trs::rule T4M1_D_3 {
trs::rule_comment T4M1 density difference in 100umX100um window <= 20%. 
trs::rule_comment INDALL/FUTR/GRID/SRINGBLK covered areas are excluded for this rule checking. 
  trs::setlayer X1 = geom_not (  T4M1ALLi DEUPAD ) 
  trs::setlayer X = check_density ( X1 > 0  by_window 100  check_gradient > 0.2  absolute_value boundary_backup inside_of_layer density_checkarea output_log density_report_T4M1_D_3.log ) 
  trs::setlayer Y = geom_or (  FUTR GRID SRINGBLK PA INDALL ) 
  trs::outputlayer ~geom_inside (  geom_not (  X Y ) NODRC ) 
}

trs::pvrs_block  {
#ENDIF 
}

trs::rule T4M1_R_1 {
trs::rule_comment T4M1 line end must be rectangular.
  trs::setlayer A = width (  T4M1 < 0.01  adjacent == 45  region ) 
  trs::setlayer B = space (  T4M1 < 0.01  adjacent == 45  region ) 
  trs::setlayer C = width (  T4M1 < 0.01  adjacent == 135  region ) 
  trs::setlayer D = space (  T4M1 < 0.01  adjacent == 135  region ) 
  trs::outputlayer ~geom_inside (  A NODRC ) 
  trs::outputlayer ~geom_inside (  B NODRC ) 
  trs::outputlayer ~geom_inside (  C NODRC ) 
  trs::outputlayer ~geom_inside (  D NODRC ) 
  }

}


#---------------------------------------------------------------------------------------------------------------------------------------------------

#=====================================================
#  Special offering for 2X design rule T2V1-T2M1
#=====================================================


#==========================
#  T2V1 - Top Via T2V1 DRC
#==========================


if { [set CHECK_T2V1] == 1 } {
  set bottom_metal_list { M8 M7 M6 M5 M4 M3 }
  foreach bottom_metal $bottom_metal_list {
    set tmp CHECK_$bottom_metal
    set tem_v [set $tmp]
    if { $tem_v == 1 } break
  }
  
group_rule GT2V1 T2V1_? 

trs::rule T2V1_W_1 {
trs::rule_comment Fixed T2V1 size (square shape) except guard ring and seal ring application is 0.2
  trs::outputlayer ~geom_inside (  geom_not (  ~geom_rectangle ( geom_not (  T2V1 GT2V1 ) == 0.2  by == 0.2  ) GRID ) NODRC ) 
  trs::outputlayer ~geom_inside (  ~geom_rectangle ( geom_rectangle ( geom_and (  T2V1 GRID ) ) == 0.2  by == 0.2  ) NODRC ) 
}

trs::rule T2V1_W_2 {
trs::rule_comment Fixed T2V1bar width = 0.2
trs::outputlayer geom_with_width ( T2V1bar < 0.2  ) 
trs::outputlayer geom_with_width ( T2V1bar > 0.2  ) 
}

trs::rule T2V1_S_1 {
trs::rule_comment Space between T2V1s >= 0.2
  trs::outputlayer ~geom_inside (  space (  T2V1 < 0.2  adjacent < 90  point_touch region ) NODRC ) 
}

trs::rule T2V1_S_2 {
trs::rule_comment Min Space between T2V1s and 3-neighboring T2V1s space is <= 0.28um. >= 0.25
  trs::setlayer X = geom_size ( T2V1 by 0.15  out_in ) 
  trs::setlayer Y = geom_size ( X by 0.455  in_out ) 
  trs::setlayer Z = geom_inside (  T2V1 Y ) 
  trs::outputlayer ~geom_inside (  space (  Z < 0.25  adjacent < 90  point_touch region ) NODRC ) 
}

trs::rule T2V1_EN_2a_EN_2b {
trs::rule_comment T2V1 must be fully enclosed by $bottom_metal.
trs::rule_comment $bottom_metal enclosure of T2V1 ($bottom_metal is Metal layer directly underneath T2V1) >= 0
trs::rule_comment $bottom_metal enclosure of T2V1 when $bottom_metal enclosure on one or both perpendicular directions< 0.05um ($bottom_metal is Metal layer directly underneath T2V1). >= 0.05 
 
   trs::setlayer X = enc_rect ( ~geom_adjacent (  T2V1 $bottom_metal ) $bottom_metal adjacent < 90  outside_also correct 0  0.05  opposite 0  0.05  opposite ) 


   trs::setlayer A = extension (  "\[X\]" $bottom_metal < 0.05  opposite ) 
   trs::setlayer D1 = width (  A < 0.01  adjacent == 90  intersecting_only region ) 
   trs::outputlayer ~geom_inside (  D1 NODRC ) 

   trs::setlayer B = edge_coincident ( both_side  T2V1 $bottom_metal ) 
   trs::setlayer D2 = width (  B < 0.01  adjacent == 90  region ) 
   trs::outputlayer ~geom_inside (  D2 NODRC ) 

   
   trs::setlayer Y = extension (  T2V1 $bottom_metal < 0.05  opposite region ) 
   trs::setlayer C1 = edge_coincident ( both_side  T2V1 $bottom_metal ) 
   trs::setlayer C2 = edge_coincident ( both_side  T2V1 Y ) 
   trs::setlayer D3 = width (  C1 C2 < 0.01  adjacent == 90  region ) 
   trs::outputlayer ~geom_inside (  D3 NODRC ) 
   
   trs::outputlayer ~geom_inside (  geom_not (  T2V1 $bottom_metal ) NODRC ) 
}

trs::pvrs_block  {
#IFDEF OPEN_RECOMMENDED_ON YES 
}
trs::rule T2V1_EN_2a_R_EN_2b_R {
trs::rule_comment Recommended enclosure by Mn to avoid high Rc >= 0.05
trs::rule_comment Recommended enclosure by Mn for at least 2 opposite sides >= 0.08
   trs::setlayer X = enc_rect ( T2V1 $bottom_metal adjacent < 90  outside_also correct 0.05  0.08  opposite 0.05  0.08  opposite ) 
   copy ( X ) 
}

trs::pvrs_block  {
#ENDIF 
}

trs::rule T2V1_EN_4a_EN_4b {
trs::rule_comment T2V1 must be fully enclosed by T2M1.
trs::rule_comment Enclosed by T2M1 >=  0
trs::rule_comment Enclosed by T2M1 when T2M1 enclosure on one or both perpendicular directions< 0.05um. >= 0.05 

  trs::setlayer X = enc_rect ( T2V1 T2M1 adjacent < 90  outside_also correct 0  0.05  opposite 0  0.05  opposite ) 
 
  trs::outputlayer ~geom_inside (  X NODRC ) 

  trs::setlayer Y = extension (  "\[X\]" T2M1 < 0.05  opposite ) 
  trs::setlayer D2 = width (  Y < 0.01  adjacent == 90  intersecting_only region ) 
  trs::outputlayer ~geom_inside (  D2 NODRC ) 
  trs::outputlayer ~geom_inside (  geom_not (  T2V1 T2M1 ) NODRC ) 
 }

trs::rule T2V1_R_1 {
trs::rule_comment There should be at least two square T2V1s space <= 0.4um for Mn and T2M1 connection when either or both Mn (Mn is Metal layer directly underneath T2V1) and T2M1 width is > 0.6um.
trs::setlayer T2V1_SQ_CHECK = geom_rectangle ( T2V1 ratio == 1  ) 
trs::setlayer T2V1_SQ_REG = space (  T2V1_SQ_CHECK <= 0.4  point_touch region ) 
trs::setlayer T2V1_SQ_CHECK_VIA = geom_interact (  T2V1_SQ_CHECK T2V1_SQ_REG ) 
trs::setlayer T2V1_SQ = geom_or (  T2V1_SQ_CHECK_VIA T2V1_SQ_REG ) 
trs::setlayer X1_Mn = geom_enclose (  $bottom_metal geom_with_width ( $bottom_metal > 0.6  ) ) 
trs::setlayer X1_T2M1 = geom_enclose (  T2M1 geom_with_width ( T2M1 > 0.6  ) ) 
trs::setlayer T2M1Mn = geom_and (  $bottom_metal T2M1 ) 
trs::setlayer X1 = geom_or (  X1_Mn X1_T2M1 ) 
trs::outputlayer geom_interact (  geom_interact (  T2M1Mn T2V1_SQ == 1  ) X1 ) 
}

trs::rule T2V1_R_2 {
trs::rule_comment There should be at least four square T2V1s in this Mn and T2M1 intersection area when either or both Mn (Mn is Metal layer directly underneath T2V1) and T2M1 width is > 1.4um.
trs::setlayer T2V1_SQ_CHECK = geom_rectangle ( T2V1 ratio == 1  ) 
trs::setlayer T2V1_SQ = geom_rectangle ( T2V1 ratio == 1  ) 
trs::setlayer T2V1_SQ_REG = space (  T2V1_SQ_CHECK <= 0.4  point_touch region ) 
trs::setlayer T2V1_SQ_CHECK_VIA = geom_interact (  T2V1_SQ_CHECK T2V1_SQ_REG ) 
trs::setlayer X1_Mn = geom_enclose (  $bottom_metal geom_with_width ( $bottom_metal > 1.4  ) ) 
trs::setlayer X1_T2M1 = geom_enclose (  T2M1 geom_with_width ( T2M1 > 1.4  ) ) 
trs::setlayer T2M1Mn = geom_and (  $bottom_metal T2M1 ) 
trs::setlayer X1 = geom_or (  X1_Mn X1_T2M1 ) 
trs::outputlayer geom_interact (  geom_interact (  T2M1Mn T2V1_SQ_CHECK_VIA < 4  ) X1 ) 
}

trs::rule T2V1_R_3 {
trs::rule_comment 45-dgree T2V1 is not allowed
trs::outputlayer edge_angle (  T2V1 == 45  ) 
}

trs::pvrs_block  {
#IFDEF OPEN_RECOMMENDED_ON YES 
}
trs::rule T2V1_R_4_R {
trs::rule_comment Recommended us redundant T2V1s as possible, DRC can help to flag single T4V1
trs::outputlayer geom_interact (  geom_and (  $bottom_metal T2M1 ) T2V1 == 1  ) 
}

trs::pvrs_block  {
#ENDIF 
}

#=============================
#  T2M1 - Top Metal T2M1 DRC
#=============================

group_rule GT2M1 T2M1_? 


trs::rule T2M1_W_1 {
trs::rule_comment T2M1 width >= 0.20
trs::rule_comment Max T2M1 width is 10,except DEUPAD and INDALL region.
trs::rule_comment Exclude top metal bond pad and INDALL and DEUPAD regions.
  trs::setlayer X = geom_not (  geom_not (  T2M1 DEUPAD ) PA ) 
  trs::outputlayer ~geom_inside (  geom_not (  geom_with_width ( X > 10  ) INDALL ) NODRC ) 
  trs::outputlayer ~geom_inside (  width (  T2M1 < 0.2  adjacent < 90  point_touch region ) NODRC ) 
}

trs::rule T2M1_W_2 {
trs::rule_comment 45 dgree T2M1 width >= 0.39
trs::setlayer X = edge_angle (  T2M1 == 45  ) 
trs::outputlayer width (  X < 0.39  adjacent < 90  region ) 
}

trs::rule T2M1_W_3 {
trs::rule_comment Minimum T2M1 width adjoining a huge non-metal region \[ area > 2000000 um2\], non-metal region is defined as (NOT (T2M1 OR T2M1DUM)) >= 0.35um
  trs::setlayer NON_METAL_REG = geom_area  ( geom_not (  DRC:1 geom_or (  T2M1 T2M1DUM ) ) > 2000000  ) 
  trs::setlayer CHECK_REGION = geom_enclose_rectangle ( NON_METAL_REG 10  0.35  ) 
  trs::setlayer CHECK_METAL = geom_interact (  T2M1 CHECK_REGION ) 
  trs::outputlayer ~geom_inside (  width (  CHECK_METAL < 0.35  adjacent < 90  point_touch region ) NODRC ) 
}

trs::rule T2M1_S_1 {
trs::rule_comment Space between T2M1s, DRC waive check 89 to 90 degree spaces in the INDALL region.>= 0.20
  trs::outputlayer ~geom_inside (  geom_not (  space (  T2M1 < 0.20  adjacent < 90  point_touch region ) INDALL ) NODRC ) 
  trs::outputlayer ~geom_inside (  geom_and (  space (  T2M1 < 0.20  adjacent < 89  point_touch region ) INDALL ) NODRC ) 
#space (  T2M1 T2M1DUM < 0.20  region ) 
#space (  T2M1DUM < 0.20  region ) 
}

trs::rule T2M1_S_2 {
trs::rule_comment Space between two T2M1s when one or both T2M1 width or length >= 0.39um, and the run length of two T2M1s is >= 1um. >= 0.24 
  Mn_2b T2M1ALL 1 0.39 0.24
}

trs::rule T2M1_S_3 {
trs::rule_comment Space between two T2M1s when one or both T2M1 width or length >= 1.5um, and the run length of two T2M1s is >= 1.5um >= 0.50 
  Mn_2b T2M1ALL 1.5 1.5 0.5
}

trs::rule T2M1_S_4 {
trs::rule_comment Space between two T2M1s when one or both T2M1 width or length >= 4.5um, and the run length of two T2M1s is >= 4.5um >= 1.50 
  Mn_2b T2M1ALL 4.5 4.5 1.5
}

trs::rule T2M1_S_5 {
trs::rule_comment Min Space between T2M1 metal lines with one or both are 45 degree bent metal lines >= 0.39
  trs::setlayer X = edge_angle (  T2M1 == 45  ) 
  trs::outputlayer ~geom_inside (  space (  X T2M1 < 0.39  adjacent < 90  region ) NODRC ) 
}

trs::rule T2M1_A_1 {
trs::rule_comment T2M1 area >= 0.14
  trs::outputlayer ~geom_inside (  geom_area  ( T2M1 < 0.14  ) NODRC ) 
}

trs::rule T2M1_A_2 {
trs::rule_comment T2M1 enclosed area >= 0.26
  trs::setlayer X = geom_not (  geom_holes ( T2M1 inner_most ) T2M1 ) 
  trs::outputlayer ~geom_inside (  geom_area  ( X < 0.26  ) NODRC ) 
}


trs::pvrs_block  {
#IFDEF Density_rules YES 
}
trs::rule T2M1_D_1_min {
trs::rule_comment T2M1 density (including dummy) in 100umX100um window with step size 50um is >= 10% and <= 80%. 
trs::rule_comment INDALL/FUTR/GRID/SRINGBLK covered areas are excluded for this rule checking. 
trs::rule_comment (Top metal bond pad areas and DEUPAD region can be waived.)

trs::setlayer check_region_1 = ~geom_inside (  geom_not (  geom_not (  geom_not (  geom_not (  geom_not (  geom_not (  DRC:1 FUTR ) GRID ) SRINGBLK ) INDALL ) PA ) DEUPAD ) NODRC ) 
trs::setlayer check_region = geom_with_width ( check_region_1 >= 25  ) 
trs::setlayer check_pattern = geom_and (  T2M1ALLi check_region ) 
trs::setlayer err1_TMP1 = check_density ( check_pattern check_region "\[!AREA(check_region) + !!AREA(check_region)*AREA(check_pattern)/AREA(check_region)\]" < 0.1  by_window 100  delta 50  boundary_backup inside_of_layer DRC:1 in_polygon ) 

trs::setlayer check_window = geom_with_width ( geom_and (  err1_TMP1 check_region ) >= 25  ) 
trs::outputlayer check_density ( check_pattern check_window "\[!AREA(check_window) + !!AREA(check_window)*AREA(check_pattern)/AREA(check_window)\]" < 0.1  by_window 100  delta 50  boundary_backup inside_of_layer DRC:1 in_polygon output_log T2M1_D_1_min.log result_db \
T2M1_D_1_min.rdb ) 

}

trs::rule T2M1_D_1_max {
trs::rule_comment T2M1 density (including dummy) in 100umX100um window with step size 50um is >= 10% and <= 80%. 
trs::rule_comment INDALL/FUTR/GRID/SRINGBLK covered areas are excluded for this rule checking. 
trs::rule_comment (Top metal bond pad areas and DEUPAD region can be waived.)

trs::setlayer check_region_1 = ~geom_inside (  geom_not (  geom_not (  geom_not (  geom_not (  geom_not (  geom_not (  DRC:1 FUTR ) GRID ) SRINGBLK ) INDALL ) PA ) DEUPAD ) NODRC ) 
trs::setlayer check_region = geom_with_width ( check_region_1 >= 25  ) 
trs::setlayer check_pattern = geom_and (  T2M1ALLi check_region ) 
trs::setlayer err1_TMP1 = check_density ( check_pattern check_region "\[!!AREA(check_region)*AREA(check_pattern)/AREA(check_region)\]" > 0.8  by_window 100  delta 50  boundary_backup inside_of_layer DRC:1 in_polygon ) 

trs::setlayer check_window = geom_with_width ( geom_and (  err1_TMP1 check_region ) >= 25  ) 
trs::outputlayer check_density ( check_pattern check_window "\[!!AREA(check_window)*AREA(check_pattern)/AREA(check_window)\]" > 0.8  by_window 100  delta 50  boundary_backup inside_of_layer DRC:1 in_polygon output_log T2M1_D_1_max.log result_db \
T2M1_D_1_max.rdb ) 

}

trs::rule T2M1_D_2 {
trs::rule_comment T4M1 density inside (T2M1dumb sizing up 2.5um) in 100umX100um window with step size 50um >= 10%  
  trs::setlayer CHECK_AREA = geom_size ( T2M1DUMB by 2.5  ) 
  trs::setlayer X1 = geom_not (  T2M1ALLi DEUPAD ) 
  trs::setlayer X = check_density ( X1 < 0.10  by_window 100  delta 50  boundary_backup inside_of_layer CHECK_AREA output_log density_report_T2M1_D_2.log ) 
  trs::setlayer Y = geom_or (  FUTR GRID SRINGBLK PA INDALL ) 
  trs::outputlayer ~geom_inside (  geom_not (  X Y ) NODRC ) 
}


trs::rule T2M1_D_3 {
trs::rule_comment T2M1 density difference in 100umX100um window <= 20%. 
trs::rule_comment INDALL/FUTR/GRID/SRINGBLK covered areas are excluded for this rule checking. 
  trs::setlayer X1 = geom_not (  T2M1ALLi DEUPAD ) 
  trs::setlayer X = check_density ( X1 > 0  by_window 100  check_gradient > 0.2  absolute_value boundary_backup inside_of_layer density_checkarea output_log density_report_T2M1_D_3.log ) 
  trs::setlayer Y = geom_or (  FUTR GRID SRINGBLK PA INDALL ) 
  trs::outputlayer ~geom_inside (  geom_not (  X Y ) NODRC ) 
}


trs::pvrs_block  {
#ENDIF 
}

trs::rule T2M1_R_1 {
trs::rule_comment T2M1 line end must be rectangular.
  trs::setlayer A = width (  T2M1 < 0.01  adjacent == 45  region ) 
  trs::setlayer B = space (  T2M1 < 0.01  adjacent == 45  region ) 
  trs::setlayer C = width (  T2M1 < 0.01  adjacent == 135  region ) 
  trs::setlayer D = space (  T2M1 < 0.01  adjacent == 135  region ) 
  trs::outputlayer ~geom_inside (  A NODRC ) 
  trs::outputlayer ~geom_inside (  B NODRC ) 
  trs::outputlayer ~geom_inside (  C NODRC ) 
  trs::outputlayer ~geom_inside (  D NODRC ) 
 }

}


#=====================================================
#  Special offering for 2X design rule T2V2-T2M2
#=====================================================


#==========================
#  T2V2 - Top Via T2V2 DRC
#==========================


if { [set CHECK_T2V2] == 1 } {
  set bottom_metal_list {T2M1 M8 M7 M6 M5 M4 M3}
  foreach bottom_metal $bottom_metal_list {
    set tmp CHECK_$bottom_metal
    set tem_v [set $tmp]
    if { $tem_v == 1 } break
  }
  
group_rule GT2V2 T2V2_? 

trs::rule T2V2_W_1 {
trs::rule_comment Fixed T2V1 (square shape) size ,exclude SRINGBLK and GRBLK area  = 0.2
  trs::outputlayer ~geom_inside (  geom_not (  ~geom_rectangle ( geom_not (  T2V2 GT2V2 ) == 0.2  by == 0.2  ) GRID ) geom_or (  SRINGBLK NODRC ) ) 
  trs::outputlayer ~geom_inside (  ~geom_rectangle ( geom_rectangle ( geom_and (  T2V2 GRID ) ) == 0.2  by == 0.2  ) geom_or (  SRINGBLK NODRC ) ) 
}

trs::rule T2V2_W_2 {
trs::rule_comment Fixed T2V2bar width = 0.2
trs::outputlayer geom_with_width ( T2V2bar < 0.2  ) 
trs::outputlayer geom_with_width ( T2V2bar > 0.2  ) 
}

trs::rule T2V2_S_1 {
trs::rule_comment Space between two T2V2s >= 0.2
  trs::outputlayer ~geom_inside (  space (  T2V2 < 0.2  adjacent < 90  point_touch region ) NODRC ) 
}

trs::rule T2V2_S_2 {
trs::rule_comment Space between T2V2 and neighboring T2V2s with space < 0.28um. >= 0.25
  trs::setlayer X = geom_size ( T2V2 by 0.14  out_in ) 
  trs::setlayer Y = geom_size ( X by 0.655  in_out ) 
  trs::setlayer Z = geom_inside (  T2V2 Y ) 
  trs::outputlayer ~geom_inside (  space (  Z < 0.25  adjacent < 90  point_touch region ) NODRC ) 
}

trs::rule T2V2_EN_2a_EN_2b {
trs::rule_comment T2V2 must be fully enclosed by T2M1.
trs::rule_comment Enclosed by $bottom_metal ($bottom_metal is Metal layer directly underneath T2V2) >= 0
trs::rule_comment Enclosed by $bottom_metal when $bottom_metal enclosure on one or both perpendicular directions< 0.05um ($bottom_metal is Metal layer directly underneath T2V2). >= 0.05
  trs::setlayer X = enc_rect ( ~geom_adjacent (  T2V2 $bottom_metal ) $bottom_metal adjacent < 90  outside_also correct 0  0.05  opposite 0  0.05  opposite ) 
  
  trs::setlayer A = extension (  "\[X\]" $bottom_metal < 0.05  opposite ) 
  trs::setlayer D1 = width (  A < 0.01  adjacent == 90  intersecting_only region ) 
  trs::outputlayer ~geom_inside (  D1 NODRC ) 

  trs::setlayer B = edge_coincident ( both_side  T2V2 $bottom_metal ) 
  trs::setlayer D2 = width (  B < 0.01  adjacent == 90  region ) 
  trs::outputlayer ~geom_inside (  D2 NODRC ) 

  trs::setlayer Y = extension (  T2V2 $bottom_metal < 0.05  opposite region ) 
  trs::setlayer C1 = edge_coincident ( both_side  T2V2 $bottom_metal ) 
  trs::setlayer C2 = edge_coincident ( both_side  T2V2 Y ) 
  trs::setlayer D3 = width (  C1 C2 < 0.01  adjacent == 90  region ) 
  trs::outputlayer ~geom_inside (  D3 NODRC ) 

  trs::outputlayer ~geom_inside (  geom_not (  T2V2 $bottom_metal ) NODRC ) 
}

trs::pvrs_block  {
#IFDEF OPEN_RECOMMENDED_ON YES 
}
trs::rule T2V2_EN_2a_R_EN_2b_R {
trs::rule_comment Recommended enclosure by Mn to avoid high Rc >= 0.05
trs::rule_comment Recommended enclosure by Mn for at least 2 opposite sides >= 0.08
   trs::setlayer X = enc_rect ( T2V2 $bottom_metal adjacent < 90  outside_also correct 0.05  0.08  opposite 0.05  0.08  opposite ) 
   copy ( X ) 
}

trs::pvrs_block  {
#ENDIF 
}

trs::rule T2V2_EN_4a_EN_4b {
trs::rule_comment T2V2 must be fully enclosed by T2M2.
trs::rule_comment Enclosed by T2M1  >= 0
trs::rule_comment Enclosed By T2M1 when T2M2 enclosure on one or both perpendicular directions< 0.05um. >= 0.05 
 trs::setlayer X = enc_rect ( T2V2 T2M2 adjacent < 90  outside_also correct 0  0.05  opposite 0  0.05  opposite ) 
   trs::setlayer A = extension (  X T2M2 < 0.05  opposite region ) 
   trs::outputlayer ~geom_inside (  A NODRC ) 

   trs::setlayer B = edge_coincident ( both_side  T2V2 T2M2 ) 
   trs::setlayer D2 = width (  B < 0.01  adjacent == 90  region ) 
   trs::outputlayer ~geom_inside (  D2 NODRC ) 

   trs::setlayer Y = extension (  T2V2 T2M2 < 0.05  opposite region ) 
   trs::setlayer C1 = edge_coincident ( both_side  T2V2 T2M2 ) 
   trs::setlayer C2 = edge_coincident ( both_side  T2V2 Y ) 
   trs::setlayer D3 = width (  C1 C2 < 0.01  adjacent == 90  region ) 
   trs::outputlayer ~geom_inside (  D3 NODRC ) 

  trs::outputlayer ~geom_inside (  geom_not (  T2V2 T2M2 ) NODRC ) 
}

trs::rule T2V2_R_1 {
trs::rule_comment There should be at least two square T2V2s space <= 0.4um for T2M1 and T2M2 connection when either or both T2M1 (T2M1 is Metal layer directly underneath T2V2) and T2M2 width is > 0.6um.
trs::setlayer T2V2_SQ_CHECK = geom_rectangle ( T2V2 ratio == 1  ) 
trs::setlayer T2V2_SQ_REG = space (  T2V2_SQ_CHECK <= 0.4  point_touch region ) 
trs::setlayer T2V2_SQ_CHECK_VIA = geom_interact (  T2V2_SQ_CHECK T2V2_SQ_REG ) 
trs::setlayer T2V2_SQ = geom_or (  T2V2_SQ_CHECK_VIA T2V2_SQ_REG ) 
trs::setlayer X1_Mn = geom_enclose (  $bottom_metal geom_with_width ( $bottom_metal > 0.6  ) ) 
trs::setlayer X1_T2M2 = geom_enclose (  T2M2 geom_with_width ( T2M2 > 0.6  ) ) 
trs::setlayer T2M2T2M1 = geom_and (  $bottom_metal T2M2 ) 
trs::setlayer X1 = geom_or (  X1_Mn X1_T2M2 ) 
trs::outputlayer geom_interact (  geom_interact (  T2M2T2M1 T2V2_SQ == 1  ) X1 ) 
}

trs::rule T2V2_R_2 {
trs::rule_comment There should be at least four square T2V2s in this T2M2 and T2M1 intersection area when either or both T2M1 (T2M1 is Metal layer directly underneath T2V2) and T2M2 width is > 1.4um.
trs::setlayer T2V2_SQ_CHECK = geom_rectangle ( T2V2 ratio == 1  ) 
trs::setlayer T2V2_SQ = geom_rectangle ( T2V2 ratio == 1  ) 
trs::setlayer T2V2_SQ_REG = space (  T2V2_SQ_CHECK <= 0.4  point_touch region ) 
trs::setlayer T2V2_SQ_CHECK_VIA = geom_interact (  T2V2_SQ_CHECK T2V2_SQ_REG ) 
trs::setlayer X1_Mn = geom_enclose (  $bottom_metal geom_with_width ( $bottom_metal > 1.4  ) ) 
trs::setlayer X1_T2M2 = geom_enclose (  T2M1 geom_with_width ( T2M2 > 1.4  ) ) 
trs::setlayer T2M2T2M1 = geom_and (  $bottom_metal T2M2 ) 
trs::setlayer X1 = geom_or (  X1_Mn X1_T2M2 ) 
trs::outputlayer geom_interact (  geom_interact (  T2M2T2M1 T2V2_SQ_CHECK_VIA < 4  ) X1 ) 
}

trs::rule T2V2_R_3 {
trs::rule_comment 45-dgree T2V2 is not allowed
trs::outputlayer edge_angle (  T2V2 == 45  ) 
}

trs::pvrs_block  {
#IFDEF OPEN_RECOMMENDED_ON YES 
}
trs::rule T2V2_R_4_R {
trs::rule_comment Recommended use redundant T2V2s as possible, DRC can help to flag single T2V2
trs::outputlayer geom_interact (  geom_and (  $bottom_metal T2M2 ) T2V2 == 1  ) 
}

trs::pvrs_block  {
#ENDIF 
}




#=============================
#  T2M2 - Top Metal T2M2 DRC
#=============================

group_rule GT2M2 T2M2_? 


trs::rule T2M2_W_1 {
trs::rule_comment Min T2M2 width, DRC waive check 89 to 90 degree widths in the DEUPAD and INDALL region. >= 0.20
  trs::setlayer X = geom_with_width ( geom_not (  T2M2 DEUPAD ) > 10  ) 
  trs::outputlayer ~geom_inside (  geom_not (  ~geom_interact (  X PA ) INDALL ) NODRC ) 
  trs::outputlayer ~geom_inside (  geom_not (  width (  T2M2 < 0.2  adjacent < 90  point_touch region ) INDALL ) NODRC ) 
  trs::outputlayer ~geom_inside (  geom_and (  width (  T2M2 < 0.2  adjacent < 89  point_touch region ) INDALL ) NODRC ) 
}

trs::rule T2M2_W_2 {
trs::rule_comment 45 dgree T2M2 width >= 0.39
trs::setlayer X = edge_angle (  T2M2 == 45  ) 
trs::outputlayer width (  X < 0.39  adjacent < 90  region ) 
}

trs::rule T2M2_W_3 {
trs::rule_comment Minimum T2M2 width adjoining a huge non-metal region \[ area > 2000000 um2\], non-metal region is defined as (NOT (T2M2 OR T2M2DUM)) >= 0.35um
  trs::setlayer NON_METAL_REG = geom_area  ( geom_not (  DRC:1 geom_or (  T2M2 T2M2DUM ) ) > 2000000  ) 
  trs::setlayer CHECK_REGION = geom_enclose_rectangle ( NON_METAL_REG 10  0.35  ) 
  trs::setlayer CHECK_METAL = geom_interact (  T2M2 CHECK_REGION ) 
  trs::outputlayer ~geom_inside (  width (  CHECK_METAL < 0.35  adjacent < 90  point_touch region ) NODRC ) 
}

trs::rule T2M2_S_1 {
trs::rule_comment Space between T2M2s,DRC waive check 89 to 90 degree spaces in the INDALL region  >= 0.20
  trs::outputlayer ~geom_inside (  geom_not (  space (  T2M2 < 0.20  adjacent < 90  point_touch region ) INDALL ) NODRC ) 
  trs::outputlayer ~geom_inside (  geom_and (  space (  T2M2 < 0.20  adjacent < 89  point_touch region ) INDALL ) NODRC ) 
}

trs::rule T2M2_S_2 {
trs::rule_comment Min Space between two T2M2s when one or both T2M2 width or length >= 0.39um, and the run length of two T2M2s is >= 1um. is 0.24
  Mn_2b T2M2ALL 1 0.39 0.24
}

trs::rule T2M2_S_3 {
trs::rule_comment Space between two T2M2s when one or both T2M1 width or length >= 1.5um, and the run length of two T2M2s is >= 1.5um >= 0.50 
  Mn_2b T2M2ALL 1.5 1.5 0.5
}

trs::rule T2M2_S_4 {
trs::rule_comment Space between two T2M2s when one or both T2M2 width or length >= 4.5um, and the run length of two T2M2s is >= 4.5um >= 1.50 
  Mn_2b T2M2ALL 4.5 4.5 1.5
}

trs::rule T2M2_S_5 {
trs::rule_comment Min Space between T2M2 metal lines with one or both are 45 degree bent metal lines >= 0.39
  trs::setlayer X = edge_angle (  T2M2 == 45  ) 
  trs::outputlayer ~geom_inside (  space (  X T2M2 < 0.39  adjacent < 90  region ) NODRC ) 
}


trs::rule T2M2_A_1 {
trs::rule_comment T2M2 area >= 0.14
  trs::outputlayer ~geom_inside (  geom_area  ( T2M2 < 0.14  ) NODRC ) 
}

trs::rule T2M2_A_2 {
trs::rule_comment T2M2 enclosed area >= 0.26
  trs::setlayer X = geom_not (  geom_holes ( T2M2 inner_most ) T2M2 ) 
  trs::outputlayer ~geom_inside (  geom_area  ( X < 0.26  ) NODRC ) 
}

trs::pvrs_block  {
#IFDEF Density_rules YES 
}
trs::rule T2M2_D_1_min {
trs::rule_comment T2M2 density (including dummy) in 100umX100um window with step size 200um is >= 10% and <= 80%. 
trs::rule_comment INDALL/FUTR/GRID/SRINGBLK covered areas are excluded for this rule checking. 
trs::rule_comment (Top metal bond pad areas can be waived.)
trs::rule_comment (Exclude Top metal bond pad areas and DEUPAD region)

trs::setlayer check_region_1 = ~geom_inside (  geom_not (  geom_not (  geom_not (  geom_not (  geom_not (  geom_not (  DRC:1 FUTR ) GRID ) SRINGBLK ) INDALL ) PA ) DEUPAD ) NODRC ) 
trs::setlayer check_region = geom_with_width ( check_region_1 >= 25  ) 
trs::setlayer check_pattern = geom_and (  T2M2ALLi check_region ) 
trs::setlayer err1_TMP1 = check_density ( check_pattern check_region "\[!AREA(check_region) + !!AREA(check_region)*AREA(check_pattern)/AREA(check_region)\]" < 0.1  by_window 100  delta 50  boundary_backup inside_of_layer DRC:1 in_polygon ) 

trs::setlayer check_window = geom_with_width ( geom_and (  err1_TMP1 check_region ) >= 25  ) 
trs::outputlayer check_density ( check_pattern check_window "\[!AREA(check_window) + !!AREA(check_window)*AREA(check_pattern)/AREA(check_window)\]" < 0.1  by_window 100  delta 50  boundary_backup inside_of_layer DRC:1 in_polygon output_log T2M2_D_1_min.log result_db \
T2M2_D_1_min.rdb ) 
}

trs::rule T2M2_D_1_max {
trs::rule_comment T2M2 density (including dummy) in 100umX100um window with step size 50um is >= 10% and <= 80%. 
trs::rule_comment INDALL/FUTR/GRID/SRINGBLK covered areas are excluded for this rule checking. 
trs::rule_comment (Top metal bond pad areas can be waived.)
trs::rule_comment (Exclude Top metal bond pad areas and DEUPAD region)

trs::setlayer check_region_1 = ~geom_inside (  geom_not (  geom_not (  geom_not (  geom_not (  geom_not (  geom_not (  DRC:1 FUTR ) GRID ) SRINGBLK ) INDALL ) PA ) DEUPAD ) NODRC ) 
trs::setlayer check_region = geom_with_width ( check_region_1 >= 25  ) 
trs::setlayer check_pattern = geom_and (  T2M2ALLi check_region ) 
trs::setlayer err1_TMP1 = check_density ( check_pattern check_region "\[!!AREA(check_region)*AREA(check_pattern)/AREA(check_region)\]" > 0.8  by_window 100  delta 50  boundary_backup inside_of_layer DRC:1 in_polygon ) 

trs::setlayer check_window = geom_with_width ( geom_and (  err1_TMP1 check_region ) >= 25  ) 
trs::outputlayer check_density ( check_pattern check_window "\[!!AREA(check_window)*AREA(check_pattern)/AREA(check_window)\]" > 0.8  by_window 100  delta 50  boundary_backup inside_of_layer DRC:1 in_polygon output_log T2M2_D_1_max.log result_db \
T2M2_D_1_max.rdb ) 

}


trs::rule T2M2_D_2 {
trs::rule_comment T4M1 density inside (T2M2dumb sizing up 2.5um) in 100umX100um window with step size 50um >= 10%  
  trs::setlayer CHECK_AREA = geom_size ( T2M2DUMB by 2.5  ) 
  trs::setlayer X1 = geom_not (  T2M2ALLi DEUPAD ) 
  trs::setlayer X = check_density ( X1 < 0.10  by_window 100  delta 50  boundary_backup inside_of_layer CHECK_AREA output_log density_report_T2M2_D_2.log ) 
  trs::setlayer Y = geom_or (  FUTR GRID SRINGBLK PA INDALL ) 
  trs::outputlayer ~geom_inside (  geom_not (  X Y ) NODRC ) 
}


trs::rule T2M2_D_3 {
trs::rule_comment T2M1 density difference in 100umX100um window <= 20%. 
trs::rule_comment INDALL/FUTR/GRID/SRINGBLK covered areas are excluded for this rule checking. 
  trs::setlayer X1 = geom_not (  T2M2ALLi DEUPAD ) 
  trs::setlayer X = check_density ( X1 > 0  by_window 100  check_gradient > 0.2  absolute_value boundary_backup inside_of_layer density_checkarea output_log density_report_T2M2_D_3.log ) 
  trs::setlayer Y = geom_or (  FUTR GRID SRINGBLK PA INDALL ) 
  trs::outputlayer ~geom_inside (  geom_not (  X Y ) NODRC ) 
}

trs::pvrs_block  {
#ENDIF 
}

trs::rule T2M2_R_1 {
trs::rule_comment T2M2 line end must be rectangular.
  trs::setlayer A = width (  T2M2 < 0.01  adjacent == 45  region ) 
  trs::setlayer B = space (  T2M2 < 0.01  adjacent == 45  region ) 
  trs::setlayer C = width (  T2M2 < 0.01  adjacent == 135  region ) 
  trs::setlayer D = space (  T2M2 < 0.01  adjacent == 135  region ) 
  trs::outputlayer ~geom_inside (  A NODRC ) 
  trs::outputlayer ~geom_inside (  B NODRC ) 
  trs::outputlayer ~geom_inside (  C NODRC ) 
  trs::outputlayer ~geom_inside (  D NODRC ) 
 }

}


#---------------------------------------------------------------------------------------------------------------------------------------------------

if { [set CHECK_T4V2] == 1 } {
 
#=======================
#  T4V2 - Top Via 2 DRC
#=======================


  set bottom_metal_list { T2M1 T4M1 M8 M7 M6 M5 M4 M3 }
  foreach bottom_metal $bottom_metal_list {
    set tmp CHECK_$bottom_metal
    set tem_v [set $tmp]
    if { $tem_v == 1 } break
    }

group_rule GT4V2 T4V2_? 

trs::rule T4V2_W_1 {
trs::rule_comment Fixed T4V2 size (square shape),exclude SRINGBLK and GRBLK region. >= 0.36,
  trs::outputlayer ~geom_inside (  geom_not (  ~geom_rectangle ( geom_not (  T4V2 GT4V2 ) == 0.36  by == 0.36  ) GRID ) geom_or (  SRINGBLK NODRC ) ) 
  trs::outputlayer ~geom_inside (  ~geom_rectangle ( geom_rectangle ( geom_and (  T4V2 GRID ) ) == 0.36  by == 0.36  ) geom_or (  SRINGBLK NODRC ) ) 
}

trs::rule T4V2_W_2 {
trs::rule_comment Fixed T4V2bar width  = 0.36,
trs::outputlayer geom_with_width ( T4V2bar < 0.36  ) 
trs::outputlayer geom_with_width ( T4V2bar > 0.36  ) 
}

trs::rule T4V2_S_1 {
trs::rule_comment Space between two T4V2s >= 0.34
  trs::outputlayer ~geom_inside (  space (  T4V2 < 0.34  adjacent < 90  point_touch region ) NODRC ) 
}

trs::rule T4V2_S_2 {
trs::rule_comment Space between T4V2s within array greater or equal to 3x3 (Two via regions whose space is <=0.56um are considered to be in the same array) is 0.5
trs::rule_comment NOTICE: It is a recommended rule.
  trs::setlayer X = geom_size ( T4V2 by 0.28  out_in ) 
  trs::setlayer Y = geom_size ( X by 0.855  in_out ) 
  trs::setlayer Z = geom_inside (  T4V2 Y ) 
  trs::outputlayer ~geom_inside (  space (  Z < 0.5  adjacent < 90  point_touch region ) NODRC ) 
}
 
trs::rule T4V2_EN_2_EN_3 {
trs::rule_comment Min $bottom_metal fully enclosure of T4V2 >= 0.01
trs::rule_comment Min $bottom_metal enclosure of T4V2 when T4M1 enclosure on one or both perpendicular directions < 0.05um. >= 0.05 

trs::setlayer X = enc_rect ( T4V2 $bottom_metal adjacent < 90  outside_also correct 0.01  opposite 0.05  opposite 0.01  opposite 0.05  opposite ) 

  trs::outputlayer ~geom_inside (  extension (  X $bottom_metal < 0.01  adjacent < 90  point_touch region overlapped outside_also ) NODRC ) 

  trs::setlayer Y = extension (  "\[X\]" $bottom_metal < 0.05  opposite ) 
  trs::outputlayer ~geom_inside (  width (  Y < 0.01  adjacent == 90  intersecting_only region ) NODRC ) 
  trs::outputlayer ~geom_inside (  geom_not (  T4V2 $bottom_metal ) NODRC ) 
}

trs::rule T4V2_EN_5_EN_6 {
trs::rule_comment Min T4V2 fully enclosure by T4M2  >= 0.02
  trs::outputlayer ~geom_inside (  extension (  T4V2 T4M2 < 0.02  adjacent < 90  point_touch region outside_also ) NODRC ) 
}

trs::pvrs_block  {
#IFDEF OPEN_RECOMMENDED_ON YES 
}
trs::rule T4V2_R_1_R {
trs::rule_comment There should be at least two square T4V2s at the intersection of Mn/T4M1/T2M1 and T4M2 when either metal width >= 0.5um,exclude SRINGBLK and GRBLK region.
trs::setlayer T4V2_SQ = geom_rectangle ( T4V2 ratio == 1  ) 
trs::setlayer "X1_${bottom_metal}" = geom_enclose (  "${bottom_metal}" geom_with_width ( "${bottom_metal}" >= 0.5  ) ) 
trs::setlayer X1_T4M2 = geom_enclose (  T4M2 geom_with_width ( T4M2 >= 0.5  ) ) 
trs::setlayer "${bottom_metal}T4M2" = geom_and (  "${bottom_metal}" T4M2 ) 
trs::setlayer X1 = geom_or (  "X1_${bottom_metal}" X1_T4M2 ) 
trs::outputlayer ~geom_inside (  geom_interact (  geom_interact (  "${bottom_metal}T4M2" T4V2_SQ == 1  ) X1 ) geom_or (  SRINGBLK GRBLK NODRC ) ) 
}
trs::pvrs_block  {
#ENDIF 
}

trs::rule T4V2_R_3 {
trs::rule_comment 45-dgree T4V2 is not allowed
trs::outputlayer edge_angle (  T4V2 == 45  ) 
}

trs::pvrs_block  {
#IFDEF OPEN_RECOMMENDED_ON YES 
}
trs::rule T4V2_R_4_R {
trs::rule_comment Recommended us redundant T4V2s as possible, DRC can help to flag single T4V2
trs::outputlayer geom_interact (  geom_and (  $bottom_metal T4M2 ) T4V2 == 1  ) 
}

trs::pvrs_block  {
#ENDIF 
}

#=========================
#  T4M2 - Top Metal 2 DRC
#=========================


group_rule GT4M2 T4M2_? 

trs::rule T4M2_W_1 {
trs::rule_comment T4M2 width ,DRC waive check 89 to 90 degree widths in the INDALL and DEUPAD region >= 0.40
trs::rule_comment T4M2 width <= 20
  trs::outputlayer ~geom_inside (  geom_not (  width (  T4M2 < 0.40  adjacent < 90  point_touch region ) INDALL ) NODRC ) 
  trs::outputlayer ~geom_inside (  geom_and (  width (  T4M2 < 0.40  adjacent < 89  point_touch region ) INDALL ) NODRC ) 
  trs::setlayer X = geom_with_width ( geom_not (  T4M2 DEUPAD ) > 20  ) 
  trs::outputlayer ~geom_inside (  geom_not (  ~geom_interact (  X PA ) INDALL ) NODRC ) 
}

trs::rule T4M2_S_1 {
trs::rule_comment Space between T4M2s DRC waive check 89 to 90 degree spaces in the INDALL region. >= 0.40,
  trs::outputlayer ~geom_inside (  geom_not (  space (  T4M2 < 0.40  adjacent < 90  point_touch region ) INDALL ) NODRC ) 
  trs::outputlayer ~geom_inside (  geom_and (  space (  T4M2 < 0.40  adjacent < 89  point_touch region ) INDALL ) NODRC ) 
}

trs::rule T4M2_S_2 {
trs::rule_comment Space between two T4M2s when one or both T4M2 width or length >= 2um, and the run length of two T4M2s is >= 2um.  >= 0.5
  Mn_2b T4M2ALL 2 2 0.5
}

trs::rule T4M2_A_1 {
trs::rule_comment T4M2 area >= 0.40
  trs::outputlayer ~geom_inside (  geom_area  ( T4M2 < 0.40  ) NODRC ) 
}

trs::rule T4M2_A_2 {
trs::rule_comment Enclosed area by T4M2 >= 0.6
  trs::setlayer X = geom_not (  geom_holes ( T4M2 inner_most ) T4M2 ) 
  trs::outputlayer ~geom_inside (  geom_area  ( X < 0.6  ) NODRC ) 
}


trs::pvrs_block  {
#IFDEF Density_rules YES 
}
trs::rule T4M2_D_1_min {
trs::rule_comment T4M2 density (including dummy) in 400umX400um window with step size 200um is >= 20% and <= 85%. 
trs::rule_comment INDALL/FUTR/GRID/SRINGBLK covered areas are excluded for this rule checking. 
trs::rule_comment Top metal bond pad areas and DEUPAD regions  can be waived.

  trs::setlayer X1 = geom_not (  T4M2ALLi DEUPAD ) 
  trs::setlayer X = check_density ( X1 < 0.20  by_window 400  delta 200  boundary_backup inside_of_layer density_checkarea output_log density_report_T4M2_D_1_min.log ) 
  trs::setlayer Y = geom_or (  geom_or (  geom_or (  INDALL FUTR ) GRID ) SRINGBLK ) 
  trs::outputlayer ~geom_inside (  geom_not (  X Y ) NODRC ) 


}

trs::rule T4M2_D_1_max {
trs::rule_comment T4M2 density (including dummy) in 400umX400um window with step size 200um is >= 20% and <= 85%. 
trs::rule_comment INDALL/FUTR/GRID/SRINGBLK covered areas are excluded for this rule checking. 
trs::rule_comment Top metal bond pad areas and DEUPAD regions can be waived.
 
trs::setlayer check_region_1 = ~geom_inside (  geom_not (  geom_not (  geom_not (  geom_not (  geom_not (  geom_not (  DRC:1 FUTR ) GRID ) SRINGBLK ) INDALL ) PA ) DEUPAD ) NODRC ) 
trs::setlayer check_region = geom_with_width ( check_region_1 >= 100  ) 
trs::setlayer check_pattern = geom_and (  T4M2ALLi check_region ) 
trs::setlayer err1_TMP1 = check_density ( check_pattern check_region "\[!!AREA(check_region)*AREA(check_pattern)/AREA(check_region)\]" > 0.85  by_window 400  delta 200  boundary_backup inside_of_layer DRC:1 in_polygon ) 

trs::setlayer check_window = geom_with_width ( geom_and (  err1_TMP1 check_region ) >= 100  ) 
trs::outputlayer check_density ( check_pattern check_window "\[!!AREA(check_window)*AREA(check_pattern)/AREA(check_window)\]" > 0.85  by_window 400  delta 200  boundary_backup inside_of_layer DRC:1 in_polygon output_log T4M2_7_h.log result_db \
T4M2_D_1_max.rdb ) 

}

trs::rule T4M2_D_2 {
trs::rule_comment T4M2 density inside (T4M2dumb sizing up 2.5um) in 100umX100um window with step size 50um >= 10%  
  trs::setlayer CHECK_AREA = geom_size ( T4M2DUMB by 2.5  ) 
  trs::setlayer X1 = geom_not (  T4M2ALLi DEUPAD ) 
  trs::setlayer X = check_density ( X1 < 0.10  by_window 100  delta 50  boundary_backup inside_of_layer CHECK_AREA output_log density_report_T4M2_D_2.log ) 
  trs::setlayer Y = geom_or (  FUTR GRID SRINGBLK PA INDALL ) 
  trs::outputlayer ~geom_inside (  geom_not (  X Y ) NODRC ) 
}


trs::rule T4M2_D_3 {
trs::rule_comment T4M2 density difference in 100umX100um window <= 20%. 
trs::rule_comment INDALL/FUTR/GRID/SRINGBLK covered areas are excluded for this rule checking. 
  trs::setlayer X1 = geom_not (  T4M2ALLi DEUPAD ) 
  trs::setlayer X = check_density ( X1 > 0  by_window 100  check_gradient > 0.2  absolute_value boundary_backup inside_of_layer density_checkarea output_log density_report_T4M2_D_3.log ) 
  trs::setlayer Y = geom_or (  FUTR GRID SRINGBLK PA INDALL ) 
  trs::outputlayer ~geom_inside (  geom_not (  X Y ) NODRC ) 
}

trs::pvrs_block  {
#ENDIF 
}

trs::rule T4M2_R_1 {
trs::rule_comment T4M2 line end must be rectangular.
  trs::setlayer A = width (  T4M2 < 0.01  adjacent == 45  region ) 
  trs::setlayer B = space (  T4M2 < 0.01  adjacent == 45  region ) 
  trs::setlayer C = width (  T4M2 < 0.01  adjacent == 135  region ) 
  trs::setlayer D = space (  T4M2 < 0.01  adjacent == 135  region ) 
  trs::outputlayer ~geom_inside (  A NODRC ) 
  trs::outputlayer ~geom_inside (  B NODRC ) 
  trs::outputlayer ~geom_inside (  C NODRC ) 
  trs::outputlayer ~geom_inside (  D NODRC ) 
   }

} 


if { [set CHECK_T8V1] == 1 } {
  
#=======================================
# T8V1  -  For RF product application
#=======================================

  set bottom_metal_list { M8 M7 M6 M5 M4 M3 }
  foreach bottom_metal $bottom_metal_list {
    set tmp CHECK_$bottom_metal
    set tem_v [set $tmp]
    if { $tem_v == 1 } break
    }

group_rule GT8V1 T8V1_? 

trs::rule T8V1_W_1 {
trs::rule_comment Fixed T8V1 size (square shape),exclude SRINGBLK and GRBLK area = 0.36
  trs::outputlayer ~geom_inside (  geom_not (  ~geom_rectangle ( geom_not (  T8V1 GT8V1 ) == 0.36  by == 0.36  ) GRID ) geom_or (  SRINGBLK NODRC ) ) 
  trs::outputlayer ~geom_inside (  ~geom_rectangle ( geom_rectangle ( geom_and (  T8V1 GRID ) ) == 0.36  by == 0.36  ) geom_or (  SRINGBLK NODRC ) ) 
}
trs::rule T8V1_W_2 {
trs::rule_comment Fixed T8V1bar width = 0.36
trs::outputlayer geom_with_width ( T8V1bar < 0.36  ) 
trs::outputlayer geom_with_width ( T8V1bar > 0.36  ) 
}

trs::rule T8V1_S_1 {
trs::rule_comment Space between T8V1s >= 0.34
  trs::outputlayer ~geom_inside (  space (  T8V1 < 0.34  adjacent < 90  point_touch region ) NODRC ) 
}

trs::rule T8V1_S_2 {
trs::rule_comment Space between T8V1s when array equal to or greater than 4x4(with space <=0.56um. >= 0.5
  trs::setlayer X = geom_size ( T8V1 by 0.28  out_in ) 
  trs::setlayer Y = geom_size ( X by 1.22  in_out ) 
  trs::setlayer Z = geom_inside (  T8V1 Y ) 
  trs::outputlayer ~geom_inside (  space (  Z < 0.5  adjacent < 90  point_touch region ) NODRC ) 
}

trs::rule T8V1_EN_2_EN_3 {
trs::rule_comment Enclosed by $bottom_metal  >= 0.01
trs::rule_comment Enclosed by $bottom_metal when $bottom_metal enclosure on perpendicular directions < 0.05um >= 0.05 

  trs::setlayer X = enc_rect ( T8V1 $bottom_metal adjacent < 90  outside_also correct 0.01  opposite 0.05  opposite 0.01  opposite 0.05  opposite ) 

  trs::outputlayer ~geom_inside (  extension (  X $bottom_metal < 0.01  adjacent < 90  point_touch overlapped outside_also region ) NODRC ) 

  trs::setlayer Y = extension (  "\[X\]" $bottom_metal < 0.05  opposite ) 
  trs::outputlayer ~geom_inside (  width (  Y < 0.01  adjacent == 90  intersecting_only region ) NODRC ) 
  trs::outputlayer ~geom_inside (  geom_not (  T8V1 $bottom_metal ) NODRC ) 
}
trs::rule T8V1_EN_5_EN_6 {
trs::rule_comment Enclosed by T8M1 >= 0.3
  trs::outputlayer ~geom_inside (  extension (  T8V1 T8M1 < 0.3  adjacent < 90  point_touch region outside_also ) NODRC ) 
}

trs::rule T8V1_R_1 {
trs::rule_comment There should be at least two square T8V1s at the intersection of Mn/T8M1  when either metal width >= 0.5um,exclude SRINGBLK and GRBLK area
trs::setlayer T8V1_SQ = geom_rectangle ( T8V1 ratio == 1  ) 
trs::setlayer "X1_${bottom_metal}" = geom_enclose (  "${bottom_metal}" geom_with_width ( "${bottom_metal}" >= 0.5  ) ) 
trs::setlayer X1_T8M1 = geom_enclose (  T8M1 geom_with_width ( T8M1 >= 0.5  ) ) 
trs::setlayer "${bottom_metal}T8M1" = geom_and (  "${bottom_metal}" T8M1 ) 
trs::setlayer X1 = geom_or (  "X1_${bottom_metal}" X1_T8M1 ) 
trs::outputlayer ~geom_inside (  geom_interact (  geom_interact (  "${bottom_metal}T8M1" T8V1_SQ == 1  ) X1 ) geom_or (  SRINGBLK GRBLK NODRC ) ) 
}


#=======================================
#  T8M1 - For RF product application
#=======================================


group_rule GT8M1 T8M1_? 

trs::rule T8M1_W_1 {
trs::rule_comment T8M1 metal width,DRC waive check 89 to 90 degree widths in the INDALL region >= 1.50
trs::rule_comment T8M1 width, except bond pad and INDALL and DEUPAD regions. <= 50
  trs::setlayer X = geom_with_width ( geom_not (  T8M1 DEUPAD ) > 50  ) 
  trs::outputlayer ~geom_inside (  geom_not (  ~geom_interact (  X PA ) INDALL ) NODRC ) 
  trs::outputlayer ~geom_inside (  geom_not (  width (  T8M1 < 1.50  adjacent < 90  point_touch region ) INDALL ) NODRC ) 
  trs::outputlayer ~geom_inside (  geom_and (  width (  T8M1 < 1.50  adjacent < 89  point_touch region ) INDALL ) NODRC ) 
}
trs::rule T8M1_S_1 {
trs::rule_comment Min Space between T8M1s is 1.5,DRC waive check 89 to 90 degree spaces in the INDALL region
  trs::outputlayer ~geom_inside (  geom_not (  space (  T8M1 < 1.50  adjacent < 90  point_touch region ) INDALL ) NODRC ) 
  trs::outputlayer ~geom_inside (  geom_and (  space (  T8M1 < 1.50  adjacent < 89  point_touch region ) INDALL ) NODRC ) 
}
trs::rule T8M1_S_2 {
trs::rule_comment Min Space between two T8M1s when one or both T8M1 width or length >= 16um, and the run length of two T8M1s >2um.  >= 2.0
  Mn_2b_SPECIAL T8M1ALL 2.001 16 2
}
trs::rule T8M1_S_3 {
trs::rule_comment Space between an Inductor T8M1 and other T8M1 (including Inductor T8M1) >= 30um
trs::rule_comment Inductor T8M1 definition: (INDALL AND T8M1)
  trs::outputlayer ~geom_inside (  space (  geom_and (  T8M1 INDALL ) geom_not (  T8M1 INDALL ) < 30  opposite region ) NODRC ) 
}
trs::rule T8M1_EX_1 {
trs::rule_comment INDID extention on T8M1, T8M1 CUT INDALL is not allowed  >= 15
  trs::outputlayer ~geom_inside (  extension (  geom_interact (  T8M1 INDALL ) INDALL < 15  opposite adjacent < 90  region ) NODRC ) 
  trs::outputlayer geom_cut (  T8M1 INDALL ) 
}
trs::rule T8M1_A_1 {
trs::rule_comment T8M1 Metal area >= 6.00
  trs::outputlayer ~geom_inside (  geom_area  ( T8M1 < 6  ) NODRC ) 
}
trs::rule T8M1_A_2 {
trs::rule_comment T8M1 enclosed area >= 6.0
  trs::setlayer X = geom_not (  geom_holes ( T8M1 inner_most ) T8M1 ) 
  trs::outputlayer ~geom_inside (  geom_area  ( X < 6  ) NODRC ) 
}

trs::pvrs_block  {
#IFDEF OPEN_RECOMMENDED_ON YES 
#IFDEF Density_rules YES 
}
trs::rule T8M1_D_1_R {
trs::rule_comment Recommend the average T8M1 density of whole chip is larger than 20% (including dummy patterns).
trs::rule_comment NOTICE: It is a recommended rule.
  trs::outputlayer ~geom_inside (  check_density ( T8M1ALLi < 0.2  output_log density_report_T8M1_D_1_R.log ) NODRC ) 
}
trs::pvrs_block  {
#ENDIF 
#ENDIF 
}
trs::pvrs_block  {
#IFDEF Density_rules YES 
}
trs::rule T8M1_D_2 {
trs::rule_comment T8M1 pattern density on the whole chip (including dummy patterns) <= 55%
  trs::outputlayer ~geom_inside (  check_density ( T8M1ALLi > 0.55  output_log density_report_T8M1_D_2.log ) NODRC ) 
}
trs::rule T8M1_D_3 {
trs::rule_comment T8M1 density (including dummy) in 400umX400um window with step size 200um <= 70%
trs::rule_comment (Exclude DEUPAD regions)
  trs::setlayer X = geom_not (  T8M1ALLi DEUPAD ) 
  trs::outputlayer ~geom_inside (  check_density ( X > 0.70  by_window 400  delta 200  boundary_backup output_log density_report_T8M1_D_3.log ) NODRC ) 
}
trs::pvrs_block  {
#ENDIF 
}

trs::rule T8M1_R_1 {
trs::rule_comment T8M1 line end must be rectangular.
  trs::setlayer A = width (  T8M1 < 0.01  adjacent == 45  region ) 
  trs::setlayer B = space (  T8M1 < 0.01  adjacent == 45  region ) 
  trs::setlayer C = width (  T8M1 < 0.01  adjacent == 135  region ) 
  trs::setlayer D = space (  T8M1 < 0.01  adjacent == 135  region ) 
  trs::outputlayer ~geom_inside (  A NODRC ) 
  trs::outputlayer ~geom_inside (  B NODRC ) 
  trs::outputlayer ~geom_inside (  C NODRC ) 
  trs::outputlayer ~geom_inside (  D NODRC ) 
   }

trs::pvrs_block  {
#IFDEF OPEN_RECOMMENDED_ON YES 
}

trs::rule T8M1_R_2 {
trs::rule_comment Both active and passive devices inside INDALL region are not allowed
  trs::setlayer Metal_res = geom_or (  geom_or (  geom_or (  geom_or (  geom_or (  geom_or (  geom_or (  geom_or (  geom_or (  M1R M2R ) M3R ) M4R ) M5R ) M6R ) M7R ) M8R ) T4M1R ) T8M1R ) 
  trs::setlayer X = geom_or (  geom_or (  geom_or (  geom_or (  geom_or (  geom_or (  geom_or (  DIODE "BJT" ) MOMLVS1 ) VARAJ ) PORES ) AARES ) NW1res ) Metal_res ) 
  trs::outputlayer ~geom_inside (  geom_and (  X INDALL ) NODRC ) 
}

trs::pvrs_block  {
#ENDIF 
}


}

if { [set CHECK_T8V2] == 1 } {
  
#=======================================
# T8V2  -  For RF product application
#=======================================

  set bottom_metal_list { T2M1 T4M1 T8M1 M8 M7 M6 M5 M4 M3}
  foreach bottom_metal $bottom_metal_list {
    set tmp CHECK_$bottom_metal
    set tem_v [set $tmp]
    if { $tem_v == 1 } break
    }

group_rule GT8V2 T8V2_? 

trs::rule T8V2_W_1 {
trs::rule_comment Fixed T8V2 size (square shape) is 0.36,exclude SRINGBLK and GRBLK area
  trs::outputlayer ~geom_inside (  geom_not (  ~geom_rectangle ( geom_not (  T8V2 GT8V2 ) == 0.36  by == 0.36  ) GRID ) geom_or (  SRINGBLK NODRC ) ) 
  trs::outputlayer ~geom_inside (  ~geom_rectangle ( geom_rectangle ( geom_and (  T8V2 GRID ) ) == 0.36  by == 0.36  ) geom_or (  SRINGBLK NODRC ) ) 
}
trs::rule T8V2_W_2 {
trs::rule_comment Fixed T8V2bar width = 0.36
trs::outputlayer geom_with_width ( T8V2bar < 0.36  ) 
trs::outputlayer geom_with_width ( T8V2bar > 0.36  ) 
}
trs::rule T8V2_S_1 {
trs::rule_comment Space between T8V2s >= 0.34
  trs::outputlayer ~geom_inside (  space (  T8V2 < 0.34  adjacent < 90  point_touch region ) NODRC ) 
}

trs::rule T8V2_S_2 {
trs::rule_comment Space between T8V2s when array equal to or greater than 4x4. >= 0.5
trs::rule_comment (Two via regions whose space is <=0.56um are considered to be in the same array.)
  trs::setlayer X = geom_size ( T8V2 by 0.28  out_in ) 
  trs::setlayer Y = geom_size ( X by 1.22  in_out ) 
  trs::setlayer Z = geom_inside (  T8V2 Y ) 
  trs::outputlayer ~geom_inside (  space (  Z < 0.5  adjacent < 90  point_touch region ) NODRC ) 
}

trs::rule T8V2_EN_2_EN_3 {
trs::rule_comment Enclosed by $bottom_metal >= 0.01
trs::rule_comment Enclosed by $bottom_metal when $bottom_metal enclosure on perpendicular directions < 0.05um. >= 0.05 

  trs::setlayer X = enc_rect ( T8V2 $bottom_metal adjacent < 90  outside_also correct 0.01  opposite 0.05  opposite 0.01  opposite 0.05  opposite ) 

  trs::outputlayer ~geom_inside (  extension (  X $bottom_metal < 0.01  adjacent < 90  point_touch overlapped outside_also region ) NODRC ) 

  trs::setlayer Y = extension (  "\[X\]" $bottom_metal < 0.05  opposite ) 
  trs::outputlayer ~geom_inside (  width (  Y < 0.01  adjacent == 90  intersecting_only region ) NODRC ) 
  trs::outputlayer ~geom_inside (  geom_not (  T8V2 $bottom_metal ) NODRC ) 
}
trs::rule T8V2_EN_5_6 {
trs::rule_comment Enclosed by T8M2 >= 0.3
trs::rule_comment T8V2 must be fully covered by T8M2 where is the metal layer directly above T8V2
  trs::outputlayer ~geom_inside (  extension (  T8V2 T8M2 < 0.3  adjacent < 90  point_touch region outside_also ) NODRC ) 
  trs::outputlayer geom_not (  T8V2 T8M2 ) 
}
trs::rule T8V2_R_1 {
trs::rule_comment There should be at least two square T8V2s at the intersection of T8M2/T8M1  when either metal width >= 0.5um,exclude SRINGBLK and GRBLK area
trs::setlayer T8V2_SQ = geom_rectangle ( T8V2 ratio == 1  ) 
trs::setlayer "X1_${bottom_metal}" = geom_enclose (  "${bottom_metal}" geom_with_width ( "${bottom_metal}" >= 0.5  ) ) 
trs::setlayer X1_T8M2 = geom_enclose (  T8M2 geom_with_width ( T8M2 >= 0.5  ) ) 
trs::setlayer "${bottom_metal}T8M2" = geom_and (  "${bottom_metal}" T8M2 ) 
trs::setlayer X1 = geom_or (  "X1_${bottom_metal}" X1_T8M2 ) 
trs::outputlayer ~geom_inside (  geom_interact (  geom_interact (  "${bottom_metal}T8M2" T8V2_SQ == 1  ) X1 ) geom_or (  SRINGBLK GRID NODRC ) ) 
}

#=======================================
#  T8M2 - For RF product application
#=======================================


group_rule GT8M2 T8M2_? 

trs::rule T8M2_1 {
trs::rule_comment T8M2 metal width,DRC waive check 89 to 90 degree widths in the INDALL region. >= 1.50
trs::rule_comment T8M2 width, except bond pad and INDALL and DEUPAD regions. <= 50
  trs::setlayer X = geom_with_width ( geom_not (  T8M2 DEUPAD ) > 50  ) 
  trs::outputlayer ~geom_inside (  geom_not (  ~geom_interact (  X PA ) INDALL ) NODRC ) 
  trs::outputlayer ~geom_inside (  geom_not (  width (  T8M2 < 1.50  adjacent < 90  point_touch region ) INDALL ) NODRC ) 
  trs::outputlayer ~geom_inside (  geom_and (  width (  T8M2 < 1.50  adjacent < 89  point_touch region ) INDALL ) NODRC ) 

}
trs::rule T8M2_S_1 {
trs::rule_comment Space between T8M2s,DRC waive check 89 to 90 degree spaces in the INDALL region  >= 1.5
  trs::outputlayer ~geom_inside (  geom_not (  space (  T8M2 < 1.50  adjacent < 90  point_touch region ) INDALL ) NODRC ) 
  trs::outputlayer ~geom_inside (  geom_and (  space (  T8M2 < 1.50  adjacent < 89  point_touch region ) INDALL ) NODRC ) 
}
trs::rule T8M2_S_2 {
trs::rule_comment Min Space between two T8M2s when one or both T8M2 width or length >= 16um, and the run length of two T8M2s >2um.  >= 2.0 
  Mn_2b_SPECIAL T8M2ALL 2.001 16 2
}
trs::rule T8M2_S_3 {
trs::rule_comment Space between an Inductor T8M2 and other T8M2 (including Inductor T8M2). >= 30
trs::rule_comment Inductor T8M2 definition: (INDALL AND T8M2)
  trs::outputlayer ~geom_inside (  space (  geom_and (  T8M2 INDALL ) geom_not (  T8M2 INDALL ) < 30  opposite region ) NODRC ) 
}
trs::rule T8M2_EX_1 {
trs::rule_comment INDALL extension on T8M2, T8M2 CUT INDALL is not allowed >= 15
  trs::outputlayer ~geom_inside (  extension (  geom_interact (  T8M2 INDALL ) INDALL < 15  opposite adjacent < 90  region ) NODRC ) 
  trs::outputlayer geom_cut (  T8M2 INDALL ) 
}
trs::rule T8M2_A_1 {
trs::rule_comment T8M2 area >= 6.00
  trs::outputlayer ~geom_inside (  geom_area  ( T8M2 < 6  ) NODRC ) 
}
trs::rule T8M2_A_2 {
trs::rule_comment T8M2 enclosed  area >= 6.0
  trs::setlayer X = geom_not (  geom_holes ( T8M2 inner_most ) T8M2 ) 
  trs::outputlayer ~geom_inside (  geom_area  ( X < 6  ) NODRC ) 
}
trs::pvrs_block  {
#IFDEF OPEN_RECOMMENDED_ON YES 
#IFDEF Density_rules YES 
}
trs::rule T8M2_D_1_R {
trs::rule_comment Recommend the average T8M2 density of whole chip is larger than 20% (including dummy patterns), otherwise ICsprout would help to add dummy patterns.
trs::rule_comment NOTICE: It is a recommended rule.
  trs::outputlayer ~geom_inside (  check_density ( T8M2ALLi < 0.2  output_log density_report_T8M2_D_1_R.log ) NODRC ) 
}
trs::pvrs_block  {
#ENDIF 
#ENDIF 
}

trs::pvrs_block  {
#IFDEF Density_rules YES 
}
trs::rule T8M2_D_2 {
trs::rule_comment Max T8M2 pattern density on the whole chip (including dummy patterns) is 55%
  trs::outputlayer ~geom_inside (  check_density ( T8M2ALLi > 0.55  output_log density_report_T8M2_D_2.log ) NODRC ) 
}
trs::rule T8M2_D_3 {
trs::rule_comment Max. T8M2 density (including dummy) in 400umX400um window with step size 200um is 70%
trs::rule_comment (Exclude DEUPAD regions)
  trs::setlayer X = geom_not (  T8M2ALLi DEUPAD ) 
  trs::outputlayer ~geom_inside (  check_density ( X > 0.70  by_window 400  delta 200  boundary_backup output_log density_report_T8M2_D_3.log ) NODRC ) 
}
trs::pvrs_block  {
#ENDIF 
}

trs::rule T8M2_R_2 {
trs::rule_comment Both active and passive devices inside INDALL region are not allowed
  trs::setlayer Metal_res = geom_or (  geom_or (  geom_or (  geom_or (  geom_or (  geom_or (  geom_or (  geom_or (  geom_or (  M1R M2R ) M3R ) M4R ) M5R ) M6R ) M7R ) M8R ) T4M1R ) T8M2R ) 
  trs::setlayer X = geom_or (  geom_or (  geom_or (  geom_or (  geom_or (  geom_or (  geom_or (  DIODE "BJT" ) MOMLVS1 ) VARAJ ) PORES ) AARES ) NW1res ) Metal_res ) 
  trs::outputlayer ~geom_inside (  geom_and (  X INDALL ) NODRC ) 
}

trs::rule T8M2_R_1 {
trs::rule_comment T8M2 line end must be rectangular.
  trs::setlayer A = width (  T8M2 < 0.01  adjacent == 45  region ) 
  trs::setlayer B = space (  T8M2 < 0.01  adjacent == 45  region ) 
  trs::setlayer C = width (  T8M2 < 0.01  adjacent == 135  region ) 
  trs::setlayer D = space (  T8M2 < 0.01  adjacent == 135  region ) 
  trs::outputlayer ~geom_inside (  A NODRC ) 
  trs::outputlayer ~geom_inside (  B NODRC ) 
  trs::outputlayer ~geom_inside (  C NODRC ) 
  trs::outputlayer ~geom_inside (  D NODRC ) 
   }

}



#//=====================================              
#//  CB -  Passivation One Rules DRC
#//===================================== 

group_rule GCB CB_? 

trs::rule CB_W_1 {
trs::rule_comment CB width  >= 3.0um
 trs::outputlayer ~geom_inside (  geom_not (  width (  PA < 3 - 0.001  adjacent < 90  point_touch region ) INDALL ) NODRC ) 
 trs::outputlayer ~geom_inside (  geom_and (  width (  PA < 3 - 0.001  adjacent < 90  point_touch region ) INDALL ) NODRC ) 
}
trs::rule CB_S_1 {
trs::rule_comment Space between two CBs >= 5.0um
 trs::outputlayer ~geom_inside (  geom_not (  space (  PA < 5  adjacent < 90  point_touch region ) INDALL ) NODRC ) 
 trs::outputlayer ~geom_inside (  geom_and (  space (  PA < 5 - 0.002  adjacent < 90  point_touch region ) INDALL ) NODRC ) 
}
trs::rule CB_EN_1_EN_2 {
trs::rule_comment CB edge fully enclosure by T4M1 or T2M1 or T8M1, T4M2 or T2M2 or T8M2 directly underneath PA >= 1.5um
 trs::outputlayer ~geom_inside (  geom_not (  extension (  PA geom_or (  T2M1 T4M1 T8M1 T4M2 T2M2 T8M2 ) < 1.50  adjacent < 90  point_touch region outside_also ) INDALL ) NODRC ) 
 trs::outputlayer ~geom_inside (  geom_and (  extension (  PA geom_or (  T2M1 T4M1 T8M1 T4M2 T2M2 T8M2 ) < 1.50 - 0.002  adjacent < 90  point_touch region outside_also ) INDALL ) NODRC ) 
}

trs::pvrs_block  {
//===============================
// RV -  RDL via design rules
//===============================
group_rule ( GRV RV_?  ) 

RDV_Fuse = geom_or (  RDLVF GRDLV ) 


RULE RV_W_1 { 
; Fixed RDL Via width and length = 3.0um

~geom_rectangle ( 
geom_not (  
geom_not (  RDLVIA RDV_Fuse ) GRID ) == 3  by == 3  ) 
}
RULE RV_S_1 { 
; Space between two RDL vias >= 3.0um

~geom_inside (  
space (  
geom_not (  RDLVIA RDV_Fuse ) < 3  adjacent < 90  point_touch region ) NODRC ) 
}
RULE RV_S_2 { 
; Space between RDL via and CB >= 6.0um

~geom_inside (  
geom_not (  
space (  RDLVIA PA < 6  adjacent < 90  point_touch region ) INDALL ) NODRC ) 
}
RULE RV_EN_1_2 { 
; RDL via enclosure by T4M2 or other metal layer directly underneath RV >= 1.5um

X11 = extension (  geom_not (  RDLVIA RDV_Fuse ) geom_or (  T4M2 T2M2 T8M2 ) < 1.50  adjacent < 90  point_touch region overlapped outside_also ) 
~geom_inside (  geom_not (  geom_not (  X11 LOGO ) GRID ) NODRC ) 
}
RULE RV_EN_3_4 { 
; RDL via enclosure by RDL >= 1.5um

X11 = extension (  geom_not (  RDLVIA RDV_Fuse ) RDL < 1.50  adjacent < 90  point_touch region overlapped outside_also ) 
~geom_inside (  ~geom_inside (  geom_not (  X11 LOGO ) geom_or (  SRINGBLK FUTR GRID ) ) NODRC ) 
geom_not (  RDLVIA RDL ) 
}

RULE RV_R_1 { 
; Recommended us redundant RVs as possible, DRC can help to flag single RV

geom_interact (  
geom_and (  
geom_or (  T4M2 T2M2 T8M2 ) RDL ) RDLVIA == 1  ) 
}
//==================================================             
//  RDL -  Al RDL (re-distribution layer) Rules DRC
//================================================== 
group_rule ( GRDL RDL_?  ) 

RULE RDL_W_1 { 
; RDL Width >= 3.0um
; RDL width <= 35um
~geom_inside (  geom_not (  width (  RDL < 3  adjacent < 90  point_touch region ) INDALL ) NODRC ) 
~geom_inside (  geom_and (  width (  RDL < 3 - 0.002  adjacent < 90  point_touch region ) INDALL ) NODRC ) 
~geom_inside (  geom_not (  geom_with_width ( RDL > 35  ) INDALL ) NODRC ) 
}
RULE RDL_S_1 { 
; Space between two (RDL OR ALPAD) >= 2.0um

~geom_inside (  
geom_not (  
space (  ALPA < 2  adjacent < 89.9  point_touch region ) INDALL ) NODRC ) 
~geom_inside (  geom_and (  space (  ALPA < 2 - 0.002  adjacent < 89.9  point_touch region ) INDALL ) NODRC ) 
}
RULE RDL_S_2 { 
; Space between (RDL OR ALPAD) with one or both (RDL OR ALPAD) width larger than 10um >= 3.0um

X1 = edge_coincident ( both_side  geom_with_width ( ALPA > 10  ) ALPA ) 
~geom_inside (  geom_not (  space (  X1 ALPA < 3  region ) INDALL ) NODRC ) 
X2 = edge_coincident ( both_side  geom_with_width ( ALPA > 10  ) ALPA ) 
~geom_inside (  geom_and (  space (  X2 ALPA < 3 - 0.002  region ) INDALL ) NODRC ) 
}
RULE RDL_S_3 { 
; Space between (RDL OR ALPAD) with one or both (RDL OR ALPAD) width larger than 35um >= 5.0um

X1 = edge_coincident ( both_side  geom_with_width ( ALPA > 35  ) ALPA ) 
~geom_inside (  geom_not (  space (  X1 ALPA < 5  region ) INDALL ) NODRC ) 
X2 = edge_coincident ( both_side  geom_with_width ( ALPA > 35  ) ALPA ) 
~geom_inside (  geom_and (  space (  X2 ALPA < 5 - 0.002  region ) INDALL ) NODRC ) 
}
RULE RDL_EN_1 { 
; ALPAD must fully enclosure of Cover

geom_not (  RDLPA2 ALPA ) 
}

RULE RDL_EN_2 { 
; ALPA must fully enclosure of CB

geom_not (  CBi ALPAD ) 
}
}

trs::pvrs_block  {
//=====================================              
//  COVER -  Passivation Two Rules DRC
//===================================== 
group_rule ( GCOVER COVER_?  ) 
}

trs::rule COVER_W_1 {
trs::rule_comment COVER width (suggest to consult with package vendor) >= 40.0um
   trs::outputlayer ~geom_inside (  geom_not (  width (  RDLPA2 < 40 - 0.002  adjacent < 90  point_touch region ) INDALL ) geom_or (  SRBLK SRINGBLK NODRC ) ) 
   trs::outputlayer ~geom_inside (  geom_and (  width (  RDLPA2 < 40 - 0.002  adjacent < 90  point_touch region ) INDALL ) geom_or (  SRBLK SRINGBLK NODRC ) ) 
}

trs::rule COVER_L_1 {
trs::rule_comment COVER length (suggest to consult with package vendor) >= 65.0um
  trs::outputlayer ~geom_inside (  ~geom_enclose_rectangle ( RDLPA2 40  65  ) geom_or (  SRBLK SRINGBLK NODRC ) ) 
}

trs::rule COVER_S_1 {
trs::rule_comment Covers space (suggest to consult with package vendor) >= 5.0um
   trs::outputlayer ~geom_inside (  geom_not (  space (  RDLPA2 < 5 - 0.002  adjacent < 90  point_touch region ) INDALL ) geom_or (  SRBLK SRINGBLK NODRC ) ) 
   trs::outputlayer ~geom_inside (  geom_and (  space (  RDLPA2 < 5 - 0.002  adjacent < 90  point_touch region ) INDALL ) geom_or (  SRBLK SRINGBLK NODRC ) ) 
}

trs::rule COVER_S_2 {
trs::rule_comment Space between metal pad and metal line  >= 2.5um
   trs::setlayer RDLLINE = geom_with_width ( ALPA < 35  ) 
   trs::setlayer RDLPAD = geom_not (  ALPA RDLLINE ) 
   trs::outputlayer ~geom_inside (  geom_not (  space (  RDLPAD RDLLINE < 2.5  adjacent < 90  point_touch region ) INDALL ) NODRC ) 
   trs::outputlayer ~geom_inside (  geom_and (  space (  RDLPAD RDLLINE < 2.5 - 0.002  adjacent < 90  point_touch region ) INDALL ) NODRC ) 
}

trs::pvrs_block  {
RULE COVER_EN_1 { 
; Cover enclosed by ALPAD >= 1.5um

~geom_inside (  
geom_not (  
extension (  RDLPA2 ALPA < 1.5  adjacent < 90  point_touch region ) INDALL ) NODRC ) 
~geom_inside (  geom_and (  extension (  RDLPA2 ALPA < 1.5 - 0.002  adjacent < 90  point_touch region ) INDALL ) NODRC ) 
}
}


trs::pvrs_block  {
#IFDEF CHIPEDGE_CHECK YES 
}
#//==================
#//  Chip Edge  Rules
#//==================

group_rule GCHIPEDGE CHIPEDGE_? 

trs::setlayer BD_EXTENT = geom_get_layout_boundary ( original_layer ) 
trs::setlayer BD_EXTENT_OTHER = geom_get_layout_boundary ( original_layer ignore_layer CHIPBLK ) 
trs::setlayer BD_OTHER_OUTSIDE = geom_not (  BD_EXTENT_OTHER CHIPEDGE ) 

trs::setlayer MS_OUT_TEMP1 = geom_or (  geom_or (  geom_or (  geom_or (  geom_or (  geom_or (  geom_or (  geom_and (  M1i SRINGBLK ) geom_and (  M2i SRINGBLK ) ) geom_and (  M3i SRINGBLK ) ) geom_and (  M4i SRINGBLK ) ) geom_and (  M5i SRINGBLK ) ) geom_and (  M6i SRINGBLK ) ) geom_and (  M7i SRINGBLK ) ) geom_and (  M8i SRINGBLK ) ) 
trs::setlayer MS_OUT_TEMP2 = geom_or (  geom_or (  geom_and (  T4M1i SRINGBLK ) geom_and (  T4M2i SRINGBLK ) ) geom_and (  RDLi SRINGBLK ) ) 
trs::setlayer MS_OUT = geom_or (  MS_OUT_TEMP1 MS_OUT_TEMP2 ) 

trs::rule CHIPEDGE_EN_1 {
trs::rule_comment Border layer must enclose all chip layout patterns (all chip design, excluding SRINGBLK, SRBLK marking layer)
trs::rule_comment This rule is not applicable if customers insert seal ring by themselves
trs::rule_comment This rule checking layer are DNW, ACT, NW1, PSUB, NVT3, PVT3, NVT1, PVT1, DGOX, TGOX, PO, NP, PP, NPR, HRP, ESD1, SAB, CT, Mn(n = 1-8), Vn(n = 1-7), T4V1, T4V2, T4M1, T4M2, T2V1, T2V2, T2M1, T2M2, PA, RV, BCB2, RDL, FUSE, ACTDUM, PODUM, MnDUM(n = 1-8), T4M1DUM, T4M2DUM, T2M1DUM, T2M2DUM. >= 0.37um

trs::setlayer BD_EXTENT_OTHER_temp = geom_get_layout_boundary ( DNWi ACTi NW1i PSUBi NVT3 PVT3 NVT1 PVT1 DGOX TGOX POLYi NPi \
PPi NPR HRPi ESD1 SABi CTi CTbar MET1o MET2o MET3o MET4o MET5o \
MET6o MET7o MET8o VIA1i VIA2i VIA3i VIA4i VIA5i VIA6i VIA7i VIA1bar VIA2bar \
VIA3bar VIA4bar VIA5bar VIA6bar VIA7bar T4V1i T4V2i T4V1bar T4V2bar T4M1o T4M2o T2V1i \
T2V2i T2V1bar T2V2bar T2M1o T2M2o T8V1i T8V2i T8V1bar T8V2bar T8M1o T8M2o CBi \
RV COVER RDLi FUTR ACTdmi POLYdmi MET1dmi MET2dmi MET3dmi MET4dmi MET5dmi MET6dmi \
MET7dmi MET8dmi T4M1dmi T4M2dmi T2M1dmi T2M2dmi T8M1dmi T8M2dmi ignore_layer CHIPBLK SRINGBLK SRBLK ) 
trs::outputlayer ~geom_inside (  extension (  BD_EXTENT_OTHER_temp CHIPEDGE < 0.37  adjacent < 90  point_touch region ) NODRC ) 
}

trs::rule CHIPEDGE_EN_2 {
trs::rule_comment Enclosure of DNW by the chip edge (CHIPEDGE layer) if it need ICsprout to add seal ring. >= 6.0um
trs::outputlayer ~geom_inside (  extension (  DNW CHIPEDGE < 6  adjacent < 90  point_touch region ) NODRC ) 
}

trs::rule CHIPEDGE_EN_3 {
trs::rule_comment Enclosure of seal ring outer ring outline edge by CHIPEDGE layer if seal ring has been added by designers. >= 1.5
trs::outputlayer ~geom_inside (  extension (  MS_OUT CHIPEDGE < 1.5  adjacent < 90  point_touch region ) NODRC ) 
}
trs::rule CHIPEDGE_R_3 {
trs::rule_comment CHIPEDGE layer size should exactly same as chip window size in tape out information file
 trs::outputlayer geom_xor (  CHIP CHIPEDGE ) 
}
trs::pvrs_block  {
#ENDIF 
}


trs::pvrs_block  {
//===========================
//   ACTres - ACT Resistor DRC
//===========================
group_rule ( GRACTres ACTres_?  ) 

AAR_SA = geom_and (  AAR SAB ) 
AAR_NS = ~geom_interact (  AAR SAB ) 


RULE ACTres_W_1 { 
; Non-silicide ACT resistor width, and it is suggest that ACT resistor length/width ratio >1 for stable Rs  >= 0.4um

X = geom_and (  geom_and (  AARES AA ) SAB ) 
L = edge_inside (  X AA ) 
~edge_inside (  edge_length (  L < 0.4  ) NODRC ) 
}

RULE ACTres_S_1_NP { 
; Space between non-silicide ACT resistors area and other implant region >= 0.18um

X = ~geom_interact (  SDN AARES ) 
~geom_inside (  space (  X AAR_SA < 0.18  adjacent < 90  region ) NODRC ) 
}
RULE ACTres_S_1_PP { 
; Space between non-silicide ACT resistors area and other implant region >= 0.18um

X = ~geom_interact (  SDP AARES ) 
~geom_inside (  space (  X AAR_SA < 0.18  adjacent < 90  region ) NODRC ) 
}
RULE ACTres_S_1_NVT3 { 
; Space between non-silicide ACT resistors area and other implant region >= 0.18um

X = ~geom_interact (  HVTN AARES ) 
~geom_inside (  space (  X AAR_SA < 0.18  adjacent < 90  region ) NODRC ) 
}
RULE ACTres_S_1_PVT3 { 
; Space between non-silicide ACT resistors area and other implant region >= 0.18um

X = ~geom_interact (  HVTP AARES ) 
~geom_inside (  space (  X AAR_SA < 0.18  adjacent < 90  region ) NODRC ) 
}
RULE ACTres_S_1_NVT1 { 
; Space between non-silicide ACT resistors area and other implant region >= 0.18um

X = ~geom_interact (  LVTN AARES ) 
~geom_inside (  space (  X AAR_SA < 0.18  adjacent < 90  region ) NODRC ) 
}
RULE ACTres_S_1_PVT1 { 
; Space between non-silicide ACT resistors area and other implant region >= 0.18um

X = ~geom_interact (  LVTP AARES ) 
~geom_inside (  space (  X AAR_SA < 0.18  adjacent < 90  region ) NODRC ) 
}
RULE ACTres_S_1_ESD { 
; Space between non-silicide ACT resistors area and other implant region >= 0.18um

X = ~geom_interact (  ESD1 AARES ) 
~geom_inside (  space (  X AAR_SA < 0.18  adjacent < 90  region ) NODRC ) 
}
RULE ACTres_S_1_HRP { 
; Space between non-silicide ACT resistors area and other implant region >= 0.18um

X = ~geom_interact (  HRP AARES ) 
~geom_inside (  space (  X AAR_SA < 0.18  adjacent < 90  region ) NODRC ) 
}
RULE ACTres_S_2 { 
; Space between SAB and CT for non-silicide ACT resistor = 0.21um

X = geom_and (  AAR SAB ) 
Y = geom_and (  CT geom_interact (  AAR SAB ) ) 
~geom_inside (  ~geom_adjacent (  geom_size ( Y by 0.21  ) AAR_SA ) NODRC ) 
}
RULE ACTres_EN_1 { 
; PP/NP enclosure of resistor ACT >= 0.18um

X = geom_or (  SDP SDN ) 
~geom_inside (  extension (  geom_and (  AA AARES ) X < 0.18  adjacent < 90  point_touch region ) NODRC ) 
}
RULE ACTres_EX_1 { 
; Extension of AARES outside of non-silicide ACT resistor area >= 0.2um

~geom_inside (  
extension (  AAR_SA AARES < 0.2  adjacent < 90  point_touch region ) NODRC ) 
}

RULE ACTres_R_1 { 
; Non-silicide ACT resistor region should be covered by SAB and implanted by NP or PP

X = geom_interact (  AAR SAB ) 
~geom_inside (  geom_not (  X geom_or (  SDN SDP ) ) NODRC ) 
}
RULE ACTres_R_2 { 
; Non-silicide ACT resistor with PP must be inside NW1

AARES_SAB = geom_and (  geom_and (  AARES AA ) SAB ) 
~geom_inside (  ~geom_inside (  geom_and (  AARES_SAB SDP ) NW ) NODRC ) 
}
RULE ACTres_R_3 { 
; It is not allowed dog-bone design at the end of ACT resistor for contact pick-up

X = geom_interact (  AAR SAB ) 
~edge_inside (  edge_convex_point ( X == 1  ) NODRC ) 
}

RULE ACTres_R_4 { 
; For Silicide ACT resistor, two sides of ACTRES must be along the CT edge

X = geom_and (  CT AAR_NS ) 
Y = edge_inside (  ~geom_interact (  AARES SAB ) AA ) 
~edge_inside (  ~edge_adjacent ( both_side  Y X ) NODRC ) 
}
}


trs::pvrs_block  {
//====================
//  NW1res_ACT Rules
//====================
group_rule ( GRNW1res_ACT NW1res_ACT_?  ) 

RULE NW1res_ACT_W_1 { 
; NW1-Resistor width,and suggest NW1 resistor length/width ratio > 5,length >= 20um for SPICE simulation accuracy >= 1.8 um

X = geom_and (  geom_and (  geom_and (  NW1res AA ) NW ) SAB ) 
~edge_inside (  edge_length (  edge_inside (  X NW ) < 1.8  ) NODRC ) 
}

RULE NW1res_ACT_S_1 { 
; Space between NW1 of NW1 resistors and un-related implant region >= 0.60um

X = geom_interact (  NWR geom_holes ( SAB ) ) 
~geom_inside (  space (  X ~geom_interact (  NW NWR ) < 0.6  adjacent < 90  point_touch region ) NODRC ) 
~geom_inside (  space (  X ~geom_interact (  HVTN NWR ) < 0.6  adjacent < 90  point_touch region ) NODRC ) 
~geom_inside (  space (  X ~geom_interact (  HVTP NWR ) < 0.6  adjacent < 90  point_touch region ) NODRC ) 
~geom_inside (  space (  X ~geom_interact (  LVTN NWR ) < 0.6  adjacent < 90  point_touch region ) NODRC ) 
~geom_inside (  space (  X ~geom_interact (  LVTP NWR ) < 0.6  adjacent < 90  point_touch region ) NODRC ) 
~geom_inside (  space (  X ~geom_interact (  SDN NWR ) < 0.6  adjacent < 90  point_touch region ) NODRC ) 
~geom_inside (  space (  X ~geom_interact (  SDP NWR ) < 0.6  adjacent < 90  point_touch region ) NODRC ) 
~geom_inside (  space (  X ~geom_interact (  NPR NWR ) < 0.6  adjacent < 90  point_touch region ) NODRC ) 
~geom_inside (  space (  X ~geom_interact (  ESD1 NWR ) < 0.6  adjacent < 90  point_touch region ) NODRC ) 
~geom_inside (  space (  X ~geom_interact (  HRP NWR ) < 0.6  adjacent < 90  point_touch region ) NODRC ) 
}

RULE NW1res_ACT_S_2 { 
; Space between SAB and CT for NW1 ressitor = 0.28 um

X = geom_size ( geom_and (  CT geom_interact (  AA NW1res ) ) by 0.28  ) 
Y = edge_inside (  SAB geom_interact (  NW NW1res ) ) 
~edge_adjacent ( both_side  Y X ) 
}

RULE NW1res_ACT_S_3 { 
; Space between NW1 resistor and (NW1 resistor OR NW1) >= 1.2um

X = geom_interact (  NW NW1res ) 
~geom_inside (  space (  X NW < 1.2  adjacent < 90  point_touch region ) NODRC ) 
}

RULE NW1res_ACT_S_4 { 
; Space between NW1 resistor and NP = 0

~edge_adjacent ( both_side  
edge_inside (  NW1res 
geom_interact (  NW 
geom_enclose (  AA 
geom_and (  NW NW1res ) ) ) ) SDN ) 
}


RULE NW1res_ACT_EN_1 { 
; ACT enclosure of NW1-Resistor >= 0.90um

X = geom_and (  geom_and (  geom_and (  NW1res AA ) NW ) SAB ) 
~geom_inside (  extension (  X geom_enclose (  AA X ) < 0.9  adjacent < 90  point_touch region ) NODRC ) 
}
RULE NW1res_ACT_EN_2 { 
; SAB enclosure of ACT >= 0.20um

X = geom_and (  geom_and (  geom_and (  NW1res AA ) NW ) SAB ) 
Y1 = geom_enclose (  AA X ) 
Y2 = ~edge_coincident ( both_side  SAB geom_holes ( SAB ) ) 
~edge_inside (  extension (  Y1 Y2 < 0.2  adjacent < 90  region ) NODRC ) 
}

RULE NW1res_ACT_EN_3 { 
; Enclosure of SAB and related NW1 >= 0.28um

X1 = geom_holes ( SAB ) 
X2 = geom_adjacent (  SAB X1 ) 
~geom_inside (  extension (  NWR X1 < 0.28  adjacent < 90  point_touch region ) NODRC ) 
~geom_inside (  extension (  NWR X2 < 0.28  adjacent < 90  point_touch region ) NODRC ) 
~geom_inside (  geom_not (  geom_not (  geom_interact (  NWR X1 ) X1 ) SAB ) NODRC ) 
}

RULE NW1res_ACT_EN_4 { 
; NW1 enclosure of CT >= 0.28um

X = geom_and (  geom_and (  geom_and (  NW1res AA ) NW ) SAB ) 
~geom_inside (  extension (  geom_and (  CT geom_holes ( SAB ) ) geom_enclose (  NW X ) < 0.28  adjacent < 90  point_touch region ) NODRC ) 
}

RULE NW1res_ACT_EX_1 { 
; Extension of NW1res outside of ACT >= 0.20um

~geom_inside (  
extension (  AA 
geom_interact (  NW1res SAB ) < 0.2  adjacent < 90  point_touch region ) NODRC ) 
}
RULE NW1res_ACT_O_1 { 
; Overlap of a NP and SAB (SAB INTERACT NW1res) >= 0.38um

X = geom_and (  geom_and (  geom_and (  NW1res AA ) NW ) SAB ) 
Y = geom_holes ( geom_interact (  SAB X ) ) 
SDN_1 = geom_interact (  SDN X ) 
~geom_inside (  extension (  Y SDN_1 < 0.38  adjacent < 90  point_touch region outside_also ) NODRC ) 
}

RULE NW1res_ACT_R_1 { 
; NW1 resistor must be covered by SAB except CT area

X = geom_enclose (  NW1res geom_and (  NW1res AA ) ) 
Y = geom_interact (  geom_or (  SAB geom_holes ( SAB ) ) X ) 
~geom_inside (  ~geom_enclose (  Y geom_and (  NW1res NW ) ) NODRC ) 
}

RULE NW1res_ACT_R_2 { 
; recommanded to use rectangle shape resistor for the spice simulation accuracy. DRC flag (NW1 resistor AND NW1) not a rectangle

X = geom_and (  NW1res NW ) 
~geom_rectangle ( X ) 
}

RULE NW1res_ACT_R_4 { 
; In one NW1 resistor
; 1. There is only one NW1 is allowed in same ACT
; 2. There is only two NPs are allowed in same ACT
; 3. There is only two SAB holes allowed in same ACT
RESNWAA_CHECK = geom_enclose (  AA geom_and (  geom_and (  NW1res NW ) SAB ) ) 
geom_interact (  RESNWAA_CHECK NW > 1  ) 
geom_interact (  RESNWAA_CHECK SDN > 2  ) 
geom_interact (  RESNWAA_CHECK SDN == 1  ) 
geom_interact (  RESNWAA_CHECK geom_interact (  geom_holes ( SAB ) RESNWAA_CHECK ) > 2  ) 
}
//=======================
//  NW1res_STI Rules
//=======================
group_rule ( GNW1es_STI NW1res_STI_?  ) 

NWRSTI = ~geom_interact (  NWR SAB ) 
NWRSTI_L = edge_inside (  NWRSTI NW1res ) 
NWRSTI_W = edge_inside (  ~geom_interact (  geom_and (  NW1res NW ) SAB ) NW ) 

RULE NW1res_STI_W_1 { 
; NW-Resistor width and suggest NW1 resistor length/width ratio > 5,length >= 20um for SPICE simulation accuracy >= 1.8um

X = ~geom_interact (  geom_and (  NW1res NW ) SAB ) 
~edge_inside (  edge_length (  edge_inside (  X NW ) < 1.8  ) NODRC ) 
}
RULE NW1res_STI_S_1 { 
; Space between NW resistor and adjacent ACT >= 0.50um

~geom_inside (  
space (  NWRSTI AA < 0.5  adjacent < 90  point_touch region ) NODRC ) 
}
RULE NW1res_STI_S_2 { 
; Space between NW1res to silicided ACT area = 0.00um

X = geom_interact (  NW1res NWRSTI ) 
~geom_inside (  geom_and (  X AA ) NODRC ) 
Y = edge_inside (  X NW ) 
Z = geom_edge_to_rect ( Y inside 0.001  ) 
~geom_inside (  ~geom_adjacent (  Z AA ) NODRC ) 
}

RULE NW1res_STI_S_3 { 
; Space between NW1 STI resistor and (NW1 STI resistor OR NW1) >= 1.2um.

X = geom_interact (  NW NWRSTI ) 
~geom_inside (  space (  X NW < 1.2  adjacent < 90  point_touch region ) NODRC ) 
}

RULE NW1res_STI_EN_1 { 
; (ACT INTERACT NW1res) enclosure CT = 0.28 um

X = geom_size ( geom_and (  CT NWRSTI ) by 0.28  ) 
Y = edge_inside (  geom_interact (  AA X ) NWRSTI ) 
~edge_adjacent ( both_side  Y X ) 
}

RULE NW1res_STI_EN_2 { 
; NP enclosure of ACT interact NW1res >= 0.38um

X = geom_and (  AA NWRSTI ) 
Y = geom_interact (  SDN NWRSTI ) 
~geom_inside (  extension (  X Y < 0.38  adjacent < 90  point_touch region ) NODRC ) 
}
RULE NW1res_STI_EN_3 { 
; NW1 enclosure of silicide CT >= 0.28um

extension (  CT NWRSTI < 0.28  point_touch region ) 
}

RULE NW1res_STI_EX_1 { 
; Extension of NW1res outside of NW1 >= 0.20um

~geom_inside (  
extension (  NW NW1res < 0.2  adjacent < 90  point_touch region ) NODRC ) 
}

RULE NW1res_STI_EX_2 { 
; ACT extention outside of NW1 resistor >= 0.28um

X = geom_interact (  AA NWRSTI ) 
Y = geom_interact (  NW NWRSTI ) 
~geom_inside (  extension (  Y X < 0.28  opposite region ) NODRC ) 
}
RULE NW1res_STI_R_1 { 
; NW1 Resistor must be fully covered by SAB except for CT area

X = ~geom_interact (  geom_and (  NW1res NW ) SAB ) 
~geom_inside (  geom_and (  X ~geom_interact (  AA CT ) ) NODRC ) 
}
RULE NW1res_STI_R_2 { 
; NW1res(ineract with NP) must not overlap with ACTdm,POLYdm,PP,ULLD,PVT3,NVT3,PVT1,NVT1,NPR,HRP and ESD

~geom_inside (  
geom_and (  
geom_interact (  NW1res SDN ) AADUM ) NODRC ) 
~geom_inside (  geom_and (  geom_interact (  NW1res SDN ) PODUM ) NODRC ) 
~geom_inside (  geom_and (  NW1res HVTN ) NODRC ) 
~geom_inside (  geom_and (  NW1res UVT ) NODRC ) 
~geom_inside (  geom_and (  NW1res HVTP ) NODRC ) 
~geom_inside (  geom_and (  NW1res LVTN ) NODRC ) 
~geom_inside (  geom_and (  NW1res LVTP ) NODRC ) 
~geom_inside (  geom_and (  NW1res SDP ) NODRC ) 
~geom_inside (  geom_and (  NW1res NPR ) NODRC ) 
~geom_inside (  geom_and (  NW1res ESD1 ) NODRC ) 
~geom_inside (  geom_and (  NW1res HRP ) NODRC ) 
}
RULE NW1res_STI_R_3 { 
; recommanded to use rectangle shape resistor for the spice simulation accuracy. DRC flag (NW1 resistor AND NW1) not a rectangle

X = geom_and (  NW1res NW ) 
~geom_rectangle ( X ) 
}
}

trs::pvrs_block  {
//==========================
//  GR - Poly Resistor DRC
//==========================
group_rule ( GPORES PORES_?  ) 

POR_SA = geom_and (  POR SAB ) 
POR_NS = ~geom_interact (  POR SAB ) 

RULE PORES_W_1 { 
; Width of non-silicide poly resistor >= 0.4um
; Suggest the Nsq >= 1 for stable Resistivity >= 1
X = geom_and (  geom_and (  PORES PO ) SAB ) 
L = edge_inside (  X PO ) 
~edge_inside (  edge_length (  L < 0.4  ) NODRC ) 
X1 = geom_and (  PORES SAB ) 
Y1 = geom_and (  geom_and (  PO PORES ) SAB ) 
L1 = edge_or ( edge_inside (  PO X1 ) edge_coincident ( both_side  PO X1 ) ) 
W1 = edge_inside (  Y1 PO ) 
~geom_inside (  dfm_build_property ( Y1 L1 W1 overlapped adjacent [ 
SQUARES = LENGTH(L1)/LENGTH(W1) ] < 1  ) NODRC ) 
}

RULE PORES_S_1a:PP { 
; Space between N type PO resistors and NP, PP, NPR, HRP, ESD  >= 0.18um

X = ~geom_interact (  SDP PORES ) 
~geom_inside (  space (  X POR_SA < 0.18  adjacent < 90  point_touch region ) NODRC ) 
}
RULE PORES_S_1b:NP { 
; Space between P type PO resistors and NP, PP, NPR, HRP, ESD (follow GT.10 rule) >= 0.18um

X = ~geom_interact (  SDN PORES ) 
~geom_inside (  space (  X POR_SA < 0.18  adjacent < 90  point_touch region ) NODRC ) 
}
RULE PORES_S_1:ESD { 
; Space between N/P type PO resistors and NP, PP, NPR, HRP, ESD (follow GT.10 rule) >= 0.18um

X = ~geom_interact (  ESD1 PORES ) 
~geom_inside (  space (  X POR_SA < 0.18  adjacent < 90  point_touch region ) NODRC ) 
}
RULE PORES_S_1:HRP { 
; Space between N/P type PO resistors and NP, PP, NPR, HRP, ESD (follow GT.10 rule) >= 0.18um

X = ~geom_interact (  HRP PORES ) 
~geom_inside (  space (  X POR_SA < 0.18  adjacent < 90  point_touch region ) NODRC ) 
}
RULE PORES_S_1:NPR { 
; Space between N/P type PO resistors and NP, PP, NPR, HRP, ESD (follow GT.10 rule) >= 0.18um

X = ~geom_interact (  NPR PORES ) 
~geom_inside (  space (  X POR_SA < 0.18  adjacent < 90  point_touch region ) NODRC ) 
}
RULE PORES_S_2 { 
; Space between SAB and CT for non-silicide poly resistor = 0.21um

X = geom_interact (  POR SAB ) 
Y = geom_and (  CT X ) 
~geom_inside (  ~geom_adjacent (  geom_size ( Y by 0.21  ) POR_SA ) NODRC ) 
}
RULE PORES_EN_1 { 
; Enclosure of PP/NP outside of a Poly resistor area >= 0.18um

X = geom_and (  PORES PO ) 
~geom_inside (  extension (  X SDN < 0.18  adjacent < 90  point_touch region ) NODRC ) 
~geom_inside (  extension (  X SDP < 0.18  adjacent < 90  point_touch region ) NODRC ) 
}
RULE PORES_EX_1 { 
; PORES extention outside of PO resistor >= 0.2um

X = edge_coincident ( both_side  POR_SA PO ) 
~edge_inside (  extension (  X PORES < 0.2  adjacent < 90  region ) NODRC ) 
}
RULE PORES_EX_2 { 
; Extension of SAB outside of non-silicide poly resistor area(follow SAB.6 rule) >= 0.2um

~geom_inside (  
extension (  POR SAB < 0.2  adjacent < 90  point_touch region ) NODRC ) 
}
RULE PORES_R_1 { 
; Non-silicide PO resistor must be covered by SAB and implanted by either NP or PP

X = geom_interact (  POR SAB ) 
~geom_inside (  geom_not (  X geom_or (  SDN SDP ) ) NODRC ) 
}
RULE PORES_R_3 { 
; For silicide Poly resistor, two sides of PORES must be along the CT edge

X = geom_and (  CT POR_NS ) 
Y = edge_inside (  ~geom_interact (  PORES SAB ) PO ) 
~edge_inside (  ~edge_adjacent ( both_side  Y X ) NODRC ) 
}
}




trs::pvrs_block  {
#IFDEF Poly_EFuse_CHECK YES 
//=======================
//    Poly E-Fuse DRC 
//======================
group_rule ( GEFU EFU_?  ) 
RULE EFU_1b_G { 
; FUSEALL (292;12) must interact with EFUSEALL (293;12) region

~geom_inside (  
~geom_interact (  FUSEALL EFUSEALL ) NODRC ) 
}
RULE EFU_1c_G { 
; FUSEALL (292;12) must fully cover EFUSEALL (293;12) region

~geom_inside (  
geom_not (  EFUSEALL FUSEALL ) NODRC ) 
}
RULE EFU_2b_G { 
; EFUSEALL (293;12) must interact with POEFUSEBLK(294;12)

~geom_inside (  
~geom_interact (  EFUSEALL POEFUSEBLK ) NODRC ) 
}
RULE EFU_2c_G { 
; EFUSE (293;12) must fully cover POEFUSEBLK(294;12)

~geom_inside (  
geom_not (  POEFUSEBLK EFUSEALL ) NODRC ) 
}
#ENDIF 
}


trs::pvrs_block  {
//==================================
//  HRP - High Resistance Poly DRC
//==================================
group_rule ( GHRP HRP_?  ) 

RULE HRP_W_1 { 
; Width of HRP >= 0.21um
; It is strongly suggested that the resistor square number (length/width ratio) >= 5 for precise Rs. >= 5
~geom_inside (  width (  HRP < 0.21  adjacent < 90  point_touch region ) NODRC ) 
}
RULE HRP_W_2 { 
; Width of high resistance poly >= 2.00um

X = ~edge_coincident ( both_side  geom_interact (  PO PO_HRP ) SDP ) 
~geom_inside (  width (  X < 2  opposite region ) NODRC ) 
}
RULE HRP_S_1 { 
; Space between two HRP >= 0.21um

~geom_inside (  
space (  HRP < 0.21  adjacent < 90  point_touch region ) NODRC ) 
}
RULE HRP_S_2 { 
; Space between HRP region and NMOS poly >= 0.16um
; Space between HRP region and PMOS poly >= 0.16um
PO_MOS = geom_interact (  PO GATE ) 
~geom_inside (  space (  HRP PO_MOS < 0.16  adjacent point_touch region ) NODRC ) 
}
RULE HRP_S_3 { 
; Fixed Space between SAB and CT in HRP region is 0.21um

X = geom_interact (  HRP SAB ) 
Y = geom_and (  CT X ) 
~geom_adjacent (  geom_size ( Y by 0.21  ) geom_interact (  SAB HRP ) ) 
}
RULE HRP_EN_1 { 
; HRP enclosure of high resistance poly >= 0.20um
~geom_inside (  extension (  PO_HRP HRP < 0.20  adjacent point_touch region ) NODRC ) 
}
RULE HRP_EX_1 { 
; SAB extension outside of high resistance poly >= 0.22um

~geom_inside (  
extension (  
geom_interact (  PO PO_HRP ) SAB < 0.22  adjacent < 90  point_touch region ) NODRC ) 
}
RULE HRP_O_1 { 
; PP overlap with SAB = 0.30um

RES_HRP = geom_and (  geom_and (  geom_and (  HPR HRP ) PO ) SAB ) 
~geom_inside (  ~geom_inside (  width (  geom_interact (  SAB RES_HRP ) SDP < 0.3  adjacent < 90  point_touch region ) SRINGBLK ) SRAMALL ) 
SDP_CK = edge_inside (  SDP geom_interact (  PO RES_HRP ) ) 
~edge_inside (  ~edge_inside (  width (  ( SDP_CK )  geom_interact (  SAB RES_HRP ) <= 0.3  adjacent < 90  ) SRINGBLK ) SRAMALL ) 
}
RULE HRP_R_1 { 
; It is not allowed (NP,PP) overlap HPR region (when checking the rule, size down the HPR by 0.3um along the current direction)

HRPR = geom_interact (  PO HRP ) 
HRP_END = geom_size ( geom_not (  HRPR HPR ) by 0.3  ) 
HRP_MID = geom_not (  HRPR HRP_END ) 
~geom_inside (  geom_and (  geom_or (  SDN SDP ) HRP_MID ) NODRC ) 
}
RULE HRP_R_2 { 
; HPR edge should align with SAB edge

SAB_AND_HRP = geom_and (  geom_interact (  SAB HRP ) PO ) 
DMY_AND_HRP = geom_and (  HPR PO ) 
~geom_inside (  geom_xor (  SAB_AND_HRP DMY_AND_HRP ) NODRC ) 
}
}

trs::pvrs_block  {
LDAA = geom_and (  AA LDMOS ) 
LDPAA = geom_and (  LDAA SDP ) 
LDNAA = geom_and (  LDAA SDN ) 
LDPGATE = geom_and (  LDPAA PO ) 
LDNGATE = geom_and (  LDNAA PO ) 
LDPD = geom_adjacent (  ~geom_interact (  LDPAA PO ) LDMOSSTI ) 
LDND = geom_adjacent (  ~geom_interact (  LDNAA PO ) LDMOSSTI ) 
LDPS = geom_not (  geom_interact (  LDPAA PO ) LDPGATE ) 
LDNS = geom_not (  geom_interact (  LDNAA PO ) LDNGATE ) 
SD_LDMOS = geom_or (  LDPD LDND LDPS LDNS ) 
PO_LDMOS = geom_or (  LDPGATE LDNGATE ) 
AA_LDMOS = geom_or (  SD_LDMOS PO_LDMOS ) 
}

trs::pvrs_block  {
#IFDEF DUP_CHECK YES 
}
trs::pvrs_block  {
//=========================================
// DEUPAD (DEVICE Under Pad) Pad Guidelines
//=========================================
padarea = geom_and (  DEUPAD MD ) 
}

group_rule GDEUPAD DEUPAD_? 

trs::rule DEUPAD_R_2 {
trs::rule_comment  DEUPAD must fully enclose COVER
trs::outputlayer ~geom_inside (  geom_not (  geom_interact (  MD DEUPAD ) DEUPAD ) NODRC ) 
}
trs::rule DEUPAD_R_3 {
trs::rule_comment Two top metal layers (TM and TM-1) are needed between DEUPAD and device, where the metal design must be solid.
trs::outputlayer ~geom_inside (  geom_enclose (  padarea geom_not (  padarea "[lindex $metal_all end]" ) ) NODRC ) 
trs::outputlayer ~geom_inside (  geom_enclose (  padarea geom_not (  padarea "[lindex $metal_all end-1]" ) ) NODRC ) 
}
trs::rule DEUPAD_R_5 {
trs::rule_comment ALPADres, MOMLVS1, INDALL, Resistor of TM or TM-1 must be outside of DEUPAD area.
trs::setlayer X1 = geom_or (  geom_or (  ALPAR MOMLVS1 ) INDALL ) 
trs::setlayer X2 = geom_or (  geom_and (  "[lindex $metal_all end]R" "[lindex $metal_all end]" ) geom_and (  "[lindex $metal_all end-1]R" "[lindex $metal_all end-1]" ) ) 
trs::outputlayer ~geom_inside (  geom_and (  geom_or (  X1 X2 ) padarea ) NODRC ) 
}
trs::rule DEUPAD_R_6 {
trs::rule_comment For one top metal process: TV-1 pattern is not allowed under the DEUPAD opening area
trs::rule_comment For two top metal process: T4V1 patterns are not allowed under the DEUPAD opening area
trs::outputlayer ~geom_inside (  geom_and (  padarea "[lindex $via_all end-1]" ) NODRC ) 
}
trs::rule DEUPAD_R_7 {
trs::rule_comment DEUPAD area must have top via array between (top metal and the top metal directly underneath top metal) 
trs::rule_comment two vias which space is within 0.51um are considerd to be same array
  trs::setlayer VIA_ARRAY_S_REG = space (  "[lindex $via_all end-1]" <= 0.51  point_touch region ) 
  trs::setlayer VIA_ARRAY = geom_interact (  "[lindex $via_all end-1]" VIA_ARRAY_S_REG ) 
  trs::outputlayer ~geom_interact (  padarea VIA_ARRAY ) 
}

trs::pvrs_block  {
#ENDIF 
}

#//====================
#//  Seal Ring Rules
#//====================

group_rule GSRCK SRCK_? 


#//Contact, via and TV slots are not permitted for main chip design except guard ring/seal ring applications.
#//(CT/via patterns, with the width/length ratio larger than 3, should be taken as Contact/via slots.)

trs::setlayer CTS = geom_and (  CT SRINGBLK ) 
trs::setlayer CTS_SL = geom_or (  geom_and (  SRINGBLK CTbar ) geom_not (  CTS CTS_SQ ) ) 
trs::setlayer CTS_SQ = geom_rectangle ( CTS == 0.09  by == 0.09  ) 

trs::setlayer AAS = geom_and (  ACTi geom_enclose (  ACTi CTS ) ) 

foreach j $m_j {
  trs::setlayer "M${j}S" = geom_and (  "M${j}i" SRINGBLK ) 
  trs::setlayer "M${j}S_INNER" = geom_adjacent (  "M${j}S" geom_holes ( "M${j}S" inner_most ) == 1  ) 
  trs::setlayer "M${j}S_OUTER" = geom_adjacent (  "M${j}S" geom_holes ( "M${j}S" ) == 1  ) 
  trs::setlayer "M${j}S_RING" = geom_and (  "M${j}i" geom_interact (  "M${j}S" "M${j}S_OUTER" ) ) 
  if { ($j < 8) && ([set CHECK_V$j] == 1) } {
  trs::setlayer "V${j}S" = geom_and (  "V${j}" SRINGBLK ) 
  trs::setlayer "V${j}S_SL" = geom_or (  geom_and (  "V${j}" "V${j}bar" ) geom_not (  "V${j}S" "V${j}S_SQ" ) ) 
  trs::setlayer "V${j}S_SQ" = geom_rectangle ( "V${j}S" == 0.09  by == 0.09  ) 
  trs::pvrs_block  {
}
  }

}

if { ([set CHECK_T4V1] == 1) && ([set CHECK_T4M1] == 1) } {
  trs::setlayer T4V1S = geom_and (  T4V1 SRINGBLK ) 
  trs::setlayer T4V1S_SL = geom_or (  geom_and (  T4V1S T4V1bar ) geom_not (  T4V1S T4V1S_SQ ) ) 
  trs::setlayer T4V1S_SQ = geom_rectangle ( T4V1S == 0.36  by == 0.36  ) 

  trs::setlayer T4M1S = geom_and (  T4M1i SRINGBLK ) 
  trs::setlayer T4M1S_INNER = geom_adjacent (  T4M1S geom_holes ( T4M1S inner_most ) == 1  ) 
  trs::setlayer T4M1S_OUTER = geom_adjacent (  T4M1S geom_holes ( T4M1S ) == 1  ) 
  trs::setlayer T4M1S_RING = geom_and (  T4M1i geom_interact (  T4M1S T4M1S_OUTER ) ) 

  trs::pvrs_block  {
}
}

if { ([set CHECK_T4V2] == 1) && ([set CHECK_T4M2] == 1) } {
  trs::setlayer T4V2S = geom_and (  T4V2 SRINGBLK ) 
  trs::setlayer T4V2S_SL = geom_or (  geom_and (  T4V2S T4V2bar ) geom_not (  T4V2S T4V2S_SQ ) ) 
  trs::setlayer T4V2S_SQ = geom_rectangle ( T4V2S == 0.36  by == 0.36  ) 

  trs::setlayer T4M2S = geom_and (  T4M2i SRINGBLK ) 
  trs::setlayer T4M2S_INNER = geom_adjacent (  T4M2S geom_holes ( T4M2S inner_most ) == 1  ) 
  trs::setlayer T4M2S_OUTER = geom_adjacent (  T4M2S geom_holes ( T4M2S ) == 1  ) 
  trs::setlayer T4M2S_RING = geom_and (  T4M2i geom_interact (  T4M2S T4M2S_OUTER ) ) 

  trs::pvrs_block  {
}
}

if { ([set CHECK_T2V1] == 1) && ([set CHECK_T2M1] == 1) } {
  trs::setlayer T2V1S = geom_and (  T2V1 SRINGBLK ) 
  trs::setlayer T2V1S_SL = geom_or (  geom_and (  T2V1S T2V1bar ) geom_not (  T2V1S T2V1S_SQ ) ) 
  trs::setlayer T2V1S_SQ = geom_rectangle ( T2V1S == 0.2  by == 0.2  ) 

  trs::setlayer T2M1S = geom_and (  T2M1 SRINGBLK ) 
  trs::setlayer T2M1S_INNER = geom_adjacent (  T2M1S geom_holes ( T2M1S inner_most ) == 1  ) 
  trs::setlayer T2M1S_OUTER = geom_adjacent (  T2M1S geom_holes ( T2M1S ) == 1  ) 
  trs::setlayer T2M1S_RING = geom_and (  T2M1i geom_interact (  T2M1S T2M1S_OUTER ) ) 

  trs::pvrs_block  {
}
}

if { ([set CHECK_T2V2] == 1) && ([set CHECK_T2M2] == 1) } {
