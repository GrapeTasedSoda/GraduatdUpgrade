trs::outputlayer check_density ( check_pattern check_window "\[!AREA(check_window) + !!AREA(check_window)*AREA(check_pattern)/AREA(check_window)\]" < 0.10  by_window 100  delta 50  boundary_backup inside_of_layer DRC:1 in_polygon output_log "${metal_layer}_D_1_min.log" result_db \
"${metal_layer}_D_1_min.rdb" ) 

} else {
  
trs::setlayer check_region_1 = ~geom_inside (  geom_not (  geom_not (  geom_not (  geom_not (  DRC:1 FUTR ) GRID ) SRINGBLK ) INDALL ) NODRC ) 
