trs::rule PO_D_1_min {
trs::rule_comment Global PO density for fully chip (including dummy) >= 14%
trs::outputlayer ~geom_inside (  check_density ( PO_all < 0.14  output_log density_report_PO_D_1_min.log ) NODRC ) 
}

trs::rule PO_D_1_max {
trs::rule_comment Global PO density for fully chip (including dummy)  <= 40%
trs::outputlayer ~geom_inside (  check_density ( PO_all > 0.40  output_log density_report_PO_D_1_max.log ) NODRC ) 
}

trs::rule PO_D_2_min {
trs::rule_comment Local PO density (including dummy) in 100um*100um window with step size: 50um
trs::rule_comment Maximum density check exclude INDALL region >= 20%
trs::outputlayer ~geom_inside (  check_density ( PO_all < 0.2  by_window 100  delta 50  boundary_backup output_log density_report_PO_D_2_min.log ) NODRC ) 
}

trs::rule PO_D_2_max {
trs::rule_comment Local PO density (including dummy) in 100um*100um window with step size: 50um
trs::rule_comment Maximum density check exclude INDALL region @ <= 40%
trs::setlayer PO_check = geom_not (  PO_all INDALL ) 
trs::outputlayer ~geom_inside (  check_density ( PO_check > 0.4  by_window 100  delta 50  boundary_backup output_log density_report_PO_D_2_max.log ) NODRC ) 
}

trs::rule PO_D_3 { 
trs::rule_comment The poly density difference between any two neighboring checking windows  <= 20%
 trs::outputlayer ~geom_inside (  check_density ( PO_all DRC:1 <= 1  by_window 100  boundary_backup check_gradient > 0.2  absolute_value corner_also inside_of_layer BULK output_log density_report_PO_D_3.log ) NODRC ) 
}

