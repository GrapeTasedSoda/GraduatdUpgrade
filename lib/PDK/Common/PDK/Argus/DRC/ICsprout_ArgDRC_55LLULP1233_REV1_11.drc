if { ([set CHECK_T8V2] == 1) && ([set CHECK_T8M2] == 1) } {
  trs::setlayer T8V2S = geom_and (  T8V2 SRINGBLK ) 
  trs::setlayer T8V2S_SL = geom_or (  geom_and (  T8V2S T8V2bar ) geom_not (  T8V2S T8V2S_SQ ) ) 
  trs::setlayer T8V2S_SQ = geom_rectangle ( T8V2S == 0.36  by == 0.36  ) 

  trs::setlayer T8M2S = geom_and (  T8M2i SRINGBLK ) 
  trs::setlayer T8M2S_INNER = geom_adjacent (  T8M2S geom_holes ( T8M2S inner_most ) == 1  ) 
  trs::setlayer T8M2S_OUTER = geom_adjacent (  T8M2S geom_holes ( T8M2S ) == 1  ) 
