for { set i 0 } { $i < [ llength $list1 ] } { incr i } {
trs::setlayer "NAA_POWER_PAD_all_[ expr $i + 1 ]" = geom_or (  NAA_POWER_PAD_all_$i "[ lindex $list1 $i ]" ) 
}
trs::pvrs_block  {
}
for { set i 0 } { $i < [ llength $list2 ] } { incr i } {
trs::setlayer "PAA_POWER_PAD_all_[ expr $i + 1 ]" = geom_or (  PAA_POWER_PAD_all_$i "[ lindex $list2 $i ]" ) 
}



trs::setlayer NAA_IO_PAD = ~geom_interact (  NAA_PAD "NAA_POWER_PAD_all_${i}" ) 
trs::setlayer PAA_IO_PAD = ~geom_interact (  PAA_PAD "PAA_POWER_PAD_all_${i}" ) 
trs::setlayer NMOS_IO_PAD = geom_interact (  NMOS_PAD NAA_IO_PAD ) 
trs::setlayer PMOS_IO_PAD = geom_interact (  PMOS_PAD PAA_IO_PAD ) 

trs::pvrs_block  {
#ENDIF 
}

trs::pvrs_block  {
#IFDEF DEFINE_PAD_BY_TEXT 0 
}
trs::setlayer ALPA_1 = geom_or (  EMPTY5 ALPAi ) 
trs::setlayer PA_1 = geom_or (  EMPTY5 CBi ) 
foreach metal_via $v_m_list_for_connect {
  trs::setlayer "${metal_via}_EMPTY5" = geom_or (  EMPTY5 "${metal_via}" ) 
}

trs::pvrs_block  {
NAA_IO_PAD = check_nar ( NACT_1 MD_IO_PAD > 0  ) 
PAA_IO_PAD = check_nar ( PACT_1 MD_IO_PAD > 0  ) 
NMOS_IO_PAD = geom_interact (  NMOS1 NAA_IO_PAD ) 
PMOS_IO_PAD = geom_interact (  PMOS1 PAA_IO_PAD ) 
}

trs::pvrs_block  {
#ENDIF 
}


trs::pvrs_block  {
#IFDEF CONNECT_ALL_RESISTOR 0 
}
trs::setlayer NACT_1 = geom_or (  EMPTY5 geom_not (  NACT_0 geom_or (  AA_resistor NW_resistor ) ) ) 
trs::setlayer PACT_1 = geom_or (  EMPTY5 geom_not (  PACT_0 geom_or (  AA_resistor NW_resistor ) ) ) 
trs::setlayer PO_1 = geom_or (  EMPTY5 geom_not (  PO_raw PO_resistor ) ) 
trs::pvrs_block  {
#ENDIF 
}


trs::pvrs_block  {
#IFDEF CONNECT_ALL_RESISTOR 1 
}
trs::setlayer NACT_1 = geom_or (  EMPTY5 NACT_0 ) 
trs::setlayer PACT_1 = geom_or (  EMPTY5 PACT_0 ) 
trs::setlayer PO_1 = geom_or (  EMPTY5 PO_raw ) 



trs::pvrs_block  {
#ENDIF 
}

for { set i 0 } { $i < [expr [llength $v_m_list_for_connect] -2] } { incr i 2 } {
  connect "[lindex $v_m_list_for_connect $i]_EMPTY5" "[lindex $v_m_list_for_connect [expr $i +2]]_EMPTY5" by "[lindex $v_m_list_for_connect [expr $i +1]]_EMPTY5" 
}

connect M1i_EMPTY5 PO_1 NACT_1 PACT_1 by CT_1 

if { [string equal $T4V2_T4M2 1] == 1 } {
connect T4M2i_EMPTY5 PA_1 
connect T4M2i_EMPTY5 RDL_1 by RDLVIA_1 
}
if { [string equal $T2V2_T2M2 1] == 1 } {
connect T2M2i_EMPTY5 PA_1 
connect T2M2i_EMPTY5 RDL_1 by RDLVIA_1 
}
if { [string equal $T8V2_T8M2 1] == 1 } {
connect T8M2i_EMPTY5 PA_1 
connect T8M2i_EMPTY5 RDL_1 by RDLVIA_1 
}
connect RDL_1 RDLPA2_1 
connect PA_1 ALPA_1 
connect RDL_1 ALPA_1 
connect ALPA_1 MD_1 

trs::setlayer NMOS_PAD = geom_interact (  NMOS check_nar ( NACT_1 MD_IO_PAD > 0  ) ) 
trs::setlayer PMOS_PAD = geom_interact (  PMOS check_nar ( PACT_1 MD_IO_PAD > 0  ) ) 


trs::setlayer NAA_PAD = check_nar ( NACT_1 MD_IO_PAD > 0  ) 
trs::setlayer PAA_PAD = check_nar ( PACT_1 MD_IO_PAD > 0  ) 

trs::setlayer PMOS1 = geom_enclose (  PACT GATE ) 
trs::setlayer NMOS1 = geom_enclose (  NACT GATE ) 
trs::setlayer NGUARDRING = geom_holes ( NTAP inner_most ) 
trs::setlayer PGUARDRING = geom_holes ( PTAP inner_most ) 
trs::setlayer NGUARDHOLE_2 = geom_enclose (  geom_holes ( NTAP inner_most ) PGUARDRING ) 
trs::setlayer PGUARDHOLE_2 = geom_enclose (  geom_holes ( PTAP inner_most ) NGUARDRING ) 

trs::setlayer GATEHV = geom_and (  GATE TG ) 
trs::setlayer NGATEHV = geom_and (  NGATE TG ) 
trs::setlayer PGATEHV = geom_and (  PGATE TG ) 
trs::setlayer GATEMV = geom_and (  GATE DG ) //1.8V or 1.5V
trs::setlayer GATELV = ~geom_inside (  GATE geom_or (  DG TG ) ) 
   
trs::rule LU_R_2 {
trs::rule_comment Guard ring should be used to surround ACT injector or a group of ACT injectors which are connected to an I/O pad
trs::rule_comment N+ injector must be surrounded by a P+ guard-ring
trs::rule_comment P+ injector must be surrounded by a N+ guard-ring
trs::rule_comment NW/PW pickups rings can be used as guard rings. DRC check the nearest guard-ring which surrounds AA injector or a group of AA injector
 trs::outputlayer ~geom_inside (  ~geom_inside (  geom_not (  geom_adjacent (  NAA_IO_PAD PO ) PGUARDRING ) geom_or (  LATCHUP SRINGBLK ) ) NODRC ) 
 trs::outputlayer ~geom_inside (  ~geom_inside (  geom_not (  geom_adjacent (  PAA_IO_PAD PO ) NGUARDRING ) geom_or (  LATCHUP SRINGBLK ) ) NODRC ) 
}
		
trs::rule LU_W_1 {
trs::rule_comment Guard-ring width for ACT injector connected to an I/O pad
trs::rule_comment Guard-ring definition please refers to LU.1. >= 0.12um
trs::outputlayer ~geom_inside (  width (  geom_adjacent (  geom_donut  ( NTAP ) geom_enclose (  geom_holes ( NTAP inner_most ) PAA_IO_PAD ) ) < 0.12  adjacent < 90  point_touch region ) geom_or (  SRINGBLK LATCHUP NODRC ) ) 
trs::outputlayer ~geom_inside (  width (  geom_adjacent (  geom_donut  ( PTAP ) geom_enclose (  geom_holes ( PTAP inner_most ) NAA_IO_PAD ) ) < 0.12  adjacent < 90  point_touch region ) geom_or (  SRINGBLK LATCHUP NODRC ) ) 
}

trs::pvrs_block  {
#IFDEF LU_3_CHECK FAST 
}
trs::rule LU_S_1a {
trs::rule_comment For 0.9/1.2V core N/PMOS ACT connected to an I/O pad
trs::rule_comment Spacing between NMOS and PMOS >= 2.0um
 trs::setlayer X = geom_not (  geom_enclose (  NMOS_IO_PAD GATELV ) SRINGBLK ) 
 trs::setlayer Y = geom_not (  geom_enclose (  PMOS_IO_PAD GATELV ) SRINGBLK ) 
 trs::setlayer M = geom_not (  geom_enclose (  NMOS GATELV ) SRINGBLK ) 
 trs::setlayer N = geom_not (  geom_enclose (  PMOS GATELV ) SRINGBLK ) 
 trs::setlayer Z1 = geom_size ( X by 1.036  clip_corner 3  ) 
 trs::setlayer Z2 = geom_size ( N by 1.036  clip_corner 3  ) 
 trs::outputlayer ~geom_inside (  geom_and (  Z1 Z2 ) geom_or (  LATCHUP NODRC ) ) 
 trs::setlayer Z3 = geom_size ( M by 1.036  clip_corner 3  ) 
 trs::setlayer Z4 = geom_size ( Y by 1.036  clip_corner 3  ) 
 trs::outputlayer ~geom_inside (  geom_and (  Z3 Z4 ) geom_or (  LATCHUP NODRC ) ) 
}
trs::rule LU_S_1b {
trs::rule_comment LU.3a-LU.3d define minimum space (S1) between NMOS and PMOS with either one of NMOS or PMOS ACT connected to I/O pad. (Fig.1).
trs::rule_comment For 1.8V N/PMOS ACT connected to an I/O pad
trs::rule_comment Spacing between 1.8V NMOS and 1.8V PMOS and Spacing between 1.8V PMOS and 1.8V/Core NMOS. >= 2.3um
 trs::setlayer X = geom_enclose (  NMOS_IO_PAD GATEMV ) 
 trs::setlayer Y = geom_enclose (  PMOS_IO_PAD GATEMV ) 
 trs::setlayer M = geom_enclose (  NMOS geom_or (  GATELV GATEMV ) ) 
 trs::setlayer N = geom_enclose (  PMOS geom_or (  GATELV GATEMV ) ) 
  trs::setlayer Z1 = geom_size ( X by 1.191  clip_corner 3  ) 
  trs::setlayer Z2 = geom_size ( N by 1.191  clip_corner 3  ) 
  trs::outputlayer ~geom_inside (  geom_not (  geom_and (  Z1 Z2 ) SRINGBLK ) geom_or (  LATCHUP NODRC ) ) 
  trs::setlayer Z3 = geom_size ( M by 1.191  clip_corner 3  ) 
  trs::setlayer Z4 = geom_size ( Y by 1.191  clip_corner 3  ) 
  trs::outputlayer ~geom_inside (  geom_not (  geom_and (  Z3 Z4 ) SRINGBLK ) geom_or (  LATCHUP NODRC ) ) 
}

trs::rule LU_S_1c {
trs::rule_comment LU.3a-LU.3d define minimum space (S1) between NMOS and PMOS with either one of NMOS or PMOS ACT connected to I/O pad. (Fig.1).
trs::rule_comment For 2.5V N/PMOS ACT connected to an I/O pad
trs::rule_comment Spacing between 2.5V NMOS and 2.5V PMOS and Spacing between 2.5V PMOS and 2.5V/Core NMOS. >= 3.2um
 trs::setlayer X = geom_enclose (  NMOS_IO_PAD GATEHV ) 
 trs::setlayer Y = geom_enclose (  PMOS_IO_PAD GATEHV ) 
 trs::setlayer M = geom_enclose (  NMOS geom_or (  GATELV GATEHV ) ) 
 trs::setlayer N = geom_enclose (  PMOS geom_or (  GATELV GATEHV ) ) 
 trs::setlayer Z1 = geom_size ( X by 1.657  clip_corner 3  ) 
 trs::setlayer Z2 = geom_size ( N by 1.657  clip_corner 3  ) 
 trs::outputlayer ~geom_inside (  geom_not (  geom_and (  Z1 Z2 ) SRINGBLK ) geom_or (  LATCHUP NODRC ) ) 
 trs::setlayer Z3 = geom_size ( M by 1.657  clip_corner 3  ) 
 trs::setlayer Z4 = geom_size ( Y by 1.657  clip_corner 3  ) 
 trs::outputlayer ~geom_inside (  geom_not (  geom_and (  Z3 Z4 ) SRINGBLK ) geom_or (  LATCHUP NODRC ) ) 
}

trs::rule LU_S_1d {
trs::rule_comment For 3.3 V N/PMOS (or 2.5V overdrive 3.3V) ACT connected to an I/O pad
trs::rule_comment Spacing between 3.3V NMOS and 3.3V/0.9V/1.2V PMOS and
trs::rule_comment Spacing between 3.3V PMOS and 3.3V/0.9V/1.2V NMOS. >= 5um
 trs::setlayer X = geom_enclose (  NMOS_IO_PAD geom_and (  GATEHV OD ) ) 
 trs::setlayer Y = geom_enclose (  PMOS_IO_PAD geom_and (  GATEHV OD ) ) 
 trs::setlayer M = geom_enclose (  NMOS geom_or (  GATELV geom_and (  GATEHV OD ) ) ) 
 trs::setlayer N = geom_enclose (  PMOS geom_or (  GATELV geom_and (  GATEHV OD ) ) ) 
#~geom_inside (  geom_not (  space (  X N < 5  adjacent < 90  point_touch region ) SRINGBLK ) NODRC ) 
#~geom_inside (  geom_not (  space (  Y M < 5  adjacent < 90  point_touch region ) SRINGBLK ) NODRC ) 
 trs::setlayer Z1 = geom_size ( X by 2.589  clip_corner 3  ) 
 trs::setlayer Z2 = geom_size ( N by 2.589  clip_corner 3  ) 
 trs::outputlayer ~geom_inside (  geom_not (  geom_and (  Z1 Z2 ) SRINGBLK ) geom_or (  LATCHUP NODRC ) ) 
 trs::setlayer Z3 = geom_size ( M by 2.589  clip_corner 3  ) 
 trs::setlayer Z4 = geom_size ( Y by 2.589  clip_corner 3  ) 
 trs::outputlayer ~geom_inside (  geom_not (  geom_and (  Z3 Z4 ) SRINGBLK ) geom_or (  LATCHUP NODRC ) ) 
}
 
trs::pvrs_block  {
#ENDIF 
}

trs::pvrs_block  {
#IFDEF LU_3_CHECK ACCURATE 
}
trs::rule LU_S_1a {
trs::rule_comment LU.3a-LU.3d define minimum space (S1) between NMOS and PMOS with either one of NMOS or PMOS ACT connected to I/O pad. (Fig.1).
trs::rule_comment For core N/PMOS connected to an I/O pad
trs::rule_comment Spacing between NMOS and PMOS. >= 2um
 trs::setlayer X = geom_enclose (  NMOS_IO_PAD GATELV ) 
 trs::setlayer Y = geom_enclose (  PMOS_IO_PAD GATELV ) 
 trs::setlayer M = geom_enclose (  NMOS GATELV ) 
 trs::setlayer N = geom_enclose (  PMOS GATELV ) 
 trs::outputlayer ~geom_inside (  geom_not (  space (  X N < 2  adjacent < 90  point_touch region ) SRINGBLK ) geom_or (  LATCHUP NODRC ) ) 
 trs::outputlayer ~geom_inside (  geom_not (  space (  M Y < 2  adjacent < 90  point_touch region ) SRINGBLK ) geom_or (  LATCHUP NODRC ) ) 
}

trs::rule LU_S_1b {
trs::rule_comment LU.3a-LU.3d define minimum space (S1) between NMOS and PMOS with either one of NMOS or PMOS ACT connected to I/O pad. (Fig.1).
trs::rule_comment For 1.8V N/PMOS ACT connected to an I/O pad
trs::rule_comment Spacing between 1.8V NMOS and 1.8V/Core PMOS and Spacing between 1.8V PMOS and 1.8V/Core NMOS. >= 2.3um
 trs::setlayer X = geom_enclose (  NMOS_IO_PAD GATEMV ) 
 trs::setlayer Y = geom_enclose (  PMOS_IO_PAD GATEMV ) 
 trs::setlayer M = geom_enclose (  NMOS geom_or (  GATELV GATEMV ) ) 
 trs::setlayer N = geom_enclose (  PMOS geom_or (  GATELV GATEMV ) ) 
 trs::outputlayer ~geom_inside (  geom_not (  space (  M Y < 2.3  adjacent < 90  point_touch region ) SRINGBLK ) geom_or (  LATCHUP NODRC ) ) 
 trs::outputlayer ~geom_inside (  geom_not (  space (  X N < 2.3  adjacent < 90  point_touch region ) SRINGBLK ) geom_or (  LATCHUP NODRC ) ) 
}

trs::rule LU_S_1c {
trs::rule_comment LU.3a-LU.3d define minimum space (S1) between NMOS and PMOS with either one of NMOS or PMOS ACT connected to I/O pad. (Fig.1).
trs::rule_comment For 2.5V N/PMOS ACT connected to an I/O pad
trs::rule_comment Spacing between 2.5V NMOS and 2.5V/Core PMOS and Spacing between 2.5V PMOS and 2.5V/Core NMOS. >= 3.2um
 trs::setlayer X = geom_enclose (  NMOS_IO_PAD GATEHV ) 
 trs::setlayer Y = geom_enclose (  PMOS_IO_PAD GATEHV ) 
 trs::setlayer M = geom_enclose (  NMOS geom_or (  GATELV GATEHV ) ) 
 trs::setlayer N = geom_enclose (  PMOS geom_or (  GATELV GATEHV ) ) 
 trs::outputlayer ~geom_inside (  geom_not (  space (  M Y < 3.2  adjacent < 90  point_touch region ) SRINGBLK ) geom_or (  LATCHUP NODRC ) ) 
 trs::outputlayer ~geom_inside (  geom_not (  space (  X N < 3.2  adjacent < 90  point_touch region ) SRINGBLK ) geom_or (  LATCHUP NODRC ) ) 
}

trs::rule LU_S_1d {
trs::rule_comment LU.3a-LU.3d define minimum space (S1) between NMOS and PMOS with either one of NMOS or PMOS ACT connected to I/O pad. (Fig.1).
trs::rule_comment For 3.3 V N/PMOS ACT (2.5V overdrive) connected to an I/O pad
trs::rule_comment Spacing between 3.3V NMOS and 3.3V/Core PMOS and Spacing between 3.3V PMOS and 3.3V/Core NMOS >= 5.0um.
 trs::setlayer X = geom_enclose (  NMOS_IO_PAD geom_and (  GATEHV OD ) ) 
 trs::setlayer Y = geom_enclose (  PMOS_IO_PAD geom_and (  GATEHV OD ) ) 
 trs::setlayer M = geom_enclose (  NMOS geom_or (  GATELV geom_and (  GATEHV OD ) ) ) 
 trs::setlayer N = geom_enclose (  PMOS geom_or (  GATELV geom_and (  GATEHV OD ) ) ) 
 trs::outputlayer ~geom_inside (  geom_not (  space (  X N < 5  adjacent < 90  point_touch region ) SRINGBLK ) geom_or (  LATCHUP NODRC ) ) 
 trs::outputlayer ~geom_inside (  geom_not (  space (  Y M < 5  adjacent < 90  point_touch region ) SRINGBLK ) geom_or (  LATCHUP NODRC ) ) 

}

trs::pvrs_block  {
#ENDIF 
}
trs::rule LU_S_2_NTAP {
trs::rule_comment Space (S2) from any point within the Source/Drain region to the nearest pickup ACT region inside the same well for I/O and internal circuits. (Fig.2). 
trs::rule_comment For native device, DRC check the pickup ACT inside the PSUB butted PW area, and PW is still treated as connection by substrate even one NW ring inserted. <= 35um
 trs::setlayer NW_MINUS_NTAP_0 = geom_size ( NTAP by 5  inside_of_layer     NW delta 0.38  clip_corner 4  ) 
 trs::setlayer MAYBE_BAD_b = geom_not (  NW NW_MINUS_NTAP_0 ) 
 trs::setlayer NW_FILTER = geom_interact (  NW MAYBE_BAD_b ) 
 trs::setlayer NW_MINUS_NTAP_1 = geom_and (  NW_MINUS_NTAP_0 NW_FILTER ) 
 trs::setlayer NW_MINUS_NTAP = geom_size ( NW_MINUS_NTAP_1 by 30  inside_of_layer     NW_FILTER delta 0.38  clip_corner 4  ) 
 trs::setlayer X = geom_and (  PMOS1 NW_FILTER ) 
 trs::outputlayer ~edge_inside (  ~edge_inside (  edge_outside (  X NW_MINUS_NTAP ) SRINGBLK ) NODRC ) 
}

trs::rule LU_S_2_PTAP {
trs::rule_comment Space (S2) from any point within the Source/Drain region to the nearest pickup ACT region inside the same well for I/O and internal circuits.(Fig. 7.3.14-2) 
trs::rule_comment For native device, DRC check the pickup ACT inside the PSUB butted PW area, and PW is still treated as connection by substrate even one NW ring inserted. <= 35um
trs::setlayer PW_MINUS_PTAP_0 = geom_size ( PTAP by 5  inside_of_layer     PW delta 0.38  clip_corner 4  ) 
 trs::setlayer MAYBE_BAD_b = geom_not (  PW PW_MINUS_PTAP_0 ) 
 trs::setlayer PW_FILTER = geom_interact (  PW MAYBE_BAD_b ) 
 trs::setlayer PW_MINUS_PTAP_1 = geom_and (  PW_MINUS_PTAP_0 PW_FILTER ) 
 trs::setlayer PW_MINUS_PTAP = geom_size ( PW_MINUS_PTAP_1 by 30  inside_of_layer     PW_FILTER delta 0.38  clip_corner 4  ) 
 trs::setlayer X = geom_and (  NMOS1 PW_FILTER ) 
 trs::outputlayer ~edge_inside (  ~edge_inside (  edge_outside (  X PW_MINUS_PTAP ) SRINGBLK ) NODRC ) 

 trs::setlayer SIZE_REGION = geom_or (  PW PSUB NW ) 
 trs::setlayer SIZE_PTAP_NOT_DNW = geom_not (  PTAP ~geom_interact (  DNW PSUB ) ) 
 trs::setlayer PW_SIZE_a = geom_size ( SIZE_PTAP_NOT_DNW by 5  inside_of_layer     SIZE_REGION delta 0.38  clip_corner 4  ) 
 trs::setlayer MAYBE_BAD_PSUB_a = geom_not (  SIZE_REGION PW_SIZE_a ) 
 trs::setlayer PW_FILTER_PSUB_a = geom_interact (  SIZE_REGION MAYBE_BAD_PSUB_a ) 
 trs::setlayer PW_MINUS_PTAP_PSUB_a = geom_and (  PW_SIZE_a PW_FILTER_PSUB_a ) 
 trs::setlayer PW_SIZE_1 = geom_size ( PW_MINUS_PTAP_PSUB_a by 30  inside_of_layer     PW_FILTER_PSUB_a delta 0.38  clip_corner 4  ) 
 trs::setlayer NMOS_PSUB_a = geom_and (  ~geom_interact (  geom_and (  NMOS1 PSUB ) DNW ) PW_FILTER_PSUB_a ) 
 trs::outputlayer ~edge_inside (  ~edge_inside (  edge_outside (  NMOS_PSUB_a PW_SIZE_1 ) SRINGBLK ) NODRC ) 

 trs::setlayer SIZE_PTAP_AND_DNW = geom_interact (  geom_and (  PTAP geom_interact (  PW PSUB ) ) DNW ) 
 trs::setlayer PW_SIZE_b = geom_size ( SIZE_PTAP_AND_DNW by 5  inside_of_layer     SIZE_REGION delta 0.38  clip_corner 4  ) 
 trs::setlayer MAYBE_BAD_PSUB_b = geom_not (  SIZE_REGION PW_SIZE_b ) 
 trs::setlayer PW_FILTER_PSUB_b = geom_interact (  SIZE_REGION MAYBE_BAD_PSUB_b ) 
 trs::setlayer PW_MINUS_PTAP_PSUB_b = geom_and (  PW_SIZE_b PW_FILTER_PSUB_b ) 
 trs::setlayer PW_SIZE_2 = geom_size ( PW_MINUS_PTAP_PSUB_b by 30  inside_of_layer     PW_FILTER_PSUB_b delta 0.38  clip_corner 4  ) 
 trs::setlayer NMOS_PSUB_b = geom_and (  geom_interact (  geom_and (  NMOS1 PSUB ) DNW ) PW_FILTER_PSUB_b ) 
 trs::outputlayer ~edge_inside (  ~edge_inside (  edge_outside (  NMOS_PSUB_b PW_SIZE_2 ) SRINGBLK ) NODRC ) 

}
trs::pvrs_block  {
#ENDIF 
}


trs::pvrs_block  {
#IFDEF MOM_CHECK YES 
}
#//===================================================
#//  MOM design rules
#//===================================================
group_rule GMOM MOM_? 

trs::rule MOM_R_1 {
trs::rule_comment It is not allowed:
trs::rule_comment 1) V1 in M1MOM
trs::rule_comment 2) Vn/Vn-1 in MOMMKn (n = 2~8), whereVn-1 is the via underneath Mn, and Vn is the via above Mn. Vn can be inter-via or T4V1/T2V1 or T4V2/T2V2
for {set i 1} { $i < [expr [llength $v_j] +1 ] } {incr i 1} {
trs::outputlayer ~geom_inside (  geom_and (  "V${i}" "M${i}MOM" ) NODRC ) 
trs::outputlayer ~geom_inside (  geom_and (  "V${i}" "M[expr ${i} +1]MOM" ) NODRC ) 
set top_inner_mk M[expr ${i} +1]MOM
}
set topvia [lindex $top_v_m_list 0]
trs::outputlayer ~geom_inside (  geom_and (  $topvia $top_inner_mk ) NODRC ) 
}

trs::rule MOM_S_1 {
trs::rule_comment The space between (Mn AND MOMMKn AND MOMLVS1) and Vn/Vn-1 (n = 1~8) outside of MOMLVS1, whereVn-1 is the via underneath Mn, and Vn is the via above Mn. Vn can be inter-via or T4V1 or T4V2. >= 0.11um
for {set i 1} { $i < [expr [llength $v_j] +1 ] } {incr i 1} {
trs::outputlayer ~geom_inside (  space (  geom_outside (  "V${i}" MOMLVS1 ) geom_and (  geom_and (  "M${i}" "M${i}MOM" ) MOMLVS1 ) < 0.11  adjacent < 90  point_touch region ) NODRC ) 
trs::outputlayer ~geom_inside (  space (  geom_outside (  "V${i}" MOMLVS1 ) geom_and (  geom_and (  "M[expr ${i} +1]" "M[expr ${i} +1]MOM" ) MOMLVS1 ) < 0.11  adjacent < 90  point_touch region ) NODRC ) 
set top_inner_mk M[expr ${i} +1]MOM
set top_inner_metal M[expr ${i} +1]
}
set topvia [lindex $top_v_m_list 0]
trs::outputlayer ~geom_inside (  space (  geom_outside (  $topvia MOMLVS1 ) geom_and (  geom_and (  $top_inner_metal $top_inner_mk ) MOMLVS1 ) < 0.11  adjacent < 90  point_touch region ) NODRC ) 
}

trs::rule MOM_R_2 {
trs::rule_comment MOMLVS1 and MOMMKn layers are must for MOM device. DRC checking is based on the label text by MOMLVS1 layer. Possible label texts and related MOMMKn follow the Table-1. DRC need flag the stacked MOM structure

set MOMMK_list { M1MOM, M2MOM, M3MOM, M4MOM, M5MOM, M6MOM, M7MOM, M8MOM }
set momcap_list { 12 13 14 15 16 17 18 23 24 25 26 27 28 34 35 36 37 38 45 46 47 48 56 57 58 67 68 78 }

foreach k $momcap_list {
trs::setlayer "M1MOM_${k}" = geom_interact (  M1MOM geom_with_label ( MOMLVS1 "\"momcap${k}\"" MOMLVS1 ) ) 
trs::setlayer "M2MOM_${k}" = geom_interact (  M2MOM geom_with_label ( MOMLVS1 "\"momcap${k}\"" MOMLVS1 ) ) 
trs::setlayer "M3MOM_${k}" = geom_interact (  M3MOM geom_with_label ( MOMLVS1 "\"momcap${k}\"" MOMLVS1 ) ) 
trs::setlayer "M4MOM_${k}" = geom_interact (  M4MOM geom_with_label ( MOMLVS1 "\"momcap${k}\"" MOMLVS1 ) ) 
trs::setlayer "M5MOM_${k}" = geom_interact (  M5MOM geom_with_label ( MOMLVS1 "\"momcap${k}\"" MOMLVS1 ) ) 
trs::setlayer "M6MOM_${k}" = geom_interact (  M6MOM geom_with_label ( MOMLVS1 "\"momcap${k}\"" MOMLVS1 ) ) 
trs::setlayer "M7MOM_${k}" = geom_interact (  M7MOM geom_with_label ( MOMLVS1 "\"momcap${k}\"" MOMLVS1 ) ) 
trs::setlayer "M8MOM_${k}" = geom_interact (  M8MOM geom_with_label ( MOMLVS1 "\"momcap${k}\"" MOMLVS1 ) ) 
}

foreach k $momcap_list {
trs::setlayer "M1MOM_${k}_no" = geom_interact (  M1MOM ~geom_with_label ( MOMLVS1 "\"momcap${k}\"" MOMLVS1 ) ) 
trs::setlayer "M2MOM_${k}_no" = geom_interact (  M2MOM ~geom_with_label ( MOMLVS1 "\"momcap${k}\"" MOMLVS1 ) ) 
trs::setlayer "M3MOM_${k}_no" = geom_interact (  M3MOM ~geom_with_label ( MOMLVS1 "\"momcap${k}\"" MOMLVS1 ) ) 
trs::setlayer "M4MOM_${k}_no" = geom_interact (  M4MOM ~geom_with_label ( MOMLVS1 "\"momcap${k}\"" MOMLVS1 ) ) 
trs::setlayer "M5MOM_${k}_no" = geom_interact (  M5MOM ~geom_with_label ( MOMLVS1 "\"momcap${k}\"" MOMLVS1 ) ) 
trs::setlayer "M6MOM_${k}_no" = geom_interact (  M6MOM ~geom_with_label ( MOMLVS1 "\"momcap${k}\"" MOMLVS1 ) ) 
trs::setlayer "M7MOM_${k}_no" = geom_interact (  M7MOM ~geom_with_label ( MOMLVS1 "\"momcap${k}\"" MOMLVS1 ) ) 
trs::setlayer "M8MOM_${k}_no" = geom_interact (  M8MOM ~geom_with_label ( MOMLVS1 "\"momcap${k}\"" MOMLVS1 ) ) 
}

foreach k $momcap_list {
trs::setlayer "MOMLVS1_${k}" = geom_with_label ( MOMLVS1 "\"momcap${k}\"" MOMLVS1 ) 
trs::setlayer "MOMLVS1_${k}_no" = ~geom_with_label ( MOMLVS1 "\"momcap${k}\"" MOMLVS1 ) 
}

