POSDP = edge_adjacent ( both_side  geom_with_edge ( PO POSDP_1 ) PGATE ) 
~geom_inside (  space (  BUTSDN_1 POSDP < 0.30  adjacent < 90  region ) NODRC ) 
}


RULE PP_EN_1 { 
; Enclosure of P+ ACT in PW, except the SRAMALL region >= 0.02um

X = ~edge_coincident ( both_side  ~edge_coincident ( both_side  ~geom_interact (  PTAP NWR ) NACT ) SDN ) 
~geom_inside (  ~geom_inside (  extension (  X SDP < 0.02  adjacent < 90  region ) SRAMALL ) NODRC ) 
}
RULE PP_EN_2 { 
; Enclosure of P+ ACT NW1, except the SRAMALL region. >= 0.12um

X = edge_inside (  ~edge_coincident ( both_side  ~edge_coincident ( both_side  ~geom_interact (  PACT NWR ) NACT ) SDN ) NW ) 
~geom_inside (  ~geom_inside (  extension (  X geom_and (  SDP NW ) < 0.12  adjacent < 90  region ) SRAMALL ) NODRC ) 
}

RULE PP_EN_3 { 
;Minimum PP Enclosure of POLY >=0.15um

PO_inter = geom_not (  POLYi geom_or (  ACT POLYres HPR ) ) 
PO_CUT = geom_interact (  geom_interact (  PO_inter SDP ) SDN ) 
~geom_inside (  ~geom_inside (  extension (  geom_not (  PO_inter PO_CUT ) SDP < 0.15  adjacent < 90  region ) SRAMALL ) NODRC ) 
}

RULE PP_EX_1_EX_1a { 
; PP extension outside of PMOS GATE along source/drain direction. >= 0.16um
; PP extension of PMOS gate poly when PP edge on ACT. >= 0.3um
SDP_S = ~geom_inside (  SDP SRAMALL ) 
PACT_S = ~geom_inside (  PACT SRAMALL ) 
call_fun (SNP_68 SDP_S PACT_S 0.3 0.16 0.2 ) 

}

RULE PP_O_1 { 
; Overlap of PP and ACT >= 0.12um

~geom_inside (  
width (  SDP 
~edge_adjacent ( both_side  AA SDP ) < 0.12  adjacent < 90  region ) NODRC ) 
}
RULE PP_A_1 { 
; PP area >= 0.12um2

~geom_inside (  
geom_area  ( SDP < 0.120  ) NODRC ) 
}
RULE PP_A_2 { 
; PP enclosed area >= 0.12um2

~geom_inside (  
geom_area  ( 
geom_not (  
geom_holes ( SDP inner_most ) SDP ) < 0.12  ) NODRC ) 
}
RULE PP_A_3 { 
; Minimum area of butted PW TAP >= 0.04um2

~geom_inside (  
geom_area  ( 
geom_adjacent (  PTAP 
geom_not (  PACT PTAP ) ) < 0.04  ) NODRC ) 
