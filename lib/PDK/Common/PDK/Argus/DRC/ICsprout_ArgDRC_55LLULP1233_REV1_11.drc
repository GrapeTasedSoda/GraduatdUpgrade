#define the list for all inner metals and vias,temporarily
#define the list for all inner metals and inner vias,respectively
set v_m_list " "
set v_m_list_for_connect " "
set v_j " "
set v_j_layer " "
set m_j " "
set m_j_layer " "
set m_j_dummy " "
set SRCK20_layer_tmp " "
set SRCK20_tmp " "

for { set j 1 } { $j <= [expr $total_metal -$top_metal] } { incr j } {
  if { [set CHECK_M$j] == 1 } { 
    lappend v_m_list M$j
    lappend v_m_list_for_connect M${j}i
    lappend m_j $j
    lappend m_j_layer M$j
    lappend m_j_dummy MET${j}dmi
    lappend SRCK20_layer_tmp M${j}S_RING
    lappend SRCK20_tmp !!(AREA(M${j}S_RING))
  }
  if { [set CHECK_M$j] == 0 } break
  if { $j < 8 } {
    if { [set CHECK_V$j] == 1 } {
    lappend v_m_list V$j
    lappend v_m_list_for_connect V${j}
    lappend v_j $j
    lappend v_j_layer V$j
    lappend SRCK20_layer_tmp V${j}S
    lappend SRCK20_tmp !!(AREA(V${j}S))
    }
  }
}
#define the list for all metals and vias
#define the list for top metals and top vias
set top_v_m_list " "
set top_v_m_list_all {  T2V1 T2M1 T2V2 T2M2 T4V1 T4M1 T4V2 T4M2 T8V1 T8M1 T8V2 T8M2 }
foreach top_v_m_layer $top_v_m_list_all {
  set tmp CHECK_$top_v_m_layer
  set tmp_v [set $tmp]
  if { $tmp_v == 1 } {
    lappend v_m_list $top_v_m_layer
    lappend v_m_list_for_connect ${top_v_m_layer}i
    lappend top_v_m_list $top_v_m_layer
  }
}


#define the lists for top metals and top vias,respectively
set t_v_j " "
set t_m_j " "
set t_v_list_all { T2V1 T2V2 T4V1 T4V2 T8V1 T8V2}
set t_m_list_all { T2M1 T2M2 T4M1 T4M2 T8M1 T8M2}

foreach t_v_list_layer $t_v_list_all {
  if { [set CHECK_$t_v_list_layer] == 1 } {
    lappend t_v_j $t_v_list_layer
  }
}
foreach t_m_list_layer $t_m_list_all {
  if { [set CHECK_$t_m_list_layer] == 1 } {
    lappend t_m_j $t_m_list_layer
  }
}


#define the lists for all metal layers and all via layers,respectively
set metal_all [concat $m_j_layer $t_m_j]
set via_all [concat $v_j_layer $t_v_j]


#define the list for T2M1 and T2M2,T4M1 and T4M2, T8M1 and T8M2 respectively
#define the list for T2M1DUM and T2M2DUM,T4M1DUM and T4M2DUM, T8M1DUM and  T8M2DUM respectively
set t_m_j_STM " "
set t_m_j_STDUM " "
set t_m_j_TM " "
set t_m_j_TMDUM " " 
set t_m_j_UTM " "
set t_m_j_UTMDUM " "
foreach t_m_j_STM_layer { T2M1 T2M2 } {
  if { [set CHECK_$t_m_j_STM_layer] == 1 } {
    lappend t_m_j_STM $t_m_j_STM_layer
    lappend t_m_j_STDUM ${t_m_j_STM_layer}dmi
  }
}
foreach t_m_j_TM_layer { T4M1 T4M2 } {
  if { [set CHECK_$t_m_j_TM_layer] == 1 } {
    lappend t_m_j_TM $t_m_j_TM_layer
    lappend t_m_j_TMDUM ${t_m_j_TM_layer}dmi
  }
}
foreach t_m_j_UTM_layer { T8M1 T8M2 } {
  if { [set CHECK_$t_m_j_UTM_layer] == 1 } {
    lappend t_m_j_UTM $t_m_j_UTM_layer
    lappend t_m_j_UTMDUM ${t_m_j_UTM_layer}dmi
  }
}


#define a list for all metal dummy layers
if {[lsearch $metal_all STM*] == -1 } {
  if { [lsearch $metal_all TM*] == -1} {
 set metal_dummy_list [concat $m_j_dummy $t_m_j_UTMDUM]
 } elseif {[lsearch $metal_all TM*] == 1} {
 set metal_dummy_list [concat $m_j_dummy $t_m_j_TMDUM $t_m_j_UTMDUM]
 } elseif {[lsearch $metal_all TM*] == 2} {
 set metal_dummy_list [concat $m_j_dummy $t_m_j_TMDUM]
 } else {
 puts "\nWrong metal option combination. Please check the setting for metal options.\n"
 exit
 }
} elseif { [lsearch $metal_all STM*] == 1 } {
  if { [lsearch $metal_all TM*] == -1 } {
 set metal_dummy_list [concat $m_j_dummy $t_m_j_STMDUM $t_m_j_UTMDUM]
 } elseif { [lsearch $metal_all TM*] == 1 } {
  set metal_dummy_list [concat $m_j_dummy $t_m_j_STMDUM $t_m_j_TMDUM]
 } else {  
  puts "\nWrong metal option combination. Please check the setting for metal options.\n"
 exit
 }
} elseif { [lsearch $metal_all STM*] == 2 } {
  set metal_dummy_list [concat $m_j_dummy $t_m_j_STMDUM]
 } else { 
 puts "\nWrong metal option combination. Please check the setting for metal options.\n"
 exit
 }

for { set i 0 } { $i < [expr [llength $v_m_list_for_connect] -2] } { incr i 2 } {
  connect "[lindex $v_m_list_for_connect $i]" "[lindex $v_m_list_for_connect [expr $i +2]]" by "[lindex $v_m_list_for_connect [expr $i +1]]" 
}
if { [string equal $T2V2_T2M2 1] == 1 } {
connect T2M2i CBi 
connect T2M2i RDLi by RV 
} 
if { [string equal $T4V2_T4M2 1] == 1 } {
connect T4M2i CBi 
connect T4M2i RDLi by RV 
} 
if { [string equal $T8V2_T8M2 1] == 1 } {
connect T8M2i CBi 
connect T8M2i RDLi by RV 
} 
connect RDLi COVER 
connect CBi ALPAi 
connect RDLi ALPAi 
connect ALPAi MDi 
connect M1i PO0 NTAP0 PTAP0 PSDi NSDi by CTi 
connect NTAP0 NW0 
connect NW1i DNWi 
#//NW interact with DNW

connect NTAP0 NW1i 
#//N+pickup interact with NW

connect PTAP0 PWi 
#//P+pickup interact with (NOT NW)

connect NTAP0 PSDi 
#//N+pickup butted P+ silicided S/D

connect PTAP0 NSDi 
#//P+pickup butted N+ silicided S/D

connect PSDi PSD 
connect NSDi NSD 
connect NW1i NW 
connect DNWi DNW 
connect PWi PW 
connect CTi CT 
set metal_all_reverse " "
for { set i 0 } { $i < [llength $metal_all] } { incr i } {
  lappend metal_all_reverse [lindex $metal_all end-$i]i
}

label_level text top_cell 
#LAYOUT TOP LAYER $metal_all_reverse
lvs_power ?VDD? ?VCC? 

attach_order $metal_all_reverse NTAP0 PTAP0 NSDi PSDi PO0 NW1i 



#// VIRTUAL CONNECT NOTICE!
#// Power name below should be adjusted following the power naming convention to detect NW spacing rule violations correctly.
virtual_connect name ?VDD? ?VCC? ?VSS? ?GND? 
virtual_connect colon  yes 


trs::pvrs_block  {
//******************************************
//    LAYER DERIVATIONS AND OPERATIONS
//******************************************
//==================
// For Connectivity
//==================
PACTi = geom_and (  PPi ACTi ) 
NACTi = geom_and (  NPi ACTi ) 

PTAPi = geom_not (  PACTi NW1i ) 
NTAPi = geom_and (  NACTi NW1i ) 
ALL_TAPi = geom_or (  PTAPi NTAPi ) 
PGATEi = geom_and (  PACTi POLYi ) 
NGATEi = geom_and (  NACTi POLYi ) 

PSDi = geom_and (  geom_not (  PACTi PGATEi ) NW1i ) 
NSDi = geom_not (  geom_not (  NACTi NGATEi ) NW1i ) 
ALL_SDi = geom_or (  PSDi NSDi ) 
PMOSi = geom_interact (  geom_or (  PGATEi PSDi ) GATE ) 
NMOSi = geom_interact (  geom_or (  NGATEi NSDi ) GATE ) 

AARES = copy ( ACTres ) 
PORES = copy ( POLYres ) 

AA_resistor = geom_or (  geom_and (  geom_and (  AA AARES ) SAB ) ~geom_interact (  geom_and (  AA AARES ) SAB ) ) 
PO_resistor = geom_or (  geom_or (  geom_and (  geom_and (  PO PORES ) SAB ) ~geom_interact (  geom_and (  PO PORES ) SAB ) ) HPR ) 
NW_resistor_AA = geom_and (  geom_and (  geom_and (  NW1res AA ) NW ) SAB ) 
NW_resistor_STI = ~geom_interact (  geom_and (  NW1res NW ) SAB ) 
NW_resistor = geom_or (  NW_resistor_AA NW_resistor_STI ) 

PO_all = geom_or (  POLYi POLYdmi ) 
AA_all = geom_or (  ACTi ACTdmi ) 
//AA0 = geom_not ( geom_not ( ACTi geom_or ( AA_resistor NW1res ) ) POLYi )


PO0 = geom_not (  POLYi geom_and (  SAB geom_or (  PORES HPR ) ) ) 
NW0 = geom_not (  NW1i NW1res ) 
NW00 = geom_not (  NW NW1res ) 

PTAP0 = geom_not (  PACTi NW1i ) 
NTAP0 = geom_and (  NACTi NW1i ) 

HVNW0 = geom_and (  NW00 HVNW ) 
MVNW0 = geom_and (  NW00 MVNW ) 
LVNW0 = geom_and (  NW00 LVNW ) 
//PO_raw = geom_not ( PO SAB )


PO_raw = copy ( PO ) 
//==================
//  Resistor Def
//==================
NWR = geom_interact (  NW NW1res ) 
AAR = geom_interact (  AA AARES ) 
POR = geom_interact (  PO PORES ) 


NR = geom_inside (  NWR AA ) 
AANR = geom_interact (  AA NWR ) 
SDNNR = geom_interact (  SDN NWR ) 
SDPNR = geom_interact (  SDP NWR ) 

NWDEV = geom_not (  NW geom_or (  NWR NR ) ) 
AADEV = geom_not (  AA geom_or (  AAR AANR ) ) 
PODEV = geom_not (  PO POR ) 
SDNDEV = geom_not (  SDN SDNNR ) 
SDPDEV = geom_not (  SDP SDPNR ) 
//=============
//   HRP Def
//=============
PO_HRP = geom_and (  geom_and (  geom_and (  HPR PO ) HRP ) SAB ) 
//PO_HRP = geom_interact ( PO HRP )
//HR_PO = geom_and ( PO_HRP HPR )
//==================
//   Well Def
//==================
DRC:1 = geom_get_layout_boundary ( original_layer ) 
BULK = geom_size ( DRC:1 by 1  ) 
CHIP = copy ( DRC:1 ) 
//EMPTY = copy ( CHIP )


EMPTY1 = copy ( EMPTY ) 
//EMPTY4 = COPY ( EMPTY )

EMPTY5 = copy ( EMPTY ) 

PW_INNW = geom_not (  DNW NW ) 
DNW_EDGE = geom_edge_to_rect ( edge_inside (  DNW NW ) outside 0.001  ) 
NW_DNW = geom_interact (  NW DNW_EDGE ) 

DGTG = geom_or (  TG DG ) 

HVNW = ~geom_outside (  NW TG ) 
MVNW = ~geom_outside (  NW DG ) 
LVNW = geom_not (  geom_not (  NW HVNW ) MVNW ) 

HVNW1i = ~geom_outside (  NW1i TGOX ) 
MVNW1i = ~geom_outside (  NW1i DGOX ) 
LVNW1i = geom_not (  geom_not (  NW1i HVNW1i ) MVNW1i ) 
//==================
// Transistor Def
//==================
PACT = geom_and (  SDP AA ) 
NACT = geom_and (  SDN AA ) 
ACT = geom_or (  PACT NACT ) 


PPO = geom_and (  SDP PO ) 
NPO = geom_and (  SDN PO ) 

PTAP = geom_not (  PACT NW ) 
NTAP = geom_and (  NACT NW ) 
TAP = geom_or (  PTAP NTAP ) 

PICKAA = geom_not (  TAP geom_and (  geom_interact (  TAP GATE ) VARAM ) ) 
NON_PICKAA = geom_not (  AA PICKAA ) 


PGATE = geom_and (  PACT PO ) 
NGATE = geom_and (  NACT PO ) 

GATE0 = geom_and (  PO AA ) 
AA1 = geom_not (  geom_interact (  AA GATE0 ) GATE0 ) 
AA2 = geom_adjacent (  AA1 GATE0 == 2  ) 
AA3 = geom_interact (  AA1 CT ) 
AA4 = geom_or (  AA2 AA3 ) 
GATE1 = geom_adjacent (  GATE0 AA4 == 2  ) 
GATE2 = geom_and (  GATE0 LDMOS ) 
GATE = geom_or (  GATE1 GATE2 ) 

GATE_W_015 = width (  edge_inside (  AA PO ) < 0.15  opposite region ) 
AAcorner = space (  AA < 0.01  adjacent == 90  intersecting_only region ) 
POcorner = space (  PO < 0.01  adjacent == 90  intersecting_only region ) 
GATE_WIDTH_D15 = geom_size ( GATE_W_015 by 0.005  ) 
GATE_WIDTH_U15 = geom_size ( ~geom_interact (  GATE0 GATE_WIDTH_D15 ) by 0.005  ) 
PO015 = geom_interact (  PO GATE_W_015 ) 
AAintPO015 = geom_interact (  AA GATE_W_015 ) 
AA_CP = copy ( ACTi ) 
PO_CP = copy ( POLYi ) 
connect ( AA_CP PO_CP  ) 
connect ( PO015 AAintPO015  ) 

FPOLY = geom_not (  PO AA ) 
GATE_L = ~edge_coincident ( both_side  edge_coincident ( both_side  GATE AA ) PO ) 
GATE_W = edge_coincident ( both_side  GATE PO ) 
GATE_60nm = edge_inside (  geom_edge_to_rect ( GATE_W inside 0.06  ) GATE ) //for SAB_5
GATE_core = geom_not (  GATE geom_or (  DG TG ) ) //1.0/1.2V MOS GATE
GATE_core_L = ~edge_coincident ( both_side  edge_coincident ( both_side  GATE_core AA ) PO ) //1.0/1.2V MOS GATE LENGTH
GATE_core_W = edge_coincident ( both_side  GATE_core PO ) //1.0/1.2V MOS GATE WIDTH
GATE_io1 = geom_not (  geom_and (  GATE DG ) TG ) //1.8V MOS GATE
GATE_io1_L = ~edge_coincident ( both_side  edge_coincident ( both_side  GATE_io1 AA ) PO ) 
GATE_io1_W = edge_coincident ( both_side  GATE_io1 PO ) 

GATE_io2 = geom_not (  geom_and (  GATE TG ) DG ) 
GATE_io2_L = ~edge_coincident ( both_side  edge_coincident ( both_side  GATE_io2 AA ) PO ) 
GATE_io2_W = edge_coincident ( both_side  GATE_io2 PO ) 

GATE_var = geom_and (  GATE VARAM ) //VARMOS GATE
GATE_var_L = ~edge_coincident ( both_side  edge_coincident ( both_side  GATE_var AA ) PO ) //VARMOS GATE LENGTH
GATE_var_W = edge_coincident ( both_side  GATE_var PO ) //VARMOS GATE WIDTH
PSD = geom_adjacent (  geom_not (  PACT PGATE ) PGATE ) 
NSD = geom_adjacent (  geom_not (  NACT NGATE ) NGATE ) 

PMOS = geom_or (  PGATE PSD ) 
NMOS = geom_or (  NGATE NSD ) 
"MOS" = geom_or (  PMOS NMOS ) 

NMOS_CAP = geom_and (  NMOS NW ) 

PBAA = geom_and (  AA PSUB ) 
PBMOS = geom_and (  NMOS PSUB ) 
PBPO = geom_interact (  PO PSUB ) 
NOMI_AA = geom_not (  AA PBAA ) 


AAEIPO = edge_inside (  AA PO ) 
POEIAA = edge_inside (  PO AA ) 

INTERPO = geom_not (  PO GATE ) 
//=====================
//   Poly E-Fuse Def
//=====================
EFU = geom_interact (  PO EFUSEALL ) 
EFU_BO = geom_and (  EFU POEFUSEBLK ) 
RCT = geom_interact (  CT EFU ) 
RCT_RT = geom_rectangle ( RCT == 0.09  by == 0.30  ) 
//=====================
//     CT Def
//=====================
ACT_CT = geom_and (  CT AA ) 
INTERCT = geom_and (  CT INTERPO ) 
}

#//=====================
#//   AL Fuse Def
#//=====================

trs::setlayer ALFUSE = geom_and (  geom_and (  RDL FUSE ) FUTR ) 
trs::setlayer Al_fuse_1 = edge_length (  ALFUSE >= 4.44  ) 
trs::setlayer Al_fuse = geom_with_edge ( ALFUSE Al_fuse_1 >= 2  ) 
trs::setlayer Alfuse_edge = edge_length (  Al_fuse >= 4.44  ) 
trs::setlayer Alfuse_edge_1 = edge_convex_point ( ALFUSE adjacent_edge_angle1 == 270  adjacent_edge_angle2 == 270  ) 

for { set i 0 } { $i <= [llength $v_m_list] } { incr i 2 } {
  trs::setlayer "H[lindex $v_m_list $i]" = geom_interact (  geom_holes ( "[lindex $v_m_list $i]" inner_most ) FUSE ) 
  trs::setlayer "G[lindex $v_m_list $i]" = geom_and (  geom_adjacent (  "[lindex $v_m_list $i]" "H[lindex $v_m_list $i]" ) GRID ) 
   
  set j [expr $i +1]
  if { $j < [llength $v_m_list] } {
    trs::setlayer "G[lindex $v_m_list $j]" = geom_interact (  "[lindex $v_m_list $j]" "G[lindex $v_m_list $i]" ) 
    trs::setlayer "[lindex $v_m_list $j]FUSE" = geom_inside (  "[lindex $v_m_list $j]" "H[lindex $v_m_list $i]" ) 
  }

  trs::pvrs_block  {
}
}

trs::setlayer GCT = geom_interact (  CT GM1 ) 
trs::setlayer CTFUSE = geom_inside (  CT HM1 ) 

trs::setlayer HRDL = geom_interact (  geom_holes ( RDL inner_most ) FUSE ) 
trs::setlayer GRDL = geom_and (  geom_adjacent (  RDL HRDL ) GRID ) 
trs::setlayer GRDLV = geom_interact (  RDLVIA GRDL ) 
trs::setlayer RDLVF = geom_inside (  RDLVIA HRDL ) 

set Stack_Vn "geom_interact ([lindex $via_all end]FUSE RDLVF)"
for { set i 1 } { $i < [llength $via_all] } { incr i } {
  set Stack_Vn "geom_interact ([lindex $via_all end-$i]FUSE ${Stack_Vn})"
}
trs::setlayer Stack_Vn  = $Stack_Vn

set Stack_MR "geom_or (G[lindex $metal_all end] GRDL)"
for { set i 1 } { $i < [llength $metal_all] } { incr i } {
  set Stack_MR "geom_or (G[lindex $metal_all end-$i] ${Stack_MR})"
}
trs::setlayer Stack_MR  = $Stack_MR


trs::setlayer LMARK = geom_and (  geom_and (  RDL FUSE ) LOGO ) 


#--------------------------------------------------------------------------------------------------------------------------------

#****************************************************
# MACRO for wide metal space rule
#****************************************************

proc Mn_2b { MTLAY MTLEN MTWID MTSPA } {
  trs::setlayer span_edge_0 = dfm_copy ( dfm_check_space ( by_int $MTLAY < $MTWID ) edge ) 
  trs::setlayer span_edge_1 = ~edge_coincident ( both_side  $MTLAY span_edge_0 ) 
  trs::setlayer span_edge = space (  "\[span_edge_1\]" $MTLAY < $MTSPA opposite adjacent < 90  ) 
  trs::outputlayer ~edge_inside (  edge_length (  span_edge >= $MTLEN ) NODRC ) 
}
proc Mn_2b_SPECIAL { MTLAY MTLEN MTWID MTSPA } {
  trs::setlayer span_edge_0 = dfm_copy ( dfm_check_space ( by_int $MTLAY < $MTWID ) edge ) 
  trs::setlayer span_edge_1 = ~edge_coincident ( both_side  $MTLAY span_edge_0 ) 
  trs::setlayer span_edge = space (  "\[span_edge_1\]" $MTLAY < $MTSPA opposite adjacent < 89.9  ) 
  trs::outputlayer ~edge_inside (  edge_length (  span_edge >= $MTLEN ) NODRC ) 
}



proc Mn_2b_DUM { MTLAY DUMMY2 MTLEN MTWID MTSPA } {
  trs::setlayer X0_a = geom_with_width ( $MTLAY >= $MTWID ) 
  trs::setlayer X0 = geom_enclose_rectangle ( X0_a $MTLEN $MTWID ) 
  trs::setlayer X1 = space (  $MTLAY < $MTSPA opposite region parallel_only ) 
  trs::setlayer X2 = edge_length (  X1 >= $MTLEN ) 
  trs::setlayer X3 = edge_adjacent ( both_side  X2 X0 ) 
  trs::setlayer X4_near = geom_edge_to_rect ( X3 outside $MTWID ) 
  trs::setlayer X4_far = geom_not (  geom_edge_to_rect ( X3 outside ( $MTWID+ 0.01 )  ) X4_near ) 
  trs::setlayer X5 = geom_not (  X4_near $MTLAY ) 
  trs::setlayer X6_near = space (  X1 X5 < $MTWID opposite region ) 
  trs::setlayer X6_far = space (  X4_far X5 < $MTWID opposite region ) 
  trs::setlayer X7 = geom_not (  geom_not (  X4_near X5 ) geom_or (  X6_near X6_far ) ) 
  trs::setlayer X7_edge = edge_length (  edge_coincident ( both_side  X7 X1 ) >= $MTLEN ) 
  trs::setlayer X7_expand = geom_edge_to_rect ( X7_edge outside $MTSPA ) 
  trs::setlayer X8 = geom_not (  geom_and (  X7_expand X1 ) X5 ) 
  trs::outputlayer ~geom_inside (  geom_interact (  X8 $DUMMY2 ) NODRC ) 
}

proc Mn_2c_DUM { MTLAY DUMMY2 MTLEN MTWID MTSPA } {
  trs::setlayer X0_a = geom_with_width ( $MTLAY >= $MTLEN ) 
  trs::setlayer X0 = geom_enclose_rectangle ( X0_a $MTLEN $MTWID ) 
  trs::setlayer X1 = space (  $MTLAY < $MTSPA opposite region parallel_only ) 
  trs::setlayer X2 = edge_length (  X1 >= $MTLEN ) 
  trs::setlayer X3 = edge_adjacent ( both_side  X2 X0 ) 
  trs::setlayer X4_near = geom_edge_to_rect ( X3 outside $MTWID ) 
  trs::setlayer X4_far = geom_not (  geom_edge_to_rect ( X3 outside ( $MTWID+ 0.01 )  ) X4_near ) 
  trs::setlayer X5 = geom_not (  X4_near $MTLAY ) 
  trs::setlayer X6_near = space (  X1 X5 < $MTWID opposite region ) 
  trs::setlayer X6_far = space (  X4_far X5 < $MTWID opposite region ) 
  trs::setlayer X7 = geom_not (  geom_not (  X4_near X5 ) geom_or (  X6_near X6_far ) ) 
  trs::setlayer X7_edge = edge_length (  edge_coincident ( both_side  X7 X1 ) >= $MTLEN ) 
  trs::setlayer X7_expand = geom_edge_to_rect ( X7_edge outside $MTSPA ) 
  trs::setlayer X8 = geom_not (  geom_and (  X7_expand X1 ) X5 ) 
  trs::outputlayer ~geom_inside (  geom_interact (  X8 $DUMMY2 ) NODRC ) 
}

#--------For AA PO shape -------------------------------------------------------------------------------------------------------------------------------
proc SHAPE { LAYER } {
trs::setlayer "${LAYER}_VEX_0" = edge_convex_point ( $LAYER == 0  ) 
trs::setlayer "${LAYER}_VEX_1" = edge_convex_point ( $LAYER == 1  ) 
trs::setlayer "${LAYER}_VEX_2" = edge_convex_point ( $LAYER == 2  ) 


trs::setlayer "${LAYER}_LS" = geom_with_edge ( geom_with_edge ( ~geom_with_edge ( $LAYER "${LAYER}_VEX_0" ) "${LAYER}_VEX_1" == 2  ) "${LAYER}_VEX_2" == 4  ) 

trs::setlayer "${LAYER}_TS1" = geom_with_edge ( geom_with_edge ( ~geom_with_edge ( $LAYER "${LAYER}_VEX_0" ) "${LAYER}_VEX_1" == 4  ) "${LAYER}_VEX_2" == 4  ) 
trs::setlayer "${LAYER}_TS2" = geom_edge_to_rect ( edge_coincident ( both_side  "${LAYER}_VEX_2" "${LAYER}_TS1" ) outside 0.005  fill_corner ) 
trs::setlayer "${LAYER}_TS3" = geom_with_edge ( "${LAYER}_TS2" "${LAYER}_VEX_2" == 3  ) 
trs::setlayer "${LAYER}_TS" = geom_interact (  "${LAYER}_TS1" "${LAYER}_TS3" == 1  ) 

trs::setlayer "${LAYER}_US" = geom_with_edge ( geom_with_edge ( geom_with_edge ( $LAYER "${LAYER}_VEX_0" == 1  ) "${LAYER}_VEX_1" == 2  ) "${LAYER}_VEX_2" == 5  ) 

trs::setlayer "${LAYER}_OS" = geom_with_edge ( ~geom_with_edge ( geom_with_edge ( $LAYER "${LAYER}_VEX_0" == 4  ) "${LAYER}_VEX_1" ) "${LAYER}_VEX_2" == 4  ) 

trs::setlayer "${LAYER}_HS" = geom_with_edge ( geom_with_edge ( geom_with_edge ( $LAYER "${LAYER}_VEX_0" == 2  ) "${LAYER}_VEX_1" == 4  ) "${LAYER}_VEX_2" == 6  ) 
}

SHAPE PO
SHAPE AA

#------------------FOR H SHAPE--------------------------
proc via_in_H_bar { via metal hole_length hole_area bar_l bar_w } {

trs::setlayer X0 = geom_area  ( geom_rectangle ( geom_holes ( $metal inner_most ) ) <= $hole_area ) 
trs::setlayer X1 = ~geom_with_edge ( X0 edge_length (  X0 > 5  ) ) 
trs::setlayer Y = edge_coincident ( both_side  $metal X1 ) 
trs::setlayer Y1 = geom_not (  space (  Y <= $bar_w opposite region ) $metal ) 
trs::setlayer Z0 = geom_interact (  $metal Y1 == 2  ) 
trs::setlayer Z1 = edge_length (  edge_coincident ( both_side  $metal Z0 ) <= 1  ) 
trs::setlayer Z = geom_with_edge ( Z0 Z1 ) 
}
#------------------FOR T4V1.10--------------------------
proc two_via_within_space_in_wide_metal { via metal_bottom metal_up metal_width } {

trs::setlayer X1a = geom_with_width ( $metal_bottom > $metal_width ) 
trs::setlayer X1b = geom_with_width ( $metal_up > $metal_width ) 
trs::setlayer WIDE = geom_or (  X1a X1b ) 
trs::setlayer X2 = geom_enclose (  geom_and (  $metal_bottom $metal_up ) ~geom_outside (  $via WIDE ) ) 
trs::setlayer X3 = geom_inside (  $via X2 ) 
trs::setlayer X5c = geom_with_adjacent ( X3 >= 1  inside_of_layer X2 ) 
trs::setlayer X6c = geom_enclose (  X2 X5c ) 
trs::outputlayer ~geom_inside (  geom_not (  geom_not (  X2 X6c ) SRINGBLK ) NODRC ) 
}


#//==================================
#//  DNW -  Deep N-Well  DRC
#//==================================

group_rule GDNW DNW_? 

trs::rule DNW_W_1 {
trs::rule_comment DNW width >= 3.00um
trs::outputlayer ~geom_inside (  width (  DNW < 3  adjacent < 90  point_touch region ) NODRC ) 
}

trs::rule DNW_S_1 {
trs::rule_comment Space between two DNWs >= 3.50um
trs::outputlayer ~geom_inside (  space (  DNW < 3.5  adjacent < 90  point_touch region ) NODRC ) 
}

trs::rule DNW_S_2a {
trs::rule_comment Space between DNW and NW1 at different net >= 2.35um
trs::outputlayer ~geom_inside (  space (  DNW NW < 2.35  point_touch region all_edge diff_net ) NODRC ) 
}

trs::rule DNW_S_3 {
trs::rule_comment Space between TPW and (TPW OR PW) >= 0.80um
trs::setlayer X = geom_inside (  PW DNW ) 
trs::setlayer Y = geom_or (  PW X ) 
trs::outputlayer ~geom_inside (  ~geom_inside (  space (  X Y < 0.80  adjacent < 90  point_touch region ) LDMOS ) NODRC ) 
}

trs::rule DNW_S_4 {
trs::rule_comment Space between TPW and (TPW OR PW) when at least one TPW OR PW interact DGOX >= 1.20um
trs::setlayer X0 = geom_interact (  geom_inside (  PW DNW ) geom_or (  DG TG ) ) 
trs::setlayer X1 = geom_interact (  geom_or (  geom_inside (  PW DNW ) PW ) geom_or (  DG TG ) ) 
trs::setlayer X2 = ~geom_interact (  geom_or (  geom_inside (  PW DNW ) PW ) geom_or (  DG TG ) ) 
trs::setlayer X3 = ~geom_interact (  geom_inside (  PW DNW ) geom_or (  DG TG ) ) 
trs::outputlayer ~geom_inside (  ~geom_inside (  space (  X0 X2 < 1.20  adjacent < 90  point_touch region ) LDMOS ) NODRC ) 
trs::outputlayer ~geom_inside (  ~geom_inside (  space (  X3 X1 < 1.20  adjacent < 90  point_touch region ) LDMOS ) NODRC ) 
}

trs::rule DNW_S_5 {
trs::rule_comment Space between DNW and N+ACT >= 1.60um
trs::outputlayer ~geom_inside (  space (  DNW NSDi < 1.60  point_touch region ) NODRC ) 
}

trs::rule DNW_EN_1 {
trs::rule_comment NW1 Enclosure of DNW >= 1.00um
trs::outputlayer ~geom_inside (  extension (  DNW NW < 1  adjacent < 90  point_touch region ) NODRC ) 
trs::outputlayer ~edge_inside (  edge_coincident ( both_side  DNW NW ) NODRC ) 
trs::outputlayer ~edge_inside (  edge_outside (  DNW NW ) NODRC ) 
}
trs::rule DNW_EN_2 {
trs::rule_comment Enclosure of N+ ACT >= 0.55um
trs::outputlayer ~geom_inside (  extension (  geom_not (  NACT geom_or (  NTAP PTAP ) ) DNW < 0.55  adjacent < 90  point_touch region ) NODRC ) 
}
trs::rule DNW_O_1 {
trs::rule_comment Overlap of NW1 and DNW. >= 0.40um 
  trs::setlayer X = geom_size ( DNW by -0.4  ) 
  trs::outputlayer ~geom_inside (  geom_not (  geom_not (  DNW X ) NW ) NODRC ) 
}

trs::rule DNW_R_1 {
trs::rule_comment It is recommanded DNW be enclosed by NW1
trs::outputlayer ~edge_inside (  ~edge_coincident ( both_side  ~edge_inside (  DNW NW_DNW ) NW_DNW ) NODRC ) 
}

#RULE DNW_R_2 { 
#}
#  @ NWs in same DNW must be same potential
#}    // checked in LVS ERC

trs::rule DNW_R_3 {
trs::rule_comment Floating TPW is not allowed. DRC flags TPW not TOUCH CT in P+ pickup ACT
trs::setlayer X = geom_inside (  PW DNW ) 
trs::outputlayer ~geom_interact (  X geom_interact (  CT PTAP ) ) 
}

#//===========================
#//  ACT - Active Area DRC
#//===========================

group_rule GAA ACT_? 

trs::rule ACT_W_1 {
trs::rule_comment ACT width >= 0.08um
trs::outputlayer ~geom_inside (  width (  AA < 0.08  adjacent < 90  point_touch region ) NODRC ) 
}
trs::rule ACT_W_2 {
trs::rule_comment Width of 45 degree bent ACT >= 0.18um
trs::setlayer X = edge_angle (  AA == 45  ) 
trs::outputlayer ~geom_inside (  width (  X < 0.18  adjacent < 90  region ) NODRC ) 
}
trs::rule ACT_W_3a {
trs::rule_comment Channel width for 0.9/1.2V NMOS/PMOS transistors >= 0.12um
trs::setlayer Y = edge_length (  GATE_core_W < 0.12  ) 
trs::outputlayer ~geom_inside (  ~geom_inside (  geom_edge_to_rect ( Y inside 0.001  ) SRAMALL ) NODRC ) 
}
trs::rule ACT_W_3b {
trs::rule_comment Channel width for 1.8/2.5V/3.3V NMOS/PMOS transistors >= 0.21um
trs::setlayer Y = edge_length (  GATE_io1_W < 0.21  ) 
trs::outputlayer ~geom_inside (  ~geom_inside (  geom_edge_to_rect ( Y inside 0.001  ) SRAMALL ) NODRC ) 
trs::setlayer Z = edge_length (  GATE_io2_W < 0.21  ) 
trs::outputlayer ~geom_inside (  ~geom_inside (  geom_edge_to_rect ( Z inside 0.001  ) SRAMALL ) NODRC ) 
}
trs::pvrs_block  {
#IFDEF OPEN_RECOMMENDED_ON YES 
}
trs::rule ACT_W_3a_R {
trs::rule_comment Recommended Channel width for 0.9/1.2V NMOS/PMOS transistors >= 0.15um
trs::setlayer Y = edge_length (  GATE_core_W < 0.15  ) 
trs::outputlayer ~geom_inside (  ~geom_inside (  geom_edge_to_rect ( Y inside 0.001  ) SRAMALL ) NODRC ) 
}

trs::pvrs_block  {
#ENDIF 
}
trs::rule ACT_L_1 {
trs::rule_comment Maximum ACT length between two contacts, or between one contact and ACT line end when ACT width < 0.15um <= 25.00um
trs::setlayer AA_1 = geom_interact (  AA CT ) 
trs::setlayer AA_CHECK = geom_with_width ( AA_1 < 0.15  ) 

trs::setlayer Z0 = geom_size ( CT by 12.5  inside_of_layer     AA_CHECK delta 0.02  ) 
trs::setlayer Z1 = geom_interact (  Z0 CT < 2  ) 
trs::setlayer Z2 = geom_not (  geom_interact (  AA_CHECK Z1 ) geom_interact (  AA_CHECK CT == 1  ) ) 
trs::outputlayer ~geom_inside (  Z2 NODRC ) 
trs::setlayer AA_CHECK_2 = width (  AA_1 < 0.15  opposite region ) 
trs::setlayer Z4 = ~geom_interact (  AA_CHECK_2 CT ) 
trs::setlayer Z6 = edge_length (  Z4 > 25  ) 
trs::outputlayer ~edge_inside (  Z6 NODRC ) 

trs::setlayer X = edge_convex_point ( AA adjacent_edge_angle1 >= 89.9  <= 90.1  adjacent_edge_angle2 >= 89.9  <= 90.1  with_edge_length < 0.15  ) 
trs::setlayer Y = geom_interact (  geom_with_width ( AA < 0.15  ) CT ) 
trs::setlayer Z = edge_adjacent ( both_side  Y X ) 
trs::setlayer Z3 = geom_size ( CT by 25  inside_of_layer     Y delta 0.02  ) 
trs::outputlayer ~edge_inside (  ~edge_adjacent ( both_side  ~edge_inside (  Z Z3 ) Z3 ) NODRC ) 
}
trs::rule ACT_L_2 {
trs::rule_comment Maximum ACT length of Source Active (without CT, width <= 0.15um) which butted with tap <= 0.5um
trs::setlayer AA_1 = ~geom_interact (  ALL_SDi CT ) 
trs::setlayer AA_2 = geom_with_width ( AA_1 < 0.15  ) 
trs::setlayer AA_3 = geom_interact (  AA_2 ALL_TAPi ) 
trs::setlayer AA_4 = edge_length (  AA_3 > 0.5  ) 
trs::outputlayer ~geom_inside (  ~geom_inside (  geom_with_edge ( ALL_SDi AA_4 ) SRAMALL ) NODRC ) 
}

trs::rule ACT_S_1 {
trs::rule_comment Space between two ACTs > = 0.11um
trs::outputlayer ~geom_inside (  space (  AA < 0.11  adjacent < 90  point_touch region ) geom_or (  NODRC SRAMALL ) ) 
}

trs::pvrs_block  {
#IFDEF OPEN_RECOMMENDED_ON YES 
}
trs::rule ACT_S_1_R {
trs::rule_comment Recommended Space between two ACTs > = 0.16um

trs::outputlayer ~geom_inside (  space (  AA < 0.16  adjacent < 90  point_touch region ) geom_or (  NODRC SRAMALL ) ) 
}

trs::rule ACT_S_2a_R {
trs::rule_comment Recommended Space between ACT and huge ACT(area> 2000000um2) is 0.35um

trs::setlayer ACT_huge = geom_area  ( AA > 2000000  ) 
trs::outputlayer ~geom_inside (  space (  AA ACT_huge < 0.35  adjacent < 90  point_touch region ) geom_or (  NODRC SRAMALL ) ) 
}

trs::pvrs_block  {
#ENDIF 
}

trs::rule ACT_S_1a {
trs::rule_comment Space between two ACTs at least one ACT inside by TGOX
trs::setlayer AA_TG = geom_inside (  AA TG ) 
trs::outputlayer ~geom_inside (  space (  AA AA_TG < 0.16  adjacent < 90  point_touch region ) geom_or (  NODRC SRAMALL ) ) 
}

trs::rule ACT_S_2 {
trs::rule_comment Space between ACTs when one or both ACT width greater than 0.2um parallel length >= 0.3,  >= 0.125
trs::setlayer X = geom_with_width ( AA > 0.2  ) 
trs::setlayer Y = space (  X AA < 0.125  opposite region ) 
trs::outputlayer ~geom_inside (  geom_enclose_rectangle ( Y 0.3  0.08  orthogonal ) geom_or (  NODRC SRAMALL ) ) 
}

trs::rule ACT_S_3 {
trs::rule_comment Space to 45 degree bent ACT >= 0.18um
trs::setlayer X = edge_angle (  AA == 45  ) 
trs::outputlayer ~geom_inside (  space (  X AA < 0.18  adjacent < 90  region ) NODRC ) 
}

trs::rule ACT_S_4 {
trs::rule_comment Space between U-shape (or O-shape) ACT inner edges >= 0.18um
trs::outputlayer ~edge_inside (  edge_convex_point ( AA_OS == 0  with_edge_length < 0.18  ) NODRC ) 
trs::outputlayer ~edge_inside (  edge_convex_point ( AA_US == 0  with_edge_length < 0.18  ) NODRC ) 
}
trs::rule ACT_S_5 {
trs::rule_comment Space between NW1 and N+ACT inside PW except NW1 resistor region >= 0.15um
trs::setlayer X = space (  ~geom_interact (  NW NW1res ) geom_inside (  NACT PW ) < 0.15  adjacent < 90  point_touch region ) 
trs::outputlayer ~geom_inside (  ~geom_inside (  X SRAMALL ) NODRC ) 
}
trs::rule ACT_S_6 {
trs::rule_comment Space between NW1 and N+ACT inside TGOX >= 0.31um
trs::setlayer X = space (  ~geom_interact (  NW NW1res ) geom_inside (  NACT TG ) < 0.31  adjacent < 90  point_touch region ) 
trs::outputlayer ~geom_inside (  ~geom_inside (  X SRAMALL ) NODRC ) 
}

trs::rule ACT_S_7 {
trs::rule_comment Space between N+ACT, which is not enclosed by DNW, and NW1 which encloses a DNW >= 0.32um
trs::setlayer X = space (  NACT NW_DNW < 0.32  adjacent < 90  point_touch region ) 
trs::outputlayer ~geom_inside (  geom_not (  X DNW ) NODRC ) 

}
trs::rule ACT_S_8 {
trs::rule_comment Space between NW1 and P+ pickup ACT except LDMOS region >= 0.15um
trs::setlayer X = space (  NW ~geom_inside (  geom_not (  geom_not (  PACT NW ) PSUB ) LDMOS ) < 0.15  adjacent < 90  point_touch region ) 
trs::outputlayer ~geom_inside (  ~geom_inside (  X SRAMALL ) NODRC ) 
}
trs::rule ACT_EN_1 {
trs::rule_comment Enclosure of N+ACT by NW1 (excluding NW1 interacting with NW1res) >= 0.15um
trs::setlayer X = extension (  NACT ~geom_interact (  NW NW1res ) < 0.15  adjacent < 90  point_touch region ) 
trs::outputlayer ~geom_inside (  ~geom_inside (  X SRAMALL ) NODRC ) 
}

trs::rule ACT_EN_2 {
trs::rule_comment Enclosure P+ACT by NW1 >= 0.15um
trs::setlayer X = extension (  PACT NW < 0.15  adjacent < 90  point_touch region ) 
trs::outputlayer ~geom_inside (  ~geom_inside (  X SRAMALL ) NODRC ) 
}

trs::rule ACT_EN_2a {
trs::rule_comment Enclosure P+ACT by (NW1 INTERACT TGOX) >= 0.31um
trs::setlayer X = extension (  PACT geom_interact (  NW TG ) < 0.31  adjacent < 90  point_touch region ) 
trs::outputlayer ~geom_inside (  ~geom_inside (  X SRAMALL ) NODRC ) 
}

trs::rule ACT_A_1 {
trs::rule_comment AA area >= 0.0384um2
trs::setlayer X = geom_area  ( AA < 0.0384  ) 
trs::outputlayer ~geom_inside (  ~geom_inside (  X SRAMALL ) NODRC ) 
}
trs::rule ACT_A_2 {
trs::rule_comment Enclosed area >= 0.08um2
trs::outputlayer ~geom_inside (  geom_area  ( geom_not (  geom_holes ( AA inner_most ) AA ) < 0.08  ) NODRC ) 
}

trs::pvrs_block  {
#IFDEF Density_rules YES 
}
trs::rule ACT_D_1_min {
trs::rule_comment AA density (including dummy ACT) in 100umX100um window with step size 50um >= 20%
trs::rule_comment <= 80%
trs::outputlayer ~geom_inside (  check_density ( AA_all < 0.20  by_window 100  delta 50  boundary_backup output_log density_report_ACT_D_1_min.log ) NODRC ) 
}
trs::rule ACT_D_1_max {
trs::rule_comment AA density (including dummy ACT) in 100umX100um window with step size 50um >= 20%
trs::rule_comment <= 80%
trs::outputlayer ~geom_inside (  check_density ( AA_all > 0.80  by_window 100  delta 50  boundary_backup output_log density_report_ACT_D_1_max.log ) NODRC ) 
}

trs::rule ACT_D_2 {
trs::rule_comment ACT density inside of dummy block area size up 2.5um, >= 10%
trs::setlayer X1 = geom_inside (  AA_all geom_size ( geom_or (  AADUMB SRBLK ) by 2.5  ) ) 
trs::outputlayer ~geom_inside (  check_density ( X1 < 0.10  by_window 20  delta 10  boundary_backup output_log density_report_ACT_D_2.log ) NODRC ) 
}
trs::rule ACT_D_3 {
trs::rule_comment ACT density gradienct <= 20%
  trs::setlayer X = check_density ( AA_all >= 0  check_gradient > 0.2  absolute_value boundary_backup inside_of_layer density_checkarea output_log density_report_ACT_D_3.log ) 
  trs::outputlayer ~geom_inside (  geom_not (  geom_not (  geom_not (  geom_not (  X FUTR ) GRID ) SRINGBLK ) INDALL ) NODRC ) 
}

trs::rule ACT_D_4_min {
trs::rule_comment Global ACT density for fully chip (including dummy ACT) >= 25%
trs::rule_comment <= 75%
trs::outputlayer ~geom_inside (  check_density ( AA_all < 0.25  output_log density_report_ACT_D_4_min.log ) NODRC ) 
}
trs::rule ACT_D_4_max {
trs::rule_comment Global ACT density for fully chip (including dummy ACT) >= 25%
trs::rule_comment <= 75%
trs::outputlayer ~geom_inside (  check_density ( AA_all > 0.75  output_log density_report_ACT_D_4_max.log ) NODRC ) 
}
trs::pvrs_block  {
#ENDIF 
}
trs::rule ACT_R_1 {
trs::rule_comment ACT must be fully covered by (NP OR PP), except NW1 resistor region
trs::outputlayer ~geom_interact (  geom_not (  AA geom_or (  SDN SDP ) ) NW1res ) 
}

#//==================================
#//  NW1 -  N-Well  DRC
#//==================================

group_rule GNW1 NW1_? 

trs::setlayer NW_RE = ~edge_outside (  NW NW1res ) 
trs::setlayer LVNW_RE = edge_coincident ( both_side  NW_RE LVNW ) 
trs::setlayer MVNW_RE = edge_coincident ( both_side  NW_RE MVNW ) 
trs::setlayer HVNW_RE = edge_coincident ( both_side  NW_RE HVNW ) 

trs::setlayer NW_RES = geom_and (  NW NW1res ) 

trs::rule NW1_W_1 {
trs::rule_comment NW1 width >= 0. 47um
trs::outputlayer ~geom_inside (  ~geom_inside (  width (  NW < 0.47  adjacent < 90  point_touch region ) SRAMALL ) NODRC ) 
}


trs::rule NW1_S_1 {
trs::rule_comment Space between NW1s >= 0. 47um
trs::outputlayer ~geom_inside (  geom_not (  space (  LVNW0 < 0.47  adjacent < 90  point_touch region ) NW_RES ) NODRC ) 
}

trs::rule NW1_S_2 {
trs::rule_comment Space between 0.9/1.2V NW1s at different nets >= 1.0um
trs::outputlayer ~geom_inside (  geom_not (  space (  LVNW0 < 1  adjacent < 90  point_touch region diff_net ) NW_RES ) NODRC ) 
trs::outputlayer ~geom_inside (  geom_not (  space (  MVNW0 < 1  adjacent < 90  point_touch region diff_net ) NW_RES ) NODRC ) 
trs::outputlayer ~geom_inside (  geom_not (  space (  HVNW0 < 1  adjacent < 90  point_touch region diff_net ) NW_RES ) NODRC ) 
trs::outputlayer ~geom_inside (  space (  LVNW_RE LVNW < 1  region ) NODRC ) 
}

trs::rule NW1_S_3 {
trs::rule_comment Space between 0.9/1.2V NW1 and 1.8/2.5/3.3V NW1 at different nets. >= 1.20um
trs::outputlayer ~geom_inside (  space (  LVNW0 HVNW0 < 1.2  adjacent < 90  point_touch region diff_net ) NODRC ) 
trs::outputlayer ~geom_inside (  space (  LVNW0 MVNW0 < 1.2  adjacent < 90  point_touch region diff_net ) NODRC ) 

trs::outputlayer ~geom_inside (  space (  LVNW_RE MVNW < 1.2  adjacent < 90  region ) NODRC ) 
trs::outputlayer ~geom_inside (  space (  LVNW_RE HVNW < 1.2  adjacent < 90  region ) NODRC ) 
trs::outputlayer ~geom_inside (  space (  MVNW_RE LVNW < 1.2  adjacent < 90  region ) NODRC ) 
trs::outputlayer ~geom_inside (  space (  HVNW_RE LVNW < 1.2  adjacent < 90  region ) NODRC ) 
}
trs::rule NW1_S_4 {
trs::rule_comment Space between 1.8/2.5/3.3V NW1s at same nets. >= 0.47um
trs::outputlayer ~geom_inside (  ~geom_inside (  space (  MVNW0 < 0.47  adjacent < 90  point_touch region same_net ) NW_RES ) NODRC ) 
trs::outputlayer ~geom_inside (  ~geom_inside (  space (  HVNW0 < 0.47  adjacent < 90  point_touch region same_net ) NW_RES ) NODRC ) 
trs::outputlayer ~geom_inside (  space (  MVNW0 HVNW0 < 0.47  adjacent < 90  point_touch region same_net ) NODRC ) 
}

trs::rule NW1_S_5 {
trs::rule_comment Space between 1.8/2.5/3.3V NW1s at different nets. >= 1.2 um
trs::outputlayer ~geom_inside (  geom_not (  space (  MVNW0 < 1.2  adjacent < 90  point_touch region diff_net ) NW_RES ) NODRC ) 
trs::outputlayer ~geom_inside (  geom_not (  space (  HVNW0 < 1.2  adjacent < 90  point_touch region diff_net ) NW_RES ) NODRC ) 
trs::outputlayer ~geom_inside (  space (  MVNW0 HVNW0 < 1.2  adjacent < 90  point_touch region diff_net ) NODRC ) 

trs::outputlayer ~geom_inside (  space (  MVNW_RE MVNW < 1.2  adjacent < 90  region ) NODRC ) 
trs::outputlayer ~geom_inside (  space (  HVNW_RE HVNW < 1.2  adjacent < 90  region ) NODRC ) 
trs::outputlayer ~geom_inside (  space (  MVNW_RE HVNW < 1.2  adjacent < 90  region ) NODRC ) 
trs::outputlayer ~geom_inside (  space (  HVNW_RE MVNW < 1.2  adjacent < 90  region ) NODRC ) 
}

trs::rule NW1_A_1 {
trs::rule_comment NW1 area >= 0.30um2
trs::outputlayer ~geom_inside (  geom_area  ( NW < 0.3  ) NODRC ) 
}

trs::rule NW1_A_2 {
trs::rule_comment Enclosed area >= 0.3um2
trs::outputlayer ~geom_inside (  geom_area  ( geom_not (  geom_holes ( NW inner_most ) NW ) < 0.3  ) NODRC ) 
}

trs::rule NW1_R_1 {
trs::rule_comment Floating NW1 is not allowed.
trs::outputlayer ~geom_inside (  ~geom_interact (  NW geom_enclose (  NTAP CT ) ) NODRC ) 
}

#//==========================================
#//  PSUB - Native NMOS blocked implant DRC
#//==========================================

group_rule GPSUB PSUB_? 


trs::rule PSUB_W_1 {
trs::rule_comment PSUB width >= 0.47um
trs::outputlayer ~geom_inside (  width (  PSUB < 0.47  adjacent < 90  point_touch region ) NODRC ) 
}
trs::rule PSUB_W_2a {
trs::rule_comment 0.9/1.2/1.8/2.5/3.3V native NMOS channel width >= 0.50um
trs::rule_comment 0.9/1.2/1.8/2.5/3.3V native NMOS channel width <= 100um
trs::setlayer X = edge_length (  GATE_W < 0.5  ) 
trs::setlayer Y = edge_length (  GATE_W > 100  ) 
trs::outputlayer ~geom_inside (  geom_and (  geom_edge_to_rect ( X inside 0.005  ) PSUB ) NODRC ) 
trs::outputlayer ~geom_inside (  geom_and (  geom_edge_to_rect ( Y inside 0.005  ) PSUB ) NODRC ) 
}

trs::rule PSUB_W_3a {
trs::rule_comment 0.9/1.2V native NMOS channel length >= 0.70um
trs::rule_comment 0.9/1.2V native NMOS channel length <= 100um
trs::setlayer X = ~edge_inside (  edge_inside (  PBPO PBAA ) geom_or (  DG TG ) ) 
trs::setlayer Y = edge_length (  GATE_core_L > 100  ) 
trs::outputlayer ~geom_inside (  width (  X < 0.70  opposite adjacent < 90  region ) NODRC ) 
trs::outputlayer ~geom_inside (  geom_and (  geom_edge_to_rect ( Y inside 0.005  ) PSUB ) NODRC ) 
}
trs::rule PSUB_W_3b {
trs::rule_comment 1.8V native NMOS channel length >= 0.8um
trs::rule_comment 1.8V native NMOS channel length <= 20um
trs::setlayer X = edge_inside (  PBPO geom_and (  PBAA DG ) ) 
trs::setlayer Y = edge_length (  GATE_io1_L > 20  ) 
trs::outputlayer ~geom_inside (  width (  X < 0.80  opposite adjacent < 90  region ) NODRC ) 
trs::outputlayer ~geom_inside (  geom_and (  geom_edge_to_rect ( Y inside 0.005  ) PSUB ) NODRC ) 
}

trs::pvrs_block  {
#IFDEF IO 1825 
}
trs::rule PSUB_W_3c {
trs::rule_comment 2.5V (or overdrive to 3.3V and underdrive to 1.8V) native NMOS channel length >= 2.0um
trs::setlayer X = edge_inside (  PBPO geom_and (  PBAA TG ) ) 
trs::outputlayer ~geom_inside (  width (  X < 2  opposite adjacent < 90  region ) NODRC ) 
}
trs::pvrs_block  {
#ENDIF 
}


trs::pvrs_block  {
#IFDEF IO 1833 
}
trs::rule PSUB_W_3d {
trs::rule_comment 3.3V native NMOS channel length >= 2.0um
trs::setlayer X = edge_inside (  PBPO geom_and (  PBAA TG ) ) 
trs::outputlayer ~geom_inside (  width (  X < 2  opposite adjacent < 90  region ) NODRC ) 
}
trs::pvrs_block  {
#ENDIF 
}

trs::rule PSUB_S_1 {
trs::rule_comment Space between two PSUBs >= 0.47um
trs::outputlayer ~geom_inside (  space (  PSUB < 0.47  adjacent < 90  point_touch region ) NODRC ) 
}

trs::rule PSUB_S_2 {
trs::rule_comment Space between PSUB and native MOS ACT >= 0.36um
trs::outputlayer ~geom_inside (  space (  PSUB "MOS" < 0.36  adjacent < 90  point_touch region ) NODRC ) 
trs::outputlayer ~geom_inside (  space (  PSUB AA_LDMOS < 0.36  adjacent < 90  point_touch region ) NODRC ) 
}

trs::rule PSUB_S_3 {
trs::rule_comment Space between PSUB and NW1 >= 1.15um
trs::outputlayer ~geom_inside (  space (  PSUB NW < 1.15  adjacent < 90  point_touch region ) NODRC ) 
}

trs::rule PSUB_EN_1 {
trs::rule_comment Native NMOS ACT enclosure by PSUB = 0.285um
trs::setlayer X = geom_size ( PBMOS by 0.285  ) 
trs::setlayer Y = geom_interact (  PSUB PBMOS ) 
trs::outputlayer ~geom_inside (  geom_xor (  X Y ) NODRC ) 
}

trs::rule PSUB_EX_1 {
trs::rule_comment Extension of native NMOS poly GATE outside of ACT
trs::rule_comment DRC doesn't flag INDALL covered regions. >= 0.32um
trs::outputlayer ~geom_inside (  ~geom_inside (  extension (  PBAA PBPO < 0.32  opposite adjacent < 90  region ) INDALL ) NODRC ) 
}

trs::rule PSUB_R_1 {
trs::rule_comment PSUB inside, overlapping with, or crossing over a DNW area is not allowed
trs::outputlayer ~geom_inside (  geom_and (  PSUB DNW ) NODRC ) 
trs::outputlayer ~edge_inside (  edge_coincident ( outside  PSUB DNW ) NODRC ) 
}

trs::rule PSUB_R_2 {
trs::rule_comment It is not allowed PSUB overlap PP ,DRC waive check INDALL covered region, and P+ pickup can be waived.
trs::setlayer X = ~geom_inside (  geom_and (  SDP PSUB ) INDALL ) 
trs::setlayer Y = geom_and (  geom_interact (  geom_or (  AA PO ) GATE ) PSUB ) 
trs::outputlayer ~geom_inside (  geom_interact (  X Y ) NODRC ) 
}

trs::rule PSUB_R_3 {
trs::rule_comment Only one ACT pattern is allowed in o PSUB region, except for NMOS capacitors
trs::outputlayer ~geom_inside (  geom_interact (  PSUB ~geom_interact (  AA INDALL ) > 1  ) NODRC ) 
}

trs::rule PSUB_A_1 {
trs::rule_comment PSUB area >= 0.60um2
trs::outputlayer ~geom_inside (  geom_area  ( PSUB < 0.6  ) NODRC ) 
}
trs::rule PSUB_A_2 {
trs::rule_comment Enclosed area >= 0.60um2
trs::outputlayer ~geom_inside (  geom_area  ( geom_not (  geom_holes ( PSUB inner_most ) PSUB ) < 0.60  ) NODRC ) 
}

trs::pvrs_block  {
//===============================
//   NVT3: High Vt NMOS Implant
//===============================
group_rule ( GNVT3 NVT3_?  ) 

RULE NVT3_W_1 { 
; NVT3 width. Single-point-interaction is allowed. >= 0.18um

~geom_inside (  
width (  HVTN < 0.18  adjacent < 90  region ) NODRC ) 
}

RULE NVT3_S_1 { 
; Space between two NVT3s >= 0.18um

~geom_inside (  
space (  HVTN < 0.18  opposite adjacent < 90  region ) NODRC ) 
}

RULE NVT3_S_2 { 
; Space between NVT3 and GATE along source/drain direction >= 0.180um

X = edge_coincident ( both_side  edge_inside (  PO geom_not (  AA HVTN ) ) GATE ) 
~geom_inside (  space (  X HVTN < 0.180  opposite adjacent < 90  region ) NODRC ) 
}

RULE NVT3_S_3 { 
; Space between NVT3 and ACT along GATE poly direction, excluding SRAM region >= 0.15um

X1 = edge_adjacent ( both_side  NACT edge_inside (  AA PO ) ) 
X2 = edge_adjacent ( both_side  PACT edge_inside (  AA PO ) ) 
X = edge_or ( X1 X2 ) 
~geom_inside (  ~geom_inside (  space (  X HVTN < 0.15  opposite adjacent < 90  region ) SRAMALL ) NODRC ) 
}

RULE NVT3_S_4 { 
; NVT3 space to non-silicide ACT >=0.21

X = ~geom_inside (  geom_and (  AA SAB ) HVTN ) 
~geom_inside (  space (  X HVTN < 0.21  opposite adjacent < 90  region ) NODRC ) 
}

RULE NVT3_EX_1 { 
; NVT3 extension outside of GATE along source/drain direction >= 0.18um

X = edge_coincident ( both_side  edge_inside (  PO geom_and (  NACT HVTN ) ) GATE ) 
Y = geom_edge_to_rect ( X outside 0.18  ) 
~geom_inside (  geom_not (  Y HVTN ) NODRC ) 
}

RULE NVT3_EX_2 { 
; NVT3 extension outside of MOS ACT along GATE poly length direction. >= 0.15um

X = edge_adjacent ( both_side  geom_and (  NACT HVTN ) GATE ) 
Y = extension (  X HVTN < 0.15  opposite adjacent < 90  region ) 
~geom_inside (  ~geom_inside (  Y SRAMALL ) NODRC ) 
}

RULE NVT3_A_1 { 
; NVT3 area >= 0.18um2

~geom_inside (  
~geom_inside (  
geom_area  ( HVTN < 0.18  ) SRAMALL ) NODRC ) 
}

RULE NVT3_A_2 { 
; NVT3 Enclosed area >= 0.18um2

~geom_inside (  
geom_area  ( 
geom_not (  
geom_holes ( HVTN inner_most ) HVTN ) < 0.18  ) NODRC ) 
}

RULE NVT3_R_1 { 
; It is not allowed NVT3 overlap with PSUB, P+ active ACT(exclude pick-up ACT), NVT1, DGOX or TGOX

~geom_inside (  
geom_and (  HVTN PSUB ) NODRC ) 
~geom_inside (  geom_and (  HVTN geom_not (  PACT geom_or (  NTAP PTAP ) ) ) NODRC ) 
~geom_inside (  geom_and (  HVTN LVTN ) NODRC ) 
~geom_inside (  geom_and (  HVTN DG ) NODRC ) 
~geom_inside (  geom_and (  HVTN TG ) NODRC ) 
}
//===============================
//   PVT3: High Vt PMOS Implant
//===============================
group_rule ( GPVT3 PVT3_?  ) 

RULE PVT3_W_1 { 
; PVT3 width. Single-point-interaction is allowed. >= 0.18um

~geom_inside (  
width (  HVTP < 0.18  adjacent < 90  region ) NODRC ) 
}

RULE PVT3_S_1 { 
; Space between two PVT3s >= 0.18um

~geom_inside (  
space (  HVTP < 0.18  opposite adjacent < 90  region ) NODRC ) 
}

RULE PVT3_S_2 { 
; Space between PVT3 and GATE along source/drain direction >= 0.180um

X = edge_coincident ( both_side  edge_inside (  PO AA ) GATE ) 
~geom_inside (  space (  X HVTP < 0.180  opposite adjacent < 90  region ) NODRC ) 
}

RULE PVT3_S_3 { 
; Space between PVT3 and ACT along poly length direction, excluding SRAM region >= 0.15um

X1 = edge_adjacent ( both_side  PACT edge_inside (  AA PO ) ) 
X2 = edge_adjacent ( both_side  NACT edge_inside (  AA PO ) ) 
X = edge_or ( X1 X2 ) 
~geom_inside (  ~geom_inside (  space (  X HVTP < 0.15  opposite adjacent < 90  region ) SRAMALL ) NODRC ) 
}

RULE PVT3_S_4 { 
; PVT3 space to non-silicide ACT >=0.21

X = ~geom_inside (  geom_and (  AA SAB ) HVTP ) 
~geom_inside (  space (  X HVTP < 0.21  opposite adjacent < 90  region ) NODRC ) 
}

RULE PVT3_EX_1 { 
; PVT3 extension outside of GATE along source/drain direction >= 0.180um

X = edge_coincident ( both_side  edge_inside (  PO geom_and (  PACT HVTP ) ) GATE ) 
Y = geom_edge_to_rect ( X outside 0.180  ) 
~geom_inside (  geom_not (  Y HVTP ) NODRC ) 
}

RULE PVT3_EX_2 { 
; PVT3 extension outside of ACT along GATE poly length direction. >= 0.15um

X = edge_adjacent ( both_side  geom_and (  PACT HVTP ) GATE ) 
Y = extension (  X HVTP < 0.15  opposite adjacent < 90  region ) 
~geom_inside (  ~geom_inside (  Y SRAMALL ) NODRC ) 
}

RULE PVT3_A_1 { 
; PVT3 area >= 0.18um2

~geom_inside (  
~geom_inside (  
geom_area  ( HVTP < 0.18  ) SRAMALL ) NODRC ) 
}

RULE PVT3_A_2 { 
; PVT3 Enclosed area >= 0.18um2

~geom_inside (  
geom_area  ( 
geom_not (  
geom_holes ( HVTP inner_most ) HVTP ) < 0.18  ) NODRC ) 
}

RULE PVT3_R_1 { 
; It is not allowed PVT3 overlap with PSUB, N+ active ACT(exclude pick-up ACT), PVT1, DGOX or TGOX 

~geom_inside (  
geom_and (  HVTP PSUB ) NODRC ) 
~geom_inside (  geom_and (  HVTP geom_not (  NACT geom_or (  NTAP PTAP ) ) ) NODRC ) 
~geom_inside (  geom_and (  HVTP LVTP ) NODRC ) 
~geom_inside (  geom_and (  HVTP DG ) NODRC ) 
~geom_inside (  geom_and (  HVTP TG ) NODRC ) 
}
//===========================================
//  NVT1: low Vt NMOS design minima 
//===========================================
group_rule ( GNVT1 NVT1_?  ) 

RULE NVT1_W_1 { 
; NVT1 width. Single-point-interaction is allowed. >= 0.18um

~geom_inside (  
width (  LVTN < 0.18  adjacent < 90  region ) NODRC ) 
}

RULE NVT1_S_1 { 
; Space between two NVT1s >= 0.18um

~geom_inside (  
space (  LVTN < 0.18  opposite adjacent < 90  region ) NODRC ) 
}

RULE NVT1_S_2 { 
; Space between NVT1 and GATE along source/drain direction >= 0.180um

X1 = edge_inside (  PO geom_not (  NACT LVTN ) ) 
X2 = edge_inside (  PO geom_not (  PACT LVTN ) ) 
X = edge_or ( X1 X2 ) 
~geom_inside (  space (  LVTN X < 0.180  opposite adjacent < 90  region ) NODRC ) 
}

RULE NVT1_S_3 { 
; Space between NVT1 and ACT along poly length direction. >= 0.15um

X1 = edge_adjacent ( both_side  NACT edge_inside (  AA PO ) ) 
X2 = edge_adjacent ( both_side  PACT edge_inside (  AA PO ) ) 
X = edge_or ( X1 X2 ) 
~geom_inside (  space (  X LVTN < 0.15  opposite adjacent < 90  region ) NODRC ) 
}

RULE NVT1_S_4 { 
; NVT1 space to non-silicide ACT >=0.21

A = edge_inside (  LVTN GATE ) 
B = edge_outside (  LVTN GATE ) 
X = ~geom_inside (  geom_and (  AA SAB ) LVTN ) 
~geom_inside (  space (  X LVTN < 0.21  opposite adjacent < 90  region ) NODRC ) 
}

RULE NVT1_EX_1 { 
; NVT1 extension outside of GATE along source/drain direction >= 0.180um

X = edge_inside (  PO geom_and (  NACT LVTN ) ) 
Y = geom_edge_to_rect ( X outside 0.180  ) 
~geom_inside (  geom_not (  Y LVTN ) NODRC ) 
}

RULE NVT1_EX_2 { 
; NVT1 extension outside of ACT along GATE poly length direction. >= 0.15um

X = edge_adjacent ( both_side  geom_and (  NACT LVTN ) GATE ) 
~geom_inside (  extension (  X LVTN < 0.15  opposite adjacent < 90  region ) NODRC ) 
}

RULE NVT1_A_1 { 
; NVT1 area >= 0.18um2

~geom_inside (  
geom_area  ( LVTN < 0.18  ) NODRC ) 
}
RULE NVT1_A_2 { 
; NVT1 enclosed area >= 0.18um2

~geom_inside (  
geom_area  ( 
geom_not (  
geom_holes ( LVTN inner_most ) LVTN ) < 0.18  ) NODRC ) 
}

RULE NVT1_R_1 { 
; It is not allowed NVT1 overlap with PSUB, P+ active ACT(exclude pick-up ACT),DGOX or TGOX 

~geom_inside (  
geom_and (  LVTN PSUB ) NODRC ) 
~geom_inside (  geom_and (  LVTN geom_not (  PACT geom_or (  NTAP PTAP ) ) ) NODRC ) 
~geom_inside (  geom_and (  LVTN DG ) NODRC ) 
~geom_inside (  geom_and (  LVTN TG ) NODRC ) 
}
//============================================
//  PVT1:  low Vt PMOS design minima 
//============================================
group_rule ( GPVT1 PVT1_?  ) 

RULE PVT1_W_1 { 
; PVT1 width >= 0.18um

~geom_inside (  
width (  LVTP < 0.18  adjacent < 90  region ) NODRC ) 
}
RULE PVT1_S_1 { 
; Space between two PVT1s >= 0.18um

~geom_inside (  
space (  LVTP < 0.18  opposite adjacent < 90  region ) NODRC ) 
}

RULE PVT1_S_2 { 
; Space between PVT1 and GATE of along source/drain direction >= 0.18um

X1 = edge_inside (  PO geom_not (  PACT LVTP ) ) 
X2 = edge_inside (  PO geom_not (  NACT LVTP ) ) 
X = edge_or ( X1 X2 ) 
~geom_inside (  space (  LVTP X < 0.18  opposite adjacent < 90  region ) NODRC ) 
}

RULE PVT1_S_3 { 
; Space between PVT1 and ACT along poly length direction. >= 0.15um

X1 = edge_adjacent ( both_side  PACT edge_inside (  AA PO ) ) 
X2 = edge_adjacent ( both_side  NACT edge_inside (  AA PO ) ) 
X = edge_or ( X1 X2 ) 
~geom_inside (  space (  X LVTP < 0.15  opposite adjacent < 90  region ) NODRC ) 
}


RULE PVT1_EX_1 { 
; PVT1 extension outside of GATE along source/drain direction >= 0.18um

X = edge_inside (  PO geom_and (  PACT LVTP ) ) 
Y = geom_edge_to_rect ( X outside 0.18  ) 
~geom_inside (  geom_not (  Y LVTP ) NODRC ) 
}

RULE PVT1_EX_2 { 
; PVT1 extension outside of ACT along GATE poly length direction. >= 0.15um

X = edge_adjacent ( both_side  geom_and (  PACT LVTP ) GATE ) 
~geom_inside (  extension (  X LVTP < 0.15  opposite adjacent < 90  region ) NODRC ) 
}


RULE PVT1_A_1 { 
; PVT1 area >= 0.18um2

~geom_inside (  
geom_area  ( LVTP < 0.18  ) NODRC ) 
}
RULE PVT1_A_2 { 
; PVT1 enclosed area >= 0.18um2

~geom_inside (  
geom_area  ( 
geom_not (  
geom_holes ( LVTP inner_most ) LVTP ) < 0.18  ) NODRC ) 
}

RULE PVT1_R_1 { 
; PVT1 overlap with PSUB is not allowed

~geom_inside (  
geom_and (  LVTP PSUB ) NODRC ) 
}
//===============================
// ULLD-- Ultra Low Leakage(ULLD)  
//===============================
group_rule ( GULLD ULLD_?  ) 

RULE ULLD_W_1 { 
; ULLD width single-point-interaction is allowed. >= 0.18

~geom_inside (  
width (  UVT < 0.18  adjacent < 90  region ) NODRC ) 
}

RULE ULLD_S_1 { 
; Space between two ULLDs >= 0.18um

~geom_inside (  
space (  UVT < 0.18  adjacent < 90  region ) NODRC ) 
}

RULE ULLD_S_2 { 
; Space between ULLD and ACT >= 0.02um

~geom_inside (  
space (  UVT AA < 0.02  adjacent < 90  point_touch region ) NODRC ) 
}

RULE ULLD_S_4 { 
; Space between ULLD and NACT >=0.055um.

~geom_inside (  
space (  UVT NACT < 0.055  adjacent < 90  point_touch region ) NODRC ) 
}

RULE ULLD_S_5 { 
; Space between ULLD and GATE along source/drain direction >= 0.18 um.

LAY_POLY = copy ( POLYi ) 
ACT = geom_or (  PACT NACT ) 
X1 = edge_inside (  LAY_POLY ACT ) 
~geom_inside (  space (  X1 UVT < 0.18  opposite adjacent < 90  region ) NODRC ) 
}

RULE ULLD_S_6 { 
; Space between ULLD and ACT along GATE poly length direction is >= 0.15um.

LAY_POLY = copy ( POLYi ) 
ACT = geom_or (  PACT NACT ) 
X1 = edge_inside (  ACT LAY_POLY ) 
X2 = edge_adjacent ( both_side  AA X1 ) 
~geom_inside (  space (  X2 UVT < 0.15  opposite adjacent < 90  region ) NODRC ) 
}

RULE ULLD_EX_1 { 
; ULLD extention outside of ACT is >= 0.02um

~geom_inside (  
extension (  AA UVT < 0.02  adjacent < 90  point_touch region ) NODRC ) 
}

RULE ULLD_EX_2 { 
; ULLD extention GATE along source/drain direction >= 0.18um.

LAY_POLY = copy ( POLYi ) 
ACT = geom_or (  PACT NACT ) 
X1 = edge_inside (  LAY_POLY ACT ) 
~geom_inside (  extension (  X1 UVT < 0.18  opposite adjacent < 90  region ) NODRC ) 
}

RULE ULLD_EX_3a { 
; ULLD extention outside of N+ ACT along GATE poly length direction >= 0.15um.
; if the distance to the related poly is less than or qual to 0.20um.
LAY_POLY = copy ( POLYi ) 
ACT = geom_or (  PACT NACT ) 
X1 = edge_inside (  ACT LAY_POLY ) 
X2 = edge_adjacent ( both_side  AA X1 ) 
X3 = geom_edge_to_rect ( X1 outside 0.001  extend 0.20  ) 
X4 = edge_coincident ( both_side  X2 X3 ) 
~geom_inside (  extension (  X4 UVT < 0.15  opposite adjacent < 90  region ) NODRC ) 
}

RULE ULLD_EX_3b { 
; ULLD extention outside of N+ ACT along GATE poly length direction >= 0.12um.
; if the distance to the related poly is larger than 0.20um.
LAY_POLY = copy ( POLYi ) 
ACT = geom_or (  PACT NACT ) 
X1 = edge_inside (  ACT LAY_POLY ) 
X2 = edge_adjacent ( both_side  AA X1 ) 
X3 = geom_edge_to_rect ( X1 outside 0.001  extend 0.20  ) 
X4 = ~edge_coincident ( both_side  X2 X3 ) 
~geom_inside (  extension (  X4 UVT < 0.12  opposite adjacent < 90  region ) NODRC ) 
}

RULE ULLD_A_1 { 
;ULLD area >= 0.18um2

~geom_inside (  
geom_area  ( UVT < 0.18  ) NODRC ) 
}

RULE ULLD_A_2 { 
;ULLD area >= 0.18um2

~geom_inside (  
geom_area  ( 
geom_holes ( UVT inner_most ) < 0.18  ) NODRC ) 
}

RULE ULLD_R_1 { 
; It is not alloweded ULLD overlap with (PSUB, DGOX OR TGOX)

~geom_inside (  
geom_and (  UVT PSUB ) NODRC ) 
~geom_inside (  geom_and (  UVT DG ) NODRC ) 
~geom_inside (  geom_and (  UVT TG ) NODRC ) 
}

RULE ULLD_R_2 { 
; ULLD must interact NVT3 or PVT3

~geom_inside (  
~geom_interact (  UVT HVTN ) NODRC ) 
~geom_inside (  ~geom_interact (  UVT HVTP ) NODRC ) 
}
//============================
//   DGOX - Dual Gate DRC
//============================

group_rule ( DGOX DGOX_?  ) 

RULE DGOX_W_1 { 
; DGOX width >= 0.47 um

~geom_inside (  
width (  DG < 0.47  adjacent < 90  point_touch region ) NODRC ) 
}

RULE DGOX_S_1 { 
; Space between two DGOXs >= 0.47um

~geom_inside (  
space (  DG < 0.47  adjacent < 90  point_touch region ) NODRC ) 
}

RULE DGOX_S_2 { 
; Space between DGOX and MOS ACT, overlap is not allowed  >= 0.25um

~geom_inside (  
space (  DG "MOS" < 0.25  adjacent < 90  point_touch region ) NODRC ) 
~geom_inside (  space (  DG AA_LDMOS < 0.25  adjacent < 90  point_touch region ) NODRC ) 
}

RULE DGOX_S_3 { 
; Space between DGOX and GATE, overlap is not allowed >= 0.32um

~geom_inside (  
space (  DG GATE < 0.32  adjacent < 90  point_touch region ) NODRC ) 
}

RULE DGOX_S_4 { 
; Space between DGOX and NW1 >= 0.47um

~geom_inside (  
space (  NW DG > 0  < 0.47  adjacent > 0  < 90  point_touch region ) NODRC ) 
}

RULE DGOX_S_5 { 
; Space between DGOX and PSUB >= 0.47um

~geom_inside (  
space (  PSUB DG > 0  < 0.47  adjacent > 0  < 90  point_touch region ) NODRC ) 
}

RULE DGOX_EN_1 { 
; Enclosure of ACT by DGOX(Except pick-up ACT) >= 0.25um

~geom_inside (  
extension (  
geom_not (  AA 
geom_or (  NTAP PTAP ) ) DG < 0.25  adjacent < 90  point_touch region ) NODRC ) 
}

RULE DGOX_EN_2 { 
; Enclosure of ACT by DGOX along GATE poly direction >= 0.25um

X = edge_adjacent ( both_side  "MOS" geom_inside (  GATE DG ) ) 
extension (  X DG < 0.25  adjacent < 90  region ) 
}

RULE DGOX_EN_3 { 
; Enclosure of GATE by DGOX, along source/drain direction >= 0.32um

~geom_inside (  
extension (  GATE_W DG < 0.32  opposite adjacent < 90  region ) NODRC ) 
}

RULE DGOX_EX_1 { 
; NW1 extention to DGOX, Extention = 0 is allowed >= 0.47um

~geom_inside (  
extension (  DG NW > 0  < 0.47  adjacent > 0  < 90  point_touch region ) NODRC ) 
}

RULE DGOX_EX_2 { 
; DGOX extention on NW1, Extention = 0 is allowed  >= 0.47um

~geom_inside (  
extension (  NW DG > 0  < 0.47  adjacent > 0  < 90  point_touch region ) NODRC ) 
}

RULE DGOX_EX_3 { 
; DGOX extention on PSUB, Extention = 0 is allowed  >= 0.47um

~geom_inside (  
extension (  PSUB DG > 0  < 0.47  adjacent > 0  < 90  point_touch region ) NODRC ) 
}

RULE DGOX_O_1 { 
; Overlap of DGOX and NW1, Overlap = 0 is allowed  >= 0.47um

~geom_inside (  
width (  DG NW > 0  < 0.47  adjacent > 0  < 90  point_touch region ) NODRC ) 
}

RULE DGOX_O_2 { 
; Overlap of DGOX and PSUB, Overlap = 0 is allowed >= 0.47um

~geom_inside (  
width (  DG PSUB > 0  < 0.47  adjacent > 0  < 90  point_touch region ) NODRC ) 
}
//==========================
//   TGOX - Triple Gate DRC
//==========================
group_rule ( GTGOX TGOX_?  ) 

RULE TGOX_W_1 { 
; TGOX width >= 0.47um

~geom_inside (  
width (  TG < 0.47  adjacent < 90  point_touch region ) NODRC ) 
}
RULE TGOX_S_1 { 
; Space between two TGOXs >= 0.47um

~geom_inside (  
space (  TG < 0.47  adjacent < 90  point_touch region ) NODRC ) 
}
RULE TGOX_S_2 { 
; Space between TGOX and MOS ACT >= 0.25um.

~geom_inside (  
space (  TG "MOS" < 0.25  adjacent < 90  point_touch region ) NODRC ) 
}

RULE TGOX_S_3 { 
; Space between TGOX and GATE >= 0.32um

~geom_inside (  
space (  GATE TG < 0.32  adjacent < 90  region ) NODRC ) 
}

RULE TGOX_S_4 { 
; Space between TGOX and NW1 >= 0.47um

~geom_inside (  
space (  NW TG > 0  < 0.47  adjacent > 0  < 90  point_touch region ) NODRC ) 
}

RULE TGOX_S_5 { 
; Space between TGOX and PSUB >= 0.47um

~geom_inside (  
space (  TG PSUB < 0.47  adjacent < 90  point_touch region ) NODRC ) 
}

RULE TGOX_S_6 { 
; Space between TGOX and DGOX >= 0.47um

~geom_inside (  
space (  TG DG < 0.47  adjacent < 90  point_touch region inside_also ) NODRC ) 
}

RULE TGOX_EN_1 { 
; Enclosure of ACT by TGOX(except pickup ACT) >= 0.25um 

extension (  "MOS" TG < 0.25  adjacent < 90  point_touch region ) 
X = geom_interact (  geom_and (  LDMOSSTI LDMOS ) PO ) 
Y = geom_adjacent (  AA X ) 
~geom_inside (  extension (  Y TG < 0.25  adjacent < 90  point_touch region ) NODRC ) 
}

RULE TGOX_EN_2 { 
; Enclosure of GATE along GATE poly direction >= 0.25um

X = edge_adjacent ( both_side  "MOS" geom_inside (  GATE TG ) ) 
~geom_inside (  extension (  X TG < 0.25  adjacent < 90  region ) NODRC ) 
}
RULE TGOX_EN_3 { 
; Enclosure of GATE by TGOX, along source/drain direction >= 0.32um

~geom_inside (  
extension (  GATE_W TG < 0.32  opposite adjacent < 90  region ) NODRC ) 
}
RULE TGOX_EX_1 { 
; NW1 extention on TGOX, Extention = 0 is allowed >= 0.47um

~geom_inside (  
extension (  TG NW > 0  < 0.47  adjacent > 0  < 90  point_touch region ) NODRC ) 
}
RULE TGOX_EX_2 { 
; TGOX extension on NW, Extention = 0 is allowed >= 0.47um

~geom_inside (  
extension (  NW TG > 0  < 0.47  adjacent > 0  < 90  point_touch region ) NODRC ) 
}

RULE TGOX_EX_3 { 
; TGOX extension of PSUB, Extention = 0 is allowed >= 0.47um

~geom_inside (  
extension (  PSUB TG > 0  < 0.47  adjacent > 0  < 90  point_touch region ) NODRC ) 
}

RULE TGOX_O_1 { 
; Overlap of TGOX and NW1, overlap = 0 is allowed >= 0.47um

~geom_inside (  
width (  TG NW > 0  < 0.47  adjacent > 0  < 90  point_touch region ) NODRC ) 
}

RULE TGOX_O_2 { 
; Overlap of TGOX and PSUB, overlap = 0 is allowed >= 0.47um

~geom_inside (  
width (  TG PSUB > 0  < 0.47  adjacent > 0  < 90  point_touch region ) NODRC ) 
}
}


#//==========================
#//    PO - Poly Rule DRC
#//==========================

group_rule GPO PO_? 

trs::rule PO_W_1 {
trs::rule_comment PO width >=0.06 um
trs::outputlayer ~geom_inside (  width (  PO < 0.06  adjacent < 90  point_touch region ) NODRC ) 
}
trs::rule PO_W_2a {
trs::rule_comment Channel length for 0.9/1.2V NMOS/PMOS transistors >= 0.06um
trs::setlayer X = edge_inside (  PO geom_not (  AA geom_or (  DG TG ) ) ) 
trs::outputlayer ~geom_inside (  width (  X < 0.06  opposite adjacent < 90  region ) NODRC ) 
}
trs::rule PO_W_2b {
trs::rule_comment Channel length for 1.8V NMOS/PMOS transistors >= 0.20um
trs::setlayer X = edge_inside (  PO geom_and (  AA DG ) ) 
trs::setlayer Y = width (  X < 0.20  opposite adjacent < 90  region ) 
trs::outputlayer ~geom_inside (  ~geom_inside (  Y SRAMALL ) NODRC ) 
}

