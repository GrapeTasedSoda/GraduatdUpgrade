trs::outputlayer space (  PODUM NW1res < 0.6  adjacent < 90  point_touch region ) 
}
trs::rule PODUM_S_8 {
trs::rule_comment Space between PODUM and LOGO >= 0.1
trs::outputlayer space (  PODUM LOGO < 0.1  adjacent < 90  point_touch region ) 
}
trs::rule PODUM_S_9 {
trs::rule_comment Space between PODUM and INDALL >= 2
trs::outputlayer space (  PODUM INDALL < 2  adjacent < 90  point_touch region ) 
}
trs::rule PODUM_S_10 {
trs::rule_comment Space between PODUM and CHIPBLK >= 0.6
trs::outputlayer space (  PODUM CHIPBLK < 0.6  adjacent < 90  point_touch region ) 
