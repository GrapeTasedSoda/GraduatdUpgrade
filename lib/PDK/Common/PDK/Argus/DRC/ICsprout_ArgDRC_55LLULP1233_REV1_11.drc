X = space (  geom_interact (  PO GATE_core ) ACT_CT < 0.06  adjacent < 90  point_touch region ) 
~geom_inside (  ~geom_inside (  X SRAMALL ) NODRC ) 
}
#ENDIF 

RULE CT_S_5 { 
; Space between GATE and contact on ACT for 1.8/2.5/3.3V >= 0.09um

X1 = space (  GATE_io1 geom_and (  ACT_CT DG ) < 0.09  adjacent < 90  point_touch region ) 
X2 = space (  GATE_io2 geom_and (  ACT_CT TG ) < 0.09  adjacent < 90  point_touch region ) 
~geom_inside (  geom_or (  X1 X2 ) NODRC ) 
}

RULE CT_S_6 { 
; Space to butted SDN/SDP edge on ACT (overlap of NP/PP boundary on ACT is not allowed) >= 0.06um

X = ~edge_outside (  edge_coincident ( both_side  SDN SDP ) AA ) 
Y = ~edge_outside (  edge_coincident ( both_side  SDP SDN ) AA ) 
~edge_inside (  edge_inside (  X CT ) NODRC ) 
~edge_inside (  edge_inside (  Y CT ) NODRC ) 
~geom_inside (  extension (  CT X < 0.06  adjacent < 90  region ) NODRC ) 
~geom_inside (  extension (  CT Y < 0.06  adjacent < 90  region ) NODRC ) 
}

RULE CT_EN_1 { 
; CT must be fully covered by M1 and (ACT OR POLY), except SRAMALL region.

~geom_inside (  
~geom_inside (  
geom_not (  CT 
geom_and (  M1 
geom_or (  PO AA ) ) ) SRAMALL ) NODRC ) 
}

RULE CT_EN_2a { 
; CT enclosure by ACT for CT >= 0.015um

X = geom_interact (  CT AA ) 
Y = extension (  X AA < 0.015  adjacent < 90  point_touch region outside_also ) 
~geom_inside (  ~geom_inside (  Y SRAMALL ) NODRC ) 
}
RULE CT_EN_2b { 
; CT enclosure by ACT for at least two opposite sides >= 0.03um

X = enc_rect ( geom_interact (  CT AA ) AA adjacent < 90  outside_also correct 0.015  opposite 0.03  opposite 0.015  opposite 0.03  opposite ) 
A = extension (  [X] AA < 0.03  opposite ) 
D2 = width (  A < 0.01  adjacent == 90  intersecting_only region ) 
~geom_inside (  D2 SRAMALL ) 
~geom_inside (  geom_not (  geom_interact (  CT AA ) AA ) SRAMALL ) 
}
#IFDEF OPEN_RECOMMENDED_ON YES 
RULE CT_EN_2_R { 
; Recomended CT enclosure by ACT for all sides >= 0.04um

X = geom_interact (  CT AA ) 
Y = extension (  X AA < 0.04  adjacent < 90  point_touch region outside_also ) 
~geom_inside (  ~geom_inside (  Y SRAMALL ) NODRC ) 
}
#ENDIF 
RULE CT_EN_3a_3b_3c { 
; Min CT enclosure by poly is 0.01
; Min CT enclosure by poly when one or both perpendicular directions <0.04um is 0.04um
; Min CT enclosure by poly all side is 0.025
X = enc_rect ( geom_interact (  CT PO ) PO adjacent < 90  outside_also correct 0.01  opposite 0.04  opposite 0.01  opposite 0.04  opposite correct 0.025  0.025  0.025  0.025  ) 

D1 = extension (  X PO < 0.01  adjacent < 90  point_touch region overlapped outside_also ) 
~geom_inside (  ~geom_inside (  D1 SRAMALL ) NODRC ) 

A = extension (  [X] PO < 0.04  opposite ) 
D2 = width (  A < 0.01  adjacent == 90  intersecting_only region ) //; For CT not touching M1
~geom_inside (  D2 SRAMALL ) 

B = extension (  X PO < 0.025  adjacent < 90  point_touch region overlapped outside_also ) 
~geom_inside (  ~geom_inside (  B SRAMALL ) NODRC ) 

~geom_inside (  
geom_not (  
geom_interact (  CT PO ) PO ) SRAMALL ) 
}
#IFDEF OPEN_RECOMMENDED_ON YES 
RULE CT_EN_3_R { 
; Recommended CT enclosure by poly for all sides to avoid high RC >= 0.06um

X = geom_interact (  CT PO ) 
Y = extension (  X PO < 0.06  adjacent < 90  point_touch region outside_also ) 
~geom_inside (  ~geom_inside (  Y SRAMALL ) NODRC ) 
}
#ENDIF 

RULE CT_EN_4a_4b_4c { 
; Enclosure by M1 >= 0 um
; Enclosure by M1 at least two opposite sides < 0.04um >= 0.04um
; Enclosure by M1 for all sides >= 0.025 um
X = enc_rect ( ~geom_adjacent (  CT M1 ) M1 adjacent < 90  outside_also correct 0  0.04  opposite 0  0.04  opposite correct 0.025  0.025  0.025  0.025  opposite ) 

A = extension (  [X] M1 < 0.04  opposite ) 
D1 = width (  A < 0.01  adjacent == 90  intersecting_only region ) //; For CT not touching M1
~geom_inside (  ~geom_inside (  D1 SRAMALL ) NODRC ) 

B = edge_coincident ( both_side  CT M1 ) 
D2 = width (  B < 0.01  adjacent == 90  region ) //; For CT touch M1 with >= 2 butting edges
~geom_inside (  ~geom_inside (  D2 SRAMALL ) NODRC ) 

Y = extension (  CT M1 < 0.04  opposite region ) 
C1 = edge_coincident ( both_side  CT M1 ) 
C2 = edge_coincident ( both_side  CT Y ) 
D3 = width (  C1 C2 < 0.01  adjacent == 90  region ) //; For CT touch M1 with only 1 edge
~geom_inside (  ~geom_inside (  D3 SRAMALL ) NODRC ) 

~geom_inside (  
~geom_inside (  
geom_not (  CT M1 ) SRAMALL ) NODRC ) 
~geom_inside (  ~geom_interact (  CT M1 ) NODRC ) 
}

#IFDEF OPEN_RECOMMENDED_ON YES 
RULE CT_EN_4a_R_4b_R { 
; Recomended M1 enclosure of CT to avoide high RC >= 0.04 um
; Recommended Minimum M1 enclosure of CT in line end region (at least two opposite sides) >=0.06 
X = enc_rect ( geom_interact (  CT M1 ) M1 adjacent < 90  outside_also correct 0.04  0.06  opposite 0.04  0.06  opposite ) 
~geom_inside (  ~geom_inside (  X SRAMALL ) NODRC ) 

A = extension (  X M1 < 0.06  opposite region ) 
~geom_inside (  A SRAMALL ) 

~geom_inside (  
geom_not (  
geom_interact (  CT M1 ) M1 ) SRAMALL ) 
}

#ENDIF 

RULE CT_EN_4d { 
; Enclosure by M1, when M1 width is > 1um. >= 0.04um

M1_CHECK = geom_with_width ( M1 > 1  ) 
CT_CHECK = ~geom_outside (  CT M1_CHECK ) 
~geom_inside (  extension (  CT_CHECK M1 < 0.04  adjacent < 90  point_touch region ) NODRC ) 
}

RULE CT_R_1 { 
; CT is not allowed to land on GATE

~geom_inside (  
~geom_inside (  
geom_and (  GATE CT ) SRAMALL ) NODRC ) 
}
RULE CT_R_2 { 
; CT is not allowed to interact SAB
; Waive the CT cutting AA in SRAM area.
~geom_inside (  ~geom_inside (  geom_interact (  CT SAB ) geom_or (  SRAMALL EFUSEALL ) ) NODRC ) 
}

RULE CT_R_3 { 
; 45 degree CT is not allowed

~geom_inside (  
geom_with_edge ( CT 
edge_angle (  CT == 45  ) ) NODRC ) 
}

RULE CT_R_4 { 
; Recomended at least two CTs for connection except Reserved area, DRC help to mark single CT

X1 = geom_interact (  geom_or (  NSD NTAP ) CT == 1  ) 
geom_not (  geom_and (  CT X1 ) NODRC ) 
X2 = geom_interact (  geom_or (  PSD PTAP ) CT == 1  ) 
geom_not (  geom_and (  CT X2 ) NODRC ) 
}

RULE CT_R_5 { 
; Recomended to put CTs at both source side and butted well tap side. DRC can flag if the tap is butted on source and the tap or source region without CT

X1 = ~geom_interact (  geom_adjacent (  NTAP NSDi ) CT ) 
X2 = ~geom_interact (  geom_adjacent (  PTAP PSDi ) CT ) 
X3 = ~geom_interact (  geom_adjacent (  NTAP PSDi ) CT ) 
X4 = ~geom_interact (  geom_adjacent (  PTAP NSDi ) CT ) 
geom_not (  geom_or (  X1 X2 X3 X4 ) NODRC ) 
}
}
#//=====================
#//  MET1 - Metal 1 DRC
#//=====================

group_rule GMET1 MET1_? 


trs::setlayer density_checkarea = geom_not (  DRC:1 INDALL ) 


trs::rule MET1_W_1 {
trs::rule_comment M1 width >= 0.09um
trs::rule_comment M1 width <= 10.00um
  trs::outputlayer ~geom_inside (  geom_with_width ( M1 > 10  ) NODRC ) 
  trs::outputlayer ~geom_inside (  width (  M1 < 0.09  adjacent < 90  point_touch region ) NODRC ) 
}
trs::rule MET1_W_2 {
trs::rule_comment Width of metal1 with 45 degree,  >= 0.19um
  trs::setlayer X = edge_angle (  M1 == 45  ) 
  trs::outputlayer ~geom_inside (  width (  X < 0.19  region ) NODRC ) 
}

trs::rule MET1_W_3 {
trs::rule_comment Minimum M1 width adjoining a huge non-metal region \[ area > 2000000 um2\], non-metal region is defined as (NOT (Mx OR MxDUM)) >= 0.35um
  trs::setlayer NON_METAL_REG = geom_area  ( geom_not (  DRC:1 geom_or (  M1 M1DUM ) ) > 2000000  ) 
  trs::setlayer CHECK_REGION = geom_enclose_rectangle ( NON_METAL_REG 10  0.35  ) 
  trs::setlayer CHECK_METAL = geom_interact (  M1 CHECK_REGION ) 
  trs::outputlayer ~geom_inside (  width (  CHECK_METAL < 0.35  adjacent < 90  point_touch region ) NODRC ) 
}

trs::rule MET1_S_1 {
trs::rule_comment Space between two M1s, DRC don\BFt flag 89 to 90 degree spaces in the INDALL region. >= 0.09um
  trs::setlayer X = space (  M1 < 0.09  adjacent < 90  point_touch region ) 
  trs::outputlayer ~geom_inside (  ~geom_inside (  geom_not (  X INDALL ) SRAMALL ) NODRC ) 
  trs::setlayer Y = space (  M1 < 0.09  adjacent < 89  point_touch region ) 
  trs::outputlayer ~geom_inside (  ~geom_inside (  geom_and (  Y INDALL ) SRAMALL ) NODRC ) 
}

trs::pvrs_block  {
#IFDEF OPEN_RECOMMENDED_ON YES 
}
trs::rule MET1_S_1_R {
trs::rule_comment Recomended pace between two M1s. >= 0.12um
  trs::setlayer X = space (  M1 < 0.12  adjacent < 90  point_touch region ) 
  trs::outputlayer ~geom_inside (  ~geom_inside (  X SRAMALL ) NODRC ) 
}
trs::pvrs_block  {
#ENDIF 
}

trs::rule MET1_S_2 {
trs::rule_comment Min Space between two M1 is 0.15 um when one or both M1 width >= 0.42um, and the parallel run length of two M1s is >= 0.42um
  Mn_2b M1ALL 0.42 0.42 0.15
}

trs::rule MET1_S_3 {
trs::rule_comment Min Space between two M1 is 0.5 um when one or both M1 width >= 1.5um, and the parallel run length of two M1s is >= 1.5um
  Mn_2b M1ALL 1.5 1.5 0.5
}

trs::rule MET1_S_4 {
trs::rule_comment Space between metal lines with one or both are 45 degree,  >= 0.19um
  trs::setlayer X = edge_angle (  M1 == 45  ) 
  trs::outputlayer ~geom_inside (  space (  X M1 < 0.19  region ) NODRC ) 
}

trs::rule MET1_S_5 { 
trs::rule_comment Minimum Space at metal1 line-end(W<0.11um) in a dense-line-end configuration: if metal1 has parallel run length with opposite metal1 along 2 adjacent edge metal1 (any one edge < 0.11um distance from the conner of the two edge), the one of the space(sp1 or sp2) need to be at least 0.11 (except for small jog with edge length < 0.09um)
  trs::setlayer LINE_END = edge_convex_point ( M1 adjacent_edge_angle1 == 90  adjacent_edge_angle2 == 90  with_edge_length < 0.11  ) 
  trs::setlayer LINE_END_SP = space (  "\[LINE_END\]" M1 < 0.11  opposite adjacent < 90  ) 
  trs::setlayer LINE_SIDE = edge_adjacent ( inside  LINE_END LINE_END_SP ) 
  trs::setlayer LINE_END_M1 = width (  LINE_SIDE "\[M1\]" < 0.11  adjacent == 90  intersecting_only ) 
  trs::setlayer LINE_END_M1_009 = edge_length (  LINE_END_M1 >= 0.09  ) 
  trs::outputlayer ~geom_inside (  ~geom_inside (  space (  LINE_END_M1_009 M1 < 0.11  opposite adjacent < 90  region ) SRAMALL ) NODRC ) 
}

trs::rule MET1_A_1 {
trs::rule_comment M1 area >= 0.042um2
  trs::setlayer X = geom_area  ( M1 < 0.042  ) 
  trs::outputlayer ~geom_inside (  ~geom_inside (  X SRAMALL ) NODRC ) 
}

trs::rule MET1_A_2 {
trs::rule_comment Enclosed dielectric area by M1 >= 0.18um2
  trs::setlayer X = geom_not (  geom_holes ( M1 inner_most hollow ) M1 ) 
  trs::outputlayer ~geom_inside (  geom_area  ( X < 0.18  ) NODRC ) 
}

trs::pvrs_block  {
#IFDEF Density_rules YES 
}
trs::rule MET1_D_1_min {
trs::rule_comment M1 density (including dummy) in 100umX100um window with step size 50um. INDALL/FUTR/GRID/SRINGBLK covered areas are excluded for this rule checking >= 10%
trs::setlayer check_region_1 = ~geom_inside (  geom_not (  geom_not (  geom_not (  geom_not (  DRC:1 FUTR ) GRID ) SRINGBLK ) INDALL ) NODRC ) 
trs::setlayer check_region = geom_with_width ( check_region_1 >= 50  ) 
trs::setlayer check_pattern = geom_and (  M1ALLi check_region ) 
trs::setlayer err1_TMP1 = check_density ( check_pattern check_region "\[!AREA(check_region) + !!AREA(check_region)*AREA(check_pattern)/AREA(check_region)\]" < 0.10  by_window 100  delta 50  boundary_backup inside_of_layer DRC:1 in_polygon ) 

trs::setlayer check_window = geom_with_width ( geom_and (  err1_TMP1 check_region ) >= 50  ) 
trs::outputlayer check_density ( check_pattern check_window "\[!AREA(check_window) + !!AREA(check_window)*AREA(check_pattern)/AREA(check_window)\]" < 0.10  by_window 100  delta 50  boundary_backup inside_of_layer DRC:1 in_polygon output_log MET1_D_1_min.log result_db \
MET1_D_1_min.rdb ) 
 
}

trs::rule MET1_D_1_max {
trs::rule_comment M1 density (including dummy) in 100umX100um window with step size 50um. INDALL/FUTR/GRID/SRINGBLK covered areas are excluded for this rule checking <= 80% 
trs::setlayer check_region_1 = ~geom_inside (  geom_not (  geom_not (  geom_not (  geom_not (  DRC:1 FUTR ) GRID ) SRINGBLK ) INDALL ) NODRC ) 
trs::setlayer check_region = geom_with_width ( check_region_1 >= 50  ) 
trs::setlayer check_pattern = geom_and (  M1ALLi check_region ) 
trs::setlayer err1_TMP1 = check_density ( check_pattern check_region "\[!!AREA(check_region)*AREA(check_pattern)/AREA(check_region)\]" > 0.8  by_window 100  delta 50  boundary_backup inside_of_layer DRC:1 in_polygon ) 

trs::setlayer check_window = geom_with_width ( geom_and (  err1_TMP1 check_region ) >= 50  ) 
trs::outputlayer check_density ( check_pattern check_window "\[!!AREA(check_window)*AREA(check_pattern)/AREA(check_window)\]" > 0.8  by_window 100  delta 50  boundary_backup inside_of_layer DRC:1 in_polygon output_log MET1_D_1_max.log result_db \
MET1_D_1_max.rdb ) 

}

trs::rule MET1_D_2 {
trs::rule_comment M1 average density inside the {SIZE dummy block BY 2.5um} area in 100umX100um window with step size 50um when the dummy block area >= 100umX100um. INDALL/FUTR/GRID/SRINGBLK covered areas are excluded for this rule checking
trs::rule_comment Device sensitive areas can be waived. >= 10%
  trs::setlayer X = check_density ( M1ALLi < 0.1  by_window 100  delta 50  boundary_backup output_log density_report_MET1_D_2.log ) 
  trs::setlayer Y = geom_not (  geom_or (  geom_size ( M1DUMB by 2.5  ) SRBLK ) geom_or (  INDALL FUTR GRID SRINGBLK ) ) 
  trs::setlayer Z = geom_size ( Y by 12.5  in_out ) 
  trs::outputlayer ~geom_inside (  geom_and (  X Z ) NODRC ) 
}

trs::rule MET1_D_3 {
trs::rule_comment The difference between M1 density in 100x100 window (including dummy)
trs::rule_comment INDID/GRID/FUTR/SRINGBLK covered areas are excluded for this rule checking <= 20%

  trs::setlayer X = check_density ( M1ALLi >= 0  by_window 200  check_gradient > 0.2  absolute_value boundary_backup inside_of_layer density_checkarea output_log density_report_MET1_D_3.log ) 
  trs::outputlayer ~geom_inside (  geom_not (  geom_not (  geom_not (  geom_not (  X FUTR ) GRID ) SRINGBLK ) INDALL ) NODRC ) 
}
trs::pvrs_block  {
#ENDIF 
}

trs::rule MET1_R_1 {
trs::rule_comment M1 line end must be rectangular.
  trs::setlayer A = width (  M1 < 0.01  adjacent == 45  region ) 
  trs::setlayer B = space (  M1 < 0.01  adjacent == 45  region ) 
  trs::setlayer C = width (  M1 < 0.01  adjacent == 135  region ) 
  trs::setlayer D = space (  M1 < 0.01  adjacent == 135  region ) 
  trs::outputlayer ~geom_inside (  A NODRC ) 
  trs::outputlayer ~geom_inside (  B NODRC ) 
  trs::outputlayer ~geom_inside (  C NODRC ) 
  trs::outputlayer ~geom_inside (  D NODRC ) 
}

#**********************************************
# Mn: Metal n (n=2~8) design rules
#**********************************************



set metal_list { M2 M3 M4 M5 M6 M7 M8 }
foreach metal_layer $metal_list {
  set tmp CHECK_$metal_layer
  set tmp_v [set $tmp]

  if { $tmp_v == 1 } {
    group_rule "G${metal_layer}" "${metal_layer}_?" 

trs::rule ${metal_layer}_W_1a {
trs::rule_comment Mn width >= 0.10um
  trs::outputlayer ~geom_inside (  width (  $metal_layer < 0.10  adjacent < 90  point_touch region ) NODRC ) 
}

trs::rule ${metal_layer}_W_1b {
trs::rule_comment Mn width
trs::rule_comment (Exclude DEUPAD region when Mn as TM-1 in 1 top metal option) <= 10.00um
set M_inner_last M[expr $total_metal-$top_metal]
if { [string equal $top_metal 1] == 1 } {
if { [string equal $metal_layer $M_inner_last] == 1 } {
 trs::setlayer X = geom_not (  $metal_layer DEUPAD ) 
 trs::outputlayer ~geom_inside (  geom_with_width ( X > 10  ) NODRC ) 
} else {
  trs::outputlayer ~geom_inside (  geom_with_width ( $metal_layer > 10  ) NODRC ) 
}

} else {
  trs::outputlayer ~geom_inside (  geom_with_width ( $metal_layer > 10  ) NODRC ) 
}
}

trs::rule ${metal_layer}_W_2 {
trs::rule_comment Width of Mn with 45 degree,  >= 0.19um
  trs::setlayer X = edge_angle (  $metal_layer == 45  ) 
  trs::outputlayer ~geom_inside (  width (  X < 0.19  region ) NODRC ) 
}

trs::rule ${metal_layer}_W_3 {
trs::rule_comment Minimum Mn width adjoining a huge non-metal region \[ area > 2000000 um2\], non-metal region is defined as (NOT (Mx OR MxDUM)) >= 0.35um
  trs::setlayer NON_METAL_REG = geom_area  ( geom_not (  DRC:1 geom_or (  $metal_layer "${metal_layer}DUM" ) ) > 2000000  ) 
  trs::setlayer CHECK_REGION = geom_enclose_rectangle ( NON_METAL_REG 10  0.35  ) 
  trs::setlayer CHECK_METAL = geom_interact (  $metal_layer CHECK_REGION ) 
  trs::outputlayer ~geom_inside (  width (  CHECK_METAL < 0.35  adjacent < 90  point_touch region ) NODRC ) 
}

#-----------------------------------------------------------------------------------------------
    if { [string equal $metal_layer M2] == 1 } {
trs::rule ${metal_layer}_S_1 {
trs::rule_comment Space between two Mns,
  trs::setlayer X = space (  $metal_layer < 0.10  adjacent < 90  point_touch region ) 
  trs::outputlayer ~geom_inside (  ~geom_inside (  X SRAMALL ) NODRC ) 
}
    } else {
trs::rule ${metal_layer}_S_1 {
trs::rule_comment Space between two Mns,
