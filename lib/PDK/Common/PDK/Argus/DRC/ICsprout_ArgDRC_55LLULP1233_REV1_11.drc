  trs::pvrs_block  {
}
}
trs::setlayer RDLVIAS = geom_and (  RDLVIA SRINGBLK ) 
trs::setlayer RDLS = geom_and (  RDLi SRINGBLK ) 
trs::setlayer RDLS_INNER = geom_adjacent (  RDLS geom_holes ( RDLS inner_most ) == 1  ) 
trs::setlayer RDLS_OUTER = geom_adjacent (  RDLS geom_holes ( RDLS ) == 1  ) 
trs::setlayer RDLS_RING = geom_and (  RDLi geom_interact (  RDLS RDLS_OUTER ) ) 
trs::setlayer RDLPA2S = geom_and (  RDLPA2 SRINGBLK ) 

trs::pvrs_block  {
}


set MS_RING_INNER "geom_or (RDLS_INNER [lindex $metal_all 0]S_INNER)"
foreach metal_each [lreplace $metal_all 0 0] {
  set MS_RING_INNER "geom_or (${MS_RING_INNER} ${metal_each}S_INNER)"
}
trs::setlayer MS_RING_INNER = $MS_RING_INNER

set M_ALL "geom_or ([lindex $metal_all 0]i [lindex $metal_all 1]i)"
foreach metal_each [lreplace $metal_all 0 1] {
  set M_ALL "geom_or (${M_ALL} ${metal_each}i)"
}
trs::setlayer M_ALL = $M_ALL

set MDUM_ALL "geom_or ([lindex $metal_dummy_list 0] [lindex $metal_dummy_list 1])"
foreach metal_dummy_each [lreplace $metal_dummy_list 0 1] {
  set MDUM_ALL "geom_or (${MDUM_ALL} $metal_dummy_each)"
}
trs::setlayer MDUM_ALL = $MDUM_ALL

trs::setlayer MA_ALL = ~geom_inside (  M_ALL SRINGBLK ) 

set ISOLATION "geom_and (SRINGBLK geom_holes (M1S_INNER INNER_MOST))"
foreach metal_each [lreplace $metal_all 0 0] {
  set ISOLATION "geom_and (${ISOLATION} geom_and (SRINGBLK geom_holes (${metal_each}S_INNER INNER_MOST)))"
}
trs::setlayer ISOLATION = $ISOLATION


connect AAS M1S_RING by CTS 
for { set i 0 } { $i < [expr [llength $v_m_list] -2] } { incr i 2 } {
  connect "[lindex $v_m_list $i]S_RING" "[lindex $v_m_list [expr $i +2]]S_RING" by "[lindex $v_m_list [expr $i +1]]S" 
}
connect SRINGBLK "[lindex $v_m_list end]S_RING" 
connect "[lindex $v_m_list end]S_RING" RDLS_RING by RDLVIAS 

foreach j $m_j {

trs::rule SRCK_3_M${j} {
trs::rule_comment Space between outer ring metal and window edge >= 2
 trs::outputlayer extension (  "M${j}S_OUTER" DRC:1 < 2  adjacent < 90  point_touch region ) 
}

} 

