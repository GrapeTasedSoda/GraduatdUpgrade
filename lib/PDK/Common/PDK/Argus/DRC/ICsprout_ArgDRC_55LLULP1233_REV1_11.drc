trs::rule PO_S_9 {
trs::rule_comment Space at PO line end(PO width <0.09um), in the dense line end configuration:
trs::rule_comment if PO has parallel run length with opposite PO
trs::rule_comment along 2 adjacent edge of PO(any one edge < 0.09um distance from the conner of
trs::rule_comment the 2 edges), then one of the space need to bigger than 0.14
  trs::setlayer LINE_END = edge_convex_point ( PO adjacent_edge_angle1 == 90  adjacent_edge_angle2 == 90  with_edge_length < 0.09  ) 
  trs::setlayer LINE_END_SP = space (  "\[LINE_END\]" PO < 0.14  opposite adjacent < 90  ) 
  trs::setlayer LINE_SIDE = edge_adjacent ( inside  LINE_END LINE_END_SP ) 
  trs::setlayer LINE_END_PO = width (  LINE_SIDE "\[PO\]" < 0.09  adjacent == 90  intersecting_only ) 
  trs::setlayer LINE_END_PO_006 = edge_length (  LINE_END_PO >= 0.06  ) 
  trs::outputlayer ~geom_inside (  ~geom_inside (  space (  LINE_END_PO_006 PO < 0.14  opposite adjacent < 90  region ) SRAMALL ) NODRC ) 
}

