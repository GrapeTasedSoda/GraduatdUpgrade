trs::setlayer all_pad_TXT_M5 = geom_or (  all_pad_vdd_M5 all_pad_vss_M5 all_pad_vcc_M5 all_pad_gnd_M5 ) 
trs::setlayer all_pad_TXT_M6 = geom_or (  all_pad_vdd_M6 all_pad_vss_M6 all_pad_vcc_M6 all_pad_gnd_M6 ) 
