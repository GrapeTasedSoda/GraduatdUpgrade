trs::outputlayer ~geom_inside (  geom_not (  space (  T8M2DUM_2p8_2p8 < 2.80  adjacent < 90  point_touch region ) INDALL ) NODRC ) 
}

trs::rule T8M2DUMCK_S_2 {
