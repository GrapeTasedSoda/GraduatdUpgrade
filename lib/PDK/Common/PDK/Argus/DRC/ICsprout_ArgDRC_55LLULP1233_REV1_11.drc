trs::rule_comment Enclosed dielectric area by Mn >= 0.18um2
  trs::setlayer X = geom_not (  geom_holes ( $metal_layer inner_most ) $metal_layer ) 
  trs::outputlayer ~geom_inside (  geom_area  ( X < 0.18  ) NODRC ) 
}


