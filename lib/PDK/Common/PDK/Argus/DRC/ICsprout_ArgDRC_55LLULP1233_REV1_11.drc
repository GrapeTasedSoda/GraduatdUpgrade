#//==================================
#// ESD design and layout guideline
#//==================================


trs::setlayer ESD = geom_and (  ESD1 ESDIOE ) 

trs::setlayer ENACT = geom_and (  NACT ESDIOE ) 
trs::setlayer EPACT = geom_and (  PACT ESDIOE ) 
trs::setlayer ENTAP = geom_and (  ENACT NW ) 
trs::setlayer EPTAP = geom_not (  EPACT NW ) 

trs::setlayer EGATE = geom_and (  geom_and (  AA PO ) ESDIOE ) 
trs::setlayer ENGATE = geom_and (  EGATE ENACT ) 
trs::setlayer EPGATE = geom_and (  EGATE EPACT ) 
trs::setlayer EGATEHV = geom_and (  geom_not (  EGATE DG ) TG ) //2.5V or 3.3V
trs::setlayer EGATEMV = geom_not (  geom_and (  EGATE DG ) TG ) //1.8V
trs::setlayer EGATELV = geom_not (  EGATE DG ) //1.2V
trs::setlayer EGATE_CASCODED = geom_and (  geom_and (  EGATE ESDIOE ) ESDIOT ) //high voltage tolerant I/O using Cascoded 2.5V/3.3V NMOS

trs::setlayer EGATE_CASCODED_OVLAP = geom_cut (  EGATE_CASCODED ESAB ) 
trs::setlayer EGATE_CASCODED_INSID = geom_inside (  EGATE_CASCODED ESAB ) 

trs::setlayer EGATE_W = edge_coincident ( both_side  EGATE PO ) 
trs::setlayer EGATE_L = edge_coincident ( both_side  EGATE AA ) 

trs::setlayer EGATE_POLY = geom_enclose (  PO EGATE ) 
trs::setlayer ENGATE_POLY = geom_enclose (  PO ENGATE ) 
trs::setlayer EPGATE_POLY = geom_enclose (  PO EPGATE ) 

trs::setlayer ECT = geom_and (  CT ESDIOE ) 
trs::setlayer ESAB = geom_and (  SAB ESDIOE ) 
trs::setlayer ESAB_HO_RAW = geom_holes ( ESAB inner_most hollow ) 
trs::setlayer ESAB_HO = geom_or (  ESAB_HO_RAW EMOS_D ) 
trs::setlayer ECT_S = geom_outside (  ECT ESAB_HO ) 
trs::setlayer ECT_D = geom_inside (  ECT ESAB_HO ) 

trs::setlayer ENMOS = geom_enclose (  ENACT EGATE ) 
trs::setlayer EPMOS = geom_enclose (  EPACT EGATE ) 
trs::setlayer ENMOS_SD = geom_not (  ENMOS EGATE ) 
trs::setlayer EPMOS_SD = geom_not (  EPMOS EGATE ) 

trs::setlayer ENMOS_S = geom_adjacent (  geom_not (  ENMOS_SD ESAB ) EGATE ) 
trs::setlayer ENMOS_D = ~geom_adjacent (  geom_not (  ENMOS_SD ESAB ) EGATE ) 
trs::setlayer ENMOS_DRAIN = geom_interact (  geom_interact (  ENMOS_SD ENMOS_D ) ECT ) 
trs::setlayer EPMOS_S = geom_adjacent (  geom_not (  EPMOS_SD ESAB ) EGATE ) 
trs::setlayer EPMOS_D = ~geom_adjacent (  geom_not (  EPMOS_SD ESAB ) EGATE ) 
trs::setlayer EPMOS_DRAIN = geom_interact (  geom_interact (  EPMOS_SD EPMOS_D ) ECT ) 
trs::setlayer EMOS_D = geom_or (  ENMOS_D EPMOS_D ) 
trs::setlayer EMOS_S = geom_or (  ENMOS_S EPMOS_S ) 


trs::setlayer ENGUARDRING = geom_holes ( ENTAP inner_most hollow ) 
trs::setlayer EPGUARDRING = geom_holes ( EPTAP inner_most hollow ) 
trs::setlayer ENGUARDHOLE_2 = geom_enclose (  geom_holes ( ENTAP inner_most ) EPGUARDRING ) 
trs::setlayer EPGUARDHOLE_2 = geom_enclose (  geom_holes ( EPTAP inner_most ) ENGUARDRING ) 

trs::setlayer NESDCLP_NOSAB = ~geom_interact (  geom_and (  NACT ESDIOE ) SAB ) 
trs::setlayer NESDCLP_SAB = geom_interact (  geom_and (  NACT ESDIOE ) SAB ) 
trs::setlayer PESDCLP_NOSAB = ~geom_interact (  geom_and (  PACT ESDIOE ) SAB ) 
trs::setlayer PESDCLP_SAB = geom_interact (  geom_and (  PACT ESDIOE ) SAB ) 

trs::setlayer ENGATE_NOSAB = geom_and (  GATE NESDCLP_NOSAB ) 
trs::setlayer ENGATE_SAB = geom_and (  GATE NESDCLP_SAB ) 
trs::setlayer EPGATE_NOSAB = geom_and (  GATE PESDCLP_NOSAB ) 
trs::setlayer EPGATE_SAB = geom_and (  GATE PESDCLP_SAB ) 
trs::setlayer EGATE_NOSAB = geom_or (  ENGATE_NOSAB EPGATE_NOSAB ) 
trs::setlayer EGATE_SAB = geom_or (  ENGATE_SAB EPGATE_SAB ) 

trs::setlayer ESD3C_1 = geom_edge_to_rect ( edge_inside (  geom_not (  EGATE EGATE_CASCODED ) AA ) inside 0.001  ) 
trs::setlayer ESD3C_2 = geom_edge_to_rect ( edge_inside (  ~geom_inside (  EGATE_CASCODED SAB ) AA ) inside 0.001  ) 
trs::setlayer ESD3C = geom_or (  ESD3C_1 ESD3C_2 ) 

trs::setlayer ENACT_D = geom_interact (  geom_interact (  geom_not (  ENACT PO ) PO ) SAB >= 1  ) 
trs::setlayer EPACT_D = geom_interact (  geom_interact (  geom_not (  EPACT PO ) PO ) SAB >= 1  ) 
trs::setlayer EACT_D = geom_or (  ENACT_D EPACT_D ) 


#layer_map (998 datatype 1234 5432)
#layer ( EMPTY1 5432)
trs::setlayer ENGATE_D_EMPTY = geom_or (  EMPTY1 geom_and (  ESDIOE ENMOS_DRAIN ) ) 
trs::setlayer EPGATE_D_EMPTY = geom_or (  EMPTY1 geom_and (  ESDIOE EPMOS_DRAIN ) ) 
trs::setlayer ESD3C_EMPTY = geom_or (  EMPTY1 ESD3C ) 
trs::setlayer ECT_EMPTY = geom_or (  EMPTY1 ECT ) 

#CONNECT EGATE_POLY_EMPTY ESD3C_EMPTY
#CONNECT EGATE_POLY_EMPTY EM1_EMPTY BY ECT_EMPTY
connect ENGATE_D_EMPTY ESD3C_EMPTY 
connect EPGATE_D_EMPTY ESD3C_EMPTY 
connect ENGATE_D_EMPTY EM1i_EMPTY by ECT_EMPTY 
connect EPGATE_D_EMPTY EM1i_EMPTY by ECT_EMPTY 

#Below connection is only for ESD_3_G; Both poly connected by PO and M1 are considered as "Finger"
foreach metal_via $v_m_list_for_connect {
  trs::setlayer "E${metal_via}_EMPTY" = geom_or (  EMPTY1 $metal_via ) 
}

for { set i 0 } { $i < [expr [llength $v_m_list_for_connect] -2] } { incr i 2 } {
  connect "E[lindex $v_m_list_for_connect $i]_EMPTY" "E[lindex $v_m_list_for_connect [expr $i +2]]_EMPTY" by "E[lindex $v_m_list_for_connect [expr $i +1]]_EMPTY" 
}

trs::setlayer EPA_EMPTY = geom_or (  EMPTY1 CBi ) 
trs::setlayer ERDL_EMPTY = geom_or (  EMPTY1 RDLi ) 
trs::setlayer ERDLVIA_EMPTY = geom_or (  EMPTY1 RV ) 
trs::setlayer EALPA_EMPTY = geom_or (  EMPTY1 ALPAi ) 
trs::setlayer EMD_EMPTY = geom_or (  EMPTY1 MDi ) 
trs::setlayer ERDLPA2_EMPTY = geom_or (  EMPTY1 COVER ) 
if { [string equal $T4V2_T4M2 1] == 1 } {
connect ET4M2i_EMPTY EPA_EMPTY 
connect ET4M2i_EMPTY ERDL_EMPTY by ERDLVIA_EMPTY 
}
if { [string equal $T2V2_T2M2 1] == 1 } {
connect ET2M2i_EMPTY EPA_EMPTY 
connect ET2M2i_EMPTY ERDL_EMPTY by ERDLVIA_EMPTY 
}
if { [string equal $T8V2_T8M2 1] == 1 } {
connect ET8M2i_EMPTY EPA_EMPTY 
connect ET8M2i_EMPTY ERDL_EMPTY by ERDLVIA_EMPTY 
}
connect ERDL_EMPTY ERDLPA2_EMPTY 
connect EPA_EMPTY EALPA_EMPTY 
connect ERDL_EMPTY EALPA_EMPTY 
connect EALPA_EMPTY EMD_EMPTY 


trs::pvrs_block  {
#IFDEF ESD_CHECK YES 
}

trs::rule ESDN_1_SEDP_1 {
trs::rule_comment Minimum ACT extnsion of CT on SOURCE >= 0.15
trs::outputlayer ~edge_inside (  extension (  ECT_S EMOS_S < 0.15  adjacent < 90  point_touch region ) NODRC ) 
}

trs::rule ESDN_2_ESDP_2 {
trs::rule_comment Minimum CT to Poly space on SOURCE >= 0.15
trs::outputlayer ~edge_inside (  space (  ECT_S EGATE < 0.15  adjacent < 90  point_touch region ) NODRC ) 
}
trs::rule ESDN_4_ESDP_4 {
trs::rule_comment Minimum SAB overlap Poly on Drain >= 0.05
trs::outputlayer ~geom_inside (  width (  ESAB EGATE < 0.05  adjacent < 90  point_touch region ) NODRC ) 
}
trs::rule ESDN_5_ESDP_5 {
trs::rule_comment Minimum SAB to Poly on Drain space >= 1.29
 trs::outputlayer ~edge_inside (  space (  ESAB_HO_RAW EGATE < 1.29  opposite region ) NODRC ) 
}
trs::rule ESDN_6_ESDP_6 {
trs::rule_comment Minimum SAB to CT on Drain space >= 0.21
 trs::outputlayer ~edge_inside (  extension (  ECT_D ESAB_HO_RAW < 0.21  adjacent < 90  point_touch region ) NODRC ) 
}

trs::rule ESDN_7_ESDP_7 {
trs::rule_comment Minimum SAB to ACT space >= 0.21
 trs::outputlayer ~edge_inside (  extension (  ~edge_coincident ( both_side  ENMOS_DRAIN EGATE ) geom_or (  ESAB ESAB_HO_RAW ) < 0.21  adjacent < 90  region ) NODRC ) 
 trs::outputlayer ~edge_inside (  extension (  ~edge_coincident ( both_side  EPMOS_DRAIN EGATE ) geom_or (  ESAB ESAB_HO_RAW ) < 0.21  adjacent < 90  region ) NODRC ) 
}
trs::rule ESDN_8_ESDP_8 {
trs::rule_comment Minimum SAB overlap ACT >= 1
 trs::outputlayer ~edge_inside (  extension (  ESAB_HO_RAW ENMOS_DRAIN < 1  adjacent < 90  point_touch region ) NODRC ) 
 trs::outputlayer ~edge_inside (  extension (  ESAB_HO_RAW EPMOS_DRAIN < 1  adjacent < 90  point_touch region ) NODRC ) 
}
trs::rule ESDN_9 {
trs::rule_comment Minimum ESD implant to Poly space >= 0.4
 trs::outputlayer ~edge_inside (  space (  ESD1 EGATE < 0.4  opposite region ) NODRC ) 
}

trs::rule ESDN_10 {
trs::rule_comment Minimum ESD implant to ACT space >= 0.4
 trs::outputlayer ~edge_inside (  extension (  ESD1 ENMOS_DRAIN < 0.4  adjacent < 90  point_touch region ) NODRC ) 
}
trs::rule ESDN_11 {
trs::rule_comment ESD implant can't overlap Poly
 trs::outputlayer ~edge_inside (  geom_and (  ESD1 EGATE_POLY ) NODRC ) 
}

trs::rule ESDN_12 {
trs::rule_comment Unit finger width (F) of NMOS for ESD protection device >= 30um
trs::rule_comment <= 40um
 trs::outputlayer ~edge_inside (  edge_length (  edge_inside (  EGATE_W ENMOS ) < 30  ) NODRC ) 
 trs::outputlayer ~edge_inside (  edge_length (  edge_inside (  EGATE_W ENMOS ) > 40  ) NODRC ) 
}
trs::rule ESDP_9 {
trs::rule_comment Unit finger width (F) of PMOS for ESD protection device >= 30um
trs::rule_comment <= 40um
 trs::outputlayer ~edge_inside (  edge_length (  edge_inside (  EGATE_W EPMOS ) < 30  ) NODRC ) 
 trs::outputlayer ~edge_inside (  edge_length (  edge_inside (  EGATE_W EPMOS ) > 40  ) NODRC ) 
}

trs::pvrs_block  {
#IFDEF OPEN_RECOMMENDED_ON YES 
}
trs::rule ESDN_13_R {
trs::rule_comment Total channel width of ESD NMOS. The total channel width is calculated by the ESD MOS in the same Drain connection. The connectivity can be formed by all metal, via, ALPA, PA and MD but not broken by resistors. SAB is used for drain recognition in DRC runset
trs::rule_comment Channel width (W) of NMOS for ESD protection device (Channel width = Finger width x Finger No.) >= 150um
   trs::setlayer X = check_nar ( ENGATE_D_EMPTY ESD3C_EMPTY "\[AREA(ESD3C_EMPTY)/0.001\]" < 150  ) 
   trs::outputlayer ~geom_inside (  ~geom_interact (  geom_interact (  X ENGATE ) EGATE_NOSAB ) NODRC ) 
}

trs::rule ESDP_10_R {
trs::rule_comment Total channel width of ESD PMOS. The total channel width is calculated by the ESD MOS in the same Drain connection. The connectivity can be formed by all metal, via, ALPA, PA and MD but not broken by resistors. SAB is used for drain recognition in DRC runset
trs::rule_comment Channel width (W) of PMOS for ESD protection device (Channel width = Finger width x Finger No.) >= 300um
   trs::setlayer X = check_nar ( EPGATE_D_EMPTY ESD3C_EMPTY "\[AREA(ESD3C_EMPTY)/0.001\]" < 300  ) 
   trs::outputlayer ~geom_inside (  ~geom_interact (  geom_interact (  X EPGATE ) EGATE_NOSAB ) NODRC ) 
}

trs::pvrs_block  {
#ENDIF 
}

trs::pvrs_block  {
#IFDEF IO 1833 
}
trs::rule ESDN_3 {
trs::rule_comment Channel length of 3.3V I/O NMOS for protection device. >= 0.5um
 trs::setlayer X = edge_coincident ( both_side  geom_and (  EGATEHV ENGATE ) EGATE_L ) 
 trs::outputlayer ~edge_inside (  edge_length (  X < 0.5  ) NODRC ) 
}
trs::rule ESDP_3 {
trs::rule_comment Channel length of 3.3V I/O PMOS for protection device. >= 0.4um, <=0.5 
 trs::setlayer X = edge_coincident ( both_side  geom_and (  EGATEHV EPGATE ) EGATE_L ) 
 trs::setlayer GOOD = ~edge_inside (  edge_length (  X >= 0.4  <= 0.5  ) NODRC ) 
 trs::outputlayer ~edge_inside (  ~geom_with_edge ( geom_and (  EGATEHV EPGATE ) GOOD ) NODRC ) 
}
trs::pvrs_block  {
#ENDIF 
}

trs::pvrs_block  {
#IFDEF IO 1825  
}
trs::rule ESDN_3 {
trs::rule_comment Channel length of 3.3V I/O NMOS for protection device. >= 0.5um
 trs::setlayer X = edge_coincident ( both_side  geom_and (  EGATEHV ENGATE ) EGATE_L ) 
 trs::outputlayer ~edge_inside (  edge_length (  X < 0.5  ) NODRC ) 
}
trs::rule ESDP_3 {
trs::rule_comment Channel length of 3.3V I/O PMOS for protection device. >= 0.4um, <=0.5 
 trs::setlayer X = edge_coincident ( both_side  geom_and (  EGATEHV EPGATE ) EGATE_L ) 
 trs::setlayer GOOD = ~edge_inside (  edge_length (  X >= 0.4  <= 0.5  ) NODRC ) 
 trs::outputlayer ~edge_inside (  ~geom_with_edge ( geom_and (  EGATEHV EPGATE ) GOOD ) NODRC ) 
}
trs::pvrs_block  {
#ENDIF 
}


trs::pvrs_block  {
#ENDIF 
}



#//============================
#//  ESD1 implant layer rules
#//============================

trs::rule ESD_W_1 {
trs::rule_comment ESD1 width >= 0.47um

trs::outputlayer ~geom_inside (  width (  ESD1 < 0.47  adjacent < 90  point_touch region ) NODRC ) 
}

trs::rule ESD_S_1 {
trs::rule_comment Space between two ESD1s. Merge if space is less than this value. >= 0.47um
trs::outputlayer ~geom_inside (  space (  ESD1 < 0.47  adjacent < 90  point_touch region ) NODRC ) 
}

trs::rule ESD_A_1 {
trs::rule_comment ESD1 area >= 0.6um2 
trs::outputlayer ~geom_inside (  geom_area  ( ESD1 < 0.6  ) NODRC ) 
}

trs::rule ESD_A_2 {
trs::rule_comment ESD1 enclosed area >= 0.6um2
trs::outputlayer ~geom_inside (  geom_area  ( geom_not (  geom_holes ( ESD1 inner_most ) ESD1 ) < 0.6  ) NODRC ) 
}

trs::pvrs_block  {
#IFDEF LATCH_UP_CHECK YES 
}

