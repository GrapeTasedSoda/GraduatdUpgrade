if {($T8V1_T8M1 == 0) && ($T8V2_T8M2 == 1)} {

trs::setlayer T8M2DUM_2p8_2p8 = geom_rectangle ( T8M2DUM == 2.8  by == 2.8  ) 

trs::rule T8M2DUMCK_W_1 {
