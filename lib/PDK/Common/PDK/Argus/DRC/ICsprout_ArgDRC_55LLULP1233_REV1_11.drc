trs::rule PO_L_2_R {
trs::rule_comment Recommanded maximum L shape length of L-shape ACT which  space to PO (in the same MOS with width >= 0.15um) <= 0.1 is <=0.21
trs::setlayer PO_CHECK = geom_edge_to_rect ( edge_length (  GATE_W >= 0.15  ) inside 0.001  ) 
trs::setlayer POmergeAA = geom_interact (  geom_or (  PO AA ) PO_CHECK ) 
trs::setlayer L_edge = edge_convex_point ( POmergeAA adjacent_edge_angle1 == 90  adjacent_edge_angle2 == 270  ) 
trs::setlayer L_edge_ = geom_edge_to_rect ( L_edge inside 0.001  ) 

trs::setlayer LAA_ = geom_adjacent (  L_edge_ AAconer == 1  ) 
trs::setlayer LAA = edge_coincident ( both_side  L_edge LAA_ ) 
trs::setlayer X = edge_length (  LAA > 0.21  ) 
trs::setlayer Y = space (  X PO < 0.1  region ) 
#~edge_inside (  edge_coincident ( both_side  X ~edge_adjacent ( both_side  AA GATE ) ) NODRC ) 
trs::outputlayer ~edge_inside (  edge_coincident ( both_side  X Y ) NODRC ) 
}
