trs::setlayer all_pad_TXT_ALPA = geom_or (  all_pad_vdd_ALPA all_pad_vss_ALPA all_pad_vcc_ALPA all_pad_gnd_ALPA ) 

trs::setlayer all_pad_TXT = geom_or (  all_pad_TXT_M1 all_pad_TXT_M2 all_pad_TXT_M3 all_pad_TXT_M4 all_pad_TXT_M5 all_pad_TXT_M6 all_pad_TXT_M7 all_pad_TXT_M8 all_pad_TXT_T4M1 all_pad_TXT_T4M2 all_pad_TXT_T2M1 \
all_pad_TXT_T2M2 all_pad_TXT_T8M1 all_pad_TXT_T8M2 all_pad_TXT_PA all_pad_TXT_ALPA ) 

trs::setlayer all_pad_TXT1_PA = geom_transfer_netid ( all_pad_TXT_PA by PA_1 ) 
trs::setlayer all_pad_TXT1_ALPA = geom_transfer_netid ( all_pad_TXT_ALPA by ALPA_1 ) 
trs::setlayer power_pad_TXT_PA = geom_interact (  PA_1 check_nar ( PA_1 all_pad_TXT1_PA > 0  ) ) 
trs::setlayer power_pad_TXT_ALPA = geom_interact (  ALPA_1 check_nar ( ALPA_1 all_pad_TXT1_ALPA > 0  ) ) 
trs::setlayer NAA_POWER_PAD_PA = check_nar ( NAA_PAD power_pad_TXT_PA > 0  ) 
trs::setlayer PAA_POWER_PAD_PA = check_nar ( PAA_PAD power_pad_TXT_PA > 0  ) 
trs::setlayer NAA_POWER_PAD_ALPA = check_nar ( NAA_PAD power_pad_TXT_ALPA > 0  ) 
trs::setlayer PAA_POWER_PAD_ALPA = check_nar ( PAA_PAD power_pad_TXT_ALPA > 0  ) 
trs::pvrs_block  {
POWER_PAD2 = geom_transfer_netid ( POWER_PAD by MD_1 ) 
POWER_PAD3 = geom_interact (  MD_1 check_nar ( MD_1 POWER_PAD2 > 0  ) ) 
MD_IO_PAD = ~geom_interact (  MD_1 POWER_PAD3 ) 
}

trs::setlayer NACT_0 = geom_not (  geom_and (  SDN AA ) PO ) 
trs::setlayer PACT_0 = geom_not (  geom_and (  SDP AA ) PO ) 

trs::setlayer CT_1 = geom_or (  EMPTY5 CT ) 
trs::setlayer MD_1 = geom_or (  EMPTY5 MD ) 
trs::setlayer RDL_1 = geom_or (  EMPTY5 RDL ) 
trs::setlayer RDLVIA_1 = geom_or (  EMPTY5 RV ) 
trs::setlayer RDLPA2_1 = geom_or (  EMPTY5 COVER ) 

trs::pvrs_block  {
#IFDEF DEFINE_PAD_BY_TEXT 1 
}
trs::setlayer ALPA_1 = geom_or (  EMPTY5 ALPA ) 
trs::setlayer PA_1 = geom_or (  EMPTY5 PA ) 

trs::setlayer M1i_EMPTY5 = geom_or (  EMPTY5 M1i ) 
trs::setlayer all_pad_TXT1_M1 = geom_transfer_netid ( all_pad_TXT_M1 by M1i_EMPTY5 ) 
trs::setlayer power_pad_TXT_M1 = geom_interact (  M1i_EMPTY5 check_nar ( M1i_EMPTY5 all_pad_TXT1_M1 > 0  ) ) 
trs::setlayer NAA_POWER_PAD_M1 = check_nar ( NAA_PAD power_pad_TXT_M1 > 0  ) 
trs::setlayer PAA_POWER_PAD_M1 = check_nar ( PAA_PAD power_pad_TXT_M1 > 0  ) 

set metal_list { M2 M3 M4 M5 M6 M7 M8 }
foreach metal_layer $metal_list {
  set tmp CHECK_$metal_layer
  set tmp_v [set $tmp]

  if { $tmp_v == 1 } {
trs::setlayer "${metal_layer}i_EMPTY5" = geom_or (  EMPTY5 "${metal_layer}i" ) 
trs::setlayer "all_pad_TXT1_${metal_layer}" = geom_transfer_netid ( "all_pad_TXT_${metal_layer}" by "${metal_layer}i_EMPTY5" ) 
trs::setlayer "power_pad_TXT_${metal_layer}" = geom_interact (  "${metal_layer}i_EMPTY5" check_nar ( "${metal_layer}i_EMPTY5" "all_pad_TXT1_${metal_layer}" > 0  ) ) 

trs::setlayer "NAA_POWER_PAD_${metal_layer}" = check_nar ( NAA_PAD "power_pad_TXT_${metal_layer}" > 0  ) 
  trs::setlayer "PAA_POWER_PAD_${metal_layer}" = check_nar ( PAA_PAD "power_pad_TXT_${metal_layer}" > 0  ) 
  lappend list1 NAA_POWER_PAD_${metal_layer}
  lappend list2 PAA_POWER_PAD_${metal_layer}
}
}

trs::setlayer V1_EMPTY5 = geom_or (  EMPTY5 V1 ) 
set via_list { V2 V3 V4 V5 V6 V7 }
foreach via_layer $via_list {
  set tmp CHECK_$via_layer
  set tmp_v [set $tmp]

  if { $tmp_v == 1 } {
trs::setlayer "${via_layer}_EMPTY5" = geom_or (  EMPTY5 "${via_layer}" ) 

}
}

if { ($T4V1_T4M1 == 1) && ($T4V2_T4M2 == 1) && ($top_metal == 2) } {
trs::setlayer T4M1i_EMPTY5 = geom_or (  EMPTY5 T4M1i ) 
trs::setlayer T4M2i_EMPTY5 = geom_or (  EMPTY5 T4M2i ) 
trs::setlayer T4V1i_EMPTY5 = geom_or (  EMPTY5 T4V1i ) 
trs::setlayer T4V2i_EMPTY5 = geom_or (  EMPTY5 T4V2i ) 

trs::setlayer all_pad_TXT1_T4M1 = geom_transfer_netid ( all_pad_TXT_T4M1 by T4M1i_EMPTY5 ) 
trs::setlayer all_pad_TXT1_T4M2 = geom_transfer_netid ( all_pad_TXT_T4M2 by T4M2i_EMPTY5 ) 
trs::setlayer power_pad_TXT_T4M1 = geom_interact (  T4M1i_EMPTY5 check_nar ( T4M1i_EMPTY5 all_pad_TXT1_T4M1 > 0  ) ) 
trs::setlayer power_pad_TXT_T4M2 = geom_interact (  T4M2i_EMPTY5 check_nar ( T4M2i_EMPTY5 all_pad_TXT1_T4M2 > 0  ) ) 
trs::setlayer NAA_POWER_PAD_T4M1 = check_nar ( NAA_PAD power_pad_TXT_T4M1 > 0  ) 
trs::setlayer PAA_POWER_PAD_T4M1 = check_nar ( PAA_PAD power_pad_TXT_T4M1 > 0  ) 
trs::setlayer NAA_POWER_PAD_T4M2 = check_nar ( NAA_PAD power_pad_TXT_T4M2 > 0  ) 
trs::setlayer PAA_POWER_PAD_T4M2 = check_nar ( PAA_PAD power_pad_TXT_T4M2 > 0  ) 
lappend list1 {NAA_POWER_PAD_T4M1 }
lappend list1 {NAA_POWER_PAD_T4M2}
lappend list2 {PAA_POWER_PAD_T4M1}
lappend list2 {PAA_POWER_PAD_T4M2}
}

if { ($T4V1_T4M1 == 1) && ($T8V2_T8M2 == 1) && ($top_metal == 2) } {
trs::setlayer T4M1i_EMPTY5 = geom_or (  EMPTY5 T4M1i ) 
trs::setlayer T8M2i_EMPTY5 = geom_or (  EMPTY5 T8M2i ) 
trs::setlayer T4V1i_EMPTY5 = geom_or (  EMPTY5 T4V1i ) 
trs::setlayer T8V2i_EMPTY5 = geom_or (  EMPTY5 T8V2i ) 
trs::setlayer all_pad_TXT1_T4M1 = geom_transfer_netid ( all_pad_TXT_T4M1 by T4M1i_EMPTY5 ) 
trs::setlayer all_pad_TXT1_T8M2 = geom_transfer_netid ( all_pad_TXT_T8M2 by T8M2i_EMPTY5 ) 
trs::setlayer power_pad_TXT_T4M1 = geom_interact (  T4M1i_EMPTY5 check_nar ( T4M1i_EMPTY5 all_pad_TXT1_T4M1 > 0  ) ) 
trs::setlayer power_pad_TXT_T8M2 = geom_interact (  T8M2i_EMPTY5 check_nar ( T8M2i_EMPTY5 all_pad_TXT1_T8M2 > 0  ) ) 
trs::setlayer NAA_POWER_PAD_T4M1 = check_nar ( NAA_PAD power_pad_TXT_T4M1 > 0  ) 
trs::setlayer PAA_POWER_PAD_T4M1 = check_nar ( PAA_PAD power_pad_TXT_T4M1 > 0  ) 
trs::setlayer NAA_POWER_PAD_T8M2 = check_nar ( NAA_PAD power_pad_TXT_T8M2 > 0  ) 
