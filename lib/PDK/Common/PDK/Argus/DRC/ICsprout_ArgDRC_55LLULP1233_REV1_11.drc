trs::rule_comment Space between T8MnDUM and FUSEALL(fuse) >= 3um
trs::outputlayer space (  T8M1DUM FUSEALL < 3  adjacent < 90  point_touch region ) 
trs::outputlayer extension (  T8M1DUM FUSEALL < 3  adjacent < 90  point_touch region ) 
}

