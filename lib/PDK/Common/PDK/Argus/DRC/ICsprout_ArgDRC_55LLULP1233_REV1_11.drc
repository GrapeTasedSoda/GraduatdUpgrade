trs::setlayer all_pad_TXT_T4M1 = geom_or (  all_pad_vdd_T4M1 all_pad_vss_T4M1 all_pad_vcc_T4M1 all_pad_gnd_T4M1 ) 
trs::setlayer all_pad_TXT_T4M2 = geom_or (  all_pad_vdd_T4M2 all_pad_vss_T4M2 all_pad_vcc_T4M2 all_pad_gnd_T4M2 ) 
trs::setlayer all_pad_TXT_T2M1 = geom_or (  all_pad_vdd_T2M1 all_pad_vss_T2M1 all_pad_vcc_T2M1 all_pad_gnd_T2M1 ) 
trs::setlayer all_pad_TXT_T2M2 = geom_or (  all_pad_vdd_T2M2 all_pad_vss_T2M2 all_pad_vcc_T2M2 all_pad_gnd_T2M2 ) 
trs::setlayer all_pad_TXT_T8M1 = geom_or (  all_pad_vdd_T8M1 all_pad_vss_T8M1 all_pad_vcc_T8M1 all_pad_gnd_T8M1 ) 
trs::setlayer all_pad_TXT_T8M2 = geom_or (  all_pad_vdd_T8M2 all_pad_vss_T8M2 all_pad_vcc_T8M2 all_pad_gnd_T8M2 ) 
