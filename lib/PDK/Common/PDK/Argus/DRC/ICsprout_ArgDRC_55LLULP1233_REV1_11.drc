trs::rule PO_L_1 {
trs::rule_comment PO length between two CTs without GATE, and the length from any point inside GATE to nearest CT, when the PO width is < 0.13um
trs::rule_comment This rule is for voltage drop concern. DRC waive check ESDIOE covered region. <= 25.00um
trs::setlayer PO_CHECK = geom_interact (  geom_not (  geom_with_width ( PO < 0.13  ) GATE ) CT ) 
trs::setlayer Z0 = geom_size ( CT by 12.5  inside_of_layer     PO_CHECK delta 0.02  ) 
trs::outputlayer ~geom_inside (  ~geom_inside (  geom_interact (  PO_CHECK Z0 > 1  ) ESDIOE ) NODRC ) 
trs::setlayer PO_CHECK1 = geom_not (  geom_interact (  PO CT ) GATE ) 
trs::setlayer Z4 = ~geom_interact (  geom_not (  width (  PO_CHECK1 < 0.13  opposite region ) GATE ) CT ) 
trs::setlayer Z6 = edge_length (  Z4 > 25  ) 
trs::outputlayer ~edge_inside (  ~edge_inside (  Z6 ESDIOE ) NODRC ) 


trs::setlayer X = geom_with_edge ( GATE edge_length (  GATE_L < 0.13  ) ) 
trs::setlayer Y = geom_interact (  geom_interact (  PO X ) CT ) 
trs::setlayer Z = geom_size ( CT by 25  inside_of_layer     Y delta 0.02  ) 
trs::outputlayer ~geom_inside (  ~geom_inside (  ~geom_inside (  geom_interact (  GATE Y ) Z ) ESDIOE ) NODRC ) 
}

