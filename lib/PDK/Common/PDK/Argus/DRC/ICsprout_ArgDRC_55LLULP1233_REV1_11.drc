  trs::setlayer T2V2S_SQ = geom_rectangle ( T2V2S == 0.2  by == 0.2  ) 

  trs::setlayer T2M2S = geom_and (  T2M2i SRINGBLK ) 
  trs::setlayer T2M2S_INNER = geom_adjacent (  T2M2S geom_holes ( T2M2S inner_most ) == 1  ) 
  trs::setlayer T2M2S_OUTER = geom_adjacent (  T2M2S geom_holes ( T2M2S ) == 1  ) 
  trs::setlayer T2M2S_RING = geom_and (  T2M2i geom_interact (  T2M2S T2M2S_OUTER ) ) 

  trs::pvrs_block  {
}
}
if { ([set CHECK_T8V1] == 1) && ([set CHECK_T8M1] == 1) } {
  trs::setlayer T8V1S = geom_and (  T8V1 SRINGBLK ) 
  trs::setlayer T8V1S_SL = geom_or (  geom_and (  T8V1S T8V1bar ) geom_not (  T8V1S T8V1S_SQ ) ) 
