U4V4_metal = geom_interact (  M4M5 V4 < 4  ) 
M5M6 = geom_and (  M5 M6 ) 
SV5_metal = geom_interact (  M5M6 V5 == 1  ) 
U4V5_metal = geom_interact (  M5M6 V5 < 4  ) 
M6M7 = geom_and (  M6 M7 ) 
SV6_metal = geom_interact (  M6M7 V6 == 1  ) 
U4V6_metal = geom_interact (  M6M7 V6 < 4  ) 
M7M8 = geom_and (  M7 M8 ) 
SV7_metal = geom_interact (  M7M8 V7 == 1  ) 
U4V7_metal = geom_interact (  M7M8 V7 < 4  ) 
//WIDE METAL FOR REDUNDANT VIA CHECK


WIDE_M1_0P30 = geom_with_width ( M1 >= 0.30  ) 
WIDE_M1_0P70 = geom_with_width ( WIDE_M1_0P30 >= 0.7  ) 

WIDE_M2_0P30 = geom_with_width ( M2 >= 0.30  ) 
WIDE_M2_0P70 = geom_with_width ( WIDE_M2_0P30 >= 0.7  ) 

WIDE_M3_0P30 = geom_with_width ( M3 >= 0.30  ) 
WIDE_M3_0P70 = geom_with_width ( WIDE_M3_0P30 >= 0.7  ) 

WIDE_M4_0P30 = geom_with_width ( M4 >= 0.30  ) 
WIDE_M4_0P70 = geom_with_width ( WIDE_M4_0P30 >= 0.7  ) 

WIDE_M5_0P30 = geom_with_width ( M5 >= 0.30  ) 
WIDE_M5_0P70 = geom_with_width ( WIDE_M5_0P30 >= 0.7  ) 

WIDE_M6_0P30 = geom_with_width ( M6 >= 0.30  ) 
WIDE_M6_0P70 = geom_with_width ( WIDE_M6_0P30 >= 0.7  ) 

WIDE_M7_0P30 = geom_with_width ( M7 >= 0.30  ) 
WIDE_M7_0P70 = geom_with_width ( WIDE_M7_0P30 >= 0.7  ) 

WIDE_M8_0P30 = geom_with_width ( M8 >= 0.30  ) 
WIDE_M8_0P70 = geom_with_width ( WIDE_M8_0P30 >= 0.7  ) 
//------------------------------------------------------------------------------------------
V1_org = geom_or (  VIA1i VIA1bar ) 
V2_org = geom_or (  VIA2i VIA2bar ) 
V3_org = geom_or (  VIA3i VIA3bar ) 
V4_org = geom_or (  VIA4i VIA4bar ) 
V5_org = geom_or (  VIA5i VIA5bar ) 
V6_org = geom_or (  VIA6i VIA6bar ) 
V7_org = geom_or (  VIA7i VIA7bar ) 

V1bar = copy ( VIA1bar ) 
V2bar = copy ( VIA2bar ) 
V3bar = copy ( VIA3bar ) 
V4bar = copy ( VIA4bar ) 
V5bar = copy ( VIA5bar ) 
V6bar = copy ( VIA6bar ) 
V7bar = copy ( VIA7bar ) 

V1_slot = geom_interact (  geom_and (  geom_enclose_rectangle ( V1_org 0.1  0.30  ) GRID ) geom_with_width ( V1_org == 0.09  ) ) 
V2_slot = geom_interact (  geom_and (  geom_enclose_rectangle ( V2_org 0.1  0.30  ) GRID ) geom_with_width ( V2_org == 0.09  ) ) 
V3_slot = geom_interact (  geom_and (  geom_enclose_rectangle ( V3_org 0.1  0.30  ) GRID ) geom_with_width ( V3_org == 0.09  ) ) 
V4_slot = geom_interact (  geom_and (  geom_enclose_rectangle ( V4_org 0.1  0.30  ) GRID ) geom_with_width ( V4_org == 0.09  ) ) 
V5_slot = geom_interact (  geom_and (  geom_enclose_rectangle ( V5_org 0.1  0.30  ) GRID ) geom_with_width ( V5_org == 0.09  ) ) 
V6_slot = geom_interact (  geom_and (  geom_enclose_rectangle ( V6_org 0.1  0.30  ) GRID ) geom_with_width ( V6_org == 0.09  ) ) 
V7_slot = geom_interact (  geom_and (  geom_enclose_rectangle ( V7_org 0.1  0.30  ) GRID ) geom_with_width ( V7_org == 0.09  ) ) 

V1_slot_SG = geom_or (  geom_interact (  geom_and (  geom_enclose_rectangle ( V1_org 0.09  0.27  ) GRID ) geom_with_width ( V1_org == 0.09  ) ) V1_slot ) 
V2_slot_SG = geom_or (  geom_interact (  geom_and (  geom_enclose_rectangle ( V2_org 0.09  0.27  ) GRID ) geom_with_width ( V2_org == 0.09  ) ) V2_slot ) 
V3_slot_SG = geom_or (  geom_interact (  geom_and (  geom_enclose_rectangle ( V3_org 0.09  0.27  ) GRID ) geom_with_width ( V3_org == 0.09  ) ) V3_slot ) 
V4_slot_SG = geom_or (  geom_interact (  geom_and (  geom_enclose_rectangle ( V4_org 0.09  0.27  ) GRID ) geom_with_width ( V4_org == 0.09  ) ) V4_slot ) 
V5_slot_SG = geom_or (  geom_interact (  geom_and (  geom_enclose_rectangle ( V5_org 0.09  0.27  ) GRID ) geom_with_width ( V5_org == 0.09  ) ) V5_slot ) 
V6_slot_SG = geom_or (  geom_interact (  geom_and (  geom_enclose_rectangle ( V6_org 0.09  0.27  ) GRID ) geom_with_width ( V6_org == 0.09  ) ) V6_slot ) 
V7_slot_SG = geom_or (  geom_interact (  geom_and (  geom_enclose_rectangle ( V7_org 0.09  0.27  ) GRID ) geom_with_width ( V7_org == 0.09  ) ) V7_slot ) 
}


trs::pvrs_block  {
