trs::rule PO_R_1 {
trs::rule_comment No bent PO on ACT is allowed.All PO patterns on ACT have to be orthogonal to ACT edage.
trs::rule_comment DRC waive check the INDALL and SRAMALL covered region, and waive check (ACT AND PO) width <= 0.01um pattern.
trs::setlayer POEIAA1 = edge_coincident ( both_side  POEIAA geom_with_width ( geom_and (  PO AA ) > 0.01  ) ) 
trs::setlayer POEIAA = edge_inside (  PO AA ) 
trs::outputlayer ~geom_inside (  ~geom_inside (  width (  POEIAA1 < 0.01  adjacent == 90  region ) geom_or (  INDALL SRAMALL ) ) NODRC ) 
trs::outputlayer ~geom_inside (  ~geom_inside (  space (  POEIAA1 < 0.01  adjacent == 90  region ) geom_or (  INDALL SRAMALL ) ) NODRC ) 
trs::outputlayer ~geom_inside (  ~geom_inside (  width (  POEIAA1 < 0.01  adjacent == 45  region ) geom_or (  INDALL SRAMALL ) ) NODRC ) 
trs::outputlayer ~geom_inside (  ~geom_inside (  space (  POEIAA1 < 0.01  adjacent == 45  region ) geom_or (  INDALL SRAMALL ) ) NODRC ) 
trs::outputlayer ~geom_inside (  ~geom_inside (  width (  POEIAA1 < 0.01  adjacent == 135  region ) geom_or (  INDALL SRAMALL ) ) NODRC ) 
trs::outputlayer ~geom_inside (  ~geom_inside (  space (  POEIAA1 < 0.01  adjacent == 135  region ) geom_or (  INDALL SRAMALL ) ) NODRC ) 
trs::setlayer AAEIPO1 = edge_coincident ( both_side  edge_inside (  AA PO ) geom_with_width ( geom_and (  PO AA ) > 0.01  ) ) 
trs::outputlayer ~geom_inside (  ~geom_inside (  width (  POEIAA1 AAEIPO1 < 0.01  adjacent != 90  region ) geom_or (  INDALL SRAMALL ) ) NODRC ) 
}

trs::rule PO_R_2 {
trs::rule_comment PO must be enclosed by NP and/or PP.
trs::setlayer HRPR = geom_interact (  PO HPR ) 
trs::setlayer HRP_END = geom_size ( geom_not (  HRPR HPR ) by 0.3  ) 
trs::setlayer PO_MID = geom_not (  geom_interact (  PO geom_or (  HPR HRP ) ) HRP_END ) 
trs::setlayer Y = ~geom_interact (  geom_not (  geom_not (  geom_not (  geom_interact (  PO CT ) PO_MID ) SDP ) SDN ) MOMLVS1 ) 
trs::outputlayer ~geom_inside (  ~geom_inside (  Y SRAMALL ) NODRC ) 
}


trs::pvrs_block  {
define_fun NPLH_68 LAY_IMP LAY_ACT ENC_SD ENC_PO ENC_EXTENSION {
X = edge_inside (  PO lay_act ) 
A = geom_edge_to_rect ( X inside enc_extension outside enc_extension fill_corner ) 
Y = edge_coincident ( both_side  geom_and (  PO lay_act ) lay_act ) 
B = geom_edge_to_rect ( Y outside enc_po extend enc_extension ) 
C = geom_or (  A B ) 
~geom_inside (  extension (  lay_act edge_inside (  lay_imp C ) < enc_po opposite adjacent < 90  region ) NODRC ) 
~geom_inside (  extension (  X lay_imp < enc_sd opposite adjacent < 90  region ) NODRC ) 
}
define_fun SNP_68 LAY_IMP LAY_ACT ENC_SD ENC_PO ENC_EXTENSION {
X = edge_inside (  PO lay_act ) 
A = geom_edge_to_rect ( X inside enc_extension outside enc_extension fill_corner ) 
Y = edge_coincident ( both_side  geom_and (  PO lay_act ) lay_act ) 
B = geom_edge_to_rect ( Y outside enc_po extend enc_extension ) 
C = geom_or (  A B ) 
D = extension (  lay_act edge_inside (  lay_imp C ) < enc_po opposite adjacent < 90  region ) 
~geom_inside (  ~geom_inside (  D SRAMALL ) NODRC ) 
E = extension (  X lay_imp < enc_sd opposite adjacent < 90  region ) 
~geom_inside (  ~geom_inside (  E SRAMALL ) NODRC ) 
}
//=================================
//  NP - N+ S/D Implantation DRC
//=================================
group_rule ( GNP NP_?  ) 

RULE NP_W_1 { 
; NP width. Single-point-interaction is allowed. >= 0.18um

~geom_inside (  
width (  SDN < 0.18  adjacent < 90  region ) NODRC ) 
}

RULE NP_S_1 { 
; Space between two NPs. >= 0.18um

~geom_inside (  
space (  SDN < 0.18  opposite adjacent < 90  region ) NODRC ) 
}

RULE NP_S_2 { 
; Space between NP and P+ ACT inside NW >= 0.12um

X = ~edge_adjacent ( both_side  geom_not (  PACT PTAP ) SDN ) 
Y = space (  SDN X < 0.12  adjacent < 90  region ) 
~geom_inside (  ~geom_inside (  Y SRAMALL ) NODRC ) 
}

RULE NP_S_3 { 
; Space between NP and P+ pick-up ACT inside PW >= 0.02um

X = ~edge_adjacent ( both_side  PTAP NACT ) 
Y = ~edge_adjacent ( both_side  X SDN ) 
~geom_inside (  space (  SDN Y < 0.02  adjacent < 90  region ) NODRC ) 
}

RULE NP_S_4 { 
; Space between NP and butted P+ACT (except SRAM area). = 0.00um

X = geom_and (  SDN PACT ) 
~geom_inside (  ~geom_inside (  X SRAMALL ) NODRC ) 
}

RULE NP_S_5 { 
; Space between NP and PMOS GATE >= 0.3um

X = edge_inside (  GATE_W SDP ) 
Y = space (  X SDN < 0.3  opposite adjacent < 90  region ) 
~geom_inside (  ~geom_inside (  Y SRAMALL ) NODRC ) 
}

RULE NP_S_6 { 
; Butted P+ pick-up ACT space to PO in the same ACT (the butted N+ACT extending <0.16um) is 0.3

NAAL = edge_adjacent ( inside  NACT NGATE ) 
NAAL_EP = geom_edge_to_rect ( NAAL outside 0.16  extend 0.01  ) 
BUTNA_ED = edge_coincident ( both_side  PACT geom_not (  NACT NTAP ) ) 
BUTNA_ED_1 = edge_inside (  BUTNA_ED NAAL_EP ) 
BUTSDN_1 = geom_with_edge ( geom_interact (  PACT PW ) BUTNA_ED_1 ) 

POSDN_1 = edge_coincident ( both_side  edge_inside (  PO geom_adjacent (  geom_not (  NACT NTAP ) PACT ) ) NGATE ) 
POSDN = edge_adjacent ( both_side  geom_with_edge ( PO POSDN_1 ) NGATE ) 
~geom_inside (  space (  BUTSDN_1 POSDN < 0.30  adjacent < 90  region ) NODRC ) 
}

RULE NP_EN_1 { 
; ACT enclosure by NP, except the SRAMALL region. >= 0.02um

X = ~edge_coincident ( both_side  ~edge_coincident ( both_side  geom_not (  ACT SDNNR ) PACT ) SDP ) 
~geom_inside (  ~geom_inside (  extension (  X SDN < 0.02  adjacent < 90  region ) SRAMALL ) NODRC ) 
}

RULE NP_EN_2 { 
; N+AA enclosure by NP, except the SRAMALL region. >= 0.12um

X = edge_inside (  ~edge_coincident ( both_side  ~edge_coincident ( both_side  ~geom_interact (  NACT NWR ) PACT ) SDP ) PW ) 
~geom_inside (  ~geom_inside (  extension (  X geom_and (  SDN PW ) < 0.12  adjacent < 90  region ) SRAMALL ) NODRC ) 
}

RULE NP_EN_3 { 
;Minimum NP Enclosure PO >= 0.15um

PO_inter = geom_not (  POLYi geom_or (  ACT POLYres HPR ) ) 
PO_CUT = geom_interact (  geom_interact (  PO_inter SDN ) SDP ) 
~geom_inside (  ~geom_inside (  extension (  geom_not (  PO_inter PO_CUT ) SDN < 0.15  adjacent < 90  region ) SRAMALL ) NODRC ) 
}

RULE NP_EX_1_EX_1a { 
; NP extension outside of NMOS GATE poly when NP edge is on ACT . >= 0.3um
; NP extension outside of GATE >= 0.16um
SDN_S = ~geom_inside (  SDN SRAMALL ) 
NACT_S = ~geom_inside (  NACT SRAMALL ) 
call_fun (SNP_68 SDN_S NACT_S 0.3 0.16 0.2 ) 

}


RULE NP_O_1 { 
; Overlap of NP and ACT >= 0.12um

~geom_inside (  
width (  SDN AA < 0.12  adjacent > 0  < 90  point_touch region ) NODRC ) 
}
RULE NP_A_1 { 
; NP area >= 0.12um2

~geom_inside (  
geom_area  ( SDN < 0.12  ) NODRC ) 
}
RULE NP_A_2 { 
; NP enclosed area >= 0.12um2

~geom_inside (  
geom_area  ( 
geom_not (  
geom_holes ( SDN inner_most ) SDN ) < 0.12  ) NODRC ) 
}
RULE NP_A_3 { 
; Minimum area of butted NW1 TAP >= 0.04um2

~geom_inside (  
geom_area  ( 
geom_adjacent (  NTAP 
geom_not (  NACT NTAP ) ) < 0.04  ) NODRC ) 
}
//=======================================
//  PP - P+ S/D implantation DRC
