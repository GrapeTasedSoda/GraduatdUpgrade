trs::rule PODUM_R_2 {
trs::rule_comment PODUM must be covered by PODUMB layer
trs::outputlayer geom_not (  PODUM PODUMB ) 
}


#**********************************************
# Mn: Metal Dummy n (n=1~8) design rules
#**********************************************

set metal_list { M1 M2 M3 M4 M5 M6 M7 M8 }
foreach metal_layer $metal_list {
  set tmp CHECK_$metal_layer
  set tmp_v [set $tmp]

trs::setlayer "${metal_layer}DUM_2_2" = geom_rectangle ( "${metal_layer}DUM" == 2  by == 2  ) 
trs::setlayer "${metal_layer}DUM_1_1" = geom_rectangle ( "${metal_layer}DUM" == 1  by == 1  ) 
trs::setlayer "${metal_layer}DUM_0p22_0p89" = geom_rectangle ( "${metal_layer}DUM" == 0.22  by == 0.89  ) 

trs::rule ${metal_layer}DUMCK_W_1 {
trs::rule_comment METndm SIZE = 2x2, 1x1, 0.22x0.89
trs::outputlayer geom_not (  geom_not (  geom_not (  "${metal_layer}DUM" "${metal_layer}DUM_2_2" ) "${metal_layer}DUM_1_1" ) "${metal_layer}DUM_0p22_0p89" ) 
}

trs::rule ${metal_layer}DUMCK_S_1 {
trs::rule_comment METndm space if METndm size is 2um*2um >= 0.8um
trs::outputlayer space (  "${metal_layer}DUM_2_2" < 0.8  adjacent < 90  point_touch region ) 
}

trs::rule ${metal_layer}DUMCK_S_2 {
trs::rule_comment Space between METndm and MET if METndm size is 2um*2um >= 10um
trs::outputlayer space (  $metal_layer "${metal_layer}DUM_2_2" < 10  adjacent < 90  point_touch region ) 
}

trs::rule ${metal_layer}DUMCK_S_3 {
trs::rule_comment METndm space if METndm size is 1um*1um >= 0.3um
trs::outputlayer space (  "${metal_layer}DUM_1_1" < 0.3  adjacent < 90  point_touch region ) 
}

trs::rule ${metal_layer}DUMCK_S_4 {
trs::rule_comment Space between METndm and MET if METndm size is 1um*1um >= 3um
trs::outputlayer space (  $metal_layer "${metal_layer}DUM_1_1" < 3  adjacent < 90  point_touch region ) 
}

trs::rule ${metal_layer}DUMCK_S_5 {
trs::rule_comment METndm space if METndm size is 0.22um*0.89um >= 0.25um
trs::outputlayer space (  "${metal_layer}DUM_0p22_0p89" < 0.25  adjacent < 90  point_touch region ) 
}

trs::rule ${metal_layer}DUMCK_S_6 {
trs::rule_comment Space between METndm and MET if METndm size is 0.22um*0.89um >= 0.3um
trs::outputlayer space (  $metal_layer "${metal_layer}DUM_0p22_0p89" < 0.3  adjacent < 90  point_touch region ) 
}

trs::rule ${metal_layer}DUMCK_S_7 {
trs::rule_comment Space between two (MnDUM or Mn) having run length >=1.5um with one or both M1DUM width >=1.5um is 0.60um
Mn_2c_DUM ${metal_layer}ALL ${metal_layer}DUM 1.5 1.5 0.6
}

trs::rule ${metal_layer}DUMCK_S_8 {
trs::rule_comment Space between MnDUM and 45 degree METn >= 0.4um
  trs::setlayer X = edge_angle (  $metal_layer == 45  ) 
  trs::outputlayer ~geom_inside (  space (  X "${metal_layer}DUM" < 0.4  region ) NODRC ) 
}

trs::rule ${metal_layer}DUMCK_S_9 {
trs::rule_comment Space between MnDUM and FUSEALL(fuse) >= 3um
trs::outputlayer space (  "${metal_layer}DUM" FUSEALL < 3  adjacent < 90  point_touch region ) 
trs::outputlayer extension (  "${metal_layer}DUM" FUSEALL < 3  adjacent < 90  point_touch region ) 
}

trs::rule ${metal_layer}DUMCK_S_10 {
trs::rule_comment Space between MnDUM and BMIM(MIM) >= 2um
trs::outputlayer space (  "${metal_layer}DUM" BMIM < 2  adjacent < 90  point_touch region ) 
trs::outputlayer extension (  "${metal_layer}DUM" BMIM < 2  adjacent < 90  point_touch region ) 
}

trs::rule ${metal_layer}DUMCK_S_11 {
trs::rule_comment Space between MnDUM and LOGO >= 0.1um
trs::outputlayer space (  "${metal_layer}DUM" LOGO < 0.1  adjacent < 90  point_touch region ) 
trs::outputlayer extension (  "${metal_layer}DUM" LOGO < 0.1  adjacent < 90  point_touch region ) 
}

trs::rule ${metal_layer}DUMCK_S_12 {
trs::rule_comment Space between MnDUM and INDALL >= 3um
trs::outputlayer space (  "${metal_layer}DUM" INDALL < 3  adjacent < 90  point_touch region ) 
trs::outputlayer extension (  "${metal_layer}DUM" INDALL < 3  adjacent < 90  point_touch region ) 
}

trs::rule ${metal_layer}DUMCK_S_13 {
trs::rule_comment Space between MnDUM and CHIPBLK(chip edge) >= 2.5um
trs::outputlayer space (  "${metal_layer}DUM" CHIPBLK < 2.5  adjacent < 90  point_touch region ) 
trs::outputlayer extension (  "${metal_layer}DUM" CHIPBLK < 2.5  adjacent < 90  point_touch region ) 
}

trs::rule ${metal_layer}DUMCK_S_14 {
trs::rule_comment Space between MnDUM and MnDUMB >= 2um
trs::outputlayer space (  "${metal_layer}DUM" "${metal_layer}DUMB" < 2  adjacent < 90  point_touch region ) 
}

trs::rule ${metal_layer}DUMCK_S_15 {
trs::rule_comment Space between MnDUM and DMYBLK >= 2um
trs::outputlayer space (  "${metal_layer}DUM" DMYBLK < 2  adjacent < 90  point_touch region ) 
}

trs::rule ${metal_layer}DUMCK_R_1 {
trs::rule_comment MnDUM must be covered by MnDUMB layer
trs::outputlayer geom_not (  "${metal_layer}DUM" "${metal_layer}DUMB" ) 
}

}

