trs::rule ${metal_layer}_S_2 {
trs::rule_comment Space between two Mns when one or both Mn width >=0.42um, and the parallel run length of two Mns is >= 0.42um.>=0.15um
  Mn_2b ${metal_layer}ALL 0.42 0.42 0.15
}

trs::rule ${metal_layer}_S_3 {
trs::rule_comment Space between two Mns when one or both Mn width >=1.5um, and the parallel run length of two Mns is >= 1.5um.>=0.5um
  Mn_2b ${metal_layer}ALL 1.5 1.5 0.5
}

trs::rule ${metal_layer}_S_4 {
trs::rule_comment Space between metal lines with one or both is 45 degree  (the area with 0.1um distance from bending point need not follow this rule) >= 0.19um
  trs::setlayer X = edge_angle (  $metal_layer == 45  ) 
  trs::outputlayer ~geom_inside (  space (  X < 0.19  region ) NODRC ) 
  trs::outputlayer ~geom_inside (  space (  $metal_layer X < 0.19  region corner_edge ) NODRC ) 
}
trs::rule ${metal_layer}_S_5 { 
trs::rule_comment Minimum Space at metalX line-end(W<0.12um) in a dense-line-end configuration:if metalx has parallel run length with opposite metalx along 2 adjacent edge metalx (any one edge < 0.12um distance from the conner of the two edge), the one of the space(sp1 or sp2) need to be at least 0.12 (except for small jog with edge length < 0.10um)
  trs::setlayer LINE_END = edge_convex_point ( "${metal_layer}" adjacent_edge_angle1 == 90  adjacent_edge_angle2 == 90  with_edge_length < 0.12  ) 
  trs::setlayer LINE_END_SP = space (  "\[LINE_END\]" "${metal_layer}" < 0.12  opposite adjacent < 90  ) 
  trs::setlayer LINE_SIDE = edge_adjacent ( inside  LINE_END LINE_END_SP ) 
  trs::setlayer LINE_END_Mn = width (  LINE_SIDE "\[${metal_layer}\]" < 0.12  adjacent == 90  intersecting_only ) 
  trs::setlayer LINE_END_Mn_010 = edge_length (  LINE_END_Mn >= 0.10  ) 
  trs::outputlayer ~geom_inside (  space (  LINE_END_Mn_010 "${metal_layer}" < 0.12  opposite adjacent < 90  region ) NODRC ) 
}

    if { [string equal $metal_layer M2] == 1 } {
trs::rule ${metal_layer}_A_1 {
trs::rule_comment Mn area >= 0.052um2
  trs::setlayer X = geom_area  ( $metal_layer < 0.052  ) 
  trs::outputlayer ~geom_inside (  ~geom_inside (  X SRAMALL ) NODRC ) 
}
    } else {
trs::rule ${metal_layer}_A_1 {
trs::rule_comment Mn area >= 0.052um2
  trs::outputlayer ~geom_inside (  geom_area  ( $metal_layer < 0.052  ) NODRC ) 
}
    }
