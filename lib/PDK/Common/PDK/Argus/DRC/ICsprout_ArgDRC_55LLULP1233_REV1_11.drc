trs::setlayer check_region_1 = ~geom_inside (  geom_not (  geom_not (  geom_not (  geom_not (  geom_not (  DRC:1 FUTR ) GRID ) SRINGBLK ) INDALL ) DEUPAD ) NODRC ) 
