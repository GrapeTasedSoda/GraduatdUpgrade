if { ([set CHECK_T8V1] == 1) && ([set CHECK_T8M1] == 1) } {
trs::rule SRCK_6_T8M1 {
trs::rule_comment Metal width of inner ring  >= 4
 trs::outputlayer width (  T8M1S_INNER < 4  adjacent < 90  point_touch region ) 
}
}
if { ([set CHECK_T8V2] == 1) && ([set CHECK_T8M2] == 1) } {
trs::rule SRCK_6_T8M2 {
trs::rule_comment Metal width of inner ring  >= 4
 trs::outputlayer width (  T8M2S_INNER < 4  adjacent < 90  point_touch region ) 
}
}

trs::rule SRCK_7_RDL {
trs::rule_comment RDL Clearance to window edge  >= 4.5
 trs::outputlayer extension (  RDLS_OUTER DRC:1 < 4.5  adjacent < 90  point_touch region ) 
}

trs::rule SRCK_8_RDL {
trs::rule_comment RDL width in seal ring  >= 5.5
 trs::outputlayer width (  RDLS < 5.498  adjacent < 90  point_touch region ) 
}


trs::rule SRCK_9_RV {
trs::rule_comment RV clearance to Window edge >= 6
trs::outputlayer extension (  RDLVIAS DRC:1 < 6  adjacent < 90  point_touch region ) 
}

trs::rule SRCK_10_RV {
trs::rule_comment RV slot width = 3
trs::outputlayer width (  RDLVIAS < 2.97  adjacent < 90  point_touch region ) 
trs::outputlayer geom_with_width ( RDLVIAS > 3.03  ) 
}

trs::rule SRCK_11_COVER {
trs::rule_comment Cover(Passivation2) clearance to Window edge >= 6
trs::outputlayer extension (  RDLPA2S DRC:1 < 6  adjacent < 90  point_touch region ) 
}

trs::rule SRCK_12_COVER {
trs::rule_comment Cover(Passivation2) Slot width = 3
trs::outputlayer width (  RDLPA2S < 2.97  adjacent < 90  point_touch region ) 
trs::outputlayer geom_with_width ( RDLPA2S > 3.03  ) 
}

trs::rule SRCK_13a {
trs::rule_comment Fixed CT bar width = 0.09
trs::rule_comment NOTICE: It is a guidelines rule.
  trs::setlayer X = width (  CTS_SL < 0.089  adjacent < 90  point_touch region ) 
  trs::setlayer Y = geom_with_width ( CTS_SL > 0.091  ) 
  trs::outputlayer ~geom_inside (  geom_or (  X Y ) NODRC ) 
}

trs::rule SRCK_13b {
trs::rule_comment Fixed Vn bar width (n=1~7) = 0.09
trs::rule_comment NOTICE: It is a guidelines rule.
foreach via $v_j_layer {
  trs::outputlayer ~geom_inside (  width (  "${via}S_SL" < 0.089  adjacent < 90  point_touch region ) NODRC ) 
  trs::outputlayer ~geom_inside (  geom_with_width ( "${via}S_SL" > 0.091  ) NODRC ) 
}
}

if { ($CHECK_T2V1 == 1) || ($CHECK_T2V2 == 1) } {
trs::rule SRCK_13d {
trs::rule_comment T2Vn(n=1~2) bar width (for 2X option)  = 0.20 
trs::rule_comment NOTICE: It is a guidelines rule.
foreach top_via { T2V1 T2V2 } {
  if { [set CHECK_$top_via] == 1 } {
    trs::outputlayer ~geom_inside (  width (  "${top_via}S_SL" < 0.199  adjacent < 90  point_touch region ) NODRC ) 
    trs::outputlayer ~geom_inside (  geom_with_width ( "${top_via}S_SL" > 0.223  ) NODRC ) 
  }
}
}
}

if { ($CHECK_T4V1 == 1) || ($CHECK_T4V2 == 1) || ($CHECK_T8V1 == 1) || ($CHECK_T8V2 == 1) } {
trs::rule SRCK_13e_13f {
trs::rule_comment Fixed T4Vn(n=1~2) width (for 4X option and T8V2) bar width = 0.36,DRC waive check 0.36um square TVn
foreach top_via { T4V1 T4V2 T8V1 T8V2} {
  if { [set CHECK_$top_via] == 1 } {
    trs::setlayer "VIA_${top_via}" = geom_rectangle ( "${top_via}S" == 0.36  by == 0.36  ) 
    trs::setlayer "TOP_${top_via}" = geom_not (  "${top_via}S" "VIA_${top_via}" ) 
    trs::outputlayer ~geom_inside (  width (  "TOP_${top_via}" < 0.36 - 0.005  adjacent < 90  point_touch region ) NODRC ) 
    trs::outputlayer ~geom_inside (  geom_with_width ( "TOP_${top_via}" > 0.36 + 0.005  ) NODRC ) 
    
  }
}
}
}

trs::rule SRCK_14a {
trs::rule_comment Fixed square CT width and length = 0.09
trs::rule_comment NOTICE: It is a guidelines rule.
  trs::outputlayer ~geom_rectangle ( CTS == 0.09  by == 0.09  ) 
}

trs::rule SRCK_14b_14c {
trs::rule_comment Fixed Vn width and length (n=1~7) is 0.09
trs::rule_comment NOTICE: It is a guidelines rule.
foreach via $v_j_layer {
  trs::outputlayer ~geom_inside (  ~geom_rectangle ( "${via}S" == 0.09  by == 0.09  ) NODRC ) 
}
}

if { ($CHECK_T2V1 == 1) || ($CHECK_T2V2 == 1) } {
trs::rule SRCK_14d {
trs::rule_comment Square T2Vn(n=1~2) width and length (for 2X option) = 0.2
trs::rule_comment NOTICE: It is a guidelines rule.
foreach top_via { T2V1 T2V2 } {
  if { [set CHECK_$top_via] == 1 } {
    trs::outputlayer ~geom_inside (  ~geom_rectangle ( "${top_via}S" == 0.2  by == 0.2  ) NODRC ) 
  }
}
}
}

if { ($CHECK_T4V1 == 1) || ($CHECK_T4V2 == 1) || ($CHECK_T8V1 == 1) || ($CHECK_T8V2 == 1)} {
trs::rule SRCK_14e_14f {
trs::rule_comment Fixed T4Vn(n=1~2) width and length (for square 4X option and T8V2) = 0.36
foreach top_via { T4V1 T4V2 T8V1 T8V2 } {
  if { [set CHECK_$top_via] == 1 } {
    trs::outputlayer ~geom_rectangle ( "${top_via}S" == 0.36  by == 0.36  ) 
    
  }
}
}
}

trs::rule SRCK_15a_CT { 
trs::rule_comment Metal enclosure of CT bar >= 0.375
  trs::outputlayer ~geom_inside (  extension (  CTS_SL M1S < 0.375  adjacent < 90  point_touch region ) NODRC ) 
}

trs::rule SRCK_15b_V1 {
trs::rule_comment Metal enclosure of via bar >= 0.375
  trs::outputlayer ~geom_inside (  extension (  V1S_SL M1S < 0.375  adjacent < 90  point_touch region ) NODRC ) 
  trs::outputlayer ~geom_inside (  extension (  V1S_SL M2S < 0.375  adjacent < 90  point_touch region ) NODRC ) 
}

trs::rule SRCK_15b_15c {
trs::rule_comment Via bar enclosure by Mn (n=2~7) is 0.375/0.5
trs::rule_comment NOTICE: It is a guidelines rule.
for { set j 2 } { $j <= [lindex $v_j end] } { incr j } {
  trs::setlayer "ENC5_V${j}" = geom_interact (  "V${j}S_SL" geom_or (  extension (  "V${j}S_SL" "M${j}S" < 0.5  adjacent < 90  point_touch region ) extension (  "V${j}S_SL" "M[expr $j+1]S" < 0.5  adjacent < 90  point_touch region ) ) ) 
  trs::outputlayer ~geom_inside (  extension (  "ENC5_V${j}" "M${j}S" < 0.375  adjacent < 90  point_touch region ) NODRC ) 
  trs::outputlayer ~geom_inside (  extension (  "ENC5_V${j}" "M[expr $j +1]S" < 0.375  adjacent < 90  point_touch region ) NODRC ) 
}
}

trs::rule SRCK_15d_15e_15f {
trs::rule_comment Min T2M1/T2M2 enclosure of T2V1/T2V2 bar is 0.52
trs::rule_comment Min T4M1/T4M2 enclosure of T4V1/T4V2 bar is 0.44
trs::rule_comment Min T8M1/T8M2 enclosure of T8V1/T8V2 bar is 0.44
trs::rule_comment NOTICE: It is a guidelines rule.
if { ([set CHECK_T2V2] == 1) && ([set CHECK_T2M2] == 1) } {
  trs::outputlayer ~geom_inside (  extension (  "[lindex $top_v_m_list 0]S_SL" "[lindex $top_v_m_list 1]S" < 0.52  adjacent < 90  point_touch region ) NODRC ) 
if { [llength $top_v_m_list] == 4 } {
  trs::outputlayer ~geom_inside (  extension (  "[lindex $top_v_m_list 2]S_SL" "[lindex $top_v_m_list 3]S" < 0.52  adjacent < 90  point_touch region ) NODRC ) 
}  
}

if { ([set CHECK_T2V2] == 0)} {
  trs::outputlayer ~geom_inside (  extension (  "[lindex $top_v_m_list 0]S_SL" "[lindex $top_v_m_list 1]S" < 0.44  adjacent < 90  point_touch region ) NODRC ) 
if { [llength $top_v_m_list] == 4 } {
  trs::outputlayer ~geom_inside (  extension (  "[lindex $top_v_m_list 2]S_SL" "[lindex $top_v_m_list 3]S" < 0.44  adjacent < 90  point_touch region ) NODRC ) 
}
}
}

trs::rule SRCK_16a_CT {
trs::rule_comment Square CT enclosure by M1 in SRINGBLK outer ring covered areas is 0.405
trs::rule_comment NOTICE: It is a guidelines rule.
  trs::outputlayer ~geom_inside (  extension (  CTS_SQ M1S_OUTER < 0.405  adjacent < 90  point_touch region ) NODRC ) 
}

trs::rule SRCK_16b_v1 {
trs::rule_comment Square via enclosure by M1 in SRINGBLK outer ring is 0.405
trs::rule_comment NOTICE: It is a guidelines rule.
  trs::outputlayer ~geom_inside (  extension (  V1S_SQ M1S_OUTER < 0.405  adjacent < 90  point_touch region ) NODRC ) 
}


trs::rule SRCK_16b_16c {
trs::rule_comment Square via enclosure by Mn in SRINGBLK outer ring (n=2~7) is 0.405
trs::rule_comment NOTICE: It is a guidelines rule.
for { set j 2 } { $j <= [lindex $v_j end] } { incr j } {
  trs::outputlayer ~geom_inside (  extension (  "V${j}S_SQ" "M${j}S_OUTER" < 0.405  adjacent < 90  point_touch region ) NODRC ) 
}
}

trs::rule SRCK_16d_16e_16f {
trs::rule_comment Min T2M1/T2M2 enclosure of T2V1/T2V2 in SRINGBLK outer ring is 0.48
trs::rule_comment Min T4M1/T4M2 enclosure of T4V1/T4V2 in SRINGBLK outer ring is 0.24
trs::rule_comment Min T8M1/T8M2 enclosure of T8V1/T8V2 in SRINGBLK outer ring is 0.24
trs::rule_comment NOTICE: It is a guidelines rule.
if { ([set CHECK_T2V2] == 1) && ([set CHECK_T2M2] == 1) } {
trs::outputlayer ~geom_inside (  extension (  "[lindex $top_v_m_list 0]S" "[lindex $top_v_m_list 1]S" < 0.48  adjacent < 90  point_touch region ) NODRC ) 

if { [llength $top_v_m_list] == 4 } {
  trs::outputlayer ~geom_inside (  extension (  "[lindex $top_v_m_list 0]S" "[lindex $top_v_m_list 1]S" < 0.48  adjacent < 90  point_touch region ) NODRC ) 
}
}

if { ([set CHECK_T2V2] == 0)} {
trs::outputlayer ~geom_inside (  extension (  "[lindex $top_v_m_list 0]S" "[lindex $top_v_m_list 1]S" < 0.24  adjacent < 90  point_touch region ) NODRC ) 
if { [llength $top_v_m_list] == 4 } {
  trs::outputlayer ~geom_inside (  extension (  "[lindex $top_v_m_list 2]S" "[lindex $top_v_m_list 3]S" < 0.24  adjacent < 90  point_touch region ) NODRC ) 
}
}
}

trs::rule SRCK_17a {
trs::rule_comment Minimum space between square contact and its bar is 0.74
trs::rule_comment NOTICE: It is a guidelines rule.
  trs::outputlayer ~geom_inside (  space (  CTS_SL CTS_SQ < 0.74  opposite adjacent < 90  region ) NODRC ) 
}


trs::rule SRCK_17b_17c {
trs::rule_comment Minimum space between square via and its bar is 0.6/0.74
trs::rule_comment NOTICE: It is a guidelines rule.
foreach via $v_j_layer {
  trs::setlayer "SPACE_074_${via}S_SL" = geom_interact (  "${via}S_SL" space (  "${via}S_SL" "${via}S_SQ" < 0.74  opposite adjacent < 90  region ) ) 
  trs::outputlayer ~geom_inside (  space (  "SPACE_074_${via}S_SL" "${via}S_SQ" < 0.6  opposite adjacent < 90  region ) NODRC ) 
}
}

trs::rule SRCK_17d_17e_17f {
trs::rule_comment Minimum space between square TV and its bar is 0.6
trs::rule_comment NOTICE: It is a guidelines rule.
foreach t_v_list_layer $t_v_j {
  trs::outputlayer ~geom_inside (  space (  "${t_v_list_layer}S_SL" "${t_v_list_layer}S_SQ" < 0.6  opposite adjacent < 90  region ) NODRC ) 
}
}

trs::rule SRCK_18a_19a {
trs::rule_comment CT space perpendicular to the direction of seal ring >=0.21
trs::rule_comment CT space along the sealring direction in the same colum >= 0.6
trs::setlayer CHECK_CT = geom_or (  CTS space (  CTS_SQ < 0.6  opposite region ) ) 
trs::outputlayer space (  CHECK_CT < 0.21  opposite region ) 
}

trs::rule SRCK_18b_18c_19b_19c {
trs::rule_comment Vn space perpendicular to the direction of seal ring >=0.21
trs::rule_comment Vn+1 space along the sealring direction in the same colum >= 0.6
foreach via $v_j_layer {
trs::setlayer "CHECK_${via}S" = geom_or (  "${via}S" space (  "${via}S_SQ" < 0.6  opposite region ) ) 
trs::outputlayer space (  "CHECK_${via}S" < 0.21  opposite region ) 
}
}

if { ($CHECK_T2V1 == 1) || ($CHECK_T2V2 == 1) } {
trs::rule SRCK_18d_19d_T2V1 {
trs::rule_comment T2Vn space perpendicular to the direction of seal ring >=0.38
trs::rule_comment T2Vn space along the sealring direction in the same colum >= 0.6
foreach top_via { T2V1 T2V2 } {
  if { [set CHECK_$top_via] == 1 } {
trs::setlayer "CHECK_${top_via}" = geom_or (  "${top_via}S" space (  "${top_via}S_SQ" < 0.6  opposite region ) ) 
trs::outputlayer space (  "CHECK_${top_via}" < 0.38  opposite region ) 
}
}
}
}

if { ($CHECK_T4V1 == 1) || ($CHECK_T4V2 == 1) || ($CHECK_T8V1 == 1) || ($CHECK_T8V2 == 1)  } {
trs::rule SRCK_18e_18f_19e_19f_${top_via} {
trs::rule_comment T4Vn space perpendicular to the direction of seal ring >=0.48
trs::rule_comment T4Vn space along the sealring direction in the same colum >= 0.6
trs::rule_comment T8Vn space perpendicular to the direction of seal ring >=0.48
trs::rule_comment T8Vn space along the sealring direction in the same colum >= 0.6
foreach top_via { T4V1 T4V2 T8V1 T8V2} {
  if { [set CHECK_$top_via] == 1 } {
trs::setlayer "CHECK_${top_via}" = geom_or (  "${top_via}S" space (  "${top_via}S_SQ" < 0.6  opposite region ) ) 
trs::outputlayer space (  "CHECK_${top_via}" < 0.48  opposite region ) 
}
}
}
}


trs::pvrs_block  {
#IFDEF Metal_Slot_CHECK YES 
}
#//========================================
#//  slot - Recommended metal slot rules
#//========================================
group_rule GSL SL_? 


trs::rule SL_W_1_L_1 {
trs::rule_comment Width of metal lot >= 2um
trs::rule_comment Length of metal lot >= 4.5um
foreach j [concat $metal_all ] {
trs::outputlayer ~geom_inside (  ~geom_rectangle ( "${j}slot" >= 2  by >= 4.5  ) NODRC ) 
}
}

trs::rule SL_S_1 {
trs::rule_comment Space of metal lot >= 3um
foreach j [concat $metal_all ] {
trs::outputlayer ~geom_inside (  space (  "${j}slot" < 3  adjacent < 90  point_touch region ) NODRC ) 
}
}

trs::rule SL_R_1 {
trs::rule_comment The top-metal slot overlap CB is not allowed
foreach j [concat $metal_all ] {
trs::outputlayer geom_and (  "${j}slot" PA ) 
}
}

trs::pvrs_block  {
#ENDIF 
}

#//======================================
#//  ACT Dummy Pattern check DRC
#//======================================

trs::setlayer AADUM_3_3 = geom_rectangle ( AADUM == 3  by == 3  ) 
trs::setlayer AADUM_1_1 = geom_rectangle ( AADUM == 1  by == 1  ) 
trs::setlayer AADUM_0p5_0p5 = geom_rectangle ( AADUM == 0.467  by == 0.467  ) 

trs::rule ACTDUM_W_1 {
trs::rule_comment ACTDUM SIZE = 3x3, 1x1, 0.467x0.467
trs::outputlayer geom_not (  geom_not (  geom_not (  AADUM AADUM_3_3 ) AADUM_1_1 ) AADUM_0p5_0p5 ) 
}
trs::rule ACTDUM_S_1 {
trs::rule_comment ACTDUM space if ACTDUM size is 3um*3um >= 2
trs::outputlayer space (  AADUM_3_3 < 2  adjacent < 90  point_touch region ) 
}
trs::rule ACTDUM_S_2 {
trs::rule_comment ACTDUM space if ACTDUM size is 1um*1um >= 0.6
trs::outputlayer space (  AADUM_1_1 < 0.6  adjacent < 90  point_touch region ) 
}
trs::rule ACTDUM_S_3 {
trs::rule_comment ACTDUM space if ACTDUM size is 0.467um*0.467um >= 0.28
trs::outputlayer space (  AADUM_0p5_0p5 < 0.28  adjacent < 90  point_touch region ) 
}
trs::rule ACTDUM_S_4 {
trs::rule_comment Space between ACTDUM and ACT, ACTDUM can not overlap with ACT  >= 1.6
trs::outputlayer space (  AADUM AA < 1.6  adjacent < 90  point_touch region ) 
trs::outputlayer geom_and (  AADUM AA ) 
}
trs::rule ACTDUM_S_5 {
trs::rule_comment Space between ACTDUM and Poly, ACTDUM can not overlap with Poly >= 1.6
trs::outputlayer space (  AADUM PO < 1.6  adjacent < 90  point_touch region ) 
trs::outputlayer geom_and (  AADUM PO ) 
}
trs::rule ACTDUM_S_6 {
trs::rule_comment Space between ACTDUM and NW1 boundary >= 0.3
trs::outputlayer space (  AADUM NW < 0.3  adjacent < 90  point_touch region ) 
trs::outputlayer extension (  AADUM NW < 0.3  adjacent < 90  point_touch region ) 
}
trs::rule ACTDUM_S_7 {
trs::rule_comment Space between ACTDUM and FUSEALL >= 2
trs::outputlayer space (  AADUM FUSEALL < 2  adjacent < 90  point_touch region ) 
}
trs::rule ACTDUM_S_8 {
trs::rule_comment Space between ACTDUM and NW1res >= 0.6
trs::outputlayer space (  AADUM NW1res < 0.6  adjacent < 90  point_touch region ) 
}
trs::rule ACTDUM_S_9 {
trs::rule_comment Space between ACTDUM and LOGO >= 0.1
trs::outputlayer space (  AADUM LOGO < 0.1  adjacent < 90  point_touch region ) 
}
trs::rule ACTDUM_S_10 {
trs::rule_comment Space between ACTDUM and INDALL >= 2
trs::outputlayer space (  AADUM INDALL < 2  adjacent < 90  point_touch region ) 
}
trs::rule ACTDUM_S_11 {
trs::rule_comment Space between ACTDUM and Frame boundary >= 0.6
trs::outputlayer space (  AADUM CHIPBLK < 0.6  adjacent < 90  point_touch region ) 
trs::outputlayer extension (  AADUM CHIPBLK < 0.6  adjacent < 90  point_touch region ) 
}
trs::rule ACTDUM_S_12 {
trs::rule_comment Space between ACTDUM and ACTDUMB >= 2
trs::outputlayer space (  AADUM AADUMB < 2  adjacent < 90  point_touch region ) 
}
trs::rule ACTDUM_S_13 {
trs::rule_comment Space between ACTDUM and DMYBLK >= 2
trs::outputlayer space (  AADUM DMYBLK < 2  adjacent < 90  point_touch region ) 
}
trs::rule ACTDUM_R_1 {
trs::rule_comment ACTDUM can not overlap with CT
trs::outputlayer geom_and (  AADUM CT ) 
}
trs::rule ACTDUM_R_2 {
trs::rule_comment ACTDUM must be covered by ACTDUMB layer
trs::outputlayer geom_not (  AADUM AADUMB ) 
}

#//======================================
#//  POLY Dummy Pattern check DRC
#//======================================

trs::setlayer PODUM_2p4_2p4 = geom_rectangle ( PODUM == 2.4  by == 2.4  ) 
