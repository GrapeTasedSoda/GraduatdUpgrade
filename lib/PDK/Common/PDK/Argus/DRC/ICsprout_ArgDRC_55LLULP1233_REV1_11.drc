trs::outputlayer space (  PODUM DMYBLK < 2  adjacent < 90  point_touch region ) 
}
trs::rule PODUM_R_1 {
trs::rule_comment PODUM can not overlap with CT
trs::outputlayer geom_and (  PODUM CT ) 
