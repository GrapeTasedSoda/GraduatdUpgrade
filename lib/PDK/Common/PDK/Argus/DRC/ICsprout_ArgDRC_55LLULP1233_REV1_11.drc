~geom_inside (  ~geom_inside (  Y SRAMALL ) NODRC ) 
}
RULE PP_S_3 { 
; Space between PP and N+ ACT inside Nwell >= 0.02um

X = ~edge_adjacent ( both_side  NTAP PACT ) 
