trs::rule PO_S_16 {
trs::rule_comment Space between large PO and GATE with narrow channel length <= 0.08um
trs::rule_comment The large PO definition:
trs::rule_comment PO area >= 630um2 and within regions of density > 70% in window 30um x 30um, stepping 15um. Dummy poly isn\BFt included in the density check. >= 1.00um
trs::setlayer Density_region = check_density ( POLYi > 0.7  by_window 30  delta 15  ) 
trs::setlayer Large_PO = geom_inside (  geom_area  ( POLYi >= 630  ) Density_region ) 
trs::setlayer GATE_check = geom_with_edge ( GATE edge_length (  GATE_LE <= 0.08  ) ) 
trs::setlayer GATE_LE = ~edge_coincident ( both_side  edge_adjacent ( both_side  GATE width (  GATE_W "\[GATE\]" < 0.005  adjacent intersecting_only ) ) GATE_W ) 
trs::outputlayer space (  Large_PO GATE_check < 1  adjacent < 90  point_touch region ) 
}

