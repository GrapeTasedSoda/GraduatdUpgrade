}
//=================================
//  SAB - Salicide Block DRC
//=================================
group_rule ( GSAB SAB_?  ) 

RULE SAB_W_1 { 
; SAB width >= 0.42um

~geom_inside (  
width (  SAB < 0.42  adjacent < 90  point_touch region ) NODRC ) 
}
RULE SAB_S_1 { 
; Space between two SABs >= 0.42um

~geom_inside (  
space (  SAB < 0.42  adjacent < 90  point_touch region ) NODRC ) 
}
RULE SAB_S_2 { 
; Space between two SABs when one or both SABs interact with PO. DRC waive if no (PO OR ACT) exists in the space region. >= 0.44um

~geom_inside (  
geom_interact (  
space (  
geom_interact (  SAB PO ) SAB < 0.44  adjacent < 90  point_touch region ) 
geom_or (  PO AA ) ) NODRC ) 
}
RULE SAB_S_3 { 
; Space between SAB and ACT >= 0.21um

~geom_inside (  
space (  SAB AA < 0.21  adjacent < 90  point_touch region ) NODRC ) 
}
RULE SAB_S_4 { 
; Space between SAB and GATE
; SAB overlap with GATE is forbidden, DRC waive ESDIOE regions and waive the total SAB which overlaps GATE 60nm. >= 0.36um
~geom_inside (  space (  SAB GATE < 0.36  adjacent < 90  region ) NODRC ) 
ESD_REGION = width (  GATE_W SAB == 0.06  opposite region ) 
~geom_inside (  ~geom_inside (  geom_and (  ~geom_interact (  SAB ESD_REGION ) GATE ) ESDIOE ) NODRC ) 
}
RULE SAB_S_5 { 
; Space between SAB and poly on field oxide. >= 0.3um

PO_CHECK = geom_not (  PO geom_or (  AA AADUM ) ) 
~geom_inside (  space (  SAB PO_CHECK < 0.3  adjacent < 90  point_touch region ) NODRC ) 
}
RULE SAB_S_6 { 
; Space between SAB and CT >= 0.21um

~geom_inside (  
space (  SAB CT < 0.21  adjacent < 90  point_touch region ) NODRC ) 
}
RULE SAB_EX_1 { 
; ACT extension outside of SAB >= 0.21um

~geom_inside (  
extension (  SAB AA < 0.21  adjacent < 90  point_touch region ) NODRC ) 
}
RULE SAB_EX_2 { 
; Extension of SAB outside of ACT >= 0.21um

~geom_inside (  
extension (  AA SAB < 0.21  adjacent < 90  point_touch region ) NODRC ) 
}
RULE SAB_EX_3 { 
; Extension of SAB outside of poly on field oxide >= 0.21um

~geom_inside (  
extension (  
geom_not (  PO 
geom_or (  AA AADUM ) ) SAB < 0.21  adjacent < 90  region ) NODRC ) 
}

#IFDEF OPEN_RECOMMENDED_ON YES 

RULE SAB_EX_4_R { 
; Extension on unsilicided ACT/POLY when SAB width is > 10um
; DRC waive if >= 5 poly fingers interact with the SAB. >= 0.30um
SAB_CHECK = ~geom_interact (  geom_with_width ( SAB > 10  ) geom_and (  PO SAB ) > 4  ) 
~geom_inside (  extension (  geom_interact (  geom_or (  AA PO ) SAB ) SAB_CHECK < 0.3  adjacent < 90  region ) NODRC ) 
}
#ENDIF 
RULE SAB_A_1 { 
; SAB area >= 0.8um2

~geom_inside (  
geom_area  ( SAB < 0.8  ) NODRC ) 
}
RULE SAB_A_2 { 
; SAB enclosed area >= 0.8um2

~geom_inside (  
geom_area  ( 
geom_not (  
geom_holes ( SAB inner_most ) SAB ) < 0.8  ) NODRC ) 
}


RULE SAB_R_1 { 
; SAB butted  ACT/POLY is not allowed

~edge_inside (  
edge_coincident ( both_side  SAB PO ) NODRC ) 
~edge_inside (  edge_coincident ( both_side  SAB AA ) NODRC ) 
}
RULE SAB_R_2 { 
; SAB overlap GATE is not allowed except ESD MOS

~edge_inside (  
~geom_inside (  
geom_and (  SAB GATE ) ESDIOE ) NODRC ) 
}
//========================
//  CT - Contact DRC
//========================
group_rule ( GCT CT_?  ) 

CTN = geom_and (  CT geom_rectangle ( CT ratio == 1  ) ) 

RULE CT_W_1 { 
; Fixed CT width (square shape) exclude SRAMALL(177;4) FUSEALL, and GRID
; DRC waive rectangular CT in SRAM and EFUSEALL area, and waive protection ring purpose non-rectangular CT in GRID area =0.09um
X = ~geom_rectangle ( geom_not (  geom_not (  CT RCT ) GCT ) == 0.09  by == 0.09  ) 
~geom_inside (  ~geom_inside (  X geom_or (  geom_or (  GRID SRAMALL ) EFUSEALL ) ) geom_or (  SRINGBLK NODRC ) ) 
~geom_inside (  ~geom_rectangle ( geom_rectangle ( geom_and (  CT GRID ) ) == 0.09  by == 0.09  ) geom_or (  SRINGBLK NODRC ) ) 
~geom_inside (  ~geom_rectangle ( geom_rectangle ( geom_and (  CT EFUSEALL ) ratio == 1  ) == 0.09  by == 0.09  ) geom_or (  SRINGBLK NODRC ) ) 
~geom_inside (  ~geom_rectangle ( geom_rectangle ( geom_and (  CT SRAMALL ) ratio == 1  ) == 0.09  by == 0.09  ) geom_or (  SRINGBLK NODRC ) ) 
}
RULE CT_W_2 { 
; Fixed CT bar width, except rectangular CT in SRAMALL (177;4) FUSEALL region = 0.09um

~geom_inside (  
geom_with_width ( CTbar < 0.09  ) 
geom_or (  SRAMALL EFUSEALL ) ) 
~geom_inside (  geom_with_width ( CTbar > 0.09  ) geom_or (  SRAMALL EFUSEALL ) ) 
}


RULE CT_S_1 { 
; Space between two contacts >= 0.11um

X = space (  CT < 0.11  adjacent < 90  point_touch region ) 
~geom_inside (  ~geom_inside (  X SRAMALL ) NODRC ) 
}
RULE CT_S_1a { 
; Space between CT and 3-neighboring CTs (space is <= 0.15um)  >= 0.14um

X = geom_size ( CT by 0.075  out_in ) 
Y = geom_size ( X by 0.340  in_out ) 
Z = geom_inside (  CT Y ) 
~geom_inside (  space (  Z < 0.14  adjacent < 90  point_touch region ) NODRC ) 
}


RULE CT_S_2 { 
; CT space at different nets, except SRAMALL region. >= 0.12um

~geom_inside (  
space (  CT < 0.12  point_touch region diff_net ) 
geom_or (  SRAMALL NODRC ) ) 
}
RULE CT_S_3 { 
; Space between ACT and contact on POLY >= 0.065um

~geom_inside (  
space (  CT AA < 0.065  adjacent < 90  point_touch region ) NODRC ) 
}
RULE CT_S_4 { 
; Space between POLY and contact on ACT for 0.9V/1.2V >= 0.055um

X = space (  geom_interact (  PO GATE_core ) ACT_CT < 0.055  adjacent < 90  point_touch region ) 
~geom_inside (  ~geom_inside (  X SRAMALL ) NODRC ) 
}
#IFDEF OPEN_RECOMMENDED_ON YES 

RULE CT_S_4_R { 
