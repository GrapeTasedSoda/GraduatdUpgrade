 trs::setlayer "AC${i}_V" = check_nar ( V$i GATE >= 0  incremental "AC[expr $i - 1]_V" ) 

connect "M[expr $i + 1]" M$i by V$i 

 trs::setlayer "M[expr $i + 1]_DIO" = geom_net ( by_area SD > 0  ) 
# minimum effective diode >0
connect M1 "M[expr $i + 1]_DIO" by CT 

set k [expr $i + 1]

set m_list GT
for { set j 1 } { $j <= $k } { incr j } {
lappend m_list M$j
}
lappend m_list M[expr $i + 1]_DIO

trs::rule ANT_GT_5b_5c_10_M[expr $i + 1 ] { 
trs::rule_comment Max. (M[expr $i + 1 ] area / gate area) is 5000 (without effective diode)
trs::rule_comment Max. (M[expr $i + 1 ] area / gate area) is Ratio Equation (with effective diode)

 trs::SETLAYER A[expr $i + 1] = check_nar ($m_list GATE > 5000 INCREMENTAL AC$i \[ AREA(M[expr $i + 1])/AREA(GATE) - (AREA(M[expr $i + 1]_DIO)*500 + !!AREA(M[expr $i + 1]_DIO)*39000)\]
 trs::outputlayer RESULT_DB ANT_GT_5b_5c_10_M[expr $i + 1].rep $m_list GATE )
 trs::outputlayer copy ( "A[expr $i + 1]" ) 
 trs::outputlayer print_log ( nar "A[expr $i + 1]" "M[expr $i + 1].rpt" ) 
}

trs::rule ANT_GT18_5a_M[expr $i + 1] {
trs::rule_comment Max. (M[expr $i + 1] area / 1.8v gate area) is 1000 (without effective diode)
trs::rule_comment Max. (M[expr $i + 1] area / 1.8v gate area) is Ratio Equation (with effective diode)

trs::SETLAYER A[expr $i + 1]_18 = check_nar ($m_list  GATE18 > 1000 INCREMENTAL AC${i}_18  \[ AREA(M[expr $i + 1])/AREA(GATE18) -(AREA(M[expr $i + 1]_DIO)*500 + !!AREA(M[expr $i + 1]_DIO)*43000) \]
 trs::outputlayer RESULT_DB ANT_GT18_5a_M[expr $i + 1].rep $m_list GATE18 )
 trs::outputlayer copy ( "A[expr $i + 1]_18" ) 
 trs::outputlayer print_log ( nar "A[expr $i + 1]_18" "M[expr $i + 1]_18.rpt" ) 
}
}

