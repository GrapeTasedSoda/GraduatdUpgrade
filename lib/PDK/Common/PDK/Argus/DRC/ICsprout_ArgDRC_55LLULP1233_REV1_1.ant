M4i = copy ( MET4i ) 
M5i = copy ( MET5i ) 
M6i = copy ( MET6i ) 
M7i = copy ( MET7i ) 
M8i = copy ( MET8i ) 





M1 = geom_not (  MET1i MET1sloti ) 
M2 = geom_not (  MET2i MET2sloti ) 
M3 = geom_not (  MET3i MET3sloti ) 
M4 = geom_not (  MET4i MET4sloti ) 
M5 = geom_not (  MET5i MET5sloti ) 
M6 = geom_not (  MET6i MET6sloti ) 
M7 = geom_not (  MET7i MET7sloti ) 
M8 = geom_not (  MET8i MET8sloti ) 

T4M1 = geom_not (  T4M1i T4M1sloti ) 
T4M2 = geom_not (  T4M2i T4M2sloti ) 
T2M1 = geom_not (  T2M1i T2M1sloti ) 
T2M2 = geom_not (  T2M2i T2M2sloti ) 
T8M1 = geom_not (  T8M1i T8M1sloti ) 
T8M2 = geom_not (  T8M2i T8M2sloti ) 




V1i = geom_or (  VIA1i VIA1bar ) 
V2i = geom_or (  VIA2i VIA2bar ) 
V3i = geom_or (  VIA3i VIA3bar ) 
V4i = geom_or (  VIA4i VIA4bar ) 
V5i = geom_or (  VIA5i VIA5bar ) 
V6i = geom_or (  VIA6i VIA6bar ) 
V7i = geom_or (  VIA7i VIA7bar ) 

V1 = copy ( V1i ) 
V2 = copy ( V2i ) 
V3 = copy ( V3i ) 
V4 = copy ( V4i ) 
V5 = copy ( V5i ) 
V6 = copy ( V6i ) 
V7 = copy ( V7i ) 
T2V1 = geom_or (  T2V1i T2V1bar ) 
T2V2 = geom_or (  T2V2i T2V2bar ) 
T4V1 = geom_or (  T4V1i T4V1bar ) 
T4V2 = geom_or (  T4V2i T4V2bar ) 
T8V1 = geom_or (  T8V1i T8V1bar ) 
T8V2 = geom_or (  T8V2i T8V2bar ) 


AA = copy ( ACTi ) 
GT = copy ( POLYi ) 
//GATE = geom_and ( GT AA )


GATE = geom_interact (  geom_and (  GT AA ) SD_1 == 2  ) 
SD_1 = geom_not (  AA GT ) 

SD = geom_not (  geom_and (  geom_or (  NPi PPi ) AA ) GT ) 

GATE18 = geom_and (  GATE DGOX ) 
GATE1825 = geom_and (  GATE geom_or (  DGOX TGOX ) ) 

incremental_connect (  yes  ) 
}

#//*******************************************
#//    LAYER DERIVATIONS AND OPERATIONS
#//*******************************************

#//=================
#//    GT Layer 
#//=================

connect GT GATE 
connect GT GATE18 
connect GT GATE1825 

trs::rule ANT_GT_1 {
trs::rule_comment Max. (Poly area / gate area) is 250

 trs::outputlayer check_nar ( GT GATE > 250 
 trs::outputlayer \[ AREA(GT) / AREA(GATE) \]
 trs::outputlayer RESULT_DB ANT_GT2.rep GT GATE )
}

trs::rule ANT_GT_2 { 
trs::rule_comment Max. (Poly perim*thickness / gate area) is 500

 trs::outputlayer check_nar ( GT GATE > 500  \[ PERIMETER(GT) * 0.10 / AREA(GATE) \]  RESULT_DB ANT_GT1.rep GT GATE )
}

#//=================
#//    CT Layer
#//=================

connect CT GT 

trs::rule ANT_GT_3 { 
trs::rule_comment Max. (contact area / gate area) is 10

 trs::outputlayer check_nar ( CT GATE > 10   
 trs::outputlayer \[ AREA(CT) / AREA(GATE) \] 
 trs::outputlayer RESULT_DB ANT_GT3.rep CT GATE )
}

#//=================
#//    M1 Layer 
#//=================

connect M1 GT SD by CT 

# minimum effective diode >0 um2
trs::setlayer M1_DIO = geom_net ( by_area SD > 0  ) 
connect M1 M1_DIO by CT 

trs::rule ANT_GT_5b_5c_M1 { 
trs::rule_comment Max. (M1 area / gate area) is 5000 (without effective diode)
trs::rule_comment Max. (M1 area / gate area) is Ratio Equation (with effective diode)
  
 trs::setlayer A1 = check_nar ( GT M1 M1_DIO GATE > 5000  incremental "\[ AREA(M1)/AREA(GATE) -(AREA(M1_DIO)*500 + !!AREA(M1_DIO)*39000) \]" 
 trs::outputlayer RESULT_DB ANT_GT_5b_5c_M1.rep GT M1 M1_DIO GATE )
 trs::outputlayer copy ( A1 ) 
 trs::outputlayer print_log ( nar A1 M1.rpt ) 
}

trs::rule ANT_GT18_5a_M1 {
trs::rule_comment Max. (M1 area / 1.8v gate area) is 1000 (without effective diode)
trs::rule_comment Max. (M1 area / 1.8v gate area) is Ratio Equation (with effective diode)
 
 trs::setlayer A1_18 = check_nar ( GT M1 M1_DIO GATE18 > 1000  incremental "\[ AREA(M1)/AREA(GATE18) -(AREA(M1_DIO)*500 + !!AREA(M1_DIO)*43000) \]" 
 trs::outputlayer RESULT_DB ANT_GT18_5a_M1.rep GT M1 M1_DIO GATE18 )
 trs::outputlayer copy ( A1_18 ) 
 trs::outputlayer print_log ( nar A1_18 M1_18.rpt ) 
}


#//=================
#//   V1 Layer
#//=================

connect V1 M1 

trs::rule ANT_GT_4a_4b_V1 {
trs::rule_comment (V1 area / gate area) > 20 (without effective diode)
trs::rule_comment (V1 area / gate area) > Ratio Equation (with effective diode)
trs::rule_comment single layer Via area to the active poly gate area, no accumulate

 trs::setlayer AV1_no_accumulate = check_nar ( GT M1 V1 M1_DIO GATE > 20  "\[ AREA(V1)/AREA(GATE) -(AREA(M1_DIO)*200 + !!AREA(M1_DIO)*980) \]" 
 trs::outputlayer RESULT_DB ANT_GT_4a_4b_V1_no_accumulate.rep GT M1 V1 M1_DIO GATE )
 trs::outputlayer copy ( AV1_no_accumulate ) 
}

trs::rule ANT_GT_6a_6b_9_V1 {
trs::rule_comment (V1 area / gate area) > 50 (without effective diode)
trs::rule_comment (V1 area / gate area) > Ratio Equation (with effective diode)

 trs::setlayer AV1 = check_nar ( GT M1 V1 M1_DIO GATE > 50  incremental "\[ AREA(V1)/AREA(GATE) -(AREA(M1_DIO)*200 + !!AREA(M1_DIO)*950) \]" 
 trs::outputlayer RESULT_DB ANT_GT_6a_6b_9_V1.rep GT M1 V1 M1_DIO GATE )
 trs::outputlayer copy ( AV1 ) 
}

#//=================
#//    M2 Layer 
#//=================

 trs::setlayer AC1 = check_nar ( M1 GATE >= 0  incremental ) 
 trs::setlayer AC1_18 = check_nar ( M1 GATE18 >= 0  incremental ) 
 trs::setlayer AC1_V = check_nar ( V1 GATE >= 0  incremental ) 

connect M2 M1 by V1 

# minimum effective diode >0um2
 trs::setlayer M2_DIO = geom_net ( by_area SD > 0  ) 
connect M1 M2_DIO by CT 

trs::rule ANT_GT_5b_5c_M2 { 
trs::rule_comment Max. (M2 area / gate area) is 5000 (without effective diode)
trs::rule_comment Max. (M2 area / gate area) is Ratio Equation (with effective diode)

 trs::setlayer A2 = check_nar ( GT M1 M2 M2_DIO GATE > 5000  incremental AC1 "\[ AREA(M2)/AREA(GATE) -(AREA(M2_DIO)*500 + !!AREA(M2_DIO)*39000) \]" 
 trs::outputlayer RESULT_DB ANT_GT_5b_5c_M2.rep GT M1 M2 M2_DIO GATE) 
 trs::outputlayer copy ( A2 ) 
 trs::outputlayer print_log ( nar A2 M2.rpt ) 
}

trs::rule ANT_GT18_5a_M2 {
trs::rule_comment Max. (M2 area / 1.8v gate area) is 1000 (without effective diode)
trs::rule_comment Max. (M2 area / 1.8v gate area) is Ratio Equation (with effective diode)

 trs::setlayer A2_18 = check_nar ( GT M1 M2 M2_DIO GATE18 > 1000  incremental AC1_18 "\[ AREA(M2)/AREA(GATE18) -(AREA(M2_DIO)*500 + !!AREA(M2_DIO)*43000) \]" 
 trs::outputlayer RESULT_DB ANT_GT18_5a_M2.rep GT M1 M2 M2_DIO GATE18 )
 trs::outputlayer copy ( A2_18 ) 
 trs::outputlayer print_log ( nar A2_18 M2_18.rpt ) 
}

if { $T == 1 } {

set l [expr $M - 2]

for { set i 2 } { $i <= $l } { incr i } {

#//=================
