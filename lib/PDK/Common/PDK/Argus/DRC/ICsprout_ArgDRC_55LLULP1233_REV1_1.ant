trs::rule_comment Max. (${TM_NAME} area / 1.8v gate area) is Ratio Equation (with effective diode)

 trs::setlayer "A[expr $i + 2]_18" = check_nar ( $tm2_list "${TM_NAME}_DIO" GATE18 > 1000  incremental "AC[expr $i + 1]_18" "\[ AREA($TM_NAME)/AREA(GATE18) - (AREA(${TM_NAME}_DIO)*9984 + !!AREA(${TM_NAME}_DIO)*19000)\]" 
 trs::outputlayer RESULT_DB ANT_GT18_5a_${TM_NAME}.rep $tm2_list ${TM_NAME}_DIO GATE18 )
 trs::outputlayer copy ( "A[expr $i + 2]_18" ) 
}

#//=================
#//   RDV Layer  
#//=================

connect RDV $TM_NAME 

trs::rule ANT_GT_7a_11_RDV { 
trs::rule_comment Max. (RDV area / 1.8V/2.5V gate area) is 20   (without effective diode)
trs::rule_comment Max. (RDV area / 1.8V/2.5V gate area) is Ratio Equation (with effective diode)

 trs::outputlayer check_nar ( $tm2_list RDV "${TM_NAME}_DIO" GATE1825 > 20  
 trs::outputlayer \[ AREA(RDV)/AREA(GATE1825) - (AREA(${TM_NAME}_DIO)*100 + !!AREA(${TM_NAME}_DIO)*380)\] 
 trs::outputlayer RESULT_DB ANT_GT7a_11_RDV.rep $tm2_list RDV ${TM_NAME}_DIO GATE1825 )
}

trs::rule ANT_GT_7b_11_RDV { 
trs::rule_comment Max. (RDV area /  gate area) is 200  (without effective diode)
trs::rule_comment Max. (RDV area /  gate area) is Ratio Equation (with effective diode)

 trs::outputlayer check_nar ( $tm2_list RDV "${TM_NAME}_DIO" GATE > 200  
 trs::outputlayer \[ AREA(RDV)/AREA(GATE) - (AREA(${TM_NAME}_DIO)*100 + !!AREA(${TM_NAME}_DIO)*200)\] 
 trs::outputlayer RESULT_DB ANT_GT7b_11_RDV.rep $tm2_list RDV ${TM_NAME}_DIO GATE )
}

#//=================
#//    RDL Layer  
#//=================

connect RDL $TM_NAME by RDV 

trs::setlayer RDL_DIO = geom_net ( by_area SD > 0  ) 
# minimum effective diode >0um2

trs::rule ANT_GT_8a_12_RDL { 
trs::rule_comment Max. (RDL side-wall area / 1.8V/2.5V gate area) is 1000 (without effective diode)
trs::rule_comment Max. (RDL side-wafl area / 1.8V/2.5V gate area) is Ratio Equation (with effective diode)

 trs::outputlayer check_nar ( $tm2_list RDL RDL_DIO GATE1825 > 1000  
 trs::outputlayer \[ PERIMETER(RDL)*$RDL_thickness/AREA(GATE1825) - (AREA(RDL_DIO)*8000 + !!AREA(RDL_DIO)*29000)\] 
 trs::outputlayer RESULT_DB ANT_GT8a_12_RDL.rep $tm2_list RDL RDL_DIO GATE1825 )
}

trs::rule ANT_GT_8b_12_RDL { 
trs::rule_comment Max. (RDL side-wall area /  gate area) is 1000 (without effective diode)
trs::rule_comment Max. (RDL side-wall area /  gate area) is Ratio Equation (with effective diode)

 trs::outputlayer check_nar ( $tm2_list RDL RDL_DIO GATE > 1000  
 trs::outputlayer \[ PERIMETER(RDL)*$RDL_thickness/AREA(GATE) - (AREA(RDL_DIO)*8000 + !!AREA(RDL_DIO)*28000)\] 
 trs::outputlayer RESULT_DB ANT_GT8b_12_RDL.rep $tm2_list RDL RDL_DIO GATE )
}
}
