trs::rule_comment Max. (RDL side-wall area / 1.8V/2.5V gate area) is Ratio Equation (with effective diode)

 trs::outputlayer check_nar ( $tm_list RDL RDL_DIO GATE1825 > 1000  
 trs::outputlayer \[ PERIMETER(RDL)*$RDL_thickness/AREA(GATE1825) - (AREA(RDL_DIO)*8000 + !!AREA(RDL_DIO)*29000)\] 
 trs::outputlayer RESULT_DB ANT_GT8a_12_RDL.rep $tm_list RDL RDL_DIO GATE1825 )
}

