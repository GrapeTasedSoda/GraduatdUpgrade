for { set j 1 } { $j <= $i } { incr j } {
lappend v_list M$j
}
lappend v_list V$i
lappend v_list M${i}_DIO

trs::rule ANT_GT_4a_4b_V$i {
trs::rule_comment (V$i area / gate area) > 20 (without effective diode)
trs::rule_comment (V$i area / gate area) > Ratio Equation (with effective diode)
trs::rule_comment single layer Via area to the active poly gate area, no accumulate

 trs::setlayer "AV${i}_no_accumulate" = check_nar ( $v_list GATE > 20  "\[ AREA(V$i)/AREA(GATE) - (AREA(M${i}_DIO)*200 + !!AREA(M${i}_DIO)*980) \]" 
 trs::outputlayer RESULT_DB ANT_GT_4a_4b_V${i}_no_accumulate.rep $v_list GATE )
 trs::outputlayer copy ( "AV${i}_no_accumulate" ) 
}

trs::rule ANT_GT_6a_6b_9_V$i {
trs::rule_comment (V$i area / gate area) > 50 (without effective diode)
trs::rule_comment (V$i area / gate area) > Ratio Equation (with effective diode)

 trs::setlayer AV$i = check_nar ( $v_list GATE > 50  incremental "AC[expr $i - 1]_V" "\[ AREA(V$i)/AREA(GATE) - (AREA(M${i}_DIO)*200 + !!AREA(M${i}_DIO)*950) \]" 
 trs::outputlayer RESULT_DB ANT_GT_6a__6b_9_V$i.rep $v_list GATE )
 trs::outputlayer copy ( AV$i ) 
}

#//========================
#//    M[expr $i + 1] Layer 
#//========================

 trs::setlayer AC$i = check_nar ( M$i GATE >= 0  incremental "AC[expr $i - 1]" ) 
