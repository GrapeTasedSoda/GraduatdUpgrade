#!trs

namespace import trs::* 


trs::pvrs_block  {
//|===============================================================================
//| Revision History :                                                            
//| Rev              Date               Who                 Description           
//| V1.0             2024-06-25         Warren              Initial               
//| V1.1             2024-09-25         Warren              Update: 
//|                                                                1.AR.8: ANT_GT_8b_12_RDL 2000-->1000
//|                                                                2.set single topmetal :T4M1/T2M1/T8M1-->T4M2/T2M2/T8M2
//|===============================================================================
}

#################################################
#     Environmental Variables Setting           #
#################################################


######################################
#  <Choice 1>   Total metal count    #
######################################

# Total metal count. Valid choices are 4~10 . See metallization option table in document. Default is 10 .

set M 7


#################################
#  <Choice 2>   top metal count #
#################################

# Top metal count. Valid choices are 1,2. See metallization option table in document. Default is 2 .

set T 1

# If M is 4, then valid choices of T is 1.
# If M is 5, then valid choices of T is 1,2.
# If M is 6, then valid choices of T is 1,2.
# If M is 7, then valid choices of T is 1,2.
# If M is 8, then valid choices of T is 1,2.
# If M is 9, then valid choices of T is 1,2.
# If M is 10, then valid choices of T is 2.


#############################################
#  <Choice 3>   top metal and top via name  #
#############################################

# top metal name. Valid choices are T4M2, T2M2 or T8M2 (for Top metal count 1); T4M1, T2M1 or T8M1(for Top metal count 2). Default is T4M2 
# top via   name. Valid choices are T4V2, T2V2 or T8V2 (for Top metal count 1); T4V1, T2V1 or T8V1(for Top metal count 2). Default is T4V2

set TM_NAME T4M2 

set TV_NAME T4V2 


########################################################
#  <Choice 4>  inter top metal and inter top via name  #
########################################################

# inter top metal name. Valid choices are T4M1, T2M1, T8M1.  Default is T4M1
# inter top via   name. Valid choices are T4V1, T2V1, T8V1.  Default is T4V1
# Please change both "T4M1" and "T4V1" value into 0 if your design only has one top metal( for Top metal count 1).

set TM_1_NAME T4M1 

set TV_1_NAME T4V1 


#################################
#  <Choice 5>   RDL thickness  #     
#################################

# RDL thickness used in this runset is defined as typical thickness * 1.1 .
# There are two kinds of RDL thickness for selection: 1.595um (1.45um * 1.1) and 3.08um (2.8um * 1.1), Default to check 1.595um
# If customer want to check 3.08um, please change this option to "set RDL_thickness 3.08"

set RDL_thickness 1.595


trs::pvrs_block  {
