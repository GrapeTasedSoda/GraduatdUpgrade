//***********************************************************************************
schematic_input ( path "TOPCELL.cdl"  ) 
schematic_input ( top_cell "TOPCELL"  ) 
schematic_input ( format spice  ) 

precision ( 1000   ) 

layout_input ( path "TOPCELL.gds"  ) 
layout_input ( top_cell "TOPCELL"  ) 
layout_input ( format gds  ) 
//layout_input ( format oasis )


lvs_report ( db  "lvs.rep"  ) 
lvs_report ( option connection short_open missing_net missing_instance missing_property show_uniconnect short_port show_virtual_connection  ) 
lvs_report ( max  1000   ) 

label_level ( port 0   ) 
label_level ( text 0   ) 
//lvs_keep_floating_top_net ( yes )
layout_exception ( severity POLYGON_DEFECTIVE WARNING_IGNORE  ) 

#IFDEF CASE_SENSITIVITY TRUE 
case_sensitive ( schematic  yes  ) 
case_sensitive ( layout  yes  ) 
case_sensitive ( compare yes  ) 
#ENDIF 

unit ( cap FF  ) 
unit ( res OHM  ) 
unit ( len U  ) 

device_filter_option ( connected_gsd connected_r connected_c connected_d schematic  ) 
device_filter_option ( connected_gsd connected_r connected_c connected_d layout  ) 

lvs_power ( "?VDD?" "?POWER?"  ) 
lvs_ground ( "?VSS?" "?GND?"  ) 

lvs_identify_gate ( none  ) 

virtual_connect ( colon  yes  ) 
virtual_connect ( report_warning  yes  ) 
//virtual_connect ( name "?" )
//drc_result ( db out.db )
#IFDEF RC_EXTRACT TRUE 
#IFDEF RC_EXTRACT_FLOW RCE
lvs_db ( "pvdb" DEVICE_PIN UNUSED_NET RECOGNIZE_VIA_ARRAY OUTPUT_BOUND_TREE OUTPUT_HASH_FILE) // For RCE flow
#ENDIF 
#IFDEF RC_EXTRACT_FLOW ACI 
lvs_db ( "pvdb" EXPAND_NON_PRESERVED_CELL FLATTEN_EMPTY_CELL DEVICE_PIN UNUSED_NET RECOGNIZE_VIA_ARRAY OUTPUT_HASH_FILE OUTPUT_BOUND_TREE) //For ACI GloryEX flow
#ENDIF 
#ELSE 
lvs_db ( "pvdb" DEVICE_PIN UNUSED_NET RECOGNIZE_VIA_ARRAY OUTPUT_BOUND_TREE OUTPUT_HASH_FILE) 
#ENDIF 

#IFDEF ERC_CHECK TRUE 
lvs_run_erc (  yes  ) 
erc_result ( db "erc.results"  ) 
erc_summary ( "erc.summary" overwrite by_cell  ) 
erc_output_cell_name ( yes cell_coordinate transform_to_top  ) 
erc_max_result (  1000   ) 
erc_max_vertex (  4096   ) 
#ENDIF 

gui_priority (  yes  ) 

erc_find_short ( yes  ) 

lvs_identify_gate ( none  ) 
quit ( power_ground_error  no  ) 
device_pin_swap ( cap  no  ) 

lvs_ignore_port ( top_cell  no  ) 
lvs_check_top_cell_port (  yes  ) 

spice ( use_subcell_pin  yes  ) 
spice ( strict_wl  yes  ) 
spice ( split_multipler_device  yes  ) 
spice ( multiplier_factor_name "M" "MR"  ) //special multipler factor name
device_merge ( parallel_bjt yes  ) 
device_merge ( parallel_mos yes  ) 
device_merge ( parallel_dio yes  ) 
device_merge ( parallel_cap yes  ) 
device_merge ( parallel_res yes  ) 
device_merge ( series_res yes  ) 
device_merge ( series_cap yes  ) 
device_merge ( split_gate yes  ) 
//lvs_inject_hierarchy ( no )
#IFDEF RC_EXTRACT TRUE 
#IFDEF RC_EXTRACT_FLOW RCE
layout_cell_group ( pcells "var1p2_npd_nw_lp*" "var2p5_npd_nw_lp*" "var3p3_npd_nw_lp*" "mom_2t*" "mom_3t*"  ) 
layout_reserve_cell_group ( pcells  ) 
#ENDIF 
#ENDIF 
