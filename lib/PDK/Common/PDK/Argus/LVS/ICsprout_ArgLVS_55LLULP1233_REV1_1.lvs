// ******************************* ERC Rules *******************************
#IFDEF ERC_CHECK TRUE 
// Nodes with a path to ground but not power.


erc_path_check ( grounded && !powered ignore_floatting  ) 
// Nodes with a path to power but not ground.


erc_path_check ( powered && !grounded ignore_floatting  ) 
// Nodes without a path to any labeled net.


erc_path_check ( !labeled ignore_floatting  ) 

RULE "erc_pathcheck_bad" { 
; Nodes without a path to both power and ground.

pathcheck_layer1 = path_check ( !powered && !grounded ignore_floatting ) 
pathcheck_layer2 = path_check ( !labeled ignore_floatting ) 
~geom_interact (  geom_and (  pathcheck_layer1 pathcheck_layer2 ) nw_para_diode_all ) 
}

RULE "erc_pTap_to_power" { 
; P-well pick-up is connected to a power net.

geom_net ( by_layer pTap "LVS_POWER_NAME" ) 
}

RULE "erc_nTap_to_ground" { 
; N-well pick-up is connectd to a ground net.

geom_net ( by_layer nTap "LVS_GROUND_NAME" ) 
}

gate_all_check = copy ( gate_all ) 
connect ( gate_all_check npoly  ) 
connect ( gate_all_check ppoly  ) 

RULE "erc_gate_floating" { 
; Gate with no path to a labeled net
path_check ( !labeled gate_all_check ) 
}

nWell_check = ~geom_interact (  ~geom_interact (  nWell "BJT" ) NW1res ) 
RULE "erc_nWell_floating" { 
; N-well is floating, i.e. without any pick-up.

~geom_interact (  nWell_check nTap ) 
}

RULE "erc_nWell_not_to_power" { 
; N-well is not connected to a power net.

nWell_with_nTap = geom_interact (  nWell_check nTap ) 
~geom_net ( by_layer nWell_with_nTap "LVS_POWER_NAME" ) 
}

RULE "erc_pWell_not_to_ground" { 
; P-well is not connected to a ground net.

~geom_net ( by_layer 
geom_not (  pTap SRINGBLK ) "LVS_GROUND_NAME" ) 
}

nsd2ground = geom_net ( by_layer nSD "LVS_GROUND_NAME" ) 
T1nsd = geom_adjacent (  ncore_svt_gate nsd2ground ) 
nsd2power = geom_net ( by_layer nSD "LVS_POWER_NAME" ) 
T2nsd = geom_adjacent (  ncore_svt_gate nsd2power ) 
RULE "erc_mn2pg" { 
; NMOS(SVT) S/D terminals connected to power and ground, respectively, may cause short circuit when turned on.

geom_and (  T1nsd T2nsd ) 
}

T1nsdhvt = geom_adjacent (  ncore_hvt_gate nsd2ground ) 
T2nsdhvt = geom_adjacent (  ncore_hvt_gate nsd2power ) 
RULE "erc_mn2pghvt" { 
; NMOS(HVT) S/D terminals connected to power and ground, respectively, may cause short circuit when turned on.

geom_and (  T1nsdhvt T2nsdhvt ) 
}

psd2ground = geom_net ( by_layer pSD "LVS_GROUND_NAME" ) 
T1psd = geom_adjacent (  pcore_svt_gate psd2ground ) 
psd2power = geom_net ( by_layer pSD "LVS_POWER_NAME" ) 
T2psd = geom_adjacent (  pcore_svt_gate psd2power ) 
RULE "erc_mp2pg" { 
; PMOS(SVT) S/D terminals connected to power and ground, respectively, may cause short circuit when turned on.

geom_and (  T1psd T2psd ) 
}

T1psdhvt = geom_adjacent (  pcore_hvt_gate psd2ground ) 
T2psdhvt = geom_adjacent (  pcore_hvt_gate psd2power ) 
RULE "erc_mp2pghvt" { 
; PMOS(HVT) S/D terminals connected to power and ground, respectively, may cause short circuit when turned on.

geom_and (  T1psdhvt T2psdhvt ) 
}

ptap_outside_dnw_ground = geom_not (  geom_net ( by_layer pTap "LVS_GROUND_NAME" ) DNW ) 
RULE "erc_ptap_outside_dnw_non_ground" { 
; Non-isolated p-well (i.e. not inside DNW) connected to non-ground nets.

geom_not (  
geom_not (  
geom_not (  pTap SRINGBLK ) DNW ) ptap_outside_dnw_ground ) 
}


erc_select_rule ( by_name "erc_pTap_to_power" "erc_nTap_to_ground" "erc_mp2pg" "erc_mn2pg" "erc_mn2pghvt" "erc_mp2pghvt" "erc_ptap_outside_dnw_non_ground" "erc_pathcheck_bad"  ) 

#IFDEF GATE_FLOATING_CHECK TRUE 
erc_select_rule ( by_name "erc_gate_floating"  ) 
#ENDIF 

#IFDEF NWELL_FLOATING_CHECK TRUE 
erc_select_rule ( by_name "erc_nWell_floating"  ) 
#ENDIF 

#IFDEF NWELL_NOT_TO_POWER_CHECK TRUE 
erc_select_rule ( by_name "erc_nWell_not_to_power"  ) 
#ENDIF 

#IFDEF PWELL_NOT_TO_GROUND_CHECK TRUE 
erc_select_rule ( by_name "erc_pWell_not_to_ground"  ) 
#ENDIF 

#ENDIF 


#ENCRYPT 
TRS_FUNCTION ( device_function  [
/*
	
 proc getvalue_expr { argument } {
  #puts "called getvalue_expr"
  set rtvalue 0.0
  if { [ catch {
   set rtvalue [ expr $argument ]
  } result ] } {
   global errorCode
   set tmpError $errorCode
   #puts $result
   if { [ string match "ARITH UNDERFLOW *" $errorCode ] } {
    #puts "$errorCode error caught during expr"
    set rtvalue 0.0
   } elseif { [ string match "ARITH OVERFLOW *" $errorCode ] } {
    #puts "$errorCode error caught during expr"
    set rtvalue 1e200
   } else {
    #puts "error propagated during expr"
    error $result $tmpError
   }
  }
  return $rtvalue
 }
 proc calc_lod_sasb { dfm_vec drawn_width drawn_length units scale } {
  set measurments [ device::convert_to_enc $dfm_vec]
  set accum 0.0
  set Wsi [expr {[$drawn_width]*[$scale]} ]
  set Lsi [expr {[$drawn_length]*[$scale]} ]
  foreach segment $measurments {
   foreach { pw sa } $segment {
	  set pw [ expr {$pw*[$units]*[$scale]} ]
		set sa [ expr {$sa*[$units]*[$scale]} ]
		set val [expr {($pw/$Wsi)*1.0/($sa+0.5*$Lsi)} ]
    set accum [ expr {$accum + $val} ]
   }
  }
    return [ expr { ((1.0/$accum)-0.5*$Lsi)/[$scale] } ]
 }
proc calculate_sca_dfm_getvalue { tclvec sgw units scale } {
 # sgw = segment gate width (L for sides, W for ends)
 set SCref 1.0
 set sum 0.0
 foreach segment $tclvec {
  foreach { width encval } $segment {
   set width [ expr { $width * $units * $scale } ]
   set encval [ expr { $encval * $units * $scale } ]
   set sum [ expr { $sum + $width * ( \
             $SCref * $SCref / ( $encval ) - \
             $SCref * $SCref / ( $encval + $sgw * $scale ) \
             ) } ]
  }
 }
 return $sum
}
proc calc_sca_dfm { PER_1 PER_2 PAR_1 PAR_2 W L UNITS SCALE} {
 set side_1 [ device::convert_to_enc $PER_1]
 set side_2 [ device::convert_to_enc $PER_2]
 set sides [ concat $side_1 $side_2 ]
 set end_1 [ device::convert_to_enc $PAR_1]
 set end_2 [ device::convert_to_enc $PAR_2]
 set sum [ expr { [ calculate_sca_dfm_getvalue $sides [$L] [$UNITS] [$SCALE]] + \
       [ calculate_sca_dfm_getvalue $end_1 [$W] [$UNITS] [$SCALE] ] + \
       [ calculate_sca_dfm_getvalue $end_2 [$W] [$UNITS] [$SCALE] ] } ]
 return [ expr { $sum / ( [$W] * [$SCALE] * [$L] * [$SCALE] * 1e12 ) } ]
}
proc calculate_scbscc_dfm_getvalue { tclvec sgw units em d1 d2 scale} {
 # sgw = segment gate width (L for sides, W for ends)
 # em = multiplier for args to exp
 # d1 = denominator1 (for 1st and 3rd terms)
 # d2 = denominator2 (for 2nd and 4th terms)
 set SCref 1.0
 set sum 0.0
 set constant 1e6
 foreach segment $tclvec {
  foreach { width encval} $segment {
   set width [ expr { $width * $units * $scale } ]
   set encval [ expr { $encval * $units * $scale } ]
   set encval_1 [ expr { ( $encval ) } ]
   set encval_2 [ expr { ( $encval + $sgw * $scale ) } ]
   set encval_1_exp [ getvalue_expr "exp( $em * $encval_1 * $constant / $SCref )" ]
   set encval_2_exp [ getvalue_expr "exp( $em * $encval_2 * $constant / $SCref )" ]
   set sum [ expr { $sum + $width * $constant * ( \
                $encval_1 * $constant * ( $encval_1_exp/$d1 ) + \
                $SCref * ( $encval_1_exp/$d2 ) - \
                $encval_2 * $constant * ( $encval_2_exp/$d1 ) - \
                $SCref * ( $encval_2_exp/$d2 ) \
                ) } ]
  }
 }
 return $sum
}
proc calc_scb_dfm { PER_1 PER_2 PAR_1 PAR_2 W L UNITS SCALE} {
 set side_1 [ device::convert_to_enc $PER_1]
 set side_2 [ device::convert_to_enc $PER_2]
 set sides [ concat $side_1 $side_2 ]
 set end_1 [ device::convert_to_enc $PAR_1]
 set end_2 [ device::convert_to_enc $PAR_2]
 set sum [ expr { [ calculate_scbscc_dfm_getvalue $sides [$L] [$UNITS] -10 10 100 [$SCALE] ] + \
       [ calculate_scbscc_dfm_getvalue $end_1 [$W] [$UNITS] -10 10 100 [$SCALE] ] + \
       [ calculate_scbscc_dfm_getvalue $end_2 [$W] [$UNITS] -10 10 100 [$SCALE] ] } ]
 return [ expr { $sum / ( [$W] * [$SCALE] * [$L] * [$SCALE] * 1e12 ) } ]
}
proc calc_scc_dfm { PER_1 PER_2 PAR_1 PAR_2 W L UNITS SCALE} {
 set side_1 [ device::convert_to_enc $PER_1]
 set side_2 [ device::convert_to_enc $PER_2]
 set sides [ concat $side_1 $side_2 ]
 set end_1 [ device::convert_to_enc $PAR_1]
 set end_2 [ device::convert_to_enc $PAR_2]
 set sum [ expr { [ calculate_scbscc_dfm_getvalue $sides [$L] [$UNITS] -20 20 400 [$SCALE] ] + \
       [ calculate_scbscc_dfm_getvalue $end_1 [$W] [$UNITS] -20 20 400 [$SCALE] ] + \
       [ calculate_scbscc_dfm_getvalue $end_2 [$W] [$UNITS] -20 20 400 [$SCALE] ] } ]
 return [ expr { $sum / ( [$W] *[$SCALE] * [$L] *[$SCALE] * 1e12 ) } ]
}
proc calc_sca_multi { PER PAR W L MAX SCALE} {
 set maxv [$MAX]*1e-6
 set sca_sum1 0.0
 set sca_sum2 0.0
 set sca_tmp 0.0
 set sum_tmp 0.0
 set finger_count [ $PER finger_count]
 set Ws [ expr { [$W] * [$SCALE] } ]
 set Ls [ expr { [$L] * [$SCALE] } ]
 for {set i 0} { $i < $finger_count } {incr i} {
   set slice_count1 [ $PER cut_count $i]
   set slice_count2 [ $PAR cut_count $i]
   set SCref 1.0
   for { set k 0 } { $k < $slice_count1} { incr k } {
    set tmpa [expr ([$PER u $i $k]>$maxv) ? $maxv : [$PER u $i $k]]
    set tmpb [expr ([$PER v $i $k]>$maxv) ? $maxv : [$PER v $i $k]]
    #puts "PER: a=[$PER u $i $k] -> $tmpa b=[$PER v $i $k] -> $tmpb "
    set sca_sum1 [ expr { $sca_sum1 + ( ([$PER w $i $k]*[$SCALE]) * ( ($SCref * $SCref/(($tmpa*[$SCALE]))) - ( $SCref * $SCref/(($tmpa*[$SCALE]+$Ls))) + ($SCref * $SCref/(($tmpb*[$SCALE]))) - ($SCref * $SCref/(($tmpb*[$SCALE]+$Ls))))) }]
    }
   for { set k 0 } { $k < $slice_count2} { incr k } {
    set tmpa [expr ([$PAR u $i $k]>$maxv) ? $maxv : [$PAR u $i $k]]
    set tmpb [expr ([$PAR v $i $k]>$maxv) ? $maxv : [$PAR v $i $k]]
    #puts "PAR: a=[$PER u $i $k] -> $tmpa b=[$PAR v $i $k] -> $tmpb "
    set sca_sum2 [ expr { $sca_sum2 + ( ([$PAR w $i $k]*[$SCALE]) * ( ($SCref * $SCref/(($tmpa*[$SCALE]))) - ( $SCref * $SCref/(($tmpa*[$SCALE]+$Ws))) + ($SCref * $SCref/(($tmpb*[$SCALE]))) - ($SCref * $SCref/(($tmpb*[$SCALE] +$Ws))))) }]
    }
   set sca_tmp [ expr { ( $sca_sum1 + $sca_sum2 ) / ( (($Ws) * ($Ls)) * 1e12) } ]
   puts "sca_finger$i = $sca_tmp"
   set sum_tmp [ expr { $sum_tmp + $sca_tmp } ]
   set sca_sum1 0.0
   set sca_sum2 0.0
 }
 return [ expr { $sum_tmp / $finger_count} ]
}
proc calc_scb_multi { PER PAR W L MAX SCALE } {
 set maxv [$MAX]*1e-6
	set scb_sum1 0.0
	set scb_sum2 0.0
	set scb_tmp 0.0
	set sum_tmp 0.0
	set finger_count [ $PER finger_count]
 set Ws [ expr { [$W] * [$SCALE] } ]
 set Ls [ expr { [$L] * [$SCALE] } ]
	for {set i 0} { $i < $finger_count } {incr i} {
		set SCref 1.0
		set slice_count1 [ $PER cut_count $i]
		set slice_count2 [ $PAR cut_count $i]
		for { set k 0 } { $k < $slice_count1} { incr k } {
   set tmpa [expr ([$PER u $i $k]>$maxv) ? $maxv : [$PER u $i $k]]
   set tmpb [expr ([$PER v $i $k]>$maxv) ? $maxv : [$PER v $i $k]]
			set exp_term1 [ getvalue_expr " exp(-10*$tmpa*[$SCALE]*1e6/$SCref) " ]
			set exp_term2 [ getvalue_expr " exp(-10*$tmpa*[$SCALE]*1e6/$SCref) " ]
			set exp_term3 [ getvalue_expr " exp(-10*($tmpa*[$SCALE]+$Ls)*1e6/$SCref) " ]
			set exp_term4 [ getvalue_expr " exp(-10*($tmpa*[$SCALE]+$Ls)*1e6/$SCref) " ]
			set exp_term5 [ getvalue_expr " exp(-10*$tmpb*[$SCALE]*1e6/$SCref) " ]
			set exp_term6 [ getvalue_expr " exp(-10*$tmpb*[$SCALE]*1e6/$SCref) " ]
			set exp_term7 [ getvalue_expr " exp(-10*($tmpb*[$SCALE]+$Ls)*1e6/$SCref) " ]
			set exp_term8 [ getvalue_expr " exp(-10*($tmpb*[$SCALE]+$Ls)*1e6/$SCref) " ]
			set scb_sum1 [ expr { $scb_sum1 + ( [ $PER w $i $k]*[$SCALE]*1e6 * (($tmpa*[$SCALE]*1e6*( $exp_term1/10)) + ($SCref*($exp_term2/100)) - (($tmpa*[$SCALE]+$Ls)*1e6*($exp_term3/10)) - (($SCref*($exp_term4/100))) + ($tmpb*[$SCALE]*1e6*( $exp_term5/10)) + ($SCref*($exp_term6/100)) - (($tmpb*[$SCALE]+$Ls)*1e6*($exp_term7/10)) - ($SCref*($exp_term8/100))  )) } ]
			}
		for { set k 0 } { $k < $slice_count2} { incr k } {
   set tmpa [expr ([$PAR u $i $k]>$maxv) ? $maxv : [$PAR u $i $k]]
   set tmpb [expr ([$PAR v $i $k]>$maxv) ? $maxv : [$PAR v $i $k]]
			set exp_term1 [ getvalue_expr " exp(-10*$tmpa*[$SCALE]*1e6/$SCref) " ]
			set exp_term2 [ getvalue_expr " exp(-10*$tmpa*[$SCALE]*1e6/$SCref) " ]
			set exp_term3 [ getvalue_expr " exp(-10*($tmpa*[$SCALE]+$Ws)*1e6/$SCref) " ]
			set exp_term4 [ getvalue_expr " exp(-10*($tmpa*[$SCALE]+$Ws)*1e6/$SCref) " ]
			set exp_term5 [ getvalue_expr " exp(-10*$tmpb*[$SCALE]*1e6/$SCref) " ]
			set exp_term6 [ getvalue_expr " exp(-10*$tmpb*[$SCALE]*1e6/$SCref) " ]
			set exp_term7 [ getvalue_expr " exp(-10*($tmpb*[$SCALE]+$Ws)*1e6/$SCref) " ]
			set exp_term8 [ getvalue_expr " exp(-10*($tmpb*[$SCALE]+$Ws)*1e6/$SCref) " ]
			set scb_sum2 [ expr { $scb_sum2 + ( [$PAR w $i $k]*[$SCALE]*1e6 * (($tmpa*[$SCALE]*1e6*( $exp_term1/10)) + ($SCref*($exp_term2/100)) - (($tmpa*[$SCALE]+$Ws)*1e6*($exp_term3/10)) - ($SCref*($exp_term4/100)) + ($tmpb*[$SCALE]*1e6*( $exp_term5/10)) + ($SCref*($exp_term6/100)) - (($tmpb*[$SCALE]+$Ws)*1e6*($exp_term7/10)) - ($SCref*($exp_term8/100))  )) } ]
			}
		set scb_tmp [ expr { ( $scb_sum1 + $scb_sum2 ) / ( (($Ws) * ($Ls)) * 1e12) } ]
		set sum_tmp [ expr { $sum_tmp + $scb_tmp } ]
		set scb_sum1 0.0
		set scb_sum2 0.0
 }
	return [ expr { $sum_tmp / $finger_count} ]
}
proc calc_scc_multi { PER PAR W L MAX SCALE } {
 set maxv [$MAX]*1e-6
	set scc_sum1 0.0
	set scc_sum2 0.0
	set scc_tmp 0.0
	set sum_tmp 0.0
	set finger_count [ $PER finger_count]
 set Ws [ expr { [$W] * [$SCALE] } ]
 set Ls [ expr { [$L] * [$SCALE] } ]
 for {set i 0} { $i < $finger_count } {incr i} {
  set SCref 1.0
  set slice_count1 [ $PER cut_count $i]
  set slice_count2 [ $PAR cut_count $i]
  for { set k 0 } { $k < $slice_count1} { incr k } {
   set tmpa [expr ([$PER u $i $k]>$maxv) ? $maxv : [$PER u $i $k]]
   set tmpb [expr ([$PER v $i $k]>$maxv) ? $maxv : [$PER v $i $k]]
   set exp_term1 [ getvalue_expr " exp(-20*$tmpa*[$SCALE]*1e6/$SCref) " ]
   set exp_term2 [ getvalue_expr " exp(-20*$tmpa*[$SCALE]*1e6/$SCref) " ]
   set exp_term3 [ getvalue_expr " exp(-20*($tmpa*[$SCALE]+$Ls)*1e6/$SCref) " ]
   set exp_term4 [ getvalue_expr " exp(-20*($tmpa*[$SCALE]+$Ls)*1e6/$SCref) " ]
   set exp_term5 [ getvalue_expr " exp(-20*$tmpb*[$SCALE]*1e6/$SCref) " ]
   set exp_term6 [ getvalue_expr " exp(-20*$tmpb*[$SCALE]*1e6/$SCref) " ]
   set exp_term7 [ getvalue_expr " exp(-20*($tmpb*[$SCALE]+$Ls)*1e6/$SCref) " ]
   set exp_term8 [ getvalue_expr " exp(-20*($tmpb*[$SCALE]+$Ls)*1e6/$SCref) " ]
   set scc_sum1 [ expr { $scc_sum1 + ( [$PER w $i $k]*[$SCALE]*1e6 * (($tmpa*[$SCALE]*1e6*( $exp_term1/20)) + ($SCref*($exp_term2/400)) - (($tmpa*[$SCALE]+$Ls)*1e6*($exp_term3/20)) - ($SCref*($exp_term4/400)) + ($tmpb*[$SCALE]*1e6*( $exp_term5/20)) + ($SCref*($exp_term6/400)) - (($tmpb*[$SCALE]+$Ls)*1e6*($exp_term7/20)) - ($SCref*($exp_term8/400))  )) } ]
  }
  for { set k 0 } { $k < $slice_count2} { incr k } {
   set tmpa [expr ([$PAR u $i $k]>$maxv) ? $maxv : [$PAR u $i $k]]
   set tmpb [expr ([$PAR v $i $k]>$maxv) ? $maxv : [$PAR v $i $k]]
   set exp_term1 [ getvalue_expr " exp(-20*$tmpa*[$SCALE]*1e6/$SCref) " ]
   set exp_term2 [ getvalue_expr " exp(-20*$tmpa*[$SCALE]*1e6/$SCref) " ]
   set exp_term3 [ getvalue_expr " exp(-20*($tmpa*[$SCALE]+$Ws)*1e6/$SCref) " ]
   set exp_term4 [ getvalue_expr " exp(-20*($tmpa*[$SCALE]+$Ws)*1e6/$SCref) " ]
   set exp_term5 [ getvalue_expr " exp(-20*$tmpb*[$SCALE]*1e6/$SCref) " ]
   set exp_term6 [ getvalue_expr " exp(-20*$tmpb*[$SCALE]*1e6/$SCref) " ]
   set exp_term7 [ getvalue_expr " exp(-20*($tmpb*[$SCALE]+$Ws)*1e6/$SCref) " ]
   set exp_term8 [ getvalue_expr " exp(-20*($tmpb*[$SCALE]+$Ws)*1e6/$SCref) " ]
   set scc_sum2 [ expr { $scc_sum2 + ( [$PAR w $i $k]*[$SCALE]*1e6 * (($tmpa*[$SCALE]*1e6*( $exp_term1/20)) + ($SCref*($exp_term2/400)) - (($tmpa*[$SCALE]+$Ws)*1e6*($exp_term3/20)) - ($SCref*($exp_term4/400)) + ($tmpb*[$SCALE]*1e6*( $exp_term5/20)) + ($SCref*($exp_term6/400)) - (($tmpb*[$SCALE]+$Ws)*1e6*($exp_term7/20)) - ($SCref*($exp_term8/400))  )) } ]
  }
  set scc_tmp [ expr { ( $scc_sum1 + $scc_sum2 ) / ( (($Ws) * ($Ls)) * 1e12) } ]
  set sum_tmp [ expr { $sum_tmp + $scc_tmp } ]
  set scc_sum1 0.0
  set scc_sum2 0.0
 }
 return [ expr { $sum_tmp / $finger_count} ]
}
*/
] ) 
#ENDCRYPT 
}

package require Argus_device_function


trs::setlayer  ngate_wpe_core = [
 device::enc_projection -base ngate_wpe -measurement pWell_wpe_core -orient nsd -max_par 2.000 -max_per 2.000
]
trs::setlayer  ngate_wpe_io1 = [
 device::enc_projection -base ngate_wpe -measurement pWell_wpe_io1 -orient nsd -max_par 2.000 -max_per 2.000
]
trs::setlayer  ngate_wpe_io2 = [
 device::enc_projection -base ngate_wpe -measurement pWell_wpe_io2 -orient nsd -max_par 2.000 -max_per 2.000
]
trs::setlayer  pgate_wpe_core = [
 device::enc_projection -base pgate_wpe -measurement nWell_wpe_core -orient psd -max_par 2.000 -max_per 2.000
]
trs::setlayer  pgate_wpe_io1 = [
 device::enc_projection -base pgate_wpe -measurement nWell_wpe_io1 -orient psd -max_par 2.000 -max_per 2.000
]
trs::setlayer  pgate_wpe_io2 = [
 device::enc_projection -base pgate_wpe -measurement nWell_wpe_io2 -orient psd -max_par 2.000 -max_per 2.000
]
trs::setlayer  dnwngate_wpe_core = [
 device::enc_projection -base ngate_wpe -measurement bpWell_wpe_core -orient nsd -max_par 2.000 -max_per 2.000
]
trs::setlayer  dnwngate_wpe_io1 = [
 device::enc_projection -base ngate_wpe -measurement bpWell_wpe_io1 -orient nsd -max_par 2.000 -max_per 2.000
]
trs::setlayer  dnwngate_wpe_io2 = [
 device::enc_projection -base ngate_wpe -measurement bpWell_wpe_io2 -orient nsd -max_par 2.000 -max_per 2.000
]
trs::setlayer  ngate_wpe_nt_core = [
 device::enc_projection -base ngate_wpe -measurement psub_wpe_core -orient nsd -max_par 2.000 -max_per 2.000
]
trs::setlayer  ngate_wpe_nt_io1 = [
 device::enc_projection -base ngate_wpe -measurement psub_wpe_io1 -orient nsd -max_par 2.000 -max_per 2.000
]
trs::setlayer  ngate_wpe_nt_io2 = [
 device::enc_projection -base ngate_wpe -measurement psub_wpe_io2 -orient nsd -max_par 2.000 -max_per 2.000
]
trs::setlayer  lod_PROP = [
 device::enc_projection -base gate_all -measurement AA -orient all_sd -max_par 0 -max_per 60 -connect
]
