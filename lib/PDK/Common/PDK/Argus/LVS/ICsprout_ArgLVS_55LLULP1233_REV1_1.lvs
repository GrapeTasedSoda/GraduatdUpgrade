//////////////////////////////////////////////
// Loigc Operation       //
//////////////////////////////////////////////
bulk = geom_size ( geom_get_boundary ( ) by 0.1  ) 

PO = geom_or (  POLY POLYdm ) 
AA = geom_or (  ACT ACTdm ) 
AA_eff_reg = geom_or (  geom_interact (  AA CTs ) geom_interact (  AA geom_interact (  PO CTs ) ) ) 

resPOLY = geom_and (  PO geom_or (  ~geom_interact (  POLYres SAB ) geom_and (  POLYres SAB ) HPR ) ) 
non_resPOLY = geom_not (  PO resPOLY ) 

gpoly = geom_and (  non_resPOLY AA ) 
poGate = geom_not (  geom_and (  gpoly AA_eff_reg ) POLYdm ) 
connpoly = geom_not (  non_resPOLY gpoly ) 
npoly = geom_and (  connpoly NP ) 
ppoly = geom_not (  connpoly npoly ) 
npoGate = geom_inside (  poGate NP ) 
ppoGate = geom_inside (  poGate PP ) 
ngpoly = geom_inside (  geom_not (  gpoly poGate ) NP ) 
pgpoly = geom_inside (  geom_not (  gpoly poGate ) PP ) 
MOM_poly = geom_and (  geom_not (  connpoly POLYdm ) MOMLVS1 ) 

nDif = geom_and (  AA NP ) 
nresDiff = geom_and (  geom_not (  nDif PO ) geom_or (  ~geom_interact (  ACTres SAB ) geom_and (  ACTres SAB ) ) ) 
nDiff = geom_not (  geom_not (  nDif PO ) nresDiff ) 
pDif = geom_and (  AA PP ) 
presDiff = geom_and (  geom_not (  pDif PO ) geom_or (  ~geom_interact (  ACTres SAB ) geom_and (  ACTres SAB ) ) ) 
pDiff = geom_not (  geom_not (  pDif PO ) presDiff ) 

resNW = geom_and (  NW NW1res ) 
non_resNW = geom_not (  NW NW1res ) 

nWell = geom_and (  bulk non_resNW ) 

nWell_wpe_core = geom_not (  geom_not (  geom_not (  nWell DGOX ) TGOX ) SUBCKTLVS ) 
nWell_wpe_io1 = geom_not (  geom_not (  geom_and (  nWell DGOX ) TGOX ) SUBCKTLVS ) 
nWell_wpe_io2 = geom_not (  geom_not (  geom_and (  nWell TGOX ) DGOX ) SUBCKTLVS ) 

nTap = geom_and (  nDiff NW ) 
nJunc = geom_not (  nDiff NW ) 
pJunc = geom_and (  pDiff NW ) 
pTap = geom_not (  pDiff NW ) 
nresJunc = geom_not (  nresDiff NW ) 
presJunc = geom_and (  presDiff NW ) 

#IFDEF PSUB_ISO TRUE 
sub2 = geom_size ( SUBCKTLVS by 0.005  ) 
sub2Ring = geom_not (  sub2 SUBCKTLVS ) 
non_pWell = geom_or (  sub2Ring NW ) 
pWellSub = geom_not (  geom_not (  geom_not (  bulk DNW ) non_pWell ) sub2Ring ) 
#ELSE 
pWellSub = geom_not (  geom_not (  bulk DNW ) NW ) 
#ENDIF 
pWell = geom_not (  bulk non_pWell ) 
bpWell1 = geom_not (  geom_and (  geom_holes ( NW ) DNW ) nWell ) 
bpWell = geom_not (  bpWell1 sub2Ring ) 
pWell1 = geom_and (  pWell bpWell ) 
bpWell_wpe_core = geom_not (  geom_not (  geom_not (  geom_not (  bpWell NW ) DGOX ) TGOX ) SUBCKTLVS ) 
bpWell_wpe_io1 = geom_not (  geom_not (  geom_and (  geom_not (  bpWell NW ) DGOX ) TGOX ) SUBCKTLVS ) 
bpWell_wpe_io2 = geom_not (  geom_not (  geom_and (  geom_not (  bpWell NW ) TGOX ) DGOX ) SUBCKTLVS ) 

dnwdio_psub = geom_not (  pWell pWell1 ) 
nWellRing = geom_donut  ( nWell ) 
pWell_nWell = geom_not (  geom_or (  pWell nWellRing ) DNW ) 
bulk_all = geom_not (  BULK sub2Ring ) 

pWell_wpe_core = geom_not (  geom_not (  geom_not (  geom_not (  bulk NW ) DGOX ) TGOX ) SUBCKTLVS ) 
pWell_wpe_io1 = geom_not (  geom_not (  geom_and (  geom_not (  bulk NW ) DGOX ) TGOX ) SUBCKTLVS ) 
pWell_wpe_io2 = geom_not (  geom_not (  geom_and (  geom_not (  bulk NW ) DGOX ) TGOX ) SUBCKTLVS ) 

psub_wpe_core = geom_not (  geom_not (  SUBCKTLVS DGOX ) TGOX ) 
psub_wpe_io1 = geom_not (  geom_and (  SUBCKTLVS DGOX ) TGOX ) 
psub_wpe_io2 = geom_not (  geom_and (  SUBCKTLVS TGOX ) DGOX ) 

poCT = geom_and (  CTs connpoly ) 
npoCT = geom_and (  poCT NP ) 
ppoCT = geom_not (  poCT npoCT ) 
dfCT = geom_not (  CTs poCT ) 
ndfCT = geom_and (  dfCT NP ) 
pdfCT = geom_not (  dfCT ndfCT ) 
