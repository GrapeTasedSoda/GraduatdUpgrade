//*****************************************

ngate = geom_not (  npoGate nWell ) 
pgate = geom_and (  ppoGate nWell ) 
gate_all = geom_or (  ngate pgate ) 
ngate_core = geom_not (  geom_not (  ngate DGOX ) TGOX ) 
pgate_core = geom_not (  geom_not (  pgate DGOX ) TGOX ) 

ngate_wpe = copy ( ngate ) 
pgate_wpe = copy ( pgate ) 
