//mom setup-----
mom_gt = geom_or (  geom_enclose (  PO MOMLVS1 ) geom_interact (  PO geom_with_label ( MOMLVS1 "mom_wips" ) ) ) 
//mom_gt = geom_interact ( PO MOMLVS1 )

mom_nw = geom_enclose (  nWell MOMLVS1 ) 
mom_pw = geom_not (  pWell geom_inside (  pWell MOMLVS1 ) ) 
mom_wims = geom_with_label ( MOMLVS1 "mom_wims" ) 
//*Define MOM DEVICE
#IFDEF TOTALMETAL 4 
#IFDEF TOP_METAL_NUM SINGLE 
mom_metal1 = geom_and (  M1s MOMLVS1 ) 
mom_VIA1 = geom_and (  VIA1 MOMLVS1 ) 
metal1b = copy ( M1s ) 
mom_metal2 = geom_and (  M2s MOMLVS1 ) 
mom_VIA2 = geom_and (  VIA2 MOMLVS1 ) 
metal2b = copy ( M2s ) 
mom_metal3 = geom_and (  M3s MOMLVS1 ) 
metal3b = copy ( M3s ) 

mom_m1_m3_VA = geom_and (  mom_VIA1 mom_VIA2 ) 

mom_text = geom_or (  mom12reg_1 mom13reg_1 mom23reg_1 ) 

