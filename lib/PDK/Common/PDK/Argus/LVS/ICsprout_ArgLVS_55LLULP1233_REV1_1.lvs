define_fun MOM_PRO_2T mom_finger TMM BMM {
[
PROPERTY LF,NF,mismod_mom,tm,bm,mr 
NF= count(mom_finger) 
A = AREA(mom_finger)/NF 
LF= A/1.0E-07+1.0E-07 
tm=tmm 
bm=bmm 
mr=1 
#IFDEF MOM_MIS_MODE 0
mismod_mom = 0 
#ELSE
#IFDEF MOM_MIS_MODE 1
mismod_mom = 1 
#ENDIF
#ENDIF
]
}

define_fun MOM_MIS_PRO mom_finger TMM BMM SHD {
[
PROPERTY LF,NF,mismod_mom,tm,bm,mr,shielding 
NF= count(mom_finger) 
A = AREA(mom_finger)/NF 
LF= A/1.0E-07+1.0E-07 
tm=tmm 
bm=bmm 
shielding=shd 
mr=1 
#IFDEF MOM_MIS_MODE 0
mismod_mom = 0 
#ELSE
#IFDEF MOM_MIS_MODE 1
mismod_mom = 1 
#ENDIF
#ENDIF
]
}

define_fun VAR_PRO seedlayer terminallayer1 terminallayer2 {
[
PROPERTY LR, WR, NF, MR, MULTI 
NF = COUNT(terminallayer1) 
WR = common_length(terminallayer1, terminallayer2)/(2*NF) 
LR = AREA(terminallayer1)/(WR*NF) 
MR = 1 
MULTI = 1 
#IFDEF VAR_MIS_MODE 0
mismod = 0 
#ELSE
#IFDEF VAR_MIS_MODE 1
mismod = 1 
#ENDIF
#ENDIF
]
}
//-------reduce procedure------


define_fun MOS_REDUCE device_name {
device_merge ( user_define device_name parallel YES [
TOLERANCE L 0 
effective L,W 
P = sum( W*L ) 
Q = sum( W/L ) 
W = sqrt( P*Q ) 
L = sqrt ( P/Q ) 
]  ) 
}

define_fun BJT_REDUCE device_name {
device_merge ( user_define device_name parallel YES [
effective "A" 
"A" = sum ( "A" ) 
]  ) 
}

define_fun RES_REDUCE device_name {
device_merge ( user_define device_name series pos neg YES [
TOLERANCE W 0 
effective L,W 
P = sum ( W * L ) 
Q = sum ( L / W ) 
L = sqrt( P * Q ) 
W = sqrt( P / Q ) 
]  ) 
device_merge ( user_define device_name parallel YES [
TOLERANCE L 0 
effective L,W 
P = sum ( W * L ) 
Q = sum ( W / L ) 
L = sqrt( P / Q ) 
W = sqrt( P * Q ) 
]  ) 
}

define_fun VAR_REDUCE device_name {
device_merge ( user_define device_name parallel YES [
TOLERANCE LR 0 WR 0 
effective LR,WR,NF 
LR = sum ( LR*NF )/sum ( NF ) 
WR = sum ( WR*NF )/sum ( NF ) 
NF = sum ( NF ) 
]  ) 
}

device_merge ( user_define mom_2t parallel yes [ 
tolerance LF 0 BM 0 TM 0 
effective LF,NF,BM,TM 
LF = SUM(LF)/COUNT() 
NF = SUM(NF) 
BM = SUM(BM)/COUNT() 
TM = SUM(TM)/COUNT() 
 ]  ) 

device_merge ( user_define mom_3t parallel yes [ 
tolerance LF 0 BM 0 TM 0 
effective LF,NF,BM,TM 
LF = SUM(LF)/COUNT() 
NF = SUM(NF) 
BM = SUM(BM)/COUNT() 
TM = SUM(TM)/COUNT() 
 ]  ) 


#IFDEF RC_EXTRACT FALSE 
//MOS

