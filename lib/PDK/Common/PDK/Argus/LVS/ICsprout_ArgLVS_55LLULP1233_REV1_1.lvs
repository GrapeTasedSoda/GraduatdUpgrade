#ENDIF
#IFDEF BACK_ANNOTATION_FLOW 2 
[
PROPERTY W,L,MR,MULTI 
#ENDIF
W = common_length(prolayer2,terminallayer)/2 
L = AREA(prolayer1)/W 
RS = rsh_value 
DW = dw_value 
DL = dl_value 
SR = (L*scale_value-2*DL)*RS/(W*scale_value-2*DW) 
MR = 1 
MULTI = 1 
#IFDEF RES_MIS_MODE 0
mismod = 0 
#ELSE
#IFDEF RES_MIS_MODE 1
mismod = 1 
#ENDIF
#ENDIF
]
}

